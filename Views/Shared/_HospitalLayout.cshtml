    <script>
        window.exportTable = function (type, tableId, fileName) {
        const table = document.getElementById(tableId);
        if (!table) { alert("Table not found!"); return; }
        const today = new Date().toLocaleDateString();
        const headers = [];
        table.querySelectorAll("thead th").forEach((th) => {
        if (th.innerText.trim().toLowerCase() !== "actions") headers.push(th.innerText.trim());
        });
        const rows = [];
        table.querySelectorAll("tbody tr").forEach(row => {
        if (row.style.display === "none") return;
        const rowData = [];
        Array.from(row.cells).forEach((cell, index) => {
        const headerText = table.querySelectorAll("thead th")[index]?.innerText?.trim()?.toLowerCase();
        if (headerText !== "actions") {
        let value = cell.querySelector(".full-message")?.innerText || cell.innerText;
        rowData.push(value.trim());
        }
        });
        rows.push(rowData);
        });

        if (type === "excel") {
        const wb = XLSX.utils.book_new();
        const data = [headers, ...rows];
        const ws = XLSX.utils.aoa_to_sheet(data);
        ws['!cols'] = headers.map((header, i) => {
        let maxLength = header.length;
        rows.forEach(r => { if (r[i] && r[i].toString().length > maxLength) maxLength = r[i].toString().length; });
        return { wch: Math.min(maxLength + 10, 120) };
        });
        XLSX.utils.book_append_sheet(wb, ws, fileName);
        XLSX.writeFile(wb, fileName + ".xlsx");
        }

        if (type === "pdf") {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF("landscape");
        doc.setFontSize(18);
        doc.setTextColor(8, 145, 178);
        doc.text("Khoon-e-Hayat - Blood Donation Management System", 14, 15);
        doc.setFontSize(13);
        doc.setTextColor(0, 0, 0);
        doc.text(fileName + " Report", 14, 25);
        doc.setFontSize(10);
        doc.text("Generated On: " + today, 14, 32);

        doc.autoTable({
        startY: 40, head: [headers], body: rows, theme: "grid",
        styles: { fontSize: 8, cellPadding: 3, valign: "middle", overflow: "linebreak", cellWidth: "wrap" },
        headStyles: { fillColor: [13, 110, 253], textColor: [255, 255, 255], fontStyle: "bold" },
        alternateRowStyles: { fillColor: [245, 247, 250] }
        });
        doc.save(fileName + ".pdf");
        }
        };

        /* ============================================
        GLOBAL SEARCH - LIVE AUTOCOMPLETE
        ============================================ */
        (function () {
        const searchInput = document.getElementById("globalSearch");
        const searchClear = document.getElementById("globalSearchClear");
        const autocomplete = document.getElementById("searchAutocomplete");
        if (!searchInput || !autocomplete) return;

        const pages = [
        { title: "Dashboard", keywords: ["dashboard", "home", "overview", "main", "panel", "hospital"], url: "/Hospital/Dashboard", icon: "bi-speedometer2", description: "View hospital dashboard and analytics" },
        { title: "Blood Inventory", keywords: ["blood", "inventory", "stock", "blood bank"], url: "/Hospital/BloodInventory", icon: "bi-droplet-half", description: "Manage blood inventory and stock levels" },
        { title: "Blood Collection History", keywords: ["collection", "history", "blood collection"], url: "/Hospital/BloodCollectionHistory", icon: "bi-box-arrow-in-down", description: "View blood collection records" },
        { title: "Blood Issue History", keywords: ["issue", "history", "blood issue", "distributed"], url: "/Hospital/BloodIssueHistory", icon: "bi-box-arrow-up-right", description: "Track blood distribution history" },
        { title: "Low Stock Monitor", keywords: ["low stock", "monitor", "alert", "inventory"], url: "/Hospital/LowStockMonitor", icon: "bi-exclamation-triangle", description: "Monitor low stock blood units" },
        { title: "Expiring Blood", keywords: ["expiring", "expiry", "blood", "soon"], url: "/Hospital/ExpiringBlood", icon: "bi-clock-history", description: "View blood units expiring soon" },
        { title: "Incoming Requests", keywords: ["requests", "incoming", "blood requests"], url: "/Hospital/IncomingRequests", icon: "bi-clipboard2-pulse", description: "View incoming blood requests" },
        { title: "Emergency Requests", keywords: ["emergency", "urgent", "critical", "requests"], url: "/Hospital/EmergencyRequests", icon: "bi-heart-pulse", description: "Handle emergency blood requests" },
        // NEW: Request Tracking Added to Global Search
        { title: "Request Tracking", keywords: ["request", "tracking", "track", "status", "blood request"], url: "/Hospital/RequestTracking", icon: "bi-clipboard2-check", description: "Track status of blood requests" },
        { title: "Smart Donor Search", keywords: ["donor", "search", "smart", "find"], url: "/Hospital/SmartDonorSearch", icon: "bi-search-heart", description: "Search for compatible donors" },
        { title: "Assigned Donors", keywords: ["donors", "assigned", "matched"], url: "/Hospital/AssignedDonors", icon: "bi-person-check", description: "View assigned donors" },
        { title: "Donor Responses", keywords: ["responses", "donor", "replies"], url: "/Hospital/DonorResponses", icon: "bi-chat-dots", description: "Check donor responses" },
        { title: "Notifications", keywords: ["notifications", "notification", "alerts", "messages", "bell"], url: "/Hospital/Notifications", icon: "bi-bell", description: "View all notifications" },
        { title: "My Profile", keywords: ["profile", "my profile", "account", "settings"], url: "/Profile/Index", icon: "bi-person-circle", description: "Manage your hospital profile" }
        ];

        let activeIndex = -1;
        let currentResults = [];
        let debounceTimer = null;

        function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function highlightMatch(text, query) {
        if (!query) return text;
        const regex = new RegExp('(' + escapeRegex(query) + ')', 'gi');
        return text.replace(regex, '<mark>$1</mark>');
        }

        function searchPages(query) {
        query = query.trim().toLowerCase();
        if (!query) return [];

        const results = [];
        pages.forEach(page => {
        if (page.title.toLowerCase().includes(query)) {
        results.push({ ...page, matchType: 'title' });
        return;
        }
        for (const kw of page.keywords) {
        if (kw.includes(query) || query.includes(kw)) {
        results.push({ ...page, matchType: 'keyword' });
        return;
        }
        }
        if (page.description.toLowerCase().includes(query)) {
        results.push({ ...page, matchType: 'description' });
        }
        });

        return results;
        }

        function renderResults(query) {
        currentResults = searchPages(query);
        activeIndex = -1;

        if (!query.trim()) {
        closeAutocomplete();
        return;
        }

        let html = '';

        if (currentResults.length === 0) {
        html = `
        <div class="search-no-results">
        <div class="search-no-results-icon"><i class="bi bi-search"></i></div>
        <div class="search-no-results-title">No matching results found</div>
        <div class="search-no-results-text">Try searching for "Dashboard", "Inventory", or "Blood"</div>
        </div>
        `;
        } else {
        html += `<div class="search-autocomplete-header">
        <span>Pages</span>
        <span class="result-count">${currentResults.length} result${currentResults.length > 1 ? 's' : ''}</span>
        </div>`;

        currentResults.forEach((page, idx) => {
        const displayTitle = page.matchType === 'title' ? highlightMatch(page.title, query) : page.title;

        html += `
        <a href="${page.url}" class="search-result-item" data-index="${idx}" role="option" aria-selected="false">
        <div class="search-result-icon"><i class="bi ${page.icon}"></i></div>
        <div class="search-result-content">
        <div class="search-result-title">${displayTitle}</div>
        <div class="search-result-desc">${page.description}</div>
        </div>
        <i class="bi bi-arrow-right search-result-arrow"></i>
        </a>
        `;
        });

        html += `
        <div class="search-keyboard-hint">
        <span class="kbd-hint"><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span class="kbd-hint"><kbd>↵</kbd> select</span>
        <span class="kbd-hint"><kbd>esc</kbd> close</span>
        </div>
        `;
        }

        autocomplete.innerHTML = html;
        openAutocomplete();
        }

        function openAutocomplete() {
        autocomplete.classList.add('open');
        searchInput.setAttribute('aria-expanded', 'true');
        }

        function closeAutocomplete() {
        autocomplete.classList.remove('open');
        searchInput.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
        }

        function setActiveItem(index) {
        const items = autocomplete.querySelectorAll('.search-result-item');
        if (items.length === 0) return;

        items.forEach(item => item.classList.remove('active'));

        if (index < 0) index = items.length - 1;
        if (index >= items.length) index = 0;

        activeIndex = index;
        items[activeIndex].classList.add('active');
        items[activeIndex].setAttribute('aria-selected', 'true');
        items[activeIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        function navigateToActive() {
        if (activeIndex >= 0 && currentResults[activeIndex]) {
        window.location.href = currentResults[activeIndex].url;
        } else if (currentResults.length === 1) {
        window.location.href = currentResults[0].url;
        }
        }

        searchInput.addEventListener('input', function () {
        const query = this.value;
        if (query.length > 0) {
        searchClear.classList.add('visible');
        } else {
        searchClear.classList.remove('visible');
        }

        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
        renderResults(query);
        }, 120);
        });

        searchInput.addEventListener('keydown', function (e) {
        if (!autocomplete.classList.contains('open')) {
        if (e.key === 'ArrowDown' && this.value.trim()) {
        renderResults(this.value);
        e.preventDefault();
        }
        return;
        }

        switch (e.key) {
        case 'ArrowDown': e.preventDefault(); setActiveItem(activeIndex + 1); break;
        case 'ArrowUp': e.preventDefault(); setActiveItem(activeIndex - 1); break;
        case 'Enter': e.preventDefault(); navigateToActive(); break;
        case 'Escape': e.preventDefault(); closeAutocomplete(); searchInput.blur(); break;
        case 'Tab': closeAutocomplete(); break;
        }
        });

        autocomplete.addEventListener('click', function (e) {
        const item = e.target.closest('.search-result-item');
        if (item) {
        e.preventDefault();
        const url = item.getAttribute('href');
        if (url) window.location.href = url;
        }
        });

        autocomplete.addEventListener('mouseover', function (e) {
        const item = e.target.closest('.search-result-item');
        if (item) {
        const idx = parseInt(item.getAttribute('data-index'));
        setActiveItem(idx);
        }
        });

        searchClear.addEventListener('click', function () {
        searchInput.value = '';
        searchClear.classList.remove('visible');
        closeAutocomplete();
        searchInput.focus();
        });

        document.addEventListener('click', function (e) {
        if (!document.getElementById('globalSearchWrapper').contains(e.target)) {
        closeAutocomplete();
        }
        });

        searchInput.addEventListener('focus', function () {
        if (this.value.trim()) {
        renderResults(this.value);
        }
        });

        document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey && e.key === 'k') || (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
        }
        });
        })();

        /* ============================================
        HOSPITAL NOTIFICATION BADGE POLLING
        ============================================ */
        function updateHospitalNotificationCounts() {
        fetch('/Hospital/GetUnreadNotificationCount')
        .then(res => res.json())
        .then(data => {
        const unreadCount = data.unread || 0;

        // SIDEBAR DOT INDICATOR
        const dot = document.getElementById("notifIndicatorDot");
        if (dot) {
        dot.style.display = unreadCount > 0 ? "block" : "none";
        }

        // NAVBAR BADGE
        const navbarBadge = document.getElementById("navbarNotifBadge");
        if (navbarBadge) {
        if (unreadCount > 0) {
        navbarBadge.textContent = unreadCount;
        navbarBadge.classList.add('show');
        } else {
        navbarBadge.classList.remove('show');
        }
        }
        })
        .catch(err => {
        console.warn('Notification polling error:', err);
        });
        }

        // Run immediately on page load, then every 5 seconds
        updateHospitalNotificationCounts();
        setInterval(updateHospitalNotificationCounts, 5000);

        /* ============================================
        NOTIFICATION BELL DROPDOWN FUNCTIONALITY
        ============================================ */
        (function () {
        const notificationBell = document.querySelector('.nav-item.dropdown a[data-bs-toggle="dropdown"]');
        const notifDropdownList = document.getElementById('notifDropdownList');
        const navbarNotifBadge = document.getElementById('navbarNotifBadge');
        let notificationDropdown = null;

        if (notificationBell) {
        notificationDropdown = new bootstrap.Dropdown(notificationBell);
        }

        async function loadNotifications() {
        try {
        const response = await fetch('/Hospital/GetLatestNotifications');

        if (!response.ok) {
        console.error(`HTTP Error: ${response.status} ${response.statusText}`);
        return;
        }

        const data = await response.json();

        if (data.success && notifDropdownList) {
        if (data.notifications.length === 0) {
        notifDropdownList.innerHTML = `
        <div class="text-center text-muted py-3">
        <i class="bi bi-bell-slash fs-4 d-block mb-2"></i>
        No new notifications
        </div>
        `;
        } else {
        let html = '';
        data.notifications.forEach(notif => {
        const unreadClass = !notif.isRead ? 'bg-light' : '';
        const unreadIndicator = !notif.isRead ? '<span class="badge bg-danger rounded-circle me-2" style="width: 8px; height: 8px;"></span>' : '';

        html += `
        <a href="${notif.actionUrl || '#'}" class="dropdown-item ${unreadClass} py-3" data-notification-id="${notif.notificationId}">
        <div class="d-flex align-items-start">
        ${unreadIndicator}
        <div class="flex-grow-1">
        <h6 class="mb-1 small fw-semibold">${notif.title}</h6>
        <p class="mb-1 small text-muted text-truncate" style="max-width: 250px;">${notif.message}</p>
        <small class="text-muted" style="font-size: 0.7rem;">${notif.timeAgo}</small>
        </div>
        </div>
        </a>
        `;
        });

        notifDropdownList.innerHTML = html;
        }

        if (navbarNotifBadge) {
        if (data.unreadCount > 0) {
        navbarNotifBadge.textContent = data.unreadCount;
        navbarNotifBadge.classList.add('show');
        } else {
        navbarNotifBadge.classList.remove('show');
        }
        }
        }
        } catch (err) {
        console.error('Error loading notifications:', err);
        }
        }

        if (notificationBell) {
        notificationBell.addEventListener('shown.bs.dropdown', function () {
        loadNotifications();
        });
        }

        loadNotifications();
        setInterval(loadNotifications, 30000);
        })();
    </script>
</body>
</html>