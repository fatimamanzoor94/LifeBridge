<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khoon-e-Hayat</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
            :root {
                --primary-red: #dc3545;
                --dark-red: #b02a37;
            }
            body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
            .btn-danger { background-color: var(--primary-red); border-color: var(--primary-red); }
            .btn-danger:hover { background-color: var(--dark-red); border-color: var(--dark-red); }
            .text-danger { color: var(--primary-red) !important; }
            .role-card { transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer; }
            .role-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
            .navbar-brand { font-weight: bold; color: var(--primary-red) !important; font-size: 1.5rem; }
            .card-header { border-radius: 0.375rem 0.375rem 0 0 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-tint me-2"></i>Khoon-e-Hayat
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-danger fw-bold" asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="bg-white text-center text-muted py-3 mt-auto border-top">
        <p class="mb-0">&copy; 2026 Khoon-e-Hayat. Saving lives, one drop at a time.</p>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>