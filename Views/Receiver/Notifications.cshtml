                    <div class="notif-detail-row-n">
                        <span class="notif-detail-label-n">Blood Group</span>
                        <span class="notif-detail-value-n" id="modalBloodGroup">-</span>
                    </div>
                    <div class="notif-detail-row-n">
                        <span class="notif-detail-label-n">Request Status</span>
                        <span class="notif-detail-value-n" id="modalRequestStatus">-</span>
                    </div>
                    <div class="notif-detail-row-n">
                        <span class="notif-detail-label-n">Category</span>
                        <span class="notif-detail-value-n" id="modalCategory">-</span>
                    </div>
                    <div class="notif-detail-row-n">
                        <span class="notif-detail-label-n">Priority</span>
                        <span class="notif-detail-value-n" id="modalPriority">-</span>
                    </div>
                    <div class="notif-detail-row-n">
