@functions {
    Dictionary<string, string> WithPage(Khoon_e_Hayat.ViewModels.NotificationFiltersViewModel f, int page)
    {
        var d = new Dictionary<string, string> { { "page", page.ToString() } };
        if (!string.IsNullOrEmpty(f?.SearchQuery)) d["SearchQuery"] = f.SearchQuery;
        if (!string.IsNullOrEmpty(f?.ReadStatus) && f.ReadStatus != "all") d["ReadStatus"] = f.ReadStatus;
        if (!string.IsNullOrEmpty(f?.Category) && f.Category != "all") d["Category"] = f.Category;
        if (!string.IsNullOrEmpty(f?.Priority) && f.Priority != "all") d["Priority"] = f.Priority;
        if (!string.IsNullOrEmpty(f?.SortOrder) && f.SortOrder != "newest") d["SortOrder"] = f.SortOrder;
        return d;
    }
}

@section Scripts {
    <script>
        /* ============================================
           NOTIFICATIONS MODULE - JavaScript
           ============================================ */
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // ============ DELETE MODAL VARIABLES (ADD THESE) ============
            let notificationToDeleteId = null;
            const deleteModalElement = document.getElementById('deleteNotificationModal');
            const deleteModal = new bootstrap.Modal(deleteModalElement);

            // ============ DATA STORE (for modal) ============
            const notifData = {};
            document.querySelectorAll('.notif-card-n').forEach(card => {
                const id = card.getAttribute('data-id');
                notifData[id] = {
                    title: card.querySelector('.notif-title-n span:last-child')?.textContent.trim() || '',
                    message: card.querySelector('.notif-msg-n')?.textContent.trim() || '',
                    requestId: card.querySelector('.notif-meta-item-n .bi-file-earmark-medical')?.parentElement?.textContent.trim() || '-',
                    hospital: card.querySelector('.notif-meta-item-n .bi-hospital')?.parentElement?.textContent.trim() || '-',
                    bloodGroup: card.querySelector('.notif-meta-item-n .bi-droplet-fill')?.parentElement?.textContent.trim() || '-',
                    requestStatus: card.querySelector('.notif-meta-item-n .bi-activity')?.parentElement?.textContent.trim() || '-',
                    category: card.querySelector('.notif-icon-n i')?.className.replace('bi ', '') || 'bell',
                    priority: card.querySelector('.badge-high-n') ? 'High' : (card.querySelector('.badge-low-n') ? 'Low' : 'Medium'),
                    isRead: card.getAttribute('data-read') === 'true',
                    iconColor: card.querySelector('.notif-icon-n')?.style.color || '#5C88A8'
                };
            });

            // ============ BULK SELECTION ============
            const bulkBar = document.getElementById('bulkBar');
            const selectedCount = document.getElementById('selectedCount');

            document.addEventListener('change', function (e) {
                if (e.target.classList.contains('notif-select')) {
                    updateBulkBar();
                }
            });

            function updateBulkBar() {
                const checked = document.querySelectorAll('.notif-select:checked');
                if (checked.length > 0) {
                    bulkBar.classList.add('show');
                    selectedCount.textContent = checked.length;
                } else {
                    bulkBar.classList.remove('show');
                }
            }

            window.bulkAction = async function (action) {
                const ids = Array.from(document.querySelectorAll('.notif-select:checked'))
                    .map(cb => parseInt(cb.getAttribute('data-id')));
                if (!ids.length) return;

                try {
                    const res = await fetch('/Receiver/BulkAction', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ action: action, ids: ids })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast(data.message, 'error');
                    }
                } catch (err) {
                    showToast('Network error. Please try again.', 'error');
                }
            };

            // ============ INDIVIDUAL ACTIONS ============
            window.markAs = async function (status, id) {
                const url = status === 'read' ? '/Receiver/MarkAsRead' : '/Receiver/MarkAsUnread';
                const fd = new FormData();
                fd.append('id', id);
                fd.append('__RequestVerificationToken', token);

                try {
                    const res = await fetch(url, { method: 'POST', body: fd });
                    const data = await res.json();
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 600);
                    } else {
                        showToast(data.message, 'error');
                    }
                } catch (err) {
                    showToast('Network error.', 'error');
                }
            };

            // ============ UPDATED DELETE FUNCTION ============
            window.deleteNotif = function (id) {
                notificationToDeleteId = id;
                deleteModal.show();
            };

            // Event Listener for the "Yes, Delete" button inside the modal
            document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
                if (!notificationToDeleteId) return;

                const fd = new FormData();
                fd.append('id', notificationToDeleteId);
                fd.append('__RequestVerificationToken', token);

                try {
                    const res = await fetch('/Receiver/DeleteNotification', { method: 'POST', body: fd });
                    const data = await res.json();

                    if (data.success) {
                        showToast(data.message, 'success');
                        deleteModal.hide();

                        const card = document.querySelector(`.notif-card-n[data-id="${notificationToDeleteId}"]`);
                        if (card) {
                            card.style.transition = 'all 0.3s';
                            card.style.opacity = '0';
                            card.style.transform = 'translateX(20px)';
                            setTimeout(() => card.remove(), 300);
                        }

                        notificationToDeleteId = null;
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast(data.message, 'error');
                    }
                } catch (err) {
                    showToast('Network error.', 'error');
                }
            });

            // ============ MARK ALL AS READ ============
            document.getElementById('markAllReadBtn')?.addEventListener('click', async function () {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                try {
                    const res = await fetch('/Receiver/MarkAllAsRead', { method: 'POST', body: fd });
                    const data = await res.json();
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 800);
                    }
                } catch (err) {
                    showToast('Network error.', 'error');
                }
            });

            // ============ REFRESH ============
            document.getElementById('refreshBtn')?.addEventListener('click', function () {
                location.reload();
            });

            // ============ VIEW DETAILS MODAL ============
            window.viewDetails = function (id) {
                const d = notifData[id];
                if (!d) return;

                document.getElementById('modalTitle').textContent = d.title;
                document.getElementById('modalMessage').textContent = d.message;
                document.getElementById('modalRequestId').textContent = d.requestId;
                document.getElementById('modalHospital').textContent = d.hospital;
                document.getElementById('modalBloodGroup').textContent = d.bloodGroup;
                document.getElementById('modalRequestStatus').textContent = d.requestStatus;
                document.getElementById('modalCategory').textContent = d.category;
                document.getElementById('modalPriority').textContent = d.priority;
                document.getElementById('modalReadStatus').innerHTML = d.isRead
                    ? '<span class="mini-badge-n badge-read-n">Read</span>'
                    : '<span class="mini-badge-n badge-unread-n">Unread</span>';

                const iconEl = document.getElementById('modalIcon');
                iconEl.style.background = d.iconColor + '15';
                iconEl.style.color = d.iconColor;
                iconEl.innerHTML = `<i class="bi ${d.category}"></i>`;

                new bootstrap.Modal(document.getElementById('notifDetailsModal')).show();

                if (!d.isRead) {
                    markAs('read', id);
                }
            };

            // ============ REAL-TIME POLLING ============
            let lastUnreadCount = parseInt(document.getElementById('statUnread')?.textContent.replace(/,/g, '') || '0');

            async function pollUpdates() {
                try {
                    const res = await fetch('/Receiver/GetNotificationsLive');
                    const data = await res.json();
                    if (data.success) {
                        const s = data.data;
                        const newUnread = s.unread;

                        document.getElementById('statTotal').textContent = s.total.toLocaleString();
                        document.getElementById('statUnread').textContent = s.unread.toLocaleString();
                        document.getElementById('statToday').textContent = s.today.toLocaleString();
                        document.getElementById('statImportant').textContent = s.important.toLocaleString();

                        updateAllBadges(s.unread);

                        document.getElementById('liveUpdateText').textContent = '• Updated just now';

                        if (newUnread > lastUnreadCount && lastUnreadCount >= 0) {
                            showToast(`You have ${newUnread - lastUnreadCount} new notification(s)`, 'info');
                        }
                        lastUnreadCount = newUnread;
                    }
                } catch (err) {
                    console.warn('Polling error:', err);
                }
            }

            function updateAllBadges(unreadCount) {
                const sidebarBadge = document.getElementById('unreadNotifBadge');
                const sidebarDot = document.getElementById('notifIndicatorDot');
                if (sidebarBadge && sidebarDot) {
                    if (unreadCount > 0) {
                        sidebarBadge.innerText = unreadCount;
                        sidebarBadge.style.display = 'flex';
                        sidebarDot.style.display = 'block';
                    } else {
                        sidebarBadge.style.display = 'none';
                        sidebarDot.style.display = 'none';
                    }
                }

                const navbarBadge = document.getElementById('navbarNotifBadge');
                if (navbarBadge) {
                    if (unreadCount > 0) {
                        navbarBadge.textContent = unreadCount;
                        navbarBadge.classList.remove('d-none');
                    } else {
                        navbarBadge.classList.add('d-none');
                    }
                }
            }

            setInterval(pollUpdates, 5000);

            // ============ EXPORT ============
            window.exportNotifications = function (type) {
                const cards = document.querySelectorAll('.notif-card-n');
                if (!cards.length) {
                    showToast('No notifications to export.', 'error');
                    return;
                }

                const headers = ['Title', 'Message', 'Category', 'Priority', 'Request ID', 'Hospital', 'Blood Group', 'Status', 'Date'];
                const rows = [];

                cards.forEach(card => {
                    const d = notifData[card.getAttribute('data-id')];
                    if (d) {
                        rows.push([
                            d.title,
                            d.message,
                            d.category,
                            d.priority,
                            d.requestId,
                            d.hospital,
                            d.bloodGroup,
                            d.isRead ? 'Read' : 'Unread',
                            card.querySelector('.notif-meta-item-n .bi-clock')?.parentElement?.textContent.trim() || ''
                        ]);
                    }
                });

                const fileName = 'ReceiverNotifications_' + new Date().toISOString().split('T')[0];

                if (type === 'excel' && window.XLSX) {
                    const wb = XLSX.utils.book_new();
                    const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
                    XLSX.utils.book_append_sheet(wb, ws, 'Notifications');
                    XLSX.writeFile(wb, fileName + '.xlsx');
                    showToast('Excel exported successfully.', 'success');
                } else if (type === 'pdf' && window.jspdf) {
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF('landscape');
                    doc.setFontSize(16);
                    doc.setTextColor(144, 21, 28);
                    doc.text('Khoon-e-Hayat - Receiver Notifications', 14, 15);
                    doc.setFontSize(10);
                    doc.setTextColor(0, 0, 0);
                    doc.text('Generated: ' + new Date().toLocaleString(), 14, 23);

                    doc.autoTable({
                        startY: 30,
                        head: [headers],
                        body: rows,
                        theme: 'grid',
                        headStyles: { fillColor: [92, 136, 168], textColor: [255, 255, 255] },
                        styles: { fontSize: 8, cellPadding: 3 }
                    });
                    doc.save(fileName + '.pdf');
                    showToast('PDF exported successfully.', 'success');
                } else {
                    showToast('Export library not loaded.', 'error');
                }
            };

            // ============ TOAST NOTIFICATION ============
            function showToast(msg, type) {
                const colors = {
                    success: { bg: '#e6f7ee', border: '#198754', text: '#198754', icon: 'bi-check-circle-fill' },
                    error:   { bg: '#ffebee', border: '#90151C', text: '#90151C', icon: 'bi-x-circle-fill' },
                    info:    { bg: '#e0f7fa', border: '#0dcaf0', text: '#0dcaf0', icon: 'bi-info-circle-fill' }
                };
                const c = colors[type] || colors.info;

                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed; top: 20px; right: 20px; z-index: 99999;
                    background: ${c.bg}; color: ${c.text};
                    border: 1px solid ${c.border}; border-left: 4px solid ${c.border};
                    padding: 14px 20px; border-radius: 12px;
                    font-weight: 600; font-size: 0.88rem;
                    display: flex; align-items: center; gap: 10px;
                    animation: slideInToast 0.3s ease;
                    box-shadow: none;
                `;
                toast.innerHTML = `<i class="bi ${c.icon}"></i> ${msg}`;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transition = 'opacity 0.3s';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            const style = document.createElement('style');
            style.textContent = `
                @@keyframes slideInToast {
                    from { transform: translateX(100%); opacity: 0; }
                    to { transform: translateX(0); opacity: 1; }
                }
            `;
            document.head.appendChild(style);

        })();
    </script>
}