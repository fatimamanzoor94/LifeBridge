@model Khoon_e_Hayat.ViewModels.ReceiverBloodRequestViewModel
@{
    ViewData["Title"] = "My Blood Requests";
    Layout = "~/Views/Shared/_ReceiverLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">My Blood Requests</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Requests -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-clipboard2-pulse text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Requests</h6>
                                <small class="text-muted">@Model.TotalCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-hourglass-split text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Pending Requests</h6>
                                <small class="text-muted">@Model.PendingCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Fulfilled -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Fulfilled Requests</h6>
                                <small class="text-muted">@Model.FulfilledCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Emergency -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Emergency Requests</h6>
                                <small class="text-muted">@Model.EmergencyCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Active Cities -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-geo-alt text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Active Cities</h6>
                                <small class="text-muted">@Model.ActiveCitiesCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Hospital, Blood Group, City..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Urgency</label>
                            <select id="filterUrgency" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Matched">Matched</option>
                                <option value="Fulfilled">Fulfilled</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">City</label>
                            <select id="filterCity" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var city in Model.AvailableCities)
                                {
                                    <option value="@city.ToLower()">@city</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">My Blood Requests</h4>
                            <small class="text-muted">Track and manage your blood requests</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'requestsTable', 'MyBloodRequests')"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'requestsTable', 'MyBloodRequests')"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="requestsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Request ID</th>
                                    <th>Blood Group</th>
                                    <th>Units</th>
                                    <th>Hospital Name</th>
                                    <th>City</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Requests.Any())
                                {
                                    foreach (var req in Model.Requests)
                                    {
                                        <tr>
                                            <td>REQ-@req.RequestId.ToString("D4")</td>
                                            <td><span class="fw-bold text-danger">@req.BloodGroup</span></td>
                                            <td>@req.UnitsRequired</td>
                                            <td>@(req.HospitalName ?? "-")</td>
                                            <td>@(req.City ?? "-")</td>
                                            <td>
                                                @if (req.UrgencyLevel == "Critical") { <span class="badge bg-danger-subtle text-danger">Critical</span> }
                                                else if (req.UrgencyLevel == "High") { <span class="badge bg-warning-subtle text-warning">High</span> }
                                                else if (req.UrgencyLevel == "Medium") { <span class="badge bg-info-subtle text-info">Medium</span> }
                                                else { <span class="badge bg-secondary-subtle text-secondary">Low</span> }
                                            </td>
                                            <td>
                                                @if (req.RequestStatus == "Pending") { <span class="badge bg-warning-subtle text-warning">Pending</span> }
                                                else if (req.RequestStatus == "Matched") { <span class="badge bg-info-subtle text-info">Matched</span> }
                                                else if (req.RequestStatus == "Fulfilled") { <span class="badge bg-success-subtle text-success">Fulfilled</span> }
                                                else if (req.RequestStatus == "Cancelled") { <span class="badge bg-danger-subtle text-danger">Cancelled</span> }
                                                else { <span class="badge bg-secondary-subtle text-secondary">@req.RequestStatus</span> }
                                            </td>
                                            <td>@req.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" 
                                                            data-requestid="@req.RequestId"
                                                            data-bg="@req.BloodGroup"
                                                            data-units="@req.UnitsRequired"
                                                            data-urgency="@req.UrgencyLevel"
                                                            data-reqdate="@(req.RequiredDate?.ToString("dd-MMM-yyyy") ?? "N/A")"
                                                            data-hospital="@req.HospitalName"
                                                            data-city="@req.City"
                                                            data-status="@req.RequestStatus"
                                                            data-created="@req.CreatedDate.ToString("dd-MMM-yyyy")"
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    @if (req.RequestStatus == "Pending")
                                                    {
                                                        <button type="button" class="btn btn-outline-danger cancel-request-btn" 
                                                                data-requestid="@req.RequestId" 
                                                                title="Cancel Request">
                                                            <i class="bx bx-x"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="emptyStateRow">
                                        <td colspan="9" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bx bx-droplet fs-1 d-block mb-2 text-danger"></i>
                                                <h5 class="fw-semibold">No Blood Requests Found</h5>
                                                <p class="mb-0">You have not created any blood requests yet.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="pagination-wrapper-n" style="margin-top: 20px;">
                            <small class="text-muted">
                                Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                                <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                                <strong>@Model.TotalCount</strong> requests
                            </small>
                            <nav>
                                <ul class="pagination pagination-n mb-0">
                                    @{
                                        var prevDisabled = Model.CurrentPage == 1 ? "disabled" : "";
                                        var nextDisabled = Model.CurrentPage == Model.TotalPages ? "disabled" : "";
                                    }
                                    <li class="page-item @prevDisabled">
                                        <a class="page-link" href="@Url.Action("MyBloodRequests", WithPage(Model.CurrentPage - 1))">
                                            <i class="bi bi-chevron-left"></i> Previous
                                        </a>
                                    </li>
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        var active = i == Model.CurrentPage ? "active" : "";
                                        <li class="page-item @active">
                                            <a class="page-link" href="@Url.Action("MyBloodRequests", WithPage(i))">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @nextDisabled">
                                        <a class="page-link" href="@Url.Action("MyBloodRequests", WithPage(Model.CurrentPage + 1))">
                                            Next <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-droplet text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Blood Request Details</h5>
                        <small class="text-muted" id="modalRequestId">REQ-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-danger mb-3"><i class="bx bx-droplet me-2"></i>Blood Requirement</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-danger mb-0" id="d_BloodGroup">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext mb-0" id="d_Units">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Urgency Level</label><p class="form-control-plaintext mb-0" id="d_Urgency">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Required Date</label><p class="form-control-plaintext mb-0" id="d_ReqDate">-</p></div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-buildings me-2"></i>Hospital Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Hospital Name</label><p class="form-control-plaintext mb-0" id="d_Hospital">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">City</label><p class="form-control-plaintext mb-0" id="d_City">-</p></div>
                        </div>

                        <h6 class="fw-bold text-info mb-3 mt-4"><i class="bx bx-info-circle me-2"></i>Request Information</h6>
                        <div class="row g-3">
                            <div class="col-4"><label class="form-label small text-muted mb-1">Request ID</label><p class="form-control-plaintext fw-semibold mb-0" id="d_RequestId">-</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Created Date</label><p class="form-control-plaintext mb-0" id="d_CreatedDate">-</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Status</label><p class="form-control-plaintext mb-0" id="d_Status">-</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CANCEL REQUEST MODAL ==================== -->
<div class="modal fade" id="cancelRequestModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #fff5f5; border: 6px solid white;">
                    <i class="fas fa-times-circle" style="color: #dc3545;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Cancel Blood Request?</h4>
                <p class="text-muted">
                    You are about to cancel request <strong id="cancelRequestId"></strong>.<br />
                    This action cannot be undone.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmCancelBtn">Yes, Cancel Request</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card { background: #ffffff; border-radius: 16px !important; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .custom-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important; }
    .icon-box { width: 48px; height: 48px; background: #f8f9fa; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .trend-icon { font-size: 1.5rem; color: #28a745; opacity: 0.6; }
    .delete-modal { border-radius: 22px; border: none; box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25); overflow: visible; animation: popIn 0.3s ease; }
    .delete-icon-wrapper { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); z-index: 10; }
    .icons-box { width: 85px; height: 85px; background: #fff5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 6px solid white; }
    .icons-box i { font-size: 34px; color: #ff3b3b; }
    @@keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    
    #viewDetailsModal .form-control-plaintext { font-size: 1.05rem; padding: 0.25rem 0; border-bottom: 1px dashed #dee2e6; }

    /* ---------- PAGINATION ---------- */
    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ==================== GLOBAL VARIABLES ====================
            let currentRequestId = null;
            let cancelModalInstance = null;
            
            cancelModalInstance = new bootstrap.Modal(document.getElementById('cancelRequestModal'));

            // ==================== FILTERS ====================
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterUrgency = document.getElementById('filterUrgency');
            const filterStatus = document.getElementById('filterStatus');
            const filterCity = document.getElementById('filterCity');

            function filterTable() {
                const sVal = searchInput.value.toLowerCase();
                const bgVal = filterBloodGroup.value;
                const urgVal = filterUrgency.value;
                const statVal = filterStatus.value;
                const cityVal = filterCity.value;
                
                const rows = document.querySelectorAll("#requestsTable tbody tr");

                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    const reqId = row.cells[0].textContent.toLowerCase();
                    const bg = row.cells[1].textContent.toLowerCase();
                    const hospital = row.cells[3].textContent.toLowerCase();
                    const city = row.cells[4].textContent.toLowerCase();
                    
                    const urgBadge = row.cells[5].querySelector('.badge');
                    const urgText = urgBadge ? urgBadge.textContent : '';

                    const statBadge = row.cells[6].querySelector('.badge');
                    const statText = statBadge ? statBadge.textContent : '';

                    let show = true;

                    if (sVal && !(reqId.includes(sVal) || bg.includes(sVal) || hospital.includes(sVal) || city.includes(sVal))) show = false;
                    if (bgVal !== 'all' && bg !== bgVal.toLowerCase()) show = false;
                    if (urgVal !== 'all' && urgText !== urgVal) show = false;
                    if (statVal !== 'all' && statText !== statVal) show = false;
                    if (cityVal !== 'all' && city !== cityVal) show = false;

                    row.style.display = show ? "" : "none";
                });
                initPagination();
            }

            [searchInput, filterBloodGroup, filterUrgency, filterStatus, filterCity].forEach(el => el.addEventListener('input', filterTable));
            [filterBloodGroup, filterUrgency, filterStatus, filterCity].forEach(el => el.addEventListener('change', filterTable));

            

            // ==================== EVENT DELEGATION ====================
            document.getElementById('requestsTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target);
                }
                else if (target.classList.contains('cancel-request-btn')) {
                    openCancelModal(target.getAttribute('data-requestid'));
                }
            });

            // ==================== VIEW DETAILS MODAL ====================
            function openViewDetailsModal(btn) {
                document.getElementById('modalRequestId').textContent = `REQ-${String(btn.getAttribute('data-requestid')).padStart(4, '0')}`;
                
                document.getElementById('d_BloodGroup').textContent = btn.getAttribute('data-bg') || '-';
                document.getElementById('d_Units').textContent = btn.getAttribute('data-units') || '-';
                document.getElementById('d_Urgency').textContent = btn.getAttribute('data-urgency') || '-';
                document.getElementById('d_ReqDate').textContent = btn.getAttribute('data-reqdate') || '-';
                
                document.getElementById('d_Hospital').textContent = btn.getAttribute('data-hospital') || '-';
                document.getElementById('d_City').textContent = btn.getAttribute('data-city') || '-';
                
                document.getElementById('d_RequestId').textContent = `REQ-${String(btn.getAttribute('data-requestid')).padStart(4, '0')}`;
                document.getElementById('d_CreatedDate').textContent = btn.getAttribute('data-created') || '-';
                document.getElementById('d_Status').textContent = btn.getAttribute('data-status') || '-';
                
                const viewModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                viewModal.show();
            }

            // ==================== CANCEL REQUEST MODAL ====================
            function openCancelModal(requestId) {
                currentRequestId = requestId;
                document.getElementById('cancelRequestId').textContent = `REQ-${String(requestId).padStart(4, '0')}`;
                cancelModalInstance.show();
            }

            document.getElementById('confirmCancelBtn').addEventListener('click', function() {
                if (!currentRequestId) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('requestId', currentRequestId);

                // TODO: Implement actual AJAX call to your Receiver Controller
                // fetch('/Receiver/CancelRequest', { method: 'POST', body: fd }) ...

                cancelModalInstance.hide();
                showNotification(`Request REQ-${String(currentRequestId).padStart(4, '0')} has been cancelled successfully.`, 'success');
                
                // Update UI dynamically
                const row = document.querySelector(`button[data-requestid="${currentRequestId}"]`)?.closest('tr');
                if (row) {
                    const statusBadge = row.cells[6].querySelector('.badge');
                    statusBadge.className = 'badge bg-danger-subtle text-danger';
                    statusBadge.textContent = 'Cancelled';
                    
                    // Remove cancel button
                    const cancelBtn = row.querySelector('.cancel-request-btn');
                    if (cancelBtn) cancelBtn.remove();
                }
            });

            // ==================== EXPORT & NOTIFICATIONS ====================
            function exportTable(type, tableId, fileName) {
                const table = document.getElementById(tableId);
                if (!table) return;

                if (type === 'excel') {
                    let csv = [];
                    let rows = table.querySelectorAll("tr");
                    for (let i = 0; i < rows.length; i++) {
                        if (rows[i].style.display === 'none') continue;
                        let row = [], cols = rows[i].querySelectorAll("td, th");
                        for (let j = 0; j < cols.length; j++) {
                            let text = cols[j].innerText.replace(/"/g, '""');
                            row.push(`"${text}"`);
                        }
                        csv.push(row.join(","));
                    }
                    let csvFile = csv.join("\n");
                    let downloadLink = document.createElement("a");
                    downloadLink.href = 'data:text/csv;charset=utf-8,' + encodeURI(csvFile);
                    downloadLink.target = '_blank';
                    downloadLink.download = `${fileName}.csv`;
                    downloadLink.click();
                } else {
                    showNotification('PDF export is not yet implemented.', 'error');
                }
            }

            function showNotification(msg, type) {
                const bg = type === 'success' ? '#28a745' : (type === 'warning' ? '#ffc107' : '#dc3545');
                const textColor = type === 'warning' ? '#000' : '#fff';
                const n = document.createElement('div');
                n.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:${textColor};padding:12px 20px;border-radius:10px;box-shadow:0 5px 20px rgba(0,0,0,0.2);font-weight:500;animation:popIn 0.3s ease;`;
                n.textContent = msg;
                document.body.appendChild(n);
                setTimeout(() => n.remove(), 3000);
            }

            @functions {
        Dictionary<string, string> WithPage(int page)
        {
                var d = new Dictionary<string, string> { { "page", page.ToString() } };
                // Add filter parameters if needed in future
                return d;
        }
}
        });
    </script>
