                const revHospitalContact = document.getElementById('rev-HospitalContact');
                const revCity = document.getElementById('rev-City');
                const revAddress = document.getElementById('rev-Address');
                const revRequiredDate = document.getElementById('rev-RequiredDate');
                const revUrgencyLevel = document.getElementById('rev-UrgencyLevel');
                const revReason = document.getElementById('rev-Reason');
                const revIsEmergency = document.getElementById('rev-IsEmergency');

                if(revReceiverName) revReceiverName.textContent = '@Model.ReceiverName';
