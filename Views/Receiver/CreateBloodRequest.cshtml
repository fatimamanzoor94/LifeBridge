                const revReceiverEmail = document.getElementById('rev-ReceiverEmail');
                const revPatientName = document.getElementById('rev-PatientName');
                const revPatientAge = document.getElementById('rev-PatientAge');
                const revGender = document.getElementById('rev-Gender');
                const revBloodGroup = document.getElementById('rev-BloodGroup');
                const revUnitsRequired = document.getElementById('rev-UnitsRequired');
