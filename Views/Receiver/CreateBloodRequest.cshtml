<!-- ==================== NOTIFICATION CONTAINER ==================== -->
<div id="notificationContainer" style="position: fixed; top: 20px; right: 20px; z-index: 10000; display: flex; flex-direction: column; gap: 10px;"></div>

<style>
    /* ==================== WIZARD STEPS VISIBILITY & ANIMATION ==================== */
    .wizard-step {
        display: none;
    }

        .wizard-step.active {
            display: block;
        }

        .wizard-step.slide-in-right {
            animation: wizardSlideInRight 0.4s ease forwards;
        }

        .wizard-step.slide-in-left {
            animation: wizardSlideInLeft 0.4s ease forwards;
        }

    @@keyframes wizardSlideInRight {
        from {
            opacity: 0;
            transform: translateX(40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes wizardSlideInLeft {
        from {
            opacity: 0;
            transform: translateX(-40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* ==================== PREMIUM FORM CONTROLS ==================== */
    .form-label-premium {
        font-size: 0.85rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        display: block;
    }

    .input-group-premium {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        color: #adb5bd;
        font-size: 1.1rem;
        z-index: 2;
        pointer-events: none;
        transition: color 0.2s;
    }

    .form-control-premium, .form-select-premium {
        width: 100%;
        border: 1.5px solid #e9ecef;
        border-radius: 12px;
        padding: 12px 16px 12px 44px;
        font-size: 0.95rem;
        color: #212529;
        background: #fff;
        transition: all 0.3s ease;
    }

    .form-select-premium {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 16px center;
        background-size: 16px 12px;
        padding-right: 40px;
    }

        .form-control-premium:focus, .form-select-premium:focus {
            outline: none;
            border-color: #5C88A8;
            box-shadow: none;
        }

            .form-control-premium:focus + .input-icon,
            .input-group-premium:focus-within .input-icon {
                color: #5C88A8;
            }

        .form-control-premium.is-invalid, .form-select-premium.is-invalid {
            border-color: #dc3545;
            box-shadow: none;
        }

    .invalid-feedback-custom {
        font-size: 0.8rem;
        color: #dc3545;
        margin-top: 4px;
        display: none;
        align-items: center;
        gap: 4px;
    }

        .invalid-feedback-custom.show {
            display: flex;
        }

        .invalid-feedback-custom::before {
            content: '\f33a';
            font-family: 'bootstrap-icons';
        }

    /* ==================== BLOOD GROUP CARDS ==================== */
    .blood-group-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .blood-group-card {
        position: relative;
        border: 2px solid #e9ecef;
        border-radius: 16px;
        padding: 20px 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
        box-shadow: none;
    }

        .blood-group-card:hover {
            border-color: #5C88A8;
            transform: translateY(-4px);
        }

        .blood-group-card:focus {
            outline: none;
            border-color: #5C88A8;
        }

        .blood-group-card.active {
            border-color: #90151C;
            background: #fff5f5;
            transform: translateY(-4px);
        }

        .blood-group-card i {
            font-size: 1.8rem;
            color: #90151C;
            transition: transform 0.3s;
        }

        .blood-group-card.active i {
            transform: scale(1.1);
        }

        .blood-group-card .bg-text {
            font-size: 1.2rem;
            font-weight: 800;
            color: #90151C;
            margin-top: 8px;
            letter-spacing: 0.5px;
        }

    .check-indicator {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #90151C;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        opacity: 0;
        transform: scale(0.5);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .blood-group-card.active .check-indicator {
        opacity: 1;
        transform: scale(1);
    }

    /* ==================== QUANTITY & URGENCY SELECTORS ==================== */
    .quantity-selector {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #f8f9fa;
        padding: 8px;
        border-radius: 16px;
        border: 1.5px solid #e9ecef;
    }

    .quantity-btn {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: none;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 1.2rem;
        color: #5C88A8;
        box-shadow: none;
    }

        .quantity-btn:hover {
            background: #5C88A8;
            color: #fff;
            transform: scale(1.05);
        }

        .quantity-btn:active {
            transform: scale(0.95);
        }

    .quantity-input {
        flex: 1;
        text-align: center;
        font-weight: 700;
        font-size: 1.2rem;
        border: none;
        background: transparent;
        color: #212529;
    }

        .quantity-input:focus {
            outline: none;
        }

    .urgency-selector {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .urgency-option {
        padding: 12px;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
        font-size: 0.9rem;
        background: #fff;
    }

        .urgency-option:hover {
            border-color: #adb5bd;
        }

        .urgency-option.active[data-value="Normal"] {
            border-color: #198754;
            background: #e6f7ee;
            color: #198754;
        }

        .urgency-option.active[data-value="High"] {
            border-color: #ffc107;
            background: #fff3cd;
            color: #d39e00;
        }

        .urgency-option.active[data-value="Critical"] {
            border-color: #90151C;
            background: #ffebee;
            color: #90151C;
        }

        .urgency-option i {
            margin-right: 4px;
        }

    /* ==================== WIZARD TIMELINE ==================== */
    .wizard-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
    }

        .wizard-timeline::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 40px;
            right: 40px;
            height: 3px;
            background: #e9ecef;
            z-index: 0;
            border-radius: 2px;
        }

    .timeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 1;
        flex: 1;
    }

    .timeline-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 1.1rem;
        color: #adb5bd;
    }

    .timeline-step.active .timeline-icon {
        border-color: #5C88A8;
        background: #5C88A8;
        color: #fff;
        transform: scale(1.1);
    }

    .timeline-step.completed .timeline-icon {
        border-color: #198754;
        background: #198754;
        color: #fff;
    }

        .timeline-step.completed .timeline-icon::before {
            content: '\f26b';
            font-family: 'bootstrap-icons';
        }

        .timeline-step.completed .timeline-icon i {
            display: none;
        }

    .timeline-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #adb5bd;
        transition: color 0.3s;
    }

    .timeline-step.active .timeline-label {
        color: #5C88A8;
    }

    .timeline-step.completed .timeline-label {
        color: #198754;
    }

    /* ==================== EMERGENCY CARD ==================== */
    .emergency-card {
        border: 2px solid #e9ecef;
        border-radius: 20px;
        padding: 24px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
    }

        .emergency-card.active {
            border-color: #90151C;
            background: #fff5f5;
        }

    .emergency-switch {
        width: 50px !important;
        height: 26px !important;
        cursor: pointer;
    }

        .emergency-switch:checked {
            background-color: #90151C !important;
            border-color: #90151C !important;
        }

    .emergency-details {
        display: none;
        margin-top: 20px;
        padding: 16px;
        background: rgba(144, 21, 28, 0.05);
        border-radius: 12px;
        border-left: 4px solid #90151C;
    }

    .emergency-card.active .emergency-details {
        display: block;
    }

    /* ==================== SIDEBAR ==================== */
    .sidebar-card-premium {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 20px;
        padding: 24px;
        box-shadow: none;
    }

    .sidebar-card-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #212529;
    }

    .preview-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 16px;
        border-bottom: 1px dashed #e9ecef;
    }

    .preview-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #5C88A8, #0dcaf0);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.5rem;
    }

    .preview-name {
        font-weight: 700;
        font-size: 1rem;
        color: #212529;
        margin-bottom: 2px;
    }

    .preview-hospital {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .preview-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .preview-badges .badge {
            font-weight: 600;
            font-size: 0.8rem;
            padding: 8px 12px;
        }

    /* ==================== REVIEW CARDS ==================== */
    .review-card-premium {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 16px;
        padding: 20px;
        height: 100%;
        transition: all 0.2s;
        box-shadow: none;
    }

        .review-card-premium:hover {
            box-shadow: none;
        }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e9ecef;
    }

    .review-title {
        font-size: 0.95rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        color: #212529;
    }

    .review-edit-btn {
        background: #fff;
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 20px;
        transition: all 0.2s;
    }

        .review-edit-btn:hover {
            background: #5C88A8;
            color: #fff;
            border-color: #5C88A8;
        }

    .review-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 0.9rem;
    }

    .review-label {
        color: #6c757d;
    }

    .review-value {
        font-weight: 600;
        text-align: right;
        max-width: 60%;
        word-break: break-word;
        color: #212529;
    }

    /* ==================== SUCCESS ANIMATION ==================== */
    .success-animation {
        width: 80px;
        height: 80px;
        margin: 0 auto;
    }

    .checkmark {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: block;
        stroke-width: 2;
        stroke-miterlimit: 10;
        animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s both;
    }

    .checkmark-circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-width: 2;
        stroke-miterlimit: 10;
        fill: none;
        animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }

    .checkmark-check {
        transform-origin: 50% 50%;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
    }

    @@keyframes stroke {
        100% {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes scale {
        0%, 100% {
            transform: none;
        }

        50% {
            transform: scale3d(1.1, 1.1, 1);
        }
    }

    @@keyframes fill {
        100% {
            box-shadow: inset 0px 0px 0px 40px #fff;
        }
    }

    /* ==================== NOTIFICATIONS ==================== */
    .custom-notification {
        background: #fff;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 300px;
        max-width: 400px;
        animation: slideIn 0.3s ease-out;
        border-left: 4px solid;
        box-shadow: none;
    }

        .custom-notification.success {
            border-left-color: #198754;
        }

        .custom-notification.error {
            border-left-color: #dc3545;
        }

        .custom-notification.info {
            border-left-color: #0dcaf0;
        }

        .custom-notification i {
            font-size: 1.5rem;
        }

        .custom-notification.success i {
            color: #198754;
        }

        .custom-notification.error i {
            color: #dc3545;
        }

        .custom-notification.info i {
            color: #0dcaf0;
        }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* ==================== RESPONSIVE ==================== */
    @@media (max-width: 991px) {
        .col-lg-4 {
            order: -1;
        }

        .sidebar-card-premium.sticky-top {
            position: relative;
            top: 0;
            margin-bottom: 20px;
        }
    }

    @@media (max-width: 768px) {
        .blood-group-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .urgency-selector {
            grid-template-columns: 1fr;
        }

        .wizard-timeline {
            flex-direction: column;
            gap: 16px;
            align-items: flex-start;
        }

            .wizard-timeline::before {
                display: none;
            }

        .timeline-step {
            flex-direction: row;
            gap: 12px;
            width: 100%;
        }

        .timeline-icon {
            margin-bottom: 0;
        }
    }

    .hover-bg-light:hover {
    background-color: #f8f9fa;
}
.cursor-pointer {
    cursor: pointer;
}
/* Smooth transition for info card */
#hospitalInfoCard, #nearestHospitalsSuggestion {
    animation: fadeIn 0.4s ease-in-out;
}
@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Hospital Dropdown Styling */
#hospitalDropdown {
    max-height: 300px;
    overflow-y: auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    border: 1px solid #e9ecef;
    z-index: 1050 !important; /* Bootstrap modal se upar */
}

#hospitalDropdown .hover-bg-light:hover {
    background-color: #f8f9fa !important;
}

.cursor-pointer {
    cursor: pointer;
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let currentStep = 1;
            const totalSteps = 4;
            const stepTitles = ["Patient Information", "Hospital Information", "Request Details", "Review & Confirm"];
            let isHospitalSelected = false; // ✅ MUST BE DECLARED HERE AT TOP LEVEL

            // ==================== DOM ELEMENTS ====================
            const form = document.getElementById('bloodRequestForm');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const submitBtn = document.getElementById('submitBtn');
            const draftBtn = document.getElementById('draftBtn');
            const progress = document.getElementById('wizardProgress');
            const progressText = document.getElementById('progressText');
            const timelineSteps = document.querySelectorAll('.timeline-step');
            const wizardSteps = document.querySelectorAll('.wizard-step');

            // ==================== HELPER: NOTIFICATIONS ====================
            function showNotification(message, type = 'info') {
                const container = document.getElementById('notificationContainer');
                const icons = { success: 'bi-check-circle-fill', error: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };

                const notif = document.createElement('div');
                notif.className = `custom-notification ${type}`;
                notif.innerHTML = `<i class="bi ${icons[type]}"></i><div><strong style="display:block; font-size:0.9rem;">${type.charAt(0).toUpperCase() + type.slice(1)}</strong><span style="font-size:0.85rem; color:#6c757d;">${message}</span></div>`;

                container.appendChild(notif);
                setTimeout(() => {
                    notif.style.animation = 'slideIn 0.3s ease-out reverse';
                    setTimeout(() => notif.remove(), 300);
                }, 3500);
            }

            // ==================== FORM INPUT ELEMENTS ====================
            const patientNameInput = document.getElementById('PatientName');
            const patientAgeInput = document.getElementById('PatientAge');
            const genderSelect = document.getElementById('Gender');
            const bloodGroupHidden = document.getElementById('BloodGroupHidden');
            const unitsInput = document.getElementById('unitsInput');
            const hospitalSearchInput = document.getElementById('HospitalNameSearch');
            const hospitalNameHidden = document.getElementById('HospitalName');
            const hospitalContactInput = document.getElementById('HospitalContactHidden');
            const cityInput = document.getElementById('CityHidden');
            const addressInput = document.getElementById('AddressHidden');
            const requiredDateInput = document.getElementById('RequiredDate');
            const reasonTextarea = document.getElementById('Reason');
            const notesTextarea = document.getElementById('AdditionalNotes');
            const areaInput = document.getElementById('Area');
            const emergencyToggle = document.getElementById('IsEmergencyToggle');
            const urgencyHidden = document.getElementById('UrgencyLevelHidden');
            const iAmThePatientCheckbox = document.getElementById('iAmThePatient');

            // ==================== REAL-TIME INPUT VALIDATIONS ====================
            
            // Patient Name Validation
            if(patientNameInput) {
                patientNameInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^a-zA-Z\s]/g, '');
                    this.value = this.value.replace(/\s+/g, ' ').trim();
                    if (this.value.length > 0 && this.value.length < 3) {
                        showError('PatientName', 'Patient name must be at least 3 characters');
                    } else {
                        clearError('PatientName');
                    }
                    updateSummary();
                });
            }

            // Patient Age Validation
            if(patientAgeInput) {
                patientAgeInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^0-9]/g, '');
                    if (this.value.startsWith('0') && this.value.length > 1) {
                        this.value = this.value.replace(/^0+/, '');
                    }
                    const age = parseInt(this.value);
                    if (this.value.length > 0) {
                        if (age < 1) {
                            showError('PatientAge', 'Age must be at least 1 year');
                        } else if (age > 120) {
                            showError('PatientAge', 'Age cannot exceed 120 years');
                            this.value = '120';
                        } else {
                            clearError('PatientAge');
                        }
                    }
                    updateSummary();
                });
            }

            // Hospital Search Input Validation
            if(hospitalSearchInput) {
                hospitalSearchInput.addEventListener('input', function(e) {
                    if(hospitalNameHidden) {
                        hospitalNameHidden.value = this.value;
                    }
                    const val = this.value.trim();
                    if (val.length > 0 && val.length < 3) {
                        showError('HospitalName', 'Hospital name must contain at least 3 characters.');
                    } else {
                        clearError('HospitalName');
                    }
                    updateSummary();
                });
            }

            // City Validation
            if(cityInput) {
                cityInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^a-zA-Z\s\-]/g, '');
                    this.value = this.value.trim();
                    if (this.value.length > 50) {
                        this.value = this.value.substring(0, 50);
                    }
                    if (this.value.length > 0 && this.value.length < 2) {
                        showError('City', 'City must contain at least 2 characters.');
                    } else {
                        clearError('City');
                    }
                });
            }

            // Reason Validation
            if(reasonTextarea) {
                reasonTextarea.addEventListener('input', function(e) {
                    const words = this.value.trim().split(/\s+/).filter(w => w.length > 0);
                    const counter = document.getElementById('reasonCounter');
                    if(counter) {
                        counter.textContent = `${this.value.length} / 500`;
                    }
                    if (this.value.length > 500) {
                        this.value = this.value.substring(0, 500);
                        if(counter) counter.textContent = `500 / 500`;
                    }
                    if (this.value.length > 0 && this.value.trim().length === 0) {
                        showError('Reason', 'Reason cannot contain only blank spaces.');
                    }
                    else if (this.value.trim().length > 0 && words.length < 10) {
                        showError('Reason', 'Please provide at least 10 words describing the reason.');
                    } else {
                        clearError('Reason');
                    }
                    if(counter) {
                        counter.style.color = this.value.length > 450 ? '#dc3545' : this.value.length > 400 ? '#ffc107' : '#6c757d';
                    }
                });
            }

            // Additional Notes Counter
            if(notesTextarea) {
                notesTextarea.addEventListener('input', function(e) {
                    const counter = document.getElementById('notesCounter');
                    if(counter) {
                        const count = this.value.length;
                        counter.textContent = `${count} / 1000`;
                        counter.style.color = count > 900 ? '#dc3545' : count > 800 ? '#ffc107' : '#6c757d';
                    }
                });
            }

            // Area Input
            if(areaInput) {
                areaInput.addEventListener('input', function(e) {
                    this.value = this.value.trim();
                });
            }

            // Required Date Validation
            const today = new Date().toISOString().split('T')[0];
            if(requiredDateInput) {
                requiredDateInput.min = today;
                requiredDateInput.addEventListener('change', function(e) {
                    const selectedDate = new Date(this.value);
                    const currentDate = new Date(today);
                    if (selectedDate < currentDate) {
                        showError('RequiredDate', 'Date cannot be in the past');
                        this.value = today;
                    } else {
                        clearError('RequiredDate');
                    }
                });
            }

            // Emergency Toggle
            const emergencyCard = document.getElementById('emergencyCard');
            if(emergencyToggle && requiredDateInput) {
                emergencyToggle.addEventListener('change', function() {
                    if(emergencyCard) {
                        emergencyCard.classList.toggle('active', this.checked);
                    }
                    if (this.checked) {
                        requiredDateInput.value = today;
                        requiredDateInput.readOnly = true;
                        showNotification('Emergency request: Date set to today', 'info');
                    } else {
                        requiredDateInput.readOnly = false;
                    }
                    updateSummary();
                });
            }

            // ==================== "I AM THE PATIENT" CHECKBOX ====================
            const receiverName = '@Model.ReceiverName';
            const receiverEmail = '@Model.ReceiverEmail';

            if(iAmThePatientCheckbox && patientNameInput) {
                iAmThePatientCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        patientNameInput.value = receiverName;
                        patientNameInput.readOnly = true;
                        patientNameInput.classList.add('bg-light');
                        showNotification('Patient details auto-filled with your information', 'info');
                    } else {
                        patientNameInput.readOnly = false;
                        patientNameInput.classList.remove('bg-light');
                        patientNameInput.value = '';
                        showNotification('You can now enter different patient details', 'info');
                    }
                    updateSummary();
                });
            }

            // ==================== BLOOD GROUP SELECTION ====================
            const bloodGroupCards = document.querySelectorAll('.blood-group-card');
            
            function selectBloodGroup(card) {
                bloodGroupCards.forEach(c => c.classList.remove('active'));
                card.classList.add('active');
                if(bloodGroupHidden) {
                    bloodGroupHidden.value = card.getAttribute('data-value');
                }
                clearError('BloodGroup');
                updateSummary();
                updateCompatibility(bloodGroupHidden ? bloodGroupHidden.value : '');
            }

            bloodGroupCards.forEach(card => {
                card.addEventListener('click', () => selectBloodGroup(card));
                card.addEventListener('keypress', (e) => { 
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        selectBloodGroup(card);
                    }
                });
            });

            // ==================== QUANTITY SELECTOR ====================
            const decreaseUnitsBtn = document.getElementById('decreaseUnits');
            const increaseUnitsBtn = document.getElementById('increaseUnits');
            
            if(decreaseUnitsBtn) {
                decreaseUnitsBtn.addEventListener('click', () => {
                    if(unitsInput) {
                        let val = parseInt(unitsInput.value) || 1;
                        if (val > 1) unitsInput.value = val - 1;
                        updateSummary();
                    }
                });
            }
            
            if(increaseUnitsBtn) {
                increaseUnitsBtn.addEventListener('click', () => {
                    if(unitsInput) {
                        let val = parseInt(unitsInput.value) || 1;
                        if (val < 10) unitsInput.value = val + 1;
                        updateSummary();
                    }
                });
            }
            
            if(unitsInput) {
                unitsInput.addEventListener('input', () => {
                    let val = parseInt(unitsInput.value);
                    if (val < 1) unitsInput.value = 1;
                    if (val > 10) unitsInput.value = 10;
                    updateSummary();
                });
            }

            // ==================== URGENCY SELECTOR ====================
            const urgencyOptions = document.querySelectorAll('.urgency-option');
            
            urgencyOptions.forEach(opt => {
                opt.addEventListener('click', () => {
                    urgencyOptions.forEach(o => o.classList.remove('active'));
                    opt.classList.add('active');
                    if(urgencyHidden) {
                        urgencyHidden.value = opt.getAttribute('data-value');
                    }
                    clearError('UrgencyLevel');
                    updateSummary();
                });
            });
            
            // Set default urgency
            const defaultUrgency = document.querySelector('.urgency-option[data-value="Normal"]');
            if(defaultUrgency) {
                defaultUrgency.classList.add('active');
            }

            // ==================== WIZARD NAVIGATION ====================
            function goToStep(step) {
                if (step < 1 || step > totalSteps || step === currentStep) return;

                const isForward = step > currentStep;
                const currentStepEl = document.querySelector(`.wizard-step[data-step="${currentStep}"]`);
                const nextStepEl = document.querySelector(`.wizard-step[data-step="${step}"]`);

                if (currentStepEl) {
                    currentStepEl.classList.remove('active', 'slide-in-left', 'slide-in-right');
                }

                if (nextStepEl) {
                    nextStepEl.classList.add('active');
                    nextStepEl.classList.add(isForward ? 'slide-in-right' : 'slide-in-left');

                    setTimeout(() => {
                        nextStepEl.classList.remove('slide-in-right', 'slide-in-left');
                    }, 400);
                }

                timelineSteps.forEach((s, i) => {
                    s.classList.remove('active', 'completed');
                    if (i + 1 < step) s.classList.add('completed');
                    else if (i + 1 === step) s.classList.add('active');
                });

                currentStep = step;
                updateProgress();
                updateNavButtons();
                if (step === 4) updateReview();

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function updateProgress() {
                const percent = (currentStep / totalSteps) * 100;
                if(progress) progress.style.width = `${percent}%`;
                if(progressText) progressText.textContent = `Step ${currentStep} of ${totalSteps} - ${stepTitles[currentStep - 1]}`;
            }

            function updateNavButtons() {
                if(prevBtn) prevBtn.style.display = currentStep === 1 ? 'none' : 'inline-flex';
                if(nextBtn) nextBtn.style.display = currentStep === totalSteps ? 'none' : 'inline-flex';
                if(submitBtn) submitBtn.style.display = currentStep === totalSteps ? 'inline-flex' : 'none';
            }

            // Next Button Click
            if(nextBtn) {
                nextBtn.addEventListener('click', () => { 
                    if (validateStep(currentStep)) {
                        goToStep(currentStep + 1); 
                    }
                });
            }
            
            // Previous Button Click
            if(prevBtn) {
                prevBtn.addEventListener('click', () => goToStep(currentStep - 1));
            }
            
            // Review Edit Buttons
            document.querySelectorAll('.review-edit-btn').forEach(btn => {
                btn.addEventListener('click', function() { 
                    const stepNum = parseInt(this.getAttribute('data-goto'));
                    goToStep(stepNum); 
                });
            });

            // ==================== VALIDATION FUNCTIONS ====================
            function showError(fieldName, message) {
                const errEl = document.getElementById(`err-${fieldName}`);
                const inputEl = document.querySelector(`[name="${fieldName}"]`) || 
                               document.getElementById(fieldName) ||
                               document.querySelector(`#${fieldName}Hidden`);
                if (errEl) { 
                    errEl.textContent = message; 
                    errEl.classList.add('show'); 
                }
                if (inputEl) {
                    inputEl.classList.add('is-invalid');
                }
            }

            function clearError(fieldName) {
                const errEl = document.getElementById(`err-${fieldName}`);
                const inputEl = document.querySelector(`[name="${fieldName}"]`) || 
                               document.getElementById(fieldName) ||
                               document.querySelector(`#${fieldName}Hidden`);
                if (errEl) { 
                    errEl.textContent = ''; 
                    errEl.classList.remove('show'); 
                }
                if (inputEl) {
                    inputEl.classList.remove('is-invalid');
                }
            }

            function validateStep(step) {
    const stepEl = document.querySelector(`.wizard-step[data-step="${step}"]`);
    let isValid = true;
    let firstInvalid = null;

    // Clear previous errors
    stepEl.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    stepEl.querySelectorAll('.invalid-feedback-custom.show').forEach(el => el.classList.remove('show'));

    if (step === 1) {
        // Patient Name
        if(patientNameInput) {
            const pName = patientNameInput.value.trim();
            if (!pName) {
                showError('PatientName', 'Patient name is required');
                isValid = false;
                firstInvalid = firstInvalid || patientNameInput;
            } else if (pName.length < 3) {
                showError('PatientName', 'Patient name must be at least 3 characters');
                isValid = false;
                firstInvalid = firstInvalid || patientNameInput;
            }
        }
        // Patient Age
        if(patientAgeInput) {
            const pAge = parseInt(patientAgeInput.value);
            if (!patientAgeInput.value || isNaN(pAge)) {
                showError('PatientAge', 'Valid age is required');
                isValid = false;
                firstInvalid = firstInvalid || patientAgeInput;
            } else if (pAge < 1 || pAge > 120) {
                showError('PatientAge', 'Age must be between 1 and 120');
                isValid = false;
                firstInvalid = firstInvalid || patientAgeInput;
            }
        }
        // Gender
        if(genderSelect) {
            if (!genderSelect.value) {
                showError('Gender', 'Gender is required');
                isValid = false;
                firstInvalid = firstInvalid || genderSelect;
            }
        }
        // Blood Group
        if(bloodGroupHidden) {
            if (!bloodGroupHidden.value) {
                showError('BloodGroup', 'Blood group is required');
                isValid = false;
            }
        }
        // Units
        if(unitsInput) {
            const units = parseInt(unitsInput.value);
            if (!unitsInput.value || units < 1 || units > 10) {
                showError('UnitsRequired', 'Units must be between 1 and 10');
                isValid = false;
                firstInvalid = firstInvalid || unitsInput;
            }
        }
    } else if (step === 2) {
        // Hospital Name Validation
        if (hospitalSearchInput) {
            const hSearchValue = hospitalSearchInput.value.trim();
            if (!hSearchValue) {
                showError('HospitalName', 'Please search and select a hospital');
                isValid = false;
                firstInvalid = firstInvalid || hospitalSearchInput;
            } else if (hSearchValue.length < 3) {
                showError('HospitalName', 'Please enter at least 3 characters');
                isValid = false;
                firstInvalid = firstInvalid || hospitalSearchInput;
            } else if (!isHospitalSelected) {
                const infoCard = document.getElementById('hospitalInfoCard');
                if (!infoCard || infoCard.style.display === 'none') {
                    showError('HospitalName', '⚠️ Please select a hospital from the dropdown suggestions');
                    isValid = false;
                    firstInvalid = firstInvalid || hospitalSearchInput;
                    if(hSearchValue.length >= 3) {
                        fetchHospitals(hSearchValue);
                    }
                }
            }
        }
        
        // If hospital is selected, validate auto-filled fields (RELAXED VALIDATION)
        if (isHospitalSelected) {
            // Hospital Contact - RELAXED: Accept any non-empty value (name or phone)
            if (hospitalContactInput) {
                const hContact = hospitalContactInput.value.trim();
                if (!hContact || hContact === '' || hContact === 'N/A' || hContact === '-') {
                    showError('HospitalContact', 'Hospital contact information is required');
                    isValid = false;
                    firstInvalid = firstInvalid || hospitalContactInput;
                } else {
                    clearError('HospitalContact');
                }
            }
            
            // City - RELAXED: Extract from address if missing
            if (cityInput) {
                const city = cityInput.value.trim();
                if (!city || city.length < 2 || city === 'N/A' || city === '-') {
                    // Try to extract city from address
                    const addr = addressInput ? addressInput.value.trim() : '';
                    if (addr && addr !== 'N/A' && addr !== '-') {
                        const parts = addr.split(',').map(p => p.trim());
                        if (parts.length >= 2) {
                            const possibleCity = parts[parts.length - 2];
                            if (possibleCity.length >= 2 && possibleCity.toLowerCase() !== 'pakistan') {
                                cityInput.value = possibleCity;
                                clearError('City');
                            } else {
                                showError('City', 'Valid city is required');
                                isValid = false;
                                firstInvalid = firstInvalid || cityInput;
                            }
                        } else {
                            showError('City', 'Valid city is required');
                            isValid = false;
                            firstInvalid = firstInvalid || cityInput;
                        }
                    } else {
                        showError('City', 'Valid city is required');
                        isValid = false;
                        firstInvalid = firstInvalid || cityInput;
                    }
                } else {
                    clearError('City');
                }
            }
            
            // Address - RELAXED: Just check if not empty
            if (addressInput) {
                const addr = addressInput.value.trim();
                if (!addr || addr === 'N/A' || addr === '-') {
                    showError('Address', 'Hospital address is required');
                    isValid = false;
                    firstInvalid = firstInvalid || addressInput;
                } else {
                    clearError('Address');
                }
            }
        }
    } else if (step === 3) {
        // Required Date
        if(requiredDateInput) {
            const reqDate = requiredDateInput.value;
            if (!reqDate) {
                showError('RequiredDate', 'Required date is required');
                isValid = false;
                firstInvalid = firstInvalid || requiredDateInput;
            } else {
                const selectedDate = new Date(reqDate);
                const currentDate = new Date(today);
                if (selectedDate < currentDate) {
                    showError('RequiredDate', 'Date cannot be in the past');
                    isValid = false;
                    firstInvalid = firstInvalid || requiredDateInput;
                }
            }
        }
        // Urgency Level
        if(urgencyHidden) {
            if (!urgencyHidden.value) {
                showError('UrgencyLevel', 'Urgency level is required');
                isValid = false;
            }
        }
        // Reason
        if(reasonTextarea) {
            const reason = reasonTextarea.value;
            const reasonTrimmed = reason.trim();
            const words = reasonTrimmed.split(/\s+/).filter(w => w.length > 0);
            if (!reasonTrimmed) {
                showError('Reason', 'Reason for request is required.');
                isValid = false;
                firstInvalid = firstInvalid || reasonTextarea;
            } else if (reasonTrimmed.length === 0) {
                showError('Reason', 'Reason cannot contain only blank spaces.');
                isValid = false;
                firstInvalid = firstInvalid || reasonTextarea;
            } else if (words.length < 10) {
                showError('Reason', 'Please provide at least 10 words describing the reason.');
                isValid = false;
                firstInvalid = firstInvalid || reasonTextarea;
            } else if (reason.length > 500) {
                showError('Reason', 'Reason cannot exceed 500 characters.');
                isValid = false;
                firstInvalid = firstInvalid || reasonTextarea;
            }
        }
    }

    if (!isValid) {
        showNotification('Please fill in all required fields correctly.', 'error');
        if (firstInvalid) {
            if (firstInvalid.type === 'hidden' && firstInvalid.id === 'HospitalContactHidden') {
                hospitalSearchInput.focus();
            } else {
                firstInvalid.focus();
            }
        }
    }
    return isValid;
}

            // Clear errors on input
            document.querySelectorAll('.form-control-premium, .form-select-premium').forEach(el => {
                el.addEventListener('input', () => {
                    if (el.classList.contains('is-invalid')) {
                        el.classList.remove('is-invalid');
                        const errEl = el.closest('.col-md-3, .col-md-6, .col-12, .col-md-4')?.querySelector('.invalid-feedback-custom');
                        if (errEl) errEl.classList.remove('show');
                    }
                });
            });

            // ==================== HOSPITAL AUTOCOMPLETE ====================
            let userLat = null;
            let userLng = null;
            let searchTimeout = null;

            // Get User Location
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        userLat = position.coords.latitude;
                        userLng = position.coords.longitude;
                        const latInput = document.getElementById('Latitude');
                        const lngInput = document.getElementById('Longitude');
                        if(latInput) latInput.value = userLat;
                        if(lngInput) lngInput.value = userLng;
                        console.log("📍 Location:", userLat, userLng);
                    },
                    (error) => {
                        console.log("Geolocation denied or unavailable.");
                    }
                );
            }

            const hospitalDropdown = document.getElementById('hospitalDropdown');
            const hospitalInfoCard = document.getElementById('hospitalInfoCard');
            const nearestSuggestionBox = document.getElementById('nearestHospitalsSuggestion');
            const suggestedHospitalsList = document.getElementById('suggestedHospitalsList');

            // Hospital Search Input Handler
            if(hospitalSearchInput) {
                hospitalSearchInput.addEventListener('input', function() {
                    const term = this.value.trim();
                    clearTimeout(searchTimeout);

                    // Reset selection state when user types
                    if(term.length < 3) {
                        if(hospitalDropdown) hospitalDropdown.style.display = 'none';
                        if(nearestSuggestionBox) nearestSuggestionBox.style.display = 'none';
                        isHospitalSelected = false;
                        return;
                    }

                    searchTimeout = setTimeout(() => {
                        fetchHospitals(term);
                    }, 400);
                });

                // Also handle focus - show dropdown if there's a value
                hospitalSearchInput.addEventListener('focus', function() {
                    if(this.value.trim().length >= 3 && hospitalDropdown) {
                        fetchHospitals(this.value.trim());
                    }
                });
            }

            async function fetchHospitals(term) {
                try {
                    let baseUrl = window.location.origin;
                    let url = `${baseUrl}/Receiver/SearchHospitals?term=${encodeURIComponent(term)}&userLat=${userLat || ''}&userLng=${userLng || ''}`;
                    
                    console.log("🔍 Fetching hospitals for:", term);
                    console.log("📡 Full URL:", url);
                    
                    const response = await fetch(url, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    console.log("📡 Response Status:", response.status);
                    
                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error("❌ Server Error:", errorText);
                        throw new Error(`Server error: ${response.status}`);
                    }
                    
                    const hospitals = await response.json();
                    console.log("✅ Hospitals found:", hospitals.length);
                    console.log("🏥 Hospitals Data:", hospitals);

                    if(hospitalDropdown) {
                        hospitalDropdown.innerHTML = '';

                        if (hospitals.length === 0) {
                            // Show helpful message
                            hospitalDropdown.innerHTML = `
                                <div class="p-3 text-center">
                                    <i class="bi bi-exclamation-triangle text-warning mb-2 d-block fs-4"></i>
                                    <small class="text-muted d-block mb-2">No hospitals found for "${term}"</small>
                                    <small class="text-primary fw-semibold">Try: "Life", "Agha", "Jinnah"</small>
                                </div>`;
                            hospitalDropdown.style.display = 'block';
                            
                            // Hide suggestion box if no results
                            if(nearestSuggestionBox) {
                                nearestSuggestionBox.style.display = 'none';
                            }
                            return;
                        }

                        // Check if any hospital name contains the exact search term
                        const isExactMatch = hospitals.some(h => 
                            (h.HospitalName || '').toLowerCase().includes(term.toLowerCase())
                        );

                        // Populate dropdown
                        hospitals.forEach(h => {
    // Fix: JSON serialization ke baad camelCase ho jata hai
    const hospitalName = h.HospitalName || h.hospitalName || h.Name || h.name;
    
    if (!hospitalName) {
        console.warn("⚠️ Hospital with null name skipped:", h);
        return;
    }

                            const div = document.createElement('div');
                            div.className = 'p-3 border-bottom hover-bg-light cursor-pointer';
                            div.style.cursor = 'pointer';
                            div.innerHTML = `
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-semibold" style="color: #212529;">
                ${highlightMatch(hospitalName, term)}  <!-- Yahan change -->
            </div>
            <div class="small text-muted">
                <i class="bi bi-geo-alt me-1"></i>${h.City || h.city || 'N/A'}
            </div>
        </div>
        ${h.Distance || h.distance ? `
            <span class="badge bg-light text-primary">
                <i class="bi bi-signpost-2 me-1"></i>${h.Distance || h.distance} km
            </span>
        ` : ''}
    </div>
`;
                            div.addEventListener('click', () => {
                                console.log("✅ Hospital clicked:", h.HospitalName);
                                selectHospital(h);
                            });
                            hospitalDropdown.appendChild(div);
                        });

                        hospitalDropdown.style.display = 'block';
                        console.log("✅ Dropdown displayed with", hospitals.length, "hospitals");

                        // Show nearest hospitals suggestion if no exact match
                        showNearestHospitalsSuggestion(hospitals, isExactMatch);
                    } else {
                        console.error(" hospitalDropdown element NOT found!");
                    }
                } catch (error) {
                    console.error("❌ Hospital search failed:", error);
                    console.error("❌ Error stack:", error.stack);
                    showNotification('Failed to search hospitals. Please try again.', 'error');
                }
            }

            // Helper function to highlight matching text
            function highlightMatch(text, term) {
                const regex = new RegExp(`(${term})`, 'gi');
                return text.replace(regex, '<mark class="bg-warning bg-opacity-25">$1</mark>');
            }

            // Show nearest hospitals suggestion box
            function showNearestHospitalsSuggestion(hospitals, isExactMatch) {
                if(!nearestSuggestionBox || !suggestedHospitalsList) {
                    console.error("❌ nearestSuggestionBox or suggestedHospitalsList not found");
                    return;
                }
                
                if (!isExactMatch && hospitals.length > 0) {
                    nearestSuggestionBox.style.display = 'block';
                    suggestedHospitalsList.innerHTML = '';
                    
                    const title = document.createElement('h6');
                    title.className = 'fw-semibold mb-2';
                    title.textContent = 'Suggested Registered Hospitals:';
                    suggestedHospitalsList.appendChild(title);
                    
                    hospitals.slice(0, 3).forEach(h => {
                        if (!h.HospitalName) return;
                        
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-sm btn-outline-primary text-start rounded-3 w-100 mb-2';
                        btn.innerHTML = `
                            <i class="bi bi-hospital me-2"></i>
                            <strong>${h.HospitalName}</strong> 
                            <span class="text-muted ms-2">
                                ${h.Distance ? '(' + h.Distance + ' km)' : ''}
                            </span>
                        `;
                        btn.addEventListener('click', () => {
                            selectHospital(h);
                            nearestSuggestionBox.style.display = 'none';
                            if(hospitalSearchInput) hospitalSearchInput.value = h.HospitalName;
                        });
                        suggestedHospitalsList.appendChild(btn);
                    });
                } else {
                    nearestSuggestionBox.style.display = 'none';
                }
            }

            // Select Hospital Function
            function selectHospital(h) {
    console.log(" Selecting hospital:", h);
    
    // Fix: Handle both PascalCase and camelCase
    const hospitalName = h.HospitalName || h.hospitalName;
    const hospitalId = h.HospitalId || h.hospitalId;
    const address = h.Address || h.address;
    const contact = h.Contact || h.contact;
    const latitude = h.Latitude || h.latitude;
    const longitude = h.Longitude || h.longitude;
    const distance = h.Distance || h.distance;
    const estimatedTime = h.EstimatedTimeMinutes || h.estimatedTimeMinutes;
    
    // Fix: Extract city from address if h.City is missing
    let city = h.City || h.city;
    if (!city && address) {
        const parts = address.split(',').map(p => p.trim());
        if (parts.length >= 2) {
            city = parts[parts.length - 2]; 
        }
    }

    // Set hidden fields
    if(hospitalNameHidden) hospitalNameHidden.value = hospitalName;
    const selectedHospitalIdInput = document.getElementById('SelectedHospitalId');
    if(selectedHospitalIdInput) selectedHospitalIdInput.value = hospitalId;
    if(hospitalContactInput) hospitalContactInput.value = contact || 'N/A';
    if(addressInput) addressInput.value = address || 'N/A';
    if(cityInput) cityInput.value = city || 'N/A';
    
    const latInput = document.getElementById('Latitude');
    const lngInput = document.getElementById('Longitude');
    if(latitude && latInput) latInput.value = latitude;
    if(longitude && lngInput) lngInput.value = longitude;

    // Update UI Card
    const infoHospitalName = document.getElementById('info-HospitalName');
    const infoAddress = document.getElementById('info-Address');
    const infoCity = document.getElementById('info-City');
    const infoContact = document.getElementById('info-Contact');
    const infoDistance = document.getElementById('info-Distance');
    const infoTime = document.getElementById('info-Time');
    
    if(infoHospitalName) infoHospitalName.textContent = hospitalName;
    if(infoAddress) infoAddress.textContent = address || 'N/A';
    if(infoCity) infoCity.textContent = city || 'N/A';
    if(infoContact) infoContact.textContent = contact || 'N/A';
    if(infoDistance) infoDistance.textContent = distance ? distance + ' km' : 'N/A';
    if(infoTime) infoTime.textContent = estimatedTime ? estimatedTime + ' mins' : 'N/A';

    // Show the info card
    if(hospitalInfoCard) {
        hospitalInfoCard.style.display = 'block';
        hospitalInfoCard.classList.add('fade-in');
    }

    // Hide dropdown
    if(hospitalDropdown) hospitalDropdown.style.display = 'none';

    // Mark as selected
    isHospitalSelected = true;
    console.log("✅ Hospital selected, isHospitalSelected =", isHospitalSelected);

    // Clear any errors
    clearError('HospitalName');
    clearError('City');
    clearError('HospitalContact');
    clearError('Address');

    // Show success notification
    showNotification(`Hospital "${hospitalName}" selected successfully!`, 'success');
    
    updateSummary();
}

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (hospitalSearchInput && hospitalDropdown) {
                    if (!hospitalSearchInput.contains(e.target) && !hospitalDropdown.contains(e.target)) {
                        // Don't hide immediately - give user time to click
                        setTimeout(() => {
