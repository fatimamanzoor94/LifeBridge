                        '<span class="badge" style="background-color: #f8f9fa; color: #6c757d; padding: 0.5rem 1rem;">No</span>';
                }
            }

            // ==================== COMPATIBILITY PREVIEW ====================
            function updateCompatibility(bg) {
                const preview = document.getElementById('compatibilityPreview');
                if (!preview) return;
                
                if (!bg) {
                    preview.innerHTML = `<div class="text-center text-muted py-4"><i class="bi bi-droplet fs-1 d-block mb-2 text-muted opacity-50"></i><small>Select a blood group to see compatibility details</small></div>`;
                    return;
                }

                const compatibility = {
                    'A+': ['A+', 'AB+'], 'A-': ['A-', 'A+', 'AB-', 'AB+'],
                    'B+': ['B+', 'AB+'], 'B-': ['B-', 'B+', 'AB-', 'AB+'],
                    'AB+': ['AB+'], 'AB-': ['AB-', 'AB+'],
                    'O+': ['O+', 'A+', 'B+', 'AB+'], 'O-': ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+']
                };

                const compatible = compatibility[bg] || [];
                preview.innerHTML = `
                    <div class="mb-3">
                        <small class="text-muted d-block mb-2 fw-semibold">Can Donate To:</small>
                        <div class="d-flex flex-wrap gap-2">
                            ${compatible.map(c => `<span class="badge" style="background-color: #ffebee; color: #90151C; padding: 0.5rem 1rem;">${c}</span>`).join('')}
                        </div>
                    </div>
                    <div class="p-3" style="background-color: #e6f7ee; border-radius: 1rem; text-align: center; margin-top: 1rem;">
                        <i class="bi bi-cpu text-info fs-4 d-block mb-2" style="color: #0dcaf0;"></i>
                        <small class="text-info fw-bold d-block" style="color: #0dcaf0;">Smart Matching Active</small>
                        <small class="text-muted" style="font-size: 0.75rem;">System will automatically find compatible donors.</small>
                    </div>
                `;
            }

            // ==================== EVENT LISTENERS FOR LIVE UPDATES ====================
