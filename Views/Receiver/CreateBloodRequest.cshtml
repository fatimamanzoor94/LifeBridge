                        const color = urg === 'Normal' ? '#198754' : urg === 'High' ? '#d39e00' : '#90151C';
                        revUrgencyLevel.innerHTML = `<span class="badge" style="background-color: ${bgColor}; color: ${color}; padding: 0.5rem 1rem;">${urg}</span>`;
                    } else {
                        revUrgencyLevel.textContent = '-';
