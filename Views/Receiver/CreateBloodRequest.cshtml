                        }, 200);
                    }
                }
            });

            // ==================== SUMMARY & REVIEW ====================
            function getVal(id) { 
                const el = document.getElementById(id);
                return el ? el.value?.trim() || '' : ''; 
            }

            function updateSummary() {
                const pName = getVal('PatientName') || 'Patient Name';
                const hName = getVal('HospitalName') || 'Hospital Name';
                const bg = getVal('BloodGroupHidden');
                const units = getVal('unitsInput') || '0';
                const date = getVal('RequiredDate');
                const isEm = emergencyToggle ? emergencyToggle.checked : false;

                const sumPatientName = document.getElementById('sum-PatientName');
                const sumHospital = document.getElementById('sum-Hospital');
                const sumBloodGroup = document.getElementById('sum-BloodGroup');
                const sumUnits = document.getElementById('sum-Units');
                const sumDate = document.getElementById('sum-Date');
                const sumEmergency = document.getElementById('sum-Emergency');
                const completionBar = document.getElementById('completionBar');
                const completionText = document.getElementById('completionText');

                if(sumPatientName) sumPatientName.textContent = pName;
                if(sumHospital) sumHospital.textContent = hName;

                if(sumBloodGroup) {
                    sumBloodGroup.innerHTML = bg ? `<i class="bi bi-droplet me-1" style="color: #90151C;"></i> ${bg}` : '<i class="bi bi-droplet me-1" style="color: #90151C;"></i> Blood Group';
                }

                if(sumUnits) {
                    sumUnits.innerHTML = `<i class="bi bi-box me-1" style="color: #5C88A8;"></i> ${units} Units`;
                }

                if(sumDate) {
                    sumDate.innerHTML = date ? `<i class="bi bi-calendar me-1" style="color: #0dcaf0;"></i> ${new Date(date).toLocaleDateString()}` : '<i class="bi bi-calendar me-1" style="color: #0dcaf0;"></i> Date';
                }

                if(sumEmergency) {
                    if (isEm) { 
                        sumEmergency.classList.remove('d-none'); 
                        sumEmergency.style.backgroundColor = '#ffebee'; 
                        sumEmergency.style.color = '#90151C'; 
                    } else { 
                        sumEmergency.classList.add('d-none'); 
                    }
                }

                // Completion Progress
                const fields = ['PatientName', 'PatientAge', 'Gender', 'BloodGroupHidden', 'unitsInput', 'HospitalName', 'HospitalContact', 'City', 'RequiredDate', 'UrgencyLevelHidden', 'Reason'];
                let filled = fields.filter(f => getVal(f)).length;
                const percent = Math.round((filled / fields.length) * 100);
                if(completionBar) completionBar.style.width = `${percent}%`;
                if(completionText) {
                    completionText.textContent = `${percent}%`;
                    completionText.style.color = '#5C88A8';
                }
            }

            function updateReview() {
