            // ==================== SAVE DRAFT ====================
            const saveDraftModalEl = document.getElementById('saveDraftModal');
            if(saveDraftModalEl && typeof bootstrap !== 'undefined') {
                const saveDraftModal = new bootstrap.Modal(saveDraftModalEl);
                
                if(draftBtn) {
                    draftBtn.addEventListener('click', () => saveDraftModal.show());
                }

                const confirmSaveDraftBtn = document.getElementById('confirmSaveDraft');
                if(confirmSaveDraftBtn) {
                    confirmSaveDraftBtn.addEventListener('click', async function() {
                        this.disabled = true;
                        this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Saving...';

                        try {
                            const formData = {};
                            document.querySelectorAll('input, select, textarea').forEach(el => {
                                if (el.name) {
                                    if (el.type === 'checkbox') {
                                        formData[el.name] = el.checked;
                                    } else if (el.type === 'number') {
                                        formData[el.name] = el.value ? parseFloat(el.value) : null;
                                    } else {
                                        formData[el.name] = el.value;
                                    }
                                }
                            });

                            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                            const response = await fetch('@Url.Action("SaveDraft", "Receiver")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': token
                                },
                                body: JSON.stringify(formData)
                            });

                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }

                            const result = await response.json();
                            saveDraftModal.hide();

                            if (result.success) {
                                showNotification(result.message || 'Draft saved successfully!', 'success');
                            } else {
                                showNotification(result.message || 'Failed to save draft.', 'error');
                            }
                        } catch (error) {
                            console.error('Save draft error:', error);
                            showNotification('Failed to save draft. Please try again.', 'error');
                        } finally {
                            this.disabled = false;
                            this.innerHTML = '<i class="bi bi-save me-2"></i>Save Draft';
                        }
                    });
                }
            }

            // ==================== FORM SUBMISSION ====================
            if(form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    for (let i = 1; i <= totalSteps; i++) {
                        if (!validateStep(i)) {
                            goToStep(i);
                            return;
                        }
                    }

                    if(submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Processing...';
                    }

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        const formData = new FormData(form);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token
                            }
                        });

                        if (!response.ok) {
                            const errorText = await response.text();
                            throw new Error(`Server error: ${errorText}`);
                        }

                        const result = await response.json();

                        if (result.success) {
                            const modalReqId = document.getElementById('modalRequestId');
                            if(modalReqId) modalReqId.textContent = `REQ-${String(result.requestId).padStart(4, '0')}`;
                            
                            const successModalEl = document.getElementById('successModal');
                            if(successModalEl && typeof bootstrap !== 'undefined') {
                                new bootstrap.Modal(successModalEl).show();
                            }
                        } else {
                            showNotification(result.message || 'Submission failed.', 'error');
                        }
                    } catch (err) {
                        console.error('Submit error:', err);
                        showNotification('Network error. Please try again.', 'error');
                    } finally {
                        if(submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Submit Request';
                        }
                    }
                });
            }

            // ==================== CREATE ANOTHER BUTTON ====================
            const createAnotherBtn = document.getElementById('createAnotherBtn');
            if(createAnotherBtn) {
                createAnotherBtn.addEventListener('click', function() {
                    const successModalEl = document.getElementById('successModal');
                    if(successModalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getInstance(successModalEl).hide();
                    }
                    if(form) form.reset();
                    
                    bloodGroupCards.forEach(c => c.classList.remove('active'));
                    urgencyOptions.forEach(o => o.classList.remove('active'));
                    
                    const defaultUrg = document.querySelector('.urgency-option[data-value="Normal"]');
                    if(defaultUrg) defaultUrg.classList.add('active');
                    
                    const emCard = document.getElementById('emergencyCard');
                    if(emCard) emCard.classList.remove('active');
                    
                    isHospitalSelected = false; // Reset hospital selection
                    
                    goToStep(1);
                    updateSummary();
                    updateCompatibility('');
                });
            }

            // ==================== INITIALIZE ====================
            updateProgress();
            updateNavButtons();
            updateSummary();
            
            console.log("✅ All buttons and listeners initialized successfully.");
            console.log(" isHospitalSelected initialized to:", isHospitalSelected);
        });
    </script>
}