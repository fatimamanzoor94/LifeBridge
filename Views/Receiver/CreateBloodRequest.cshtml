@model Khoon_e_Hayat.ViewModels.ReceiverCreateBloodRequestViewModel
@{
    ViewData["Title"] = "Create Blood Request";
    Layout = "~/Views/Shared/_ReceiverLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- ==================== PREMIUM HEADER ==================== -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-3">
                <div>

                    <h4 class="mb-1 fw-bold" style="color: #212529;">Create Blood Request</h4>
                    <small class="text-muted">Submit patient details to initiate our Smart Matching System.</small>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge" style="background-color: #e6f4ff; color: #5C88A8; border-radius: 50rem; padding: 0.5rem 1rem; font-weight: 600;">
                        <i class="bi bi-clock me-1" style="color: #5C88A8;"></i> 2-3 Minutes
                    </span>
                    <span class="badge" style="background-color: #e6f7ee; color: #198754; border-radius: 50rem; padding: 0.5rem 1rem; font-weight: 600;">
                        <i class="bi bi-shield-check me-1" style="color: #198754;"></i> Secure & Encrypted
                    </span>
                </div>
            </div>

            <!-- ==================== RECEIVER INFORMATION CARD ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4"
                 style="border-left:5px solid #90151C !important; box-shadow:none;">

                <div class="card-body p-4">

                    <!-- Heading -->
                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="icon-box bg-danger-subtle">
                            <i class="bi bi-person-badge-fill" style="color:#5C88A8;"></i>
                        </div>

                        <h4 class="fw-bold mb-0" style="color:#5C88A8;">
                            Receiver Information
                        </h4>

                    </div>

                    <div class="row">

                        <!-- Left -->
                        <div class="col-lg-8">

                            <div class="row g-4">

                                <div class="col-md-4">

                                    <small class="text-uppercase fw-semibold text-muted d-block mb-1">
                                        Name
                                    </small>

                                    <div class="fw-semibold fs-6"
                                         id="receiverNameDisplay">
                                        @Model.ReceiverName
                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <small class="text-uppercase fw-semibold text-muted d-block mb-1">
                                        Email
                                    </small>

                                    <div class="fw-semibold"
                                         id="receiverEmailDisplay">
                                        @Model.ReceiverEmail
                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <small class="text-uppercase fw-semibold text-muted d-block mb-1">
                                        Status
                                    </small>

                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background:#198754;color:#fff;">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        @Model.ReceiverStatus

                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- Right -->
                        <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end">

                            <small class="text-muted d-block mb-2">
                                Request submitted from your account
                            </small>

                            <span class="fw-semibold text-dark">
                                <i class="bi bi-shield-check me-1"
                                   style="color:#5C88A8;"></i>

                                Receiver ID:
                                @ViewContext.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                            </span>

                        </div>

                    </div>

                    <!-- Bottom Information Box -->
                    <div class="alert border-0 rounded-4 mt-4 mb-0 d-flex align-items-start gap-3"
                         role="alert"
                         style="background:#5C88A8;color:#fff;">

                        <i class="bi bi-info-circle-fill fs-3"></i>

                        <div>

                            <strong class="d-block mb-1">
                                Account Information
                            </strong>

                            <span>
                                This blood request will be linked with your receiver account.
                                Your receiver details are automatically used for verification and communication.
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ==================== MAIN GRID ==================== -->
            <div class="row g-4">

                <!-- ==================== LEFT: FORM AREA ==================== -->
                <div class="col-lg-8">

                    <!-- Wizard Timeline -->
                    <div class="card custom-card border-0 rounded-4 mb-4" style="box-shadow: none;">
                        <div class="card-body p-4">
                            <div class="wizard-timeline" id="wizardTimeline">
                                <div class="timeline-step active" data-step="1">
                                    <div class="timeline-icon"><i class="bi bi-person"></i></div>
                                    <div class="timeline-label">Patient</div>
                                </div>
                                <div class="timeline-step" data-step="2">
                                    <div class="timeline-icon"><i class="bi bi-hospital"></i></div>
                                    <div class="timeline-label">Hospital</div>
                                </div>
                                <div class="timeline-step" data-step="3">
                                    <div class="timeline-icon"><i class="bi bi-clipboard-check"></i></div>
                                    <div class="timeline-label">Details</div>
                                </div>
                                <div class="timeline-step" data-step="4">
                                    <div class="timeline-icon"><i class="bi bi-check2-circle"></i></div>
                                    <div class="timeline-label">Review</div>
                                </div>
                            </div>
                            <div class="progress mt-4" style="height: 6px; border-radius: 3px; background: #e9ecef;">
                                <div class="progress-bar" id="wizardProgress" style="width: 25%; transition: width 0.4s ease; border-radius: 3px; background-color: #5C88A8;"></div>
                            </div>
                            <small class="text-muted d-block mt-2 text-center fw-semibold" id="progressText">Step 1 of 4 - Patient Information</small>
                        </div>
                    </div>

                    <form id="bloodRequestForm" method="post" asp-action="CreateBloodRequest" asp-controller="Receiver" novalidate>
                        @Html.HiddenFor(m => m.Latitude)
                        @Html.HiddenFor(m => m.Longitude)
                        @Html.HiddenFor(m => m.ReceiverName)
                        @Html.HiddenFor(m => m.ReceiverEmail)
                        @Html.HiddenFor(m => m.ReceiverStatus)

                        <!-- ==================== STEP 1: PATIENT ==================== -->
                        <div class="wizard-step active" data-step="1">
                            <div class="card custom-card border-0 rounded-4 mb-4" style="box-shadow: none;">
                                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                                    <h5 class="mb-1 fw-bold" style="color: #212529;"><i class="bi bi-person-fill me-2" style="color: #5C88A8;"></i>Patient Information</h5>
                                    <small class="text-muted">Provide accurate patient details for precise donor matching.</small>
                                </div>
                                <div class="card-body px-4 pb-4">

                                    <!-- "I am the Patient" Checkbox -->
                                    <div class="alert alert-info d-flex align-items-center mb-4" style="border-radius: 12px; border-left: 4px solid #5C88A8;">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="iAmThePatient" style="width: 1.5em; height: 1.5em; margin-right: 12px;">
                                            <label class="form-check-label fw-semibold" for="iAmThePatient" style="cursor: pointer;">
                                                <i class="bi bi-person-check me-2"></i>I am the patient
                                            </label>
                                        </div>
                                        <small class="text-muted ms-auto">Auto-fill your details</small>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label-premium">Patient Name <span class="text-danger">*</span></label>
                                            <div class="input-group-premium">
                                                <i class="bi bi-person input-icon" style="color: #adb5bd;"></i>
                                                <input asp-for="PatientName" class="form-control-premium" id="PatientName" placeholder="Enter full name" required />
                                            </div>
                                            <div class="invalid-feedback-custom" id="err-PatientName"></div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label-premium">Patient Age <span class="text-danger">*</span></label>
                                            <div class="input-group-premium">
                                                <i class="bi bi-calendar3 input-icon" style="color: #adb5bd;"></i>
                                                <input asp-for="PatientAge" type="number" class="form-control-premium" id="PatientAge" placeholder="Age" required />
                                            </div>
                                            <div class="invalid-feedback-custom" id="err-PatientAge"></div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label-premium">Gender <span class="text-danger">*</span></label>
                                            <div class="input-group-premium">
                                                <i class="bi bi-gender-ambiguous input-icon" style="color: #adb5bd;"></i>
                                                <select asp-for="Gender" class="form-select-premium" id="Gender" required>
                                                    <option value="">Select</option>
                                                    <option value="Male">Male</option>
                                                    <option value="Female">Female</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </div>
                                            <div class="invalid-feedback-custom" id="err-Gender"></div>
                                        </div>

                                        <div class="col-12 mt-4">
                                            <label class="form-label-premium mb-3">Blood Group <span class="text-danger">*</span></label>
                                            <div class="blood-group-grid" id="bloodGroupGrid">
                                                @foreach (var bg in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
                                                {
                                                    <div class="blood-group-card" data-value="@bg" tabindex="0" role="button" aria-label="Select Blood Group @bg">
                                                        <i class="bi bi-droplet-fill" style="color: #90151C;"></i>
                                                        <div class="bg-text" style="color: #90151C;">@bg</div>
                                                        <div class="check-indicator"><i class="bi bi-check-lg"></i></div>
                                                    </div>
                                                }
                                            </div>
                                            <input type="hidden" asp-for="BloodGroup" id="BloodGroupHidden" />
                                            <div class="invalid-feedback-custom" id="err-BloodGroup"></div>
                                        </div>

                                        <div class="col-md-6 mt-4">
                                            <label class="form-label-premium">Units Required <span class="text-danger">*</span></label>
                                            <div class="quantity-selector">
                                                <button type="button" class="quantity-btn" id="decreaseUnits" aria-label="Decrease units"><i class="bi bi-dash"></i></button>
                                                <input asp-for="UnitsRequired" type="number" class="quantity-input" id="unitsInput" min="1" max="10" value="1" required />
                                                <button type="button" class="quantity-btn" id="increaseUnits" aria-label="Increase units"><i class="bi bi-plus"></i></button>
                                            </div>
                                            <small class="text-muted d-block mt-2"><i class="bi bi-info-circle me-1" style="color: #0dcaf0;"></i> Estimated donor requirement based on medical need.</small>
                                            <div class="invalid-feedback-custom" id="err-UnitsRequired"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== STEP 2: HOSPITAL ==================== -->
                        <div class="wizard-step" data-step="2">
                            <div class="card custom-card border-0 rounded-4 mb-4" style="box-shadow: none;">
                                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                                    <h5 class="mb-1 fw-bold" style="color: #212529;"><i class="bi bi-hospital-fill me-2" style="color: #198754;"></i>Hospital Information</h5>
                                    <small class="text-muted">Where is the patient currently admitted?</small>
                                </div>
                                <div class="card-body px-4 pb-4">
                                    <!-- Hospital Name with Autocomplete -->
<div class="col-md-6">
    <label class="form-label-premium">Hospital Name <span class="text-danger">*</span></label>
    <div class="input-group-premium position-relative">
        <i class="bi bi-hospital input-icon" style="color: #adb5bd;"></i>
        <input type="text" id="HospitalNameSearch" class="form-control-premium" placeholder="Type hospital name..." autocomplete="off" required />
        <input type="hidden" asp-for="HospitalName" id="HospitalName" />
        <input type="hidden" asp-for="SelectedHospitalId" id="SelectedHospitalId" />
        
        <!-- Autocomplete Dropdown -->
        <div id="hospitalDropdown" class="position-absolute w-100 bg-white border rounded-4 shadow-sm mt-1" style="z-index: 1000; display: none; max-height: 250px; overflow-y: auto;"></div>
    </div>
    <div class="invalid-feedback-custom" id="err-HospitalName"></div>
</div>

<!-- Auto-filled Hospital Info Card (Hidden by default) -->
<div class="col-12" id="hospitalInfoCard" style="display: none;">
    <div class="p-3 rounded-4" style="background-color: #f0f7ff; border-left: 4px solid #5C88A8;">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h6 class="fw-bold mb-1" style="color: #212529;" id="info-HospitalName">Hospital Name</h6>
                <p class="small text-muted mb-1"><i class="bi bi-geo-alt-fill me-1" style="color: #90151C;"></i><span id="info-Address">Address</span>, <span id="info-City">City</span></p>
                <p class="small text-muted mb-0"><i class="bi bi-telephone-fill me-1" style="color: #198754;"></i><span id="info-Contact">Contact</span></p>
            </div>
            <div class="text-end">
                <span class="badge rounded-pill mb-2" style="background-color: #e6f7ee; color: #198754; font-weight: 600;">
                    <i class="bi bi-check-circle-fill me-1"></i>Verified
                </span>
                <div class="d-flex gap-2 justify-content-end">
                    <span class="badge" style="background-color: #fff; color: #5C88A8; border: 1px solid #5C88A8;">
                        <i class="bi bi-signpost-2 me-1"></i><span id="info-Distance">0</span> km
                    </span>
                    <span class="badge" style="background-color: #fff; color: #0dcaf0; border: 1px solid #0dcaf0;">
                        <i class="bi bi-clock me-1"></i><span id="info-Time">0</span> mins
                    </span>
                </div>
            </div>
        </div>
        <!-- Live Inventory Mockup -->
        <div class="mt-3 pt-2 border-top" style="border-color: #dee2e6 !important;">
            <small class="fw-semibold text-muted d-block mb-2">Live Blood Inventory Status</small>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge" style="background-color: #ffebee; color: #90151C;"><i class="bi bi-droplet-fill me-1"></i>O+ : High</span>
                <span class="badge" style="background-color: #e6f7ee; color: #198754;"><i class="bi bi-droplet-fill me-1"></i>A+ : Adequate</span>
                <span class="badge" style="background-color: #fff3cd; color: #d39e00;"><i class="bi bi-droplet-fill me-1"></i>B- : Low</span>
            </div>
        </div>
    </div>
</div>

<!-- Hidden fields for auto-fill mapping -->
<input type="hidden" asp-for="HospitalContact" id="HospitalContactHidden" />
<input type="hidden" asp-for="Address" id="AddressHidden" />
<input type="hidden" asp-for="City" id="CityHidden" />
                                </div>
                            </div>
                        </div>

                        <!-- ==================== STEP 3: REQUEST DETAILS ==================== -->
                        <div class="wizard-step" data-step="3">
                            <div class="card custom-card border-0 rounded-4 mb-4" style="box-shadow: none;">
                                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                                    <h5 class="mb-1 fw-bold" style="color: #212529;"><i class="bi bi-clipboard-check-fill me-2" style="color: #0dcaf0;"></i>Request Details</h5>
                                    <small class="text-muted">Specify urgency, reason, and precise location.</small>
                                </div>
                                <div class="card-body px-4 pb-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label-premium">Required Date <span class="text-danger">*</span></label>
                                            <div class="input-group-premium">
                                                <i class="bi bi-calendar-event input-icon" style="color: #adb5bd;"></i>
                                                <input asp-for="RequiredDate" type="date" class="form-control-premium" required />
                                            </div>
                                            <div class="invalid-feedback-custom" id="err-RequiredDate"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label-premium">Urgency Level <span class="text-danger">*</span></label>
                                            <div class="urgency-selector">
                                                <div class="urgency-option" data-value="Normal">
                                                    <i class="bi bi-clock"></i> Normal
                                                </div>
                                                <div class="urgency-option" data-value="High">
                                                    <i class="bi bi-exclamation-circle"></i> High
                                                </div>
                                                <div class="urgency-option" data-value="Critical">
                                                    <i class="bi bi-exclamation-octagon"></i> Critical
                                                </div>
                                            </div>
                                            <select asp-for="UrgencyLevel" class="d-none" id="UrgencyLevelHidden" required>
                                                <option value="Normal">Normal</option>
                                                <option value="High">High</option>
                                                <option value="Critical">Critical</option>
                                            </select>
                                            <div class="invalid-feedback-custom" id="err-UrgencyLevel"></div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label-premium">Reason for Request <span class="text-danger">*</span></label>
                                            <textarea asp-for="Reason" class="form-control-premium" rows="3" maxlength="500" placeholder="Briefly describe why blood is required" required></textarea>
                                            <div class="d-flex justify-content-between mt-1">
                                                <small class="text-muted">Provide medical context for donors</small>
                                                <small class="text-muted fw-semibold char-counter" id="reasonCounter">0 / 500</small>
                                            </div>
                                            <div class="invalid-feedback-custom" id="err-Reason"></div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label-premium">Additional Notes</label>
                                            <textarea asp-for="AdditionalNotes" class="form-control-premium" rows="2" maxlength="1000" placeholder="Any special instructions or landmarks..."></textarea>
                                            <div class="d-flex justify-content-between mt-1">
                                                <small class="text-muted">Optional information</small>
                                                <small class="text-muted fw-semibold char-counter" id="notesCounter">0 / 1000</small>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label-premium">Area / Locality</label>
                                            <div class="input-group-premium">
                                                <i class="bi bi-pin-map input-icon" style="color: #adb5bd;"></i>
                                                <input asp-for="Area" class="form-control-premium" placeholder="e.g. Clifton, DHA" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label-premium">Full Address</label>
                                            <div class="input-group-premium">
                                                <i class="bi bi-geo input-icon" style="color: #adb5bd;"></i>
                                                <input asp-for="FullAddress" class="form-control-premium" placeholder="Complete address" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Emergency Module -->
                                    <div class="emergency-card mt-4" id="emergencyCard" style="border: 2px solid #e9ecef; border-radius: 20px; padding: 24px; background: #fff;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="emergency-icon-box" style="width: 48px; height: 48px; border-radius: 12px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #90151C;">
                                                    <i class="bi bi-shield-exclamation"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold" style="color: #212529;">Emergency Request</h6>
                                                    <small class="text-muted">Flag as medical emergency for priority matching</small>
                                                </div>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input emergency-switch" type="checkbox" asp-for="IsEmergency" id="IsEmergencyToggle" style="background-color: #e9ecef;" />
                                            </div>
                                        </div>
                                        <div class="emergency-details mt-3" id="emergencyDetails" style="display: none; margin-top: 20px; padding: 16px; background: rgba(144, 21, 28, 0.05); border-radius: 12px; border-left: 4px solid #90151C;">
                                            <div class="d-flex gap-2 mb-2 flex-wrap">
                                                <span class="badge" style="background-color: #ffebee; color: #90151C; border-radius: 50rem; padding: 0.5rem 1rem;"><i class="bi bi-lightning-charge me-1"></i> Emergency</span>
                                                <span class="badge" style="background-color: #ffebee; color: #90151C; border-radius: 50rem; padding: 0.5rem 1rem;">Highest Priority</span>
                                            </div>
                                            <p class="small text-muted mb-0">
                                                <i class="bi bi-info-circle me-1" style="color: #0dcaf0;"></i> Nearby compatible donors and hospitals will receive immediate push notifications and SMS alerts. Smart Matching will prioritize this request above all others.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== STEP 4: REVIEW ==================== -->
                        <div class="wizard-step" data-step="4">
                            <div class="card custom-card border-0 rounded-4 mb-4" style="box-shadow: none;">
                                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                                    <h5 class="mb-1 fw-bold" style="color: #212529;"><i class="bi bi-check2-circle me-2" style="color: #198754;"></i>Review & Confirm</h5>
                                    <small class="text-muted">Please verify the information below before submitting.</small>
                                </div>
                                <div class="card-body px-4 pb-4">
                                    <div class="row g-3">
                                        <!-- Receiver Information -->
                                        <div class="col-12">
                                            <!-- Changed from gradient to solid #5C88A8 -->
                                            <div class="review-card-premium" style="background-color: #5C88A8; color: white; border: none;">
                                                <div class="review-header" style="border-bottom-color: rgba(255,255,255,0.3);">
                                                    <div class="review-title" style="color: white;">
                                                        <i class="bi bi-person-badge me-2"></i>Receiver Information
                                                    </div>
                                                    <span class="badge bg-white text-primary">
                                                        <i class="bi bi-check-circle me-1"></i>@Model.ReceiverStatus
                                                    </span>
                                                </div>
                                                <div class="row mt-3">
                                                    <div class="col-md-6">
                                                        <div class="review-item" style="color: rgba(255,255,255,0.9);">
                                                            <span class="review-label" style="color: rgba(255,255,255,0.7);">Name:</span>
                                                            <span class="review-value fw-semibold" id="rev-ReceiverName" style="color: white;">@Model.ReceiverName</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="review-item" style="color: rgba(255,255,255,0.9);">
                                                            <span class="review-label" style="color: rgba(255,255,255,0.7);">Email:</span>
                                                            <span class="review-value fw-semibold" id="rev-ReceiverEmail" style="color: white;">@Model.ReceiverEmail</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Patient Information -->
                                        <div class="col-md-6">
                                            <div class="review-card-premium" style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 16px; padding: 20px;">
                                                <div class="review-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid #e9ecef;">
                                                    <div class="review-title" style="font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; gap: 8px; color: #212529;">
                                                        <i class="bi bi-person-fill" style="color: #5C88A8;"></i>Patient Information
                                                    </div>
                                                    <button type="button" class="review-edit-btn" data-goto="1" style="background: #fff; border: 1px solid #e9ecef; color: #5C88A8; font-weight: 600; cursor: pointer; font-size: 0.8rem; padding: 4px 12px; border-radius: 20px;">Edit</button>
                                                </div>
