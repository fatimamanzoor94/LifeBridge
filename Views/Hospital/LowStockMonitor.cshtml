@model Khoon_e_Hayat.ViewModels.LowStockMonitorViewModel
@{
    ViewData["Title"] = "Low Stock Monitor";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
    var hospitalName = ViewBag.HospitalName ?? "Khoon-e-Hayat Hospital";

    // Calculate Inventory Health Server-Side
    var healthPercentage = Model.TotalBloodGroups > 0
        ? (Model.HealthyStockGroups * 100) / Model.TotalBloodGroups
        : 0;
    var healthLevel = healthPercentage >= 80 ? "Excellent"
        : healthPercentage >= 60 ? "Good"
        : healthPercentage >= 40 ? "Average"
        : "Critical";
    var healthColor = healthPercentage >= 80 ? "#198754"
        : healthPercentage >= 60 ? "#5C88A8"
        : healthPercentage >= 40 ? "#ECBD35"
        : "#90151C";
}

@Html.AntiForgeryToken()

<style>
    .text-blood {
        color: #90151C !important;
    }

    .text-theme {
        color: #5C88A8 !important;
    }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }

        .btn-theme:hover {
            background-color: #4a6d87;
            border-color: #4a6d87;
            color: #fff;
        }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    #viewDetailsModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }

    .progress {
        height: 10px;
        border-radius: 50px;
        background-color: #e9ecef;
    }

    .progress-bar {
        box-shadow: none !important;
        border-radius: 50px;
        transition: width 0.6s ease;
    }

    .smart-alert {
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        font-size: 0.95rem;
    }

        .smart-alert.alert-danger-custom {
            background-color: #fff5f5;
            border: 1px solid #fecaca;
            color: #90151C;
        }

        .smart-alert.alert-warning-custom {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
        }

        .smart-alert.alert-success-custom {
            background-color: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

    #stockTable thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa !important;
        z-index: 10;
        box-shadow: 0 2px 4px -1px rgba(0, 0, 0, 0.05);
    }

    tr.row-healthy {
        background-color: rgba(25, 135, 84, 0.03);
    }

    tr.row-lowstock {
        background-color: rgba(236, 189, 53, 0.05);
    }

    tr.row-critical {
        background-color: rgba(144, 21, 28, 0.04);
    }

    tr.row-outofstock {
        background-color: rgba(144, 21, 28, 0.08);
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .card.border-0.w-100.mb-3, .card.border-0.w-100.mb-3 * {
            visibility: visible;
        }

        .card.border-0.w-100.mb-3 {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 20px;
        }

        .no-print {
            display: none !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        #stockTable thead th {
            position: static !important;
            box-shadow: none !important;
        }

        .smart-alert {
            border: 1px solid #000 !important;
            color: #000 !important;
            background: #fff !important;
        }
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Low Stock Monitor</h4>
            </div>

            <!-- SMART ALERT BANNER - Server-Side Initial State -->
            @{
                var outGroups = Model.BloodGroupStock.Where(x => x.Status == "Out of Stock").Select(x => x.BloodGroup).ToList();
                var criticalGroups = Model.BloodGroupStock.Where(x => x.Status == "Critical").Select(x => x.BloodGroup).ToList();
                var lowGroups = Model.BloodGroupStock.Where(x => x.Status == "Low Stock").Select(x => x.BloodGroup).ToList();

                string bannerClass = "smart-alert alert-success-custom";
                string bannerIcon = "bi-check-circle-fill";
                string bannerHtml = "🟢 <strong>Healthy Inventory:</strong> All blood groups currently have healthy stock levels. No action required.";

                if (outGroups.Any())
                {
                    bannerClass = "smart-alert alert-danger-custom";
                    bannerIcon = "bi-exclamation-triangle-fill";
                    bannerHtml = $"<strong>Emergency Alert:</strong> {outGroups.Count} blood group(s) out of stock. Immediate emergency action required.<span class='fw-bold ms-1 d-block small'>Affected: {string.Join(", ", outGroups)}</span>";
                }
                else if (criticalGroups.Any())
                {
                    bannerClass = "smart-alert alert-warning-custom";
                    bannerIcon = "bi-exclamation-octagon-fill";
                    bannerHtml = $"<strong>Critical Stock Alert:</strong> {criticalGroups.Count} critical blood group(s) detected. Start smart donor search and arrange blood collection.<span class='fw-bold ms-1 d-block small'>Affected: {string.Join(", ", criticalGroups)}</span>";
                }
                else if (lowGroups.Any())
                {
                    bannerClass = "smart-alert alert-warning-custom";
                    bannerIcon = "bi-exclamation-triangle-fill";
                    bannerHtml = $"<strong>Low Stock Warning:</strong> {lowGroups.Count} blood group(s) running low. Schedule blood collection and monitor inventory.<span class='fw-bold ms-1 d-block small'>Affected: {string.Join(", ", lowGroups)}</span>";
                }
            }
            <div id="alertBanner" class="@bannerClass">
                <i class="bi @bannerIcon fs-4"></i>
                <span>@Html.Raw(bannerHtml)</span>
            </div>

            <!-- STATISTICS CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-collection text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Groups</h6>
                                <small class="text-muted" id="stat-total-groups">@Model.TotalBloodGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Healthy</h6>
                                <small class="text-muted" style="color: #198754 !important; font-weight: bold;" id="stat-healthy">@Model.HealthyStockGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Low Stock</h6>
                                <small class="text-muted" style="color: #ECBD35 !important; font-weight: bold;" id="stat-low">@Model.LowStockGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-octagon text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Critical</h6>
                                <small class="text-muted" style="color: #90151C !important; font-weight: bold;" id="stat-critical">@Model.CriticalStockGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-x-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Out of Stock</h6>
                                <small class="text-muted" style="color: #90151C !important; font-weight: bold;" id="stat-out">@Model.OutOfStockGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet-fill text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Units</h6>
                                <small class="text-muted" id="stat-total-units">@Model.TotalAvailableUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-heart-pulse text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Inventory Health</h6>
                                <small class="text-muted" id="healthScoreText">
                                    <span style="color:@healthColor; font-weight:bold;">@healthPercentage%</span>
                                    <span class="small">(@healthLevel)</span>
                                </small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SEARCH & FILTER -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4" style="border-left: none;">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Blood group, status, units, action..." />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Healthy">Healthy</option>
                                <option value="Low Stock">Low Stock</option>
                                <option value="Critical">Critical</option>
                                <option value="Out of Stock">Out of Stock</option>
                                <option value="critical_out">Critical & Out of Stock</option>
                                <option value="recently_updated">Recently Updated</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted mb-1">Sort By</label>
                            <select id="filterSortBy" class="form-select form-select-sm rounded-pill">
                                <option value="priority">Priority (Critical First)</option>
                                <option value="lowest">Lowest Stock</option>
                                <option value="highest">Highest Stock</option>
                                <option value="bloodgroup">Blood Group</option>
                                <option value="updated">Last Updated</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-pill w-100" title="Reset all filters">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLE -->
            <div class="card custom-card border-0 shadow-sm rounded-4" style="border-left: none;">
                @if (Model.BloodGroupStock.Count == 0 || (Model.HealthyStockGroups == Model.TotalBloodGroups && Model.TotalBloodGroups > 0))
                {
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                                <h5 class="fw-semibold">All Blood Groups Are Well Stocked!</h5>
                                <p class="mb-3">Great news! All blood groups have sufficient stock levels.</p>
                                <a asp-controller="Hospital" asp-action="BloodInventory" class="btn btn-theme rounded-pill px-4">
                                    <i class="bi bi-droplet me-2"></i> View Full Inventory
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">Low Stock Monitor</h4>
                                <small class="text-muted">Monitor blood stock levels and take action</small>
                            </div>
                            <div class="d-flex gap-2 no-print">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="window.print()">
                                    <i class="bi bi-printer me-1"></i> Print
                                </button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'stockTable', 'LowStockMonitor')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'stockTable', 'LowStockMonitor')">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="stockTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Blood Group</th>
                                        <th>Available Units</th>
                                        <th>Minimum Required</th>
                                        <th style="min-width: 200px;">Stock Level</th>
                                        <th>Status</th>
                                        <th>Last Updated</th>
                                        <th class="no-print">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="stockTableBody">
                                    @foreach (var item in Model.BloodGroupStock)
                                    {
                                        string progressColor = "#198754";
                                        string badgeClass = "bg-success-subtle text-success";
                                        string rowClass = "row-healthy";

                                        if (item.Status == "Out of Stock") { progressColor = "#90151C"; badgeClass = "bg-danger-subtle text-danger"; rowClass = "row-outofstock"; }
                                        else if (item.Status == "Critical") { progressColor = "#90151C"; badgeClass = "bg-danger-subtle text-danger"; rowClass = "row-critical"; }
                                        else if (item.Status == "Low Stock") { progressColor = "#ECBD35"; badgeClass = "bg-warning-subtle text-warning"; rowClass = "row-lowstock"; }

                                        int clampedPercentage = Math.Min(100, item.PercentageRemaining);
                                        string updatedRaw = item.LastUpdated.ToString("dd-MMM-yyyy, hh:mm tt");

                                        <tr class="@rowClass" data-bg="@item.BloodGroup" data-units="@item.TotalUnits" data-status="@item.Status" data-action="@item.RecommendedAction" data-updated="@updatedRaw">
                                            <td><span class="fw-bold text-blood">@item.BloodGroup</span></td>
                                            <td>@item.TotalUnits units</td>
                                            <td>@item.ReorderLevel units</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Available: @item.TotalUnits | Required: @item.ReorderLevel | Remaining: @clampedPercentage%">
                                                        <div class="progress-bar" role="progressbar" style="width: @clampedPercentage%; background-color: @progressColor !important;" aria-valuenow="@clampedPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="text-muted" style="min-width: 90px; text-align: right;">@item.TotalUnits/@item.ReorderLevel (@clampedPercentage%)</small>
                                                </div>
                                            </td>
                                            <td><span class="badge @badgeClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@item.Status</span></td>
                                            <td><span class="relative-time" data-full="@updatedRaw">@item.LastUpdated.ToString("dd-MMM-yyyy")</span></td>
                                            <td class="no-print">
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn"
                                                            data-bg="@item.BloodGroup" data-units="@item.TotalUnits" data-reorder="@item.ReorderLevel"
                                                            data-status="@item.Status" data-percentage="@clampedPercentage" data-updated="@updatedRaw"
                                                            data-action="@item.RecommendedAction" title="View Details & Recommendation">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    <a asp-controller="Hospital" asp-action="BloodInventory" asp-route-group="@item.BloodGroup" class="btn btn-outline-primary" title="Update Stock">
                                                        <i class="bx bx-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    <tr id="emptyStateRow" style="display: none;">
                                        <td colspan="7" class="text-center py-5 text-muted">
                                            <i class="bi bi-search fs-1 d-block mb-2"></i>
                                            <h6 class="fw-semibold">No matching records found.</h6>
                                            <p class="mb-0 small">Try changing your search or filter criteria.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="pagination-wrapper-n no-print" style="margin-top: 20px;">
                            <small class="text-muted" id="paginationSummary">
                                Showing <strong>1</strong> to <strong>@Model.BloodGroupStock.Count</strong> of <strong>@Model.BloodGroupStock.Count</strong> records
                            </small>
                            <nav>
                                <ul class="pagination pagination-n mb-0">
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#" tabindex="-1"><i class="bi bi-chevron-left"></i> Previous</a>
                                    </li>
                                    <li class="page-item active">
                                        <a class="page-link" href="#">1</a>
                                    </li>
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#">Next <i class="bi bi-chevron-right"></i></a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- VIEW DETAILS MODAL -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-droplet text-theme"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Stock Details</h5>
                        <small class="text-muted" id="modalBloodGroup">BG-XX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-blood mb-3"><i class="bx bx-droplet me-2"></i>Stock Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Blood Group</label>
                                <p class="form-control-plaintext fw-bold text-blood mb-0" id="d_BloodGroup">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Available Units</label>
                                <p class="form-control-plaintext mb-0" id="d_Units">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Minimum Required</label>
                                <p class="form-control-plaintext mb-0" id="d_Reorder">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Status</label>
                                <p class="form-control-plaintext mb-0" id="d_StatusWrapper">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Stock Percentage</label>
                                <p class="form-control-plaintext mb-0 fw-bold" id="d_Percentage">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Estimated Health</label>
                                <p class="form-control-plaintext mb-0 fw-bold" id="d_Health">-</p>
                            </div>
                        </div>

                        <h6 class="fw-bold text-theme mb-3 mt-4"><i class="bx bx-bar-chart-alt-2 me-2"></i>Stock Analytics</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Avg. Daily Usage</label>
                                <p class="form-control-plaintext mb-0" id="d_AvgUsage">Loading...</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Est. Remaining Days</label>
                                <p class="form-control-plaintext mb-0" id="d_RemainingDays">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Last Collection</label>
                                <p class="form-control-plaintext mb-0" id="d_LastCollection">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Last Issue</label>
                                <p class="form-control-plaintext mb-0" id="d_LastIssue">-</p>
                            </div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-info-circle me-2"></i>Recommendation</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1">Recommended Action</label>
                                <div id="d_ActionWrapper" class="p-3 rounded-3 border">
                                    <p class="mb-0 fw-semibold" id="d_Action">-</p>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1">Last Updated</label>
                                <p class="form-control-plaintext mb-0" id="d_Updated">-</p>
                            </div>
                        </div>

                        <!-- Dynamic Quick Actions Populated Here -->
                        <div class="row g-2 mt-3" id="modalActionButtons"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <a asp-controller="Hospital" asp-action="BloodInventory" id="modalUpdateStockBtn" class="btn btn-theme rounded-pill px-4">Update Stock</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        console.log("🚀 Low Stock Monitor Enhanced Script Loaded Successfully!");

        let refreshInterval;
        let currentFilters = { search: '', status: 'all', sortBy: 'priority' };
        let isFirstLoad = true;
        let previousStockStatus = {};
        const hospitalName = "@hospitalName";

        // Initialize Bootstrap Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // ==================== AUTO REFRESH & NOTIFICATIONS ====================
        function startAutoRefresh() {
            refreshInterval = setInterval(async () => {
                try {
                    const response = await fetch('/Hospital/GetLowStockDataJson');
                    const data = await response.json();
                    updateDashboard(data);
                } catch (e) {
                    console.log("Auto-refresh skipped", e);
                }
            }, 45000);
        }

        function checkForStatusChanges(newStockData) {
            const severityOrder = { "Healthy": 1, "Low Stock": 2, "Critical": 3, "Out of Stock": 4 };
            newStockData.forEach(item => {
                const bg = item.BloodGroup;
                const newStatus = item.Status;
                const oldStatus = previousStockStatus[bg];

                if (oldStatus && oldStatus !== newStatus) {
                    if (severityOrder[newStatus] > severityOrder[oldStatus]) {
                        showNotification(`⚠️ Alert: ${bg} status degraded from ${oldStatus} to ${newStatus}!`, 'warning');
                    } else {
                        showNotification(`✅ Update: ${bg} stock restored to ${newStatus}.`, 'success');
                    }
                }
                previousStockStatus[bg] = newStatus;
            });
        }

        function updateDashboard(data) {
            // Update Stats
            document.getElementById('stat-total-groups').textContent = data.Stats.TotalBloodGroups;
            document.getElementById('stat-healthy').textContent = data.Stats.Healthy;
            document.getElementById('stat-low').textContent = data.Stats.LowStock;
            document.getElementById('stat-critical').textContent = data.Stats.Critical;
            document.getElementById('stat-out').textContent = data.Stats.OutOfStock;
            document.getElementById('stat-total-units').textContent = data.Stats.TotalUnits;

            // Update Health Score (Calculated in Controller)
            const healthEl = document.getElementById('healthScoreText');
            let color = "#90151C";
            if (data.Stats.HealthPercentage >= 80) { color = "#198754"; }
            else if (data.Stats.HealthPercentage >= 60) { color = "#5C88A8"; }
            else if (data.Stats.HealthPercentage >= 40) { color = "#ECBD35"; }
            healthEl.innerHTML = `<span style="color:${color}; font-weight:bold;">${data.Stats.HealthPercentage}%</span> <span class="small">(${data.Stats.HealthLevel})</span>`;

            // Handle Notifications on Subsequent Loads
            if (isFirstLoad) {
                data.BloodGroupStock.forEach(item => {
                    previousStockStatus[item.BloodGroup] = item.Status;
                });
                isFirstLoad = false;
            } else {
                checkForStatusChanges(data.BloodGroupStock);
            }

            // Update Alert Banner
            updateAlertBanner(data.BloodGroupStock);

            // Update Table Rows
            const tbody = document.querySelector('#stockTableBody');
            if (tbody) {
                let html = '';
                data.BloodGroupStock.forEach(item => {
                    let progressColor = "#198754", badgeClass = "bg-success-subtle text-success", rowClass = "row-healthy";
                    if (item.Status === "Out of Stock") { progressColor = "#90151C"; badgeClass = "bg-danger-subtle text-danger"; rowClass = "row-outofstock"; }
                    else if (item.Status === "Critical") { progressColor = "#90151C"; badgeClass = "bg-danger-subtle text-danger"; rowClass = "row-critical"; }
                    else if (item.Status === "Low Stock") { progressColor = "#ECBD35"; badgeClass = "bg-warning-subtle text-warning"; rowClass = "row-lowstock"; }

                    html += `<tr class="${rowClass}" data-bg="${item.BloodGroup}" data-units="${item.TotalUnits}" data-status="${item.Status}" data-action="${item.RecommendedAction}" data-updated="${item.LastUpdated}">
                                        <td><span class="fw-bold text-blood">${item.BloodGroup}</span></td>
                                        <td>${item.TotalUnits} units</td>
                                        <td>${item.ReorderLevel} units</td>
                                        <td><div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" data-bs-toggle="tooltip" title="Available: ${item.TotalUnits} | Required: ${item.ReorderLevel} | Remaining: ${item.PercentageRemaining}%">
                                                <div class="progress-bar" style="width: ${item.PercentageRemaining}%; background-color: ${progressColor} !important;"></div>
                                            </div>
                                            <small class="text-muted" style="min-width: 90px; text-align: right;">${item.TotalUnits}/${item.ReorderLevel} (${item.PercentageRemaining}%)</small>
                                        </div></td>
                                        <td><span class="badge ${badgeClass}" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">${item.Status}</span></td>
                                        <td><span class="relative-time" data-full="${item.LastUpdated}">${item.LastUpdatedRelative}</span></td>
                                        <td class="no-print"><div class="btn-group btn-group-sm d-flex gap-2">
                                            <button type="button" class="btn btn-outline-info view-details-btn" data-bg="${item.BloodGroup}" data-units="${item.TotalUnits}" data-reorder="${item.ReorderLevel}" data-status="${item.Status}" data-percentage="${item.PercentageRemaining}" data-updated="${item.LastUpdated}" data-action="${item.RecommendedAction}"><i class="bx bx-info-circle"></i></button>
                                            <a href="/Hospital/BloodInventory?group=${item.BloodGroup}" class="btn btn-outline-primary"><i class="bx bx-pencil"></i></a>
                                        </div></td>
                                    </tr>`;
                });
                html += `<tr id="emptyStateRow" style="display: none;"><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-search fs-1 d-block mb-2"></i><h6 class="fw-semibold">No matching records found.</h6><p class="mb-0 small">Try changing your search or filter criteria.</p></td></tr>`;
                tbody.innerHTML = html;
            }

            // Re-initialize tooltips and apply current filters
            tooltipList.length = 0;
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
            applyFiltersAndSort();
        }

        function updateAlertBanner(stockData) {
            const outGroups = stockData.filter(x => x.Status === "Out of Stock").map(x => x.BloodGroup);
            const criticalGroups = stockData.filter(x => x.Status === "Critical").map(x => x.BloodGroup);
            const lowGroups = stockData.filter(x => x.Status === "Low Stock").map(x => x.BloodGroup);
            const banner = document.getElementById('alertBanner');

            if (outGroups.length > 0) {
                banner.className = "smart-alert alert-danger-custom";
                banner.innerHTML = `<i class="bi bi-exclamation-triangle-fill fs-4"></i><span><strong>Emergency Alert:</strong> ${outGroups.length} blood group(s) out of stock. Immediate emergency action required.<span class="fw-bold ms-1 d-block small">Affected: ${outGroups.join(', ')}</span></span>`;
            } else if (criticalGroups.length > 0) {
                banner.className = "smart-alert alert-warning-custom";
                banner.innerHTML = `<i class="bi bi-exclamation-octagon-fill fs-4"></i><span><strong>Critical Stock Alert:</strong> ${criticalGroups.length} critical blood group(s) detected. Start smart donor search and arrange blood collection.<span class="fw-bold ms-1 d-block small">Affected: ${criticalGroups.join(', ')}</span></span>`;
            } else if (lowGroups.length > 0) {
                banner.className = "smart-alert alert-warning-custom";
                banner.innerHTML = `<i class="bi bi-exclamation-triangle-fill fs-4"></i><span><strong>Low Stock Warning:</strong> ${lowGroups.length} blood group(s) running low. Schedule blood collection and monitor inventory.<span class="fw-bold ms-1 d-block small">Affected: ${lowGroups.join(', ')}</span></span>`;
            } else {
                banner.className = "smart-alert alert-success-custom";
                banner.innerHTML = `<i class="bi bi-check-circle-fill fs-4"></i><span> <strong>Healthy Inventory:</strong> All blood groups currently have healthy stock levels. No action required.</span>`;
            }
        }

        // ==================== RELATIVE TIME ====================
        function getRelativeTime(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffMs = now - date;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMins / 60);
            const diffDays = Math.floor(diffHours / 24);

            if (diffMins < 1) return "Just now";
            if (diffMins < 60) return `${diffMins} min${diffMins > 1 ? 's' : ''} ago`;
            if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
            if (diffDays < 7) return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
            return dateString;
        }

        function updateRelativeTimes() {
            document.querySelectorAll('.relative-time').forEach(el => {
                const fullDate = el.getAttribute('data-full');
                if (fullDate) {
                    const parts = fullDate.split(',');
                    if (parts.length === 2) {
                        const jsDate = new Date(parts[0].replace(/-/g, ' ') + ' ' + parts[1]);
                        if (!isNaN(jsDate)) {
                            el.textContent = getRelativeTime(jsDate);
                            el.title = fullDate;
                        }
                    }
                }
            });
        }

        // ==================== FILTER & SORT ====================
        function applyFiltersAndSort() {
            const sVal = currentFilters.search.toLowerCase().trim();
            const statVal = currentFilters.status.toLowerCase().trim();
            const sortBy = currentFilters.sortBy;
            const tbody = document.querySelector("#stockTableBody");
            const rows = Array.from(tbody.querySelectorAll("tr"));
            let visibleCount = 0;

            rows.forEach(row => {
                if (row.id === 'emptyStateRow') return;
                const bg = row.getAttribute('data-bg')?.toLowerCase() || '';
                const units = row.getAttribute('data-units') || '';
                const status = row.getAttribute('data-status')?.toLowerCase() || '';
                const action = row.getAttribute('data-action')?.toLowerCase() || '';
                const updated = row.getAttribute('data-updated')?.toLowerCase() || '';

                let show = true;
                if (sVal && !(bg.includes(sVal) || status.includes(sVal) || action.includes(sVal) || units.includes(sVal) || updated.includes(sVal))) show = false;
                if (statVal === 'critical_out' && !(status.includes('critical') || status.includes('out of stock'))) show = false;
                else if (statVal === 'recently_updated' && !updated.includes('min') && !updated.includes('hour') && !updated.includes('just now')) show = false;
                else if (statVal !== 'all' && statVal !== 'critical_out' && statVal !== 'recently_updated' && status !== statVal) show = false;

                row.style.display = show ? "" : "none";
                row.dataset.visible = show ? "true" : "false";
                if (show) visibleCount++;
            });

            const visibleRows = rows.filter(r => r.dataset.visible === "true" && r.id !== 'emptyStateRow');
            visibleRows.sort((a, b) => {
                if (sortBy === 'priority') {
                    const getPriority = (s) => s.includes('out of stock') ? 1 : s.includes('critical') ? 2 : s.includes('low stock') ? 3 : 4;
                    return getPriority(a.getAttribute('data-status').toLowerCase()) - getPriority(b.getAttribute('data-status').toLowerCase());
                } else if (sortBy === 'lowest') return parseInt(a.getAttribute('data-units')) - parseInt(b.getAttribute('data-units'));
                else if (sortBy === 'highest') return parseInt(b.getAttribute('data-units')) - parseInt(a.getAttribute('data-units'));
                else if (sortBy === 'bloodgroup') return a.getAttribute('data-bg').localeCompare(b.getAttribute('data-bg'));
                return 0;
            });

            visibleRows.forEach(row => tbody.appendChild(row));
            rows.filter(r => r.dataset.visible === "false").forEach(row => tbody.appendChild(row));

            const emptyRow = document.getElementById('emptyStateRow');
            if (emptyRow) emptyRow.style.display = visibleCount === 0 ? 'table-row' : 'none';

            document.getElementById('paginationSummary').innerHTML = `Showing <strong>${visibleCount > 0 ? 1 : 0}</strong> to <strong>${visibleCount}</strong> of <strong>${visibleCount}</strong> records`;
        }

        // ==================== EVENT LISTENERS ====================
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('searchInput').addEventListener('input', (e) => { currentFilters.search = e.target.value; applyFiltersAndSort(); });
            document.getElementById('filterStatus').addEventListener('change', (e) => { currentFilters.status = e.target.value; applyFiltersAndSort(); });
            document.getElementById('filterSortBy').addEventListener('change', (e) => { currentFilters.sortBy = e.target.value; applyFiltersAndSort(); });
            document.getElementById('resetFiltersBtn').addEventListener('click', () => {
                currentFilters = { search: '', status: 'all', sortBy: 'priority' };
                document.getElementById('searchInput').value = '';
                document.getElementById('filterStatus').value = 'all';
                document.getElementById('filterSortBy').value = 'priority';
                applyFiltersAndSort();
            });

            document.getElementById('stockTable').addEventListener('click', function(e) {
                const btn = e.target.closest('.view-details-btn');
                if (btn) openViewDetailsModal(btn);
            });

            updateRelativeTimes();
            startAutoRefresh();

            // ✅ FIX: Initialize previous stock status on page load
            const initialStockData = [
                        @foreach (var item in Model.BloodGroupStock)
                {
                    <text>{BloodGroup: "@item.BloodGroup", Status: "@item.Status" },</text>
                        }
                    ];
            initialStockData.forEach(item => {
                previousStockStatus[item.BloodGroup] = item.Status;
            });
            isFirstLoad = false;
        });

        // ==================== VIEW DETAILS MODAL ====================
        async function openViewDetailsModal(btn) {
            const bg = btn.getAttribute('data-bg');
            const units = parseInt(btn.getAttribute('data-units')) || 0;
            const reorder = parseInt(btn.getAttribute('data-reorder')) || 10;
            const status = btn.getAttribute('data-status');
            const updated = btn.getAttribute('data-updated');
            const percentage = parseInt(btn.getAttribute('data-percentage')) || 0;
            const action = btn.getAttribute('data-action');

            document.getElementById('modalBloodGroup').textContent = bg;
            document.getElementById('d_BloodGroup').textContent = bg;
            document.getElementById('d_Units').textContent = units + ' units';
            document.getElementById('d_Reorder').textContent = reorder + ' units';
            document.getElementById('d_Updated').textContent = updated;
            document.getElementById('d_Percentage').textContent = percentage + '%';
            document.getElementById('d_Action').textContent = action;

            // Status Badge
            const s = status.toLowerCase();
            let badgeClass = 'bg-secondary-subtle text-secondary';
            if (s === 'healthy') badgeClass = 'bg-success-subtle text-success';
            else if (s === 'low stock') badgeClass = 'bg-warning-subtle text-warning';
            else if (s === 'critical' || s === 'out of stock') badgeClass = 'bg-danger-subtle text-danger';
            document.getElementById('d_StatusWrapper').innerHTML = `<span class="badge ${badgeClass}" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">${status}</span>`;

            // Health Level
            let healthLevel = "Critical", healthColor = "#90151C";
            if (percentage >= 80) { healthLevel = "Excellent"; healthColor = "#198754"; }
            else if (percentage >= 60) { healthLevel = "Good"; healthColor = "#5C88A8"; }
            else if (percentage >= 40) { healthLevel = "Average"; healthColor = "#ECBD35"; }
            const healthEl = document.getElementById('d_Health');
            healthEl.textContent = healthLevel;
            healthEl.style.color = healthColor;

            // Action Wrapper Color
            const actionWrapper = document.getElementById('d_ActionWrapper');
            actionWrapper.className = 'p-3 rounded-3 border mb-0 fw-semibold';
            if (s.includes('out of stock') || s.includes('critical')) actionWrapper.classList.add('bg-danger-subtle', 'text-danger', 'border-danger');
            else if (s.includes('low')) actionWrapper.classList.add('bg-warning-subtle', 'text-warning', 'border-warning');
            else actionWrapper.classList.add('bg-success-subtle', 'text-success', 'border-success');

            // Fetch Real Analytics from Database
            try {
                const response = await fetch(`/Hospital/GetBloodGroupAnalytics?bloodGroup=${encodeURIComponent(bg)}`);
                const analytics = await response.json();
                if (analytics.success) {
                    document.getElementById('d_AvgUsage').textContent = `~${analytics.avgDailyUsage} units/day`;
                    document.getElementById('d_RemainingDays').textContent = analytics.remainingDays;
                    document.getElementById('d_LastCollection').textContent = `${analytics.lastCollectionDate} (${analytics.collectionFrequency})`;
                    document.getElementById('d_LastIssue').textContent = analytics.lastIssueDate;
                }
            } catch (e) { console.error("Failed to load analytics", e); }

            // Dynamic Quick Actions Based on Status
            let actionHtml = '<div class="row g-2 mt-2">';
            if (s === 'healthy') {
                actionHtml += `<div class="col-12"><a href="/Hospital/BloodInventory?group=${encodeURIComponent(bg)}" class="btn btn-theme btn-sm rounded-pill w-100"><i class="bx bx-pencil me-1"></i> Update Stock</a></div>`;
            } else if (s === 'low stock') {
                actionHtml += `<div class="col-6"><a href="/Hospital/BloodInventory?group=${encodeURIComponent(bg)}" class="btn btn-outline-primary btn-sm rounded-pill w-100"><i class="bx bx-calendar me-1"></i> Schedule Collection</a></div>`;
                actionHtml += `<div class="col-6"><a href="/Hospital/BloodInventory?group=${encodeURIComponent(bg)}" class="btn btn-theme btn-sm rounded-pill w-100"><i class="bx bx-pencil me-1"></i> Update Stock</a></div>`;
            } else if (s === 'critical') {
                actionHtml += `<div class="col-6"><a href="/Hospital/SmartDonorSearch?bloodGroup=${encodeURIComponent(bg)}" class="btn btn-theme btn-sm rounded-pill w-100"><i class="bx bx-user me-1"></i> Smart Donor Search</a></div>`;
                actionHtml += `<div class="col-6"><a href="/Hospital/BloodInventory?group=${encodeURIComponent(bg)}" class="btn btn-outline-primary btn-sm rounded-pill w-100"><i class="bx bx-pencil me-1"></i> Update Stock</a></div>`;
            } else if (s === 'out of stock') {
                actionHtml += `<div class="col-6"><a href="/Hospital/SmartDonorSearch?bloodGroup=${encodeURIComponent(bg)}" class="btn btn-theme btn-sm rounded-pill w-100"><i class="bx bx-user me-1"></i> Smart Donor Search</a></div>`;
                actionHtml += `<div class="col-6"><a href="/Hospital/EmergencyRequests?bloodGroup=${encodeURIComponent(bg)}&priority=Emergency" class="btn btn-danger btn-sm rounded-pill w-100"><i class="bx bx-error-circle me-1"></i> Emergency Request</a></div>`;
            }
            actionHtml += '</div>';
            document.getElementById('modalActionButtons').innerHTML = actionHtml;

            document.getElementById('modalUpdateStockBtn').href = `/Hospital/BloodInventory?group=${encodeURIComponent(bg)}`;
            new bootstrap.Modal(document.getElementById('viewDetailsModal')).show();
        }

        // ==================== NOTIFICATION ====================
        function showNotification(message, type = "success") {
            const old = document.getElementById("customNotification");
            if (old) old.remove();
            const notification = document.createElement("div");
            notification.id = "customNotification";
            let bg = "#5C88A8", icon = "✔";
            if (type === "error") { bg = "#dc3545"; icon = ""; }
            else if (type === "warning") { bg = "#ffc107"; icon = "⚠"; }

            notification.innerHTML = `<div style="display:flex;align-items:center;gap:12px;padding:16px 24px;background:${bg};color:#fff;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.15);font-weight:600;font-size:15px;z-index:9999999999;"><span style="font-size:20px;">${icon}</span><span>${message}</span></div>`;
            notification.style.cssText = "position:fixed!important;top:20px!important;right:20px!important;z-index:2147483647!important;animation:slideInRight 0.4s ease;";

            if (!document.getElementById('notification-anim-style')) {
                const style = document.createElement('style');
                style.id = 'notification-anim-style';
                style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                document.head.appendChild(style);
            }

            document.documentElement.appendChild(notification);
            setTimeout(() => {
                notification.style.transition = "all 0.4s ease";
                notification.style.opacity = "0";
                notification.style.transform = "translateX(400px)";
                setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
            }, 3000);
        }

        // ==================== EXPORT ====================
        window.exportTable = function(type, tableId, fileName) {
            const table = document.getElementById(tableId);
            if (!table) { showNotification('Table not found!', 'error'); return; }

            const totalGroups = document.getElementById('stat-total-groups')?.textContent || '0';
            const healthy = document.getElementById('stat-healthy')?.textContent || '0';
            const low = document.getElementById('stat-low')?.textContent || '0';
            const critical = document.getElementById('stat-critical')?.textContent || '0';
            const out = document.getElementById('stat-out')?.textContent || '0';
            const totalUnits = document.getElementById('stat-total-units')?.textContent || '0';
            const summaryText = `Summary: Total Groups: ${totalGroups} | Healthy: ${healthy} | Low: ${low} | Critical: ${critical} | Out: ${out} | Total Units: ${totalUnits}`;

            if (type === 'excel') {
                let csv = [`"Hospital: ${hospitalName}"`, `"Generated: ${new Date().toLocaleString()}"`, `"${summaryText}"`, ""];
                table.querySelectorAll("tr").forEach(row => {
                    if (row.style.display !== 'none' && row.id !== 'emptyStateRow') {
                        let rowData = [];
                        row.querySelectorAll("td, th").forEach((cell, idx) => {
                            if (idx < 6) rowData.push(`"${cell.innerText.trim().replace(/"/g, '""')}"`);
                        });
                        csv.push(rowData.join(","));
                    }
                });
                if (csv.length <= 4) { showNotification('No records to export!', 'warning'); return; }

                const blob = new Blob(["\uFEFF" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = `${fileName}_Report.csv`;
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(link.href);
                showNotification('Excel Export Successful', 'success');

            } else if (type === 'pdf') {
                if (typeof window.jspdf === 'undefined') { showNotification('PDF library not loaded!', 'error'); return; }
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('l', 'mm', 'a4');

                doc.setFontSize(18); doc.setTextColor(92, 136, 168); doc.text("Low Stock Monitor Report", 14, 20);
                doc.setFontSize(10); doc.setTextColor(108, 117, 125);
                doc.text(`Hospital: ${hospitalName}`, 14, 30);
                doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 36);
                doc.text(summaryText, 14, 42);

                const rows = [];
                table.querySelectorAll("tbody tr").forEach(tr => {
                    if (tr.style.display !== 'none' && tr.id !== 'emptyStateRow') {
                        const cells = tr.querySelectorAll("td");
                        if (cells.length >= 6) rows.push([cells[0].innerText, cells[1].innerText, cells[2].innerText, cells[3].innerText, cells[4].innerText, cells[5].innerText]);
                    }
                });

                if (rows.length === 0) { showNotification('No records to export!', 'warning'); return; }
                doc.autoTable({ startY: 48, head: [['Blood Group', 'Units', 'Min Required', 'Stock Level', 'Status', 'Last Updated']], body: rows, theme: 'grid', headStyles: { fillColor: [92, 136, 168], textColor: 255 }, styles: { fontSize: 8 } });
                doc.save(`${fileName}_Report.pdf`);
                showNotification('PDF Export Successful', 'success');
            }
        };
    </script>
}