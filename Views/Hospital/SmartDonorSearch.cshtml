@model Khoon_e_Hayat.ViewModels.HospitalDonorSearchViewModel
@{
    ViewData["Title"] = "Smart Donor Search";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
}

@Html.AntiForgeryToken()

<style>
    .text-blood {
        color: #90151C !important;
    }

    .text-theme {
        color: #5C88A8 !important;
    }

    .text-success-custom {
        color: #198754 !important;
    }

    .text-warning-custom {
        color: #ECBD35 !important;
    }

    .text-danger-custom {
        color: #90151C !important;
    }

    .text-info-custom {
        color: #0dcaf0 !important;
    }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }

        .btn-theme:hover {
            background-color: #4a6d87;
            border-color: #4a6d87;
            color: #fff;
        }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #0E1A2B !important;
    }

    #viewProfileModal .form-control-plaintext,
    #assignDonorModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }

    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icons-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icons-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    .icons-box-success {
        background: #e6f7ee;
    }

        .icons-box-success i {
            color: #198754;
        }

    .icons-box-primary {
        background: #e6f4ff;
    }

        .icons-box-primary i {
            color: #5C88A8;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .progress-bar {
        box-shadow: none !important;
        border-radius: 50px;
        transition: width 0.6s ease;
    }

    .match-progress {
        width: 90px;
        height: 8px;
        background: #e9ecef;
        border-radius: 50px;
        overflow: hidden;
    }

        .match-progress .progress-bar {
            border-radius: 50px;
            transition: width .3s ease;
        }

    @@media (max-width: 768px) {
        .btn-group-sm .btn {
            padding: 4px 8px;
            font-size: 0.75rem;
        }

        .table-responsive {
            font-size: 0.85rem;
        }
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Smart Donor Search</h4>
                <div class="d-flex gap-2">
                    <button type="button" id="refreshMatchesBtn" class="btn btn-outline-secondary btn-sm rounded-pill">
                        <i class="bi bi-arrow-clockwise me-1"></i> Refresh Matches
                    </button>
                </div>
            </div>

            @if (Model.SelectedRequest != null)
            {
                @if (Model.IsBloodInventorySufficient)
                {
                    <div class="alert alert-success border-0 rounded-4 d-flex align-items-center gap-3 mb-4 shadow-sm" style="background-color: #f0fdf4; border-left: 4px solid #198754 !important;">
                        <div class="icon-box" style="background: #dcfce7;"><i class="bi bi-check-circle-fill text-success"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1 text-success">✅ Inventory Sufficient</h6>
                            <p class="mb-2 small text-muted">
                                Your hospital already has <strong>@Model.CurrentStockUnits units</strong> of <strong>@Model.RequiredBloodGroup</strong> available.
                                This request can be fulfilled directly from your hospital's blood inventory. Donor assignment is not required.
                            </p>
                            <a href="@Url.Action("BloodInventory", "Hospital", new { Filters = new Khoon_e_Hayat.ViewModels.InventoryFilters { BloodGroup = Model.RequiredBloodGroup } })" class="btn btn-success btn-sm rounded-pill px-4">
                                <i class="bi bi-box-seam me-2"></i>Issue Blood From Inventory
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-0 rounded-4 d-flex align-items-center gap-3 mb-4 shadow-sm" style="background-color: #fff8e1; border-left: 4px solid #ECBD35 !important;">
                        <div class="icon-box" style="background: #ffe69c;"><i class="bi bi-exclamation-triangle text-warning-custom"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1 text-warning-custom">Low Blood Inventory Alert</h6>
                            <p class="mb-0 small text-muted">
                                Current hospital stock is low (@Model.CurrentStockUnits units). Specifically, <strong>@Model.RequiredBloodGroup</strong> is needed.
                                Use this AI-powered search to find compatible, eligible donors nearby.
                            </p>
                        </div>
                    </div>
                }

                <div class="alert alert-info border-0 rounded-4 d-flex align-items-center gap-3 mb-4 shadow-sm" style="background-color: #e6f4ff; border-left: 4px solid #5C88A8 !important;">
                    <div class="icon-box" style="background: #cfe2ff;"><i class="bi bi-clipboard-check text-theme"></i></div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1 text-theme">Searching for: Request #REQ-@Model.SelectedRequest.RequestId.ToString("D4")</h6>
                        <p class="mb-0 small text-muted">
                            <strong>Receiver:</strong> @Model.SelectedRequest.ReceiverName |
                            <strong>Blood Group:</strong> <span class="text-blood fw-bold">@Model.SelectedRequest.BloodGroup</span> |
                            <strong>Units:</strong> @Model.SelectedRequest.UnitsRequired |
                            <strong>Urgency:</strong> <span class="badge @(Model.SelectedRequest.UrgencyLevel == "Critical" || Model.SelectedRequest.UrgencyLevel == "Emergency" ? "bg-danger" : "bg-warning")">@Model.SelectedRequest.UrgencyLevel</span> |
                            <strong>Hospital:</strong> @Model.SelectedRequest.HospitalName
                        </p>
                    </div>
                    <a href="@Url.Action("SmartDonorSearch", "Hospital")" class="btn btn-sm btn-outline-secondary rounded-pill">Clear Selection</a>
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 rounded-4 d-flex align-items-center gap-3 mb-4 shadow-sm" style="background-color: #e6f4ff; border-left: 4px solid #5C88A8 !important;">
                    <div class="icon-box" style="background: #cfe2ff;"><i class="bi bi-info-circle text-theme"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1 text-theme">No Request Selected</h6>
                        <p class="mb-0 small text-muted">Select a pending blood request to start the smart donor matching process.</p>
                    </div>
                </div>
            }

            <!-- SEARCH & FILTER -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4" style="border-left: none;">
                <div class="card-body p-3">
                    <form method="get" action="@Url.Action("SmartDonorSearch", "Hospital")">
                        <input type="hidden" name="requestId" value="@Context.Request.Query["requestId"]" />
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label small text-muted mb-1">Search</label>
                                <input type="text" name="SearchQuery" value="@Model.Filters.SearchQuery" class="form-control form-control-sm rounded-pill px-3" placeholder="Name, ID, phone, city..." />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small text-muted mb-1">Blood Group</label>
                                <select name="BloodGroup" class="form-select form-select-sm rounded-pill">
                                    <option value="all" selected="@(Model.Filters.BloodGroup == "all")">All</option>
                                    @foreach (var bg in Model.AvailableBloodGroups)
                                    {
                                        <option value="@bg" selected="@(Model.Filters.BloodGroup == bg)">@bg</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small text-muted mb-1">Sort By</label>
                                <select name="SortBy" class="form-select form-select-sm rounded-pill">
                                    <option value="bestmatch" selected="@(Model.Filters.SortBy == "bestmatch")">Best Match</option>
                                    <option value="nearest" selected="@(Model.Filters.SortBy == "nearest")">Nearest</option>
                                    <option value="recentlyactive" selected="@(Model.Filters.SortBy == "recentlyactive")">Recently Active</option>
                                    <option value="highestacceptance" selected="@(Model.Filters.SortBy == "highestacceptance")">Highest Acceptance</option>
                                    <option value="mostdonations" selected="@(Model.Filters.SortBy == "mostdonations")">Most Donations</option>
                                    <option value="prevhospital" selected="@(Model.Filters.SortBy == "prevhospital")">Previous Hospital</option>
                                    <option value="highestscore" selected="@(Model.Filters.SortBy == "highestscore")">Highest Score</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-2">
                                <button type="submit" class="btn btn-theme btn-sm rounded-pill w-100">
                                    <i class="bi bi-search me-1"></i> Search
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TABLE WRAPPER FOR AJAX REFRESH -->
            <div id="donorsTableContainer">
                @if (Model.SelectedRequest != null && Model.IsBloodInventorySufficient)
                {
                    <div class="card custom-card border-0 shadow-sm rounded-4" style="border-left: none;">
                        <div class="card-body px-4 text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                                <h5 class="fw-semibold">Donor Search Skipped</h5>
                                <p class="mb-3">The required blood units are already available in your hospital inventory. Please use the "Issue Blood From Inventory" button above to fulfill this request.</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card custom-card border-0 shadow-sm rounded-4" style="border-left: none;">
                        @if (!Model.Donors.Any())
                        {
                            <div class="card-body px-4">
                                <div class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-search fs-1 d-block mb-2 text-theme"></i>
                                        <h5 class="fw-semibold">No Matching Donors Found</h5>
                                        <p class="mb-3">Try adjusting your filters or check back later when new donors register.</p>
                                        <div class="alert alert-light border-0 shadow-sm rounded-4 text-start mx-auto" style="max-width: 600px;">
                                            <h6 class="fw-bold text-theme mb-2"><i class="bi bi-robot me-2"></i>AI Suggestions:</h6>
                                            <ul class="mb-0 small text-muted">
                                                <li>Expand your search radius or remove the availability filter.</li>
                                                <li>Try searching for compatible blood groups (e.g., O+ for A+).</li>
                                                <li>Search nearby cities or notify the central blood bank.</li>
                                                <li>Click "Refresh Matches" to recalculate AI scores with real-time data.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <h4 class="mb-1 fw-semibold">AI Matched Donors</h4>
                                        <small class="text-muted">Intelligent donor matching based on compatibility, location, and eligibility</small>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body px-4">
                                <div class="table-responsive p-3">
                                    <table class="table align-middle mb-0" id="donorsTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Donor Name</th>
                                                <th>Blood Group</th>
                                                <th style="min-width: 140px;">Match Score</th>
                                                <th>Smart Status</th>
                                                <th>Last Donation</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var donor in Model.Donors)
                                            {
                                                var progressColor = donor.MatchScore >= 85 ? "#198754" : donor.MatchScore >= 70 ? "#ECBD35" : "#90151C";
                                                var deadlineStr = donor.ResponseDeadline?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "";

                                                <tr data-donorid="@donor.DonorId">
                                                    <td>
                                                        <div>
                                                            <div class="fw-semibold">@donor.FullName</div>
                                                            <small class="text-muted">@donor.Phone</small>
                                                            @if (donor.DistanceKm > 0 && donor.DistanceKm < 999)
                                                            {
                                                                <div><small class="text-info-custom"><i class="bi bi-geo-alt"></i> @donor.DistanceKm km (@donor.TravelTime)</small></div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td><span class="fw-bold text-blood">@donor.BloodGroup</span></td>
                                                    <td>
                                                        <div class="d-flex flex-column">
                                                            <span style="font-size:0.75rem; font-weight:600; color:#198754;">@donor.MatchQuality</span>
                                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                                <div class="progress match-progress">
                                                                    <div class="progress-bar" role="progressbar" style="width:@(donor.MatchScore)%; background-color:@progressColor;" aria-valuenow="@donor.MatchScore" aria-valuemin="0" aria-valuemax="100"></div>
                                                                </div>
                                                                <small style="font-weight:600; color:@progressColor;">@donor.MatchScore%</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="fw-semibold" style="color: @(donor.AvailabilityStatus == "Available Now" ? "#198754" : donor.AvailabilityStatus == "Pending Response" ? "#b48e12" : "#90151C");">
                                                            @donor.AvailabilityStatus
                                                        </span>
                                                        @if (donor.AvailabilityStatus == "Pending Response" && donor.ResponseDeadline.HasValue)
                                                        {
                                                            <div><small class="countdown-timer text-warning-custom" data-deadline="@deadlineStr">Calculating...</small></div>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (donor.LastDonationDate.HasValue)
                                                        {
                                                            <div class="fw-semibold">@donor.LastDonationDate.Value.ToString("dd-MMM-yyyy")</div>
                                                            <small class="text-muted">(@donor.TotalDonations total)</small>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Never</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm d-flex gap-2">
                                                            <button type="button" class="btn btn-outline-info view-profile-btn"
                                                                    data-donorid="@donor.DonorId" data-name="@donor.FullName" data-bg="@donor.BloodGroup"
                                                                    data-phone="@donor.Phone" data-email="@donor.Email"
                                                                    data-lastdonation="@(donor.LastDonationDate?.ToString("dd-MMM-yyyy") ?? "Never")"
                                                                    data-total="@donor.TotalDonations" data-hospitaldonations="@donor.PreviousHospitalDonations"
                                                                    data-commstatus="@donor.CommunicationStatus" data-reasons="@string.Join("|", donor.MatchReasons)"
                                                                    data-total-requests="@donor.TotalRequestsReceived" data-accepted="@donor.AcceptedRequests"
                                                                    data-rejected="@donor.RejectedRequests" data-expired="@donor.ExpiredRequests"
                                                                    data-acceptance-rate="@donor.AcceptanceRate"
                                                                    data-age="@(donor.Age?.ToString() ?? "N/A")" data-gender="@(donor.Gender ?? "N/A")"
                                                                    data-weight="@(donor.Weight?.ToString() ?? "N/A")" data-regdate="@(donor.RegistrationDate.ToString("dd-MMM-yyyy"))"
                                                                    data-nexteligible="@(donor.NextEligibleDate?.ToString("dd-MMM-yyyy") ?? "Eligible Now")"
                                                                    data-location="@(donor.City + (string.IsNullOrEmpty(donor.Area) ? "" : ", " + donor.Area))"
                                                                    title="View Profile & AI Reasons">
                                                                <i class="bx bx-user"></i>
                                                            </button>
                                                            @if (donor.IsEligibleToDonate && donor.AvailabilityStatus == "Available Now")
                                                            {
                                                                <button type="button" class="btn btn-outline-success assign-donor-btn"
                                                                        data-donorid="@donor.DonorId" data-name="@donor.FullName" data-bg="@donor.BloodGroup"
                                                                        title="Assign to Request">
                                                                    <i class="bx bx-check-circle"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- PAGINATION -->
                                @if (Model.TotalPages > 1 || Model.Donors.Count > 0)
                                {
                                    <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                        <small class="text-muted" id="paginationSummary">
                                            Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to <strong>@(Model.CurrentPage * Model.PageSize > Model.TotalCount ? Model.TotalCount : Model.CurrentPage * Model.PageSize)</strong> of <strong>@Model.TotalCount</strong> donors
                                        </small>
                                        <nav>
                                            <ul class="pagination pagination-n mb-0">
                                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                                    <a class="page-link" href="@Url.Action("SmartDonorSearch", "Hospital", new { page = Model.CurrentPage - 1, requestId = Context.Request.Query["requestId"], SearchQuery = Model.Filters.SearchQuery, BloodGroup = Model.Filters.BloodGroup, SortBy = Model.Filters.SortBy })" tabindex="-1">
                                                        <i class="bi bi-chevron-left"></i> Previous
                                                    </a>
                                                </li>
                                                @for (int i = 1; i <= Model.TotalPages; i++)
                                                {
                                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                                        <a class="page-link" href="@Url.Action("SmartDonorSearch", "Hospital", new { page = i, requestId = Context.Request.Query["requestId"], SearchQuery = Model.Filters.SearchQuery, BloodGroup = Model.Filters.BloodGroup, SortBy = Model.Filters.SortBy })">@i</a>
                                                    </li>
                                                }
                                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                                    <a class="page-link" href="@Url.Action("SmartDonorSearch", "Hospital", new { page = Model.CurrentPage + 1, requestId = Context.Request.Query["requestId"], SearchQuery = Model.Filters.SearchQuery, BloodGroup = Model.Filters.BloodGroup, SortBy = Model.Filters.SortBy })">
                                                        Next <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- VIEW PROFILE MODAL -->
<div class="modal fade" id="viewProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bx bx-user text-theme" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0 fw-semibold">Donor Profile</h5>
                        <small class="text-muted" id="modalDonorId">DON-XXXX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3 px-4">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-theme d-flex align-items-center gap-2"><i class="bx bx-user-circle" style="font-size: 1.25rem;"></i> Personal Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Full Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_Name">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Donor ID</label><p class="form-control-plaintext fw-semibold mb-0" id="d_DonorId">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-blood mb-0" id="d_Bg" style="font-size: 1.1rem;">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Age / Gender</label><p class="form-control-plaintext mb-0" id="d_AgeGender">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Contact</label><p class="form-control-plaintext mb-0" id="d_Phone">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Email</label><p class="form-control-plaintext mb-0" id="d_Email">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">City / Area</label><p class="form-control-plaintext mb-0" id="d_Location">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Weight</label><p class="form-control-plaintext mb-0" id="d_Weight">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Registration Date</label><p class="form-control-plaintext mb-0" id="d_RegDate">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Next Eligible Date</label><p class="form-control-plaintext mb-0 fw-semibold text-theme" id="d_NextEligible">-</p></div>
                        </div>

                        <h6 class="fw-bold mb-3 text-success-custom d-flex align-items-center gap-2"><i class="bx bx-droplet" style="font-size: 1.25rem;"></i> Donation History</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Last Donation</label><p class="form-control-plaintext mb-0" id="d_LastDonation">-</p></div>
                            <div class="col-md-6"><label class="form-label small text-muted mb-1">Total Donations</label><p class="form-control-plaintext mb-0" id="d_Total">-</p></div>
                            <div class="col-md-12"><label class="form-label small text-muted mb-1">Donations at This Hospital</label><p class="form-control-plaintext mb-0 fw-semibold text-theme" id="d_HospitalDonations">0 times</p></div>
                            <div class="col-md-12"><label class="form-label small text-muted mb-1">Communication Status</label><p class="form-control-plaintext mb-0 fw-semibold" id="d_CommStatus">None</p></div>
                        </div>

                        <h6 class="fw-bold mb-3 text-warning-custom d-flex align-items-center gap-2"><i class="bx bx-history" style="font-size: 1.25rem;"></i> Response History</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Total Requests</label><p class="form-control-plaintext mb-0 fw-semibold" id="d_TotalRequests">0</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Acceptance Rate</label><p class="form-control-plaintext mb-0 fw-semibold text-success-custom" id="d_AcceptanceRate">0%</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Accepted</label><p class="form-control-plaintext mb-0 text-success" id="d_Accepted">0</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Rejected</label><p class="form-control-plaintext mb-0 text-danger" id="d_Rejected">0</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Expired</label><p class="form-control-plaintext mb-0 text-secondary" id="d_Expired">0</p></div>
                        </div>

                        <h6 class="fw-bold mb-3 text-info-custom d-flex align-items-center gap-2"><i class="bx bx-brain" style="font-size: 1.25rem;"></i> AI Match Reasons</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12"><div id="d_Reasons" class="mb-0"></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ASSIGN DONOR MODAL -->
<div class="modal fade" id="assignDonorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box icons-box-primary"><i class="bx bx-user-plus"></i></div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Assign Donor</h4>
                <p class="text-muted mb-3">You are about to assign <strong id="assignDonorName"></strong> (<strong id="assignDonorBg" class="text-blood"></strong>) to a pending blood request.</p>
                <input type="hidden" id="assignDonorId" />
                <div class="mb-3 text-start px-4">
                    <label class="form-label small text-muted">Select Pending Request <span class="text-danger">*</span></label>
                    <select id="assignRequestId" class="form-select rounded-3">
                        <option value="">Loading requests...</option>
                    </select>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-theme px-4 rounded-pill" id="confirmAssignBtn">Assign Donor</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let assignModalInstance = null;

            // Event delegation for dynamic elements (supports AJAX refresh)
            const donorsTable = document.getElementById('donorsTable');
            if (donorsTable) {
                donorsTable.addEventListener('click', function(e) {
                    const target = e.target.closest('button');
                    if (!target) return;

                    if (target.classList.contains('view-profile-btn')) {
                        openProfileModal(target);
                    } else if (target.classList.contains('assign-donor-btn')) {
                        openAssignModal(target);
                    }
                });
            }

            // Refresh Matches (AJAX without full page reload)
            const refreshBtn = document.getElementById('refreshMatchesBtn');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const btn = this;
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Recalculating...';
                    btn.disabled = true;

                    fetch(window.location.href, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(response => response.text())
                        .then(html => {
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const newContainer = doc.getElementById('donorsTableContainer');
                            if (newContainer) {
                                document.getElementById('donorsTableContainer').innerHTML = newContainer.innerHTML;
                                showNotification('AI Match Scores and availability recalculated!', 'success');
                                updateCountdowns();
                            } else {
                                location.reload();
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            location.reload();
                        })
                        .finally(() => {
                            btn.innerHTML = originalHtml;
                            btn.disabled = false;
                        });
                });
            }

            function openProfileModal(btn) {
                const donorId = btn.getAttribute('data-donorid');
                document.getElementById('modalDonorId').textContent = `DON-${String(donorId).padStart(4, '0')}`;
                document.getElementById('d_Name').textContent = btn.getAttribute('data-name') || '-';
                document.getElementById('d_DonorId').textContent = `DON-${String(donorId).padStart(4, '0')}`;
                document.getElementById('d_Bg').textContent = btn.getAttribute('data-bg') || '-';
                document.getElementById('d_AgeGender').textContent = `${btn.getAttribute('data-age')} / ${btn.getAttribute('data-gender')}`;
                document.getElementById('d_Phone').textContent = btn.getAttribute('data-phone') || '-';
                document.getElementById('d_Email').textContent = btn.getAttribute('data-email') || '-';
                document.getElementById('d_Location').textContent = btn.getAttribute('data-location') || '-';
                document.getElementById('d_Weight').textContent = btn.getAttribute('data-weight') !== 'N/A' ? `${btn.getAttribute('data-weight')} kg` : 'N/A';
                document.getElementById('d_RegDate').textContent = btn.getAttribute('data-regdate') || '-';
                document.getElementById('d_NextEligible').textContent = btn.getAttribute('data-nexteligible') || '-';

                document.getElementById('d_LastDonation').textContent = btn.getAttribute('data-lastdonation') || '-';
                document.getElementById('d_Total').textContent = (btn.getAttribute('data-total') || '0') + ' times';
                document.getElementById('d_HospitalDonations').textContent = (btn.getAttribute('data-hospitaldonations') || '0') + ' time(s)';

                const commStatus = btn.getAttribute('data-commstatus') || 'None';
                document.getElementById('d_CommStatus').textContent = commStatus;
                document.getElementById('d_CommStatus').className = 'form-control-plaintext mb-0 fw-semibold ' + (commStatus === 'None' ? 'text-secondary' : 'text-info-custom');

                document.getElementById('d_TotalRequests').textContent = btn.getAttribute('data-total-requests') || '0';
                document.getElementById('d_Accepted').textContent = btn.getAttribute('data-accepted') || '0';
                document.getElementById('d_Rejected').textContent = btn.getAttribute('data-rejected') || '0';
                document.getElementById('d_Expired').textContent = btn.getAttribute('data-expired') || '0';
                document.getElementById('d_AcceptanceRate').textContent = (btn.getAttribute('data-acceptance-rate') || '0') + '%';

                const reasonsContainer = document.getElementById('d_Reasons');
                reasonsContainer.innerHTML = '';
                const reasons = (btn.getAttribute('data-reasons') || '').split('|');
                reasons.forEach(r => {
                    if (r) {
                        const span = document.createElement('span');
                        span.className = 'badge bg-primary-subtle text-primary me-2 mb-2';
                        span.style.fontWeight = '500';
                        span.style.padding = '6px 12px';
                        span.textContent = r;
                        reasonsContainer.appendChild(span);
                    }
                });

                const modal = new bootstrap.Modal(document.getElementById('viewProfileModal'));
                modal.show();
            }

            function loadPendingRequests() {
                fetch('/Hospital/GetPendingRequests')
                    .then(response => response.json())
                    .then(data => {
                        const select = document.getElementById('assignRequestId');
                        select.innerHTML = '<option value="">Select a pending request...</option>';
                        if (data.success && data.requests) {
                            data.requests.forEach(req => {
                                const option = document.createElement('option');
                                option.value = req.requestId;
                                option.textContent = `REQ-${req.requestId.toString().padStart(4, '0')} - ${req.bloodGroup} (${req.urgencyLevel}) at ${req.hospitalName}`;
                                select.appendChild(option);
                            });
                        }
                    })
                    .catch(err => {
                        console.error('Error loading requests:', err);
                        document.getElementById('assignRequestId').innerHTML = '<option value="">Error loading requests</option>';
                    });
            }

            async function openAssignModal(btn) {
                const donorId = btn.getAttribute('data-donorid');

                try {
                    const response = await fetch(`/Hospital/CheckDonorAvailability?donorId=${donorId}`);
                    const data = await response.json();

                    if (!data.isAvailable) {
                        showNotification(data.message || 'This donor is no longer available.', 'error');
                        if (refreshBtn) refreshBtn.click();
                        return;
                    }
                } catch (error) {
                    console.error('Error checking availability:', error);
                }

                document.getElementById('assignDonorId').value = donorId;
                document.getElementById('assignDonorName').textContent = btn.getAttribute('data-name');
                document.getElementById('assignDonorBg').textContent = btn.getAttribute('data-bg');
                document.getElementById('assignRequestId').value = "";
                loadPendingRequests();
                assignModalInstance = new bootstrap.Modal(document.getElementById('assignDonorModal'));
                assignModalInstance.show();
            }

            const confirmAssignBtn = document.getElementById('confirmAssignBtn');
            if (confirmAssignBtn) {
                confirmAssignBtn.addEventListener('click', function() {
                    const donorId = document.getElementById('assignDonorId').value;
                    const requestId = document.getElementById('assignRequestId').value;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    if (!requestId) {
                        showNotification('Please select a pending request.', 'warning');
                        return;
                    }

                    const btnEl = this;
                    const originalHTML = btnEl.innerHTML;
                    btnEl.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Assigning...';
                    btnEl.disabled = true;

                    const formData = new FormData();
                    formData.append('donorId', donorId);
                    formData.append('requestId', requestId);
                    formData.append('__RequestVerificationToken', token);

                    fetch('/Hospital/AssignDonor', {
                        method: 'POST',
                        body: formData
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                if (data.isInventorySufficient) {
                                    showNotification(data.message, 'success');
                                    assignModalInstance.hide();
                                    setTimeout(() => location.reload(), 2000);
                                } else {
                                    showNotification(data.message, 'success');
                                    assignModalInstance.hide();

                                    if (data.nextBestDonors && data.nextBestDonors.length > 0) {
                                        const backupNames = data.nextBestDonors.map(d => `${d.name} (${d.bloodGroup}, ${d.score}%)`).join(' • ');
                                        setTimeout(() => {
                                            showNotification(`💡 AI Backup Queue Ready: Top alternatives are ${backupNames}`, 'info');
                                        }, 1000);
                                    }

                                    setTimeout(() => location.reload(), 6000);
                                }
                            } else {
                                showNotification(data.message || 'Failed to assign donor.', 'error');
                                btnEl.innerHTML = originalHTML;
                                btnEl.disabled = false;
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showNotification('An error occurred. Please try again.', 'error');
                            btnEl.innerHTML = originalHTML;
                            btnEl.disabled = false;
                        });
                });
            }

            // Live Countdown Timer & Status Synchronization
            function updateCountdowns() {
                document.querySelectorAll('.countdown-timer').forEach(el => {
                    const deadline = new Date(el.getAttribute('data-deadline')).getTime();
                    const now = new Date().getTime();
                    const distance = deadline - now;

                    if (distance < 0) {
                        el.textContent = "Expired";
                        el.classList.remove('text-warning-custom');
                        el.classList.add('text-danger-custom');
                    } else {
                        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                        if (hours > 0) {
                            el.textContent = `${hours}h ${minutes}m left`;
                        } else {
                            el.textContent = `${minutes}m ${seconds}s left`;
                        }
                    }
                });
            }

            setInterval(updateCountdowns, 1000);
            updateCountdowns();

            // Live Status Polling (Silent fail if endpoint is not yet implemented)
            setInterval(async () => {
                try {
                    const response = await fetch('/Hospital/GetLiveDonorStatuses');
                    const data = await response.json();
                    if (data.success) {
                        data.statuses.forEach(status => {
                            const row = document.querySelector(`tr[data-donorid="${status.donorId}"]`);
                            if (row) {
                                const statusCell = row.cells[3];
                                const actionCell = row.cells[5];

                                if (statusCell) {
                                    let color = status.Status === "Accepted" ? "#198754" :
                                        (status.Status === "Pending Response" ? "#b48e12" :
                                            (status.Status === "Expired" ? "#90151C" : "#6c757d"));

                                    statusCell.innerHTML = `<span class="fw-semibold" style="color: ${color};">${status.BadgeText}</span>`;

                                    if (status.Status === "Expired" || status.Status === "Accepted" || status.Status === "Rejected") {
                                        const timer = statusCell.querySelector('.countdown-timer');
                                        if (timer) timer.remove();
                                    } else if (status.Status === "Pending Response" && status.responseDeadline) {
                                        if (!statusCell.querySelector('.countdown-timer')) {
                                            const deadlineStr = new Date(status.responseDeadline).toISOString().slice(0, 19);
                                            statusCell.innerHTML += `<div><small class="countdown-timer text-warning-custom" data-deadline="${deadlineStr}">Calculating...</small></div>`;
                                        }
                                    }
                                }

                                if (actionCell && (status.Status === "Accepted" || status.Status === "Expired" || status.Status === "Rejected" || status.Status === "Completed")) {
                                    const assignBtn = actionCell.querySelector('.assign-donor-btn');
                                    if (assignBtn) assignBtn.remove();
                                }
                            }
                        });
                        updateCountdowns();
                    }
                } catch (e) {
                    // Silent fail to prevent console spam if endpoint is missing
                }
            }, 30000);

            function showNotification(message, type = "success") {
                const old = document.getElementById("customNotification");
                if (old) old.remove();

                const notification = document.createElement("div");
                notification.id = "customNotification";
                let bg = "#5C88A8", icon = "✔";
                if (type === "error") { bg = "#90151C"; icon = "✖"; }
                else if (type === "warning") { bg = "#ECBD35"; icon = "⚠"; }
                else if (type === "info") { bg = "#0dcaf0"; icon = "ℹ"; }

                notification.innerHTML = `
                            <div style="display: flex; align-items: center; gap: 12px; padding: 16px 24px; background: ${bg}; color: #ffffff; border-radius: 12px; box-shadow: none; font-family: system-ui, -apple-system, sans-serif; font-weight: 600; font-size: 15px; z-index: 9999999999; border: 1px solid rgba(255,255,255,0.1);">
                                <span style="font-size: 20px; line-height: 1;">${icon}</span>
                                <span>${message}</span>
                            </div>`;

                notification.style.cssText = `position: fixed !important; top: 20px !important; right: 20px !important; z-index: 2147483647 !important; margin: 0 !important; padding: 0 !important; pointer-events: auto !important; animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;`;

                if (!document.getElementById('notification-anim-style')) {
                    const style = document.createElement('style');
                    style.id = 'notification-anim-style';
                    style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                    document.head.appendChild(style);
                }

                document.documentElement.appendChild(notification);

                setTimeout(() => {
                    notification.style.transition = "all 0.4s ease";
                    notification.style.opacity = "0";
                    notification.style.transform = "translateX(400px)";
                    notification.style.pointerEvents = "none";
                    setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
                }, 8000);
            }

            // Export Functionality
            window.exportDonors = function(format) {
                const url = new URL('@Url.Action("ExportDonors", "Hospital")', window.location.origin);
                url.searchParams.append('format', format);
                url.searchParams.append('SearchQuery', '@Model.Filters.SearchQuery');
                url.searchParams.append('BloodGroup', '@Model.Filters.BloodGroup');
                url.searchParams.append('SortBy', '@Model.Filters.SortBy');
                const reqId = '@Context.Request.Query["requestId"]';
                if (reqId) url.searchParams.append('requestId', reqId);

                window.location.href = url.toString();
            };
        });
    </script>
}