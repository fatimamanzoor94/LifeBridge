@model Khoon_e_Hayat.ViewModels.AssignedDonorsViewModel
@{
    ViewData["Title"] = "Assigned Donors";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
}

@Html.AntiForgeryToken()

<style>
    .text-blood {
        color: #90151C !important;
    }

    .text-theme {
        color: #5C88A8 !important;
    }

    .text-success-custom {
        color: #198754 !important;
    }

    .text-warning-custom {
        color: #ECBD35 !important;
    }

    .text-danger-custom {
        color: #90151C !important;
    }

    .text-info-custom {
        color: #0dcaf0 !important;
    }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }

        .btn-theme:hover {
            background-color: #4a6d87;
            border-color: #4a6d87;
            color: #fff;
        }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #0E1A2B !important;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    .badge-pending {
        color: #b48e12 !important;
    }

    .badge-approved {
        color: #5C88A8 !important;
    }

    .badge-reserved {
        color: #0dcaf0 !important;
    }

    .badge-completed {
        color: #198754 !important;
    }

    .badge-rejected {
        color: #90151C !important;
    }

    .badge-delayed {
        color: #90151C !important;
    }

    .badge-normal {
        color: #6c757d !important;
    }

    #viewDetailsModal .form-control-plaintext, #timelineModal .form-control-plaintext, #cancelModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }

    .progress-bar {
        box-shadow: none !important;
        border-radius: 50px;
        transition: width 0.6s ease;
    }

    .timeline {
        position: relative;
        padding-left: 30px;
        margin-top: 10px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 10px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: #e9ecef;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 24px;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -24px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #adb5bd;
            border: 2px solid #fff;
            box-shadow: 0 0 0 2px #e9ecef;
            z-index: 1;
        }

        .timeline-item.completed::before {
            background: #198754;
            box-shadow: 0 0 0 2px #198754;
        }

        .timeline-item.active::before {
            background: #5C88A8;
            box-shadow: 0 0 0 2px #5C88A8;
            animation: pulse-blue 1.5s infinite;
        }

        .timeline-item.delayed::before {
            background: #90151C;
            box-shadow: 0 0 0 2px #90151C;
            animation: pulse-red 1.5s infinite;
        }

        .timeline-item .timeline-content {
            background: #f8f9fa;
            padding: 12px 16px;
            border-radius: 8px;
            border-left: 3px solid #adb5bd;
        }

        .timeline-item.completed .timeline-content {
            border-left-color: #198754;
            background: rgba(25, 135, 84, 0.05);
        }

        .timeline-item.active .timeline-content {
            border-left-color: #5C88A8;
            background: rgba(92, 136, 168, 0.05);
        }

        .timeline-item.delayed .timeline-content {
            border-left-color: #90151C;
            background: rgba(144, 21, 28, 0.05);
        }

    @@keyframes pulse-blue {
        0% {
            box-shadow: 0 0 0 2px #5C88A8, 0 0 0 4px rgba(92, 136, 168, 0.3);
        }

        50% {
            box-shadow: 0 0 0 2px #5C88A8, 0 0 0 8px rgba(92, 136, 168, 0);
        }

        100% {
            box-shadow: 0 0 0 2px #5C88A8, 0 0 0 4px rgba(92, 136, 168, 0.3);
        }
    }

    @@keyframes pulse-red {
        0% {
            box-shadow: 0 0 0 2px #90151C, 0 0 0 4px rgba(144, 21, 28, 0.3);
        }

        50% {
            box-shadow: 0 0 0 2px #90151C, 0 0 0 8px rgba(144, 21, 28, 0);
        }

        100% {
            box-shadow: 0 0 0 2px #90151C, 0 0 0 4px rgba(144, 21, 28, 0.3);
        }
    }

    @@media (max-width: 768px) {
        .btn-group-sm .btn {
            padding: 4px 8px;
            font-size: 0.75rem;
        }

        .table-responsive {
            font-size: 0.85rem;
        }
    }

    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icons-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icons-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Assigned Donors</h4>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><div class="icon-box"><i class="bi bi-people text-dark"></i></div><h6 class="card-title mt-3 mb-1">Total Assigned</h6><small class="text-muted">@Model.TotalAssigned.ToString("N0")</small></div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><div class="icon-box"><i class="bi bi-hourglass-split text-dark"></i></div><h6 class="card-title mt-3 mb-1">Pending Response</h6><small class="text-muted text-warning-custom fw-bold">@Model.PendingResponse.ToString("N0")</small></div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><div class="icon-box"><i class="bi bi-check-circle text-dark"></i></div><h6 class="card-title mt-3 mb-1">Accepted/Sched</h6><small class="text-muted text-theme fw-bold">@Model.AcceptedOrScheduled.ToString("N0")</small></div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><div class="icon-box"><i class="bi bi-trophy text-dark"></i></div><h6 class="card-title mt-3 mb-1">Completed</h6><small class="text-muted text-success-custom fw-bold">@Model.Completed.ToString("N0")</small></div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><div class="icon-box"><i class="bi bi-x-octagon text-dark"></i></div><h6 class="card-title mt-3 mb-1">Rejected/Exp</h6><small class="text-muted text-danger-custom fw-bold">@Model.RejectedOrExpired.ToString("N0")</small></div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4" style="border-left: none;">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Donor name, Request ID, Patient..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Pending Response">Pending Response</option>
                                <option value="Accepted">Accepted</option>
                                <option value="DonationScheduled">Scheduled</option>
                                <option value="Completed">Completed</option>
                                <option value="Rejected">Rejected</option>
                                <option value="Expired">Expired</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Sort By</label>
                            <select id="filterSortBy" class="form-select form-select-sm rounded-pill">
                                <option value="newest">Newest</option>
                                <option value="oldest">Oldest</option>
                                <option value="score">Highest Score</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-pill w-100" title="Reset all filters"><i class="bi bi-arrow-counterclockwise"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4" style="border-left: none;">
                @if (!Model.Donors.Any())
                {
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-theme"></i>
                                <h5 class="fw-semibold">No Assigned Donors Found</h5>
                                <p class="mb-3">There are no donor assignments matching your criteria.</p>
                                <a asp-controller="Hospital" asp-action="SmartDonorSearch" class="btn btn-theme rounded-pill px-4"><i class="bi bi-search me-2"></i> Find Donors</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">Donor Assignments</h4>
                                <small class="text-muted">Track the status of all assigned donors</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'assignedTable', 'AssignedDonors')"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'assignedTable', 'AssignedDonors')"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="assignedTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Donor Name</th>
                                        <th>Blood Group</th>
                                        <th>Patient Name</th>
                                        <th style="min-width: 120px;">Match Score</th>
                                        <th>Status</th>
                                        <th>Assigned Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donor in Model.Donors)
                                    {
                                        var progressColor = donor.MatchScore >= 85 ? "#198754" : donor.MatchScore >= 70 ? "#ECBD35" : "#90151C";
                                        <tr>
                                            <td><span class="fw-bold text-theme">#@donor.RequestId.ToString("D4")</span></td>
                                            <td><strong>@donor.DonorName</strong></td>
                                            <td><span class="fw-bold text-blood">@donor.DonorBloodGroup</span></td>
                                            <td>@donor.PatientName</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 8px; border-radius: 50px; background-color: #e9ecef;">
                                                        <div class="progress-bar" role="progressbar" style="width: @donor.MatchScore%; background-color: @progressColor !important;" aria-valuenow="@donor.MatchScore" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="text-muted fw-bold" style="min-width: 35px;">@donor.MatchScore%</small>
                                                </div>
                                            </td>
                                            <td><span class="badge @donor.StatusBadgeClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@donor.StatusDisplay</span></td>
                                            <td><small class="text-muted">@donor.AssignedDate.ToString("dd-MMM-yyyy")</small></td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn"
                                                            data-reqid="@donor.RequestId" data-donorname="@donor.DonorName" data-bg="@donor.DonorBloodGroup"
                                                            data-patient="@donor.PatientName" data-units="@donor.UnitsRequired" data-score="@donor.MatchScore"
                                                            data-status="@donor.StatusDisplay" data-date="@donor.AssignedDate.ToString("dd-MMM-yyyy, hh:mm tt")"
                                                            data-deadline="@(donor.ResponseDeadline?.ToString("dd-MMM-yyyy, hh:mm tt") ?? "N/A")"
                                                            data-scheddate="@(donor.DonationScheduledDate?.ToString("dd-MMM-yyyy") ?? "Not Scheduled")"
                                                            data-notes="@(donor.Notes ?? "No notes")" title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary track-timeline-btn"
                                                            data-reqid="@donor.RequestId" data-status="@donor.Status" title="Track Timeline">
                                                        <i class="bx bx-time-five"></i>
                                                    </button>
                                                    @if (donor.Status == "Pending Response" || donor.Status == "Accepted")
                                                    {
                                                        <button type="button" class="btn btn-outline-danger cancel-assign-btn" data-matchid="@donor.MatchId" data-donorname="@donor.DonorName" title="Cancel Assignment">
                                                            <i class="bx bx-x-circle"></i>
                                                        </button>
                                                    }

                                                    @if (donor.Status == "DonationScheduled" || donor.Status == "Scheduled")
                                                    {
                                                        <button type="button" class="btn btn-outline-success mark-completed-btn"
                                                                data-matchid="@donor.MatchId"
                                                                data-donorname="@donor.DonorName"
                                                                data-reqid="@donor.RequestId"
                                                                data-reqid="@donor.RequestId"
                                                                title="Mark as Completed">
                                                            <i class="bx bx-check-circle"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1 || Model.Donors.Count > 10)
                        {
                            <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                <small class="text-muted" id="paginationSummary">
                                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to <strong>@(Model.CurrentPage * Model.PageSize > Model.TotalCount ? Model.TotalCount : Model.CurrentPage * Model.PageSize)</strong> of <strong>@Model.TotalCount</strong> donors
                                </small>
                                <nav>
                                    <ul class="pagination pagination-n mb-0">
                                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("AssignedDonors", "Hospital", new { page = Model.CurrentPage - 1, SearchQuery = Model.Filters.SearchQuery, Status = Model.Filters.Status, BloodGroup = Model.Filters.BloodGroup, SortBy = Model.Filters.SortBy })"><i class="bi bi-chevron-left"></i> Previous</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("AssignedDonors", "Hospital", new { page = i, SearchQuery = Model.Filters.SearchQuery, Status = Model.Filters.Status, BloodGroup = Model.Filters.BloodGroup, SortBy = Model.Filters.SortBy })">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("AssignedDonors", "Hospital", new { page = Model.CurrentPage + 1, SearchQuery = Model.Filters.SearchQuery, Status = Model.Filters.Status, BloodGroup = Model.Filters.BloodGroup, SortBy = Model.Filters.SortBy })">Next <i class="bi bi-chevron-right"></i></a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bx bx-user text-theme"></i></div>
                    <div><h5 class="modal-title mb-0">Assignment Details</h5><small class="text-muted" id="modalReqId">REQ-XXXX</small></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-theme"><i class="bx bx-user me-2"></i>Donor Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Donor Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_DonorName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-blood mb-0" id="d_BloodGroup">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Match Score</label><p class="form-control-plaintext mb-0" id="d_Score">-</p></div>
                        </div>
                        <h6 class="fw-bold mb-3 mt-4 text-blood"><i class="bx bx-droplet me-2"></i>Request Details</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Patient Name</label><p class="form-control-plaintext mb-0" id="d_Patient">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext mb-0" id="d_Units">-</p></div>
                        </div>
                        <h6 class="fw-bold mb-3 mt-4 text-success-custom"><i class="bx bx-time-five me-2"></i>Assignment Status</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Current Status</label><p class="form-control-plaintext fw-semibold mb-0" id="d_Status">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Assigned Date</label><p class="form-control-plaintext mb-0" id="d_Date">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Response Deadline</label><p class="form-control-plaintext mb-0" id="d_Deadline">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Scheduled Date</label><p class="form-control-plaintext mb-0" id="d_SchedDate">-</p></div>
                            <div class="col-12"><label class="form-label small text-muted mb-1">Notes</label><p class="form-control-plaintext mb-0" id="d_Notes">-</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

<!-- Track Timeline Modal -->
<div class="modal fade" id="timelineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bx bx-time-five text-theme"></i></div>
                    <div><h5 class="modal-title mb-0">Assignment Timeline</h5><small class="text-muted" id="timelineReqId">REQ-XXXX</small></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="timeline" id="timelineContainer"></div>
            </div>
            <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

<!-- Cancel Assignment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #fff5f5; border: 6px solid white;">
                    <i class="bx bx-x-circle" style="font-size: 34px; color: #ff3b3b;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Cancel Assignment?</h4>
                <p class="text-muted mb-3">Are you sure you want to cancel the assignment for <strong id="cancelDonorName"></strong>?<br />This action cannot be undone.</p>
                <input type="hidden" id="cancelMatchId" />
                <div class="mb-3 text-start px-4">
                    <label class="form-label small text-muted">Reason for Cancellation <span class="text-danger">*</span></label>
                    <textarea id="cancelReason" class="form-control rounded-3" rows="3" placeholder="e.g., Donor unreachable, patient recovered, etc."></textarea>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmCancelBtn">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById('searchInput');
            const filterStatus = document.getElementById('filterStatus');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterSortBy = document.getElementById('filterSortBy');
            const resetFiltersBtn = document.getElementById('resetFiltersBtn');

            function filterTable() {
                try {
                    const sVal = (searchInput.value || '').toLowerCase().trim();
                    const statVal = (filterStatus.value || 'all').toLowerCase().trim();
                    const bgVal = (filterBloodGroup.value || 'all').toLowerCase().trim();
                    const sortBy = filterSortBy.value;
                    const tbody = document.querySelector("#assignedTable tbody");
                    const rows = Array.from(tbody.querySelectorAll("tr"));

                    if (sortBy === 'score') {
                        rows.sort((a, b) => {
                            const scoreA = parseInt(a.cells[4].querySelector('small').innerText) || 0;
                            const scoreB = parseInt(b.cells[4].querySelector('small').innerText) || 0;
                            return scoreB - scoreA;
                        });
                    } else if (sortBy === 'oldest') {
                        rows.reverse();
                    }
                    rows.forEach(row => tbody.appendChild(row));

                    let visibleCount = 0;
                    rows.forEach(row => {
                        const reqId = row.cells[0].textContent.toLowerCase();
                        const donorName = row.cells[1].textContent.toLowerCase();
                        const bg = row.cells[2].textContent.toLowerCase();
                        const patient = row.cells[3].textContent.toLowerCase();
                        const status = row.cells[5].querySelector('.badge').textContent.toLowerCase().trim();

                        let show = true;
                        if (sVal && !(reqId.includes(sVal) || donorName.includes(sVal) || patient.includes(sVal))) show = false;
                        if (statVal !== 'all' && status !== statVal) show = false;
                        if (bgVal !== 'all' && bg !== bgVal) show = false;

                        if (show) visibleCount++;
                        row.style.display = show ? "" : "none";
                    });

                    const summaryEl = document.getElementById('paginationSummary');
                    if (summaryEl) summaryEl.innerHTML = `Showing <strong>${visibleCount > 0 ? 1 : 0}</strong> to <strong>${visibleCount}</strong> of <strong>${visibleCount}</strong> donors`;
                } catch (error) { console.error("Filter error:", error); }
            }

            [searchInput, filterStatus, filterBloodGroup, filterSortBy].forEach(el => {
                if (el) { el.addEventListener('input', filterTable); el.addEventListener('change', filterTable); }
            });
            if (resetFiltersBtn) {
                resetFiltersBtn.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (filterStatus) filterStatus.value = 'all';
                    if (filterBloodGroup) filterBloodGroup.value = 'all';
                    if (filterSortBy) filterSortBy.value = 'newest';
                    filterTable();
                });
            }
            filterTable();

            document.getElementById('assignedTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;
                if (target.classList.contains('view-details-btn')) openDetailsModal(target);
                else if (target.classList.contains('track-timeline-btn')) openTimelineModal(target);
                else if (target.classList.contains('cancel-assign-btn')) openCancelModal(target);
            });

            function openDetailsModal(btn) {
                document.getElementById('modalReqId').textContent = `REQ-${String(btn.getAttribute('data-reqid')).padStart(4, '0')}`;
                document.getElementById('d_DonorName').textContent = btn.getAttribute('data-donorname') || '-';
                document.getElementById('d_BloodGroup').textContent = btn.getAttribute('data-bg') || '-';
                document.getElementById('d_Score').textContent = (btn.getAttribute('data-score') || '-') + '%';
                document.getElementById('d_Patient').textContent = btn.getAttribute('data-patient') || '-';
                document.getElementById('d_Units').textContent = (btn.getAttribute('data-units') || '-') + ' units';
                document.getElementById('d_Status').textContent = btn.getAttribute('data-status') || '-';
                document.getElementById('d_Date').textContent = btn.getAttribute('data-date') || '-';
                document.getElementById('d_Deadline').textContent = btn.getAttribute('data-deadline') || '-';
                document.getElementById('d_SchedDate').textContent = btn.getAttribute('data-scheddate') || '-';
                document.getElementById('d_Notes').textContent = btn.getAttribute('data-notes') || '-';
                new bootstrap.Modal(document.getElementById('viewDetailsModal')).show();
            }

            function openTimelineModal(btn) {
                const reqId = btn.getAttribute('data-reqid');
                const status = btn.getAttribute('data-status').toLowerCase();
                document.getElementById('timelineReqId').textContent = `REQ-${String(reqId).padStart(4, '0')}`;

                const steps = ["Donor Matched", "Pending Response", "Donor Accepted", "Donation Scheduled", "Donation Completed"];
                let activeIndex = 0;
                if (status === 'completed') activeIndex = 4;
                else if (status === 'donationscheduled') activeIndex = 3;
                else if (status === 'accepted') activeIndex = 2;
                else if (status === 'pending response') activeIndex = 1;
                else activeIndex = 0;

                let html = '';
                steps.forEach((step, index) => {
                    let itemClass = index < activeIndex ? 'completed' : (index === activeIndex ? 'active' : '');
                    if (status === 'rejected' || status === 'expired' || status === 'cancelled') {
                        if (index === 0) itemClass = 'delayed';
                    }
                    const timeText = index <= activeIndex ? 'Completed' : (index === activeIndex + 1 ? 'In Progress' : 'Pending');
                    const colorClass = index <= activeIndex ? (itemClass === 'delayed' ? 'text-danger-custom' : 'text-success-custom') : 'text-muted';
                    html += `<div class="timeline-item ${itemClass}"><div class="timeline-content"><div class="d-flex justify-content-between align-items-center"><h6 class="mb-0 fw-semibold">${step}</h6><small class="${colorClass} fw-bold">${timeText}</small></div></div></div>`;
                });

                if (status === 'rejected' || status === 'expired' || status === 'cancelled') {
                    html += `<div class="timeline-item delayed"><div class="timeline-content"><div class="d-flex justify-content-between align-items-center"><h6 class="mb-0 fw-semibold text-danger-custom">Assignment ${status === 'cancelled' ? 'Cancelled' : (status === 'expired' ? 'Expired' : 'Rejected')}</h6><small class="text-danger-custom fw-bold">Workflow Stopped</small></div></div></div>`;
                }
                document.getElementById('timelineContainer').innerHTML = html;
                new bootstrap.Modal(document.getElementById('timelineModal')).show();
            }

            function openCancelModal(btn) {
                document.getElementById('cancelMatchId').value = btn.getAttribute('data-matchid');
                document.getElementById('cancelDonorName').textContent = btn.getAttribute('data-donorname');
                document.getElementById('cancelReason').value = '';
                new bootstrap.Modal(document.getElementById('cancelModal')).show();
            }

            document.getElementById('confirmCancelBtn').addEventListener('click', function() {
                const matchId = document.getElementById('cancelMatchId').value;
                const reason = document.getElementById('cancelReason').value;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!reason.trim()) { showNotification('Please provide a reason for cancellation.', 'warning'); return; }

                const btnEl = this;
                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Cancelling...';
                btnEl.disabled = true;

                const formData = new FormData();
                formData.append('matchId', matchId);
                formData.append('reason', reason);
                formData.append('__RequestVerificationToken', token);

                fetch('/Hospital/CancelAssignment', { method: 'POST', body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showNotification(data.message, 'success');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showNotification(data.message || 'Failed to cancel.', 'error');
                            btnEl.innerHTML = 'Confirm Cancel';
                            btnEl.disabled = false;
                        }
                    })
                    .catch(() => {
                        showNotification('An error occurred.', 'error');
                        btnEl.innerHTML = 'Confirm Cancel';
                        btnEl.disabled = false;
                    });
            });

            // Mark as Completed Button Handler
            document.addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('mark-completed-btn')) {
                    openCompleteModal(target);
                }
            });

            function openCompleteModal(btn) {
                const matchId = btn.getAttribute('data-matchid');
                const donorName = btn.getAttribute('data-donorname');
                const reqId = btn.getAttribute('data-reqid');

                // Create modal dynamically
                const modalHtml = `
            <div class="modal fade" id="completeModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content delete-modal position-relative">
                        <div class="delete-icon-wrapper">
                            <div class="icons-box icons-box-success">
                                <i class="bx bx-check-circle"></i>
                            </div>
                        </div>
                        <div class="modal-body text-center pt-5 pb-4">
                            <h4 class="fw-bold">Mark Donation as Completed?</h4>
                            <p class="text-muted mb-3">Confirm that donor <strong>${donorName}</strong> has successfully completed the donation for <strong>REQ-${String(reqId).padStart(4, '0')}</strong>?</p>
                            <input type="hidden" id="completeMatchId" value="${matchId}" />
                            <div class="mb-3 text-start px-4">
                                <label class="form-label small text-muted">Completion Notes (Optional)</label>
                                <textarea id="completeNotes" class="form-control rounded-3" rows="3" placeholder="e.g., Donation completed successfully, donor vitals stable..."></textarea>
                            </div>
                            <div class="d-flex gap-2 justify-content-center mt-4">
                                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmCompleteBtn">
                                    <i class="bx bx-check me-2"></i>Mark Completed
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>`;

                // Remove existing modal if any
                const existingModal = document.getElementById('completeModal');
                if (existingModal) existingModal.remove();

                // Add new modal to body
                document.body.insertAdjacentHTML('beforeend', modalHtml);

                const modal = new bootstrap.Modal(document.getElementById('completeModal'));
                modal.show();

                // Handle confirm button
document.getElementById('confirmCompleteBtn').addEventListener('click', async function() {
    const matchId = document.getElementById('completeMatchId').value;
    const notes = document.getElementById('completeNotes').value;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    console.log("📝 Completing donation - MatchId:", matchId);
    
    const btnEl = this;
    const originalHTML = btnEl.innerHTML;
    btnEl.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
    btnEl.disabled = true;
    
    const formData = new FormData();
    formData.append('id', matchId);
    formData.append('notes', notes);
    formData.append('__RequestVerificationToken', token);
    
    try {
        const response = await fetch('/Hospital/MarkDonationCompleted', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        console.log("📡 Response status:", response.status);
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        console.log("📦 Response data:", data);
        
        if (data.success) {
            showNotification(data.message, 'success');
            modal.hide();
            setTimeout(() => location.reload(), 1500);
        } else {
            showNotification(data.message || 'Failed to mark as completed.', 'error');
            btnEl.innerHTML = originalHTML;
            btnEl.disabled = false;
        }
    } catch (error) {
        console.error('❌ Error:', error);
        showNotification('An error occurred while completing donation. Please check console for details.', 'error');
        btnEl.innerHTML = originalHTML;
        btnEl.disabled = false;
    }
});

                // Clean up modal on hide
                document.getElementById('completeModal').addEventListener('hidden.bs.modal', function() {
                    this.remove();
                });
            }

            window.exportTable = function(type, tableId, fileName) {
                const table = document.getElementById(tableId);
                if (!table) { showNotification('Table not found!', 'error'); return; }
                try {
                    if (type === 'excel') {
                        let csv = [];
                        let rows = table.querySelectorAll("tr");
                        for (let i = 0; i < rows.length; i++) {
                            if (rows[i].style.display === 'none') continue;
                            let row = [], cols = rows[i].querySelectorAll("td, th");
                            for (let j = 0; j < cols.length - 1; j++) {
                                let text = cols[j].innerText.replace(/"/g, '""').trim();
                                row.push('"' + text + '"');
                            }
                            csv.push(row.join(","));
                        }
                        if (csv.length <= 1) { showNotification('No records to export!', 'warning'); return; }
                        let blob = new Blob(["\uFEFF" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' });
                        let link = document.createElement("a");
                        link.href = URL.createObjectURL(blob);
                        link.download = fileName + '.csv';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        showNotification('Excel Export Successful', 'success');
                    } else {
                        if (typeof window.jspdf === 'undefined') { showNotification('PDF library not loaded!', 'error'); return; }
                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF('l', 'mm', 'a4');
                        doc.setFontSize(18);
                        doc.setTextColor(92, 136, 168);
                        doc.text("Assigned Donors Report", 14, 20);
                        doc.setFontSize(10);
                        doc.setTextColor(108, 117, 125);
                        doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 30);

                        const rows = [];
                        table.querySelectorAll("tbody tr").forEach(tr => {
                            if (tr.style.display !== 'none') {
                                const cells = tr.querySelectorAll("td");
                                if (cells.length >= 8) {
                                    rows.push([cells[0].innerText.trim(), cells[1].innerText.trim(), cells[2].innerText.trim(), cells[3].innerText.trim(), cells[4].innerText.trim(), cells[5].innerText.trim(), cells[6].innerText.trim()]);
                                }
                            }
                        });
                        if (rows.length === 0) { showNotification('No records to export!', 'warning'); return; }
                        doc.autoTable({
                            startY: 40,
                            head: [['Request ID', 'Donor Name', 'Blood Group', 'Patient', 'Match Score', 'Status', 'Assigned Date']],
                            body: rows,
                            theme: 'grid',
                            headStyles: { fillColor: [92, 136, 168], textColor: 255, fontSize: 9 },
                            styles: { fontSize: 8, cellPadding: 2, overflow: 'linebreak' }
                        });
                        doc.save(`${fileName}.pdf`);
                        showNotification('PDF Export Successful', 'success');
                    }
                } catch (error) {
                    console.error("Export Error:", error);
                    showNotification('Export failed: ' + error.message, 'error');
                }
            };

            function showNotification(message, type = "success") {
                const old = document.getElementById("customNotification");
                if (old) old.remove();
                const notification = document.createElement("div");
                notification.id = "customNotification";
                let bg = "#5C88A8", icon = "✔";
                if (type === "error") { bg = "#90151C"; icon = "✖"; }
                else if (type === "warning") { bg = "#ECBD35"; icon = "⚠"; }

                notification.innerHTML = `<div style="display: flex; align-items: center; gap: 12px; padding: 16px 24px; background: ${bg}; color: #ffffff; border-radius: 12px; box-shadow: none; font-family: system-ui, -apple-system, sans-serif; font-weight: 600; font-size: 15px; z-index: 9999999999; border: 1px solid rgba(255,255,255,0.1);"><span style="font-size: 20px; line-height: 1;">${icon}</span><span>${message}</span></div>`;
                notification.style.cssText = `position: fixed !important; top: 20px !important; right: 20px !important; z-index: 2147483647 !important; margin: 0 !important; padding: 0 !important; pointer-events: auto !important; animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;`;

                if (!document.getElementById('notification-anim-style')) {
                    const style = document.createElement('style');
                    style.id = 'notification-anim-style';
                    style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                    document.head.appendChild(style);
                }
                document.documentElement.appendChild(notification);
                setTimeout(() => {
                    notification.style.transition = "all 0.4s ease";
                    notification.style.opacity = "0";
                    notification.style.transform = "translateX(400px)";
                    notification.style.pointerEvents = "none";
                    setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
                }, 6000);
            }
        });
    </script>
}