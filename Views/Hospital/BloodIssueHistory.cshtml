@model Khoon_e_Hayat.ViewModels.BloodIssueHistoryViewModel
@{
    ViewData["Title"] = "Blood Issue History";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
}

@Html.AntiForgeryToken()

<style>
    /* Strict Theme Colors & Card Styling (Matches Blood Collection History Exactly) */
    .text-blood {
        color: #90151C !important;
    }

    .text-theme {
        color: #5C88A8 !important;
    }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }

        .btn-theme:hover {
            background-color: #4a6d87;
            border-color: #4a6d87;
            color: #fff;
        }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    #viewDetailsModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Blood Issue History</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-box-seam text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Issues</h6>
                                <small class="text-muted">@Model.TotalIssues.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet-half text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Units</h6>
                                <small class="text-muted">@Model.TotalUnitsIssued.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-calendar-day text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Today</h6>
                                <small class="text-muted">@Model.TodayIssues.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-calendar-month text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">This Month</h6>
                                <small class="text-muted">@Model.MonthIssues.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Successful</h6>
                                <small class="text-muted">@Model.SuccessfulDeliveries.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-trophy text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Most Issued</h6>
                                <small class="text-muted fw-bold text-blood">
                                    @(!string.IsNullOrEmpty(Model.MostIssuedBloodGroup) && Model.MostIssuedBloodGroup != "N/A" ? Model.MostIssuedBloodGroup : "N/A")
                                </small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Search Issue ID, Blood Group, Hospital, Issued By..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var bg in Model.AvailableBloodGroups)
                                {
                                    <option value="@bg" selected="@(Model.Filters?.BloodGroup == bg)">@bg</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">From Date</label>
                            <input type="date" id="filterDateFrom" class="form-control form-control-sm rounded-pill" value="@(Model.Filters?.DateFrom?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">To Date</label>
                            <input type="date" id="filterDateTo" class="form-control form-control-sm rounded-pill" value="@(Model.Filters?.DateTo?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Sort By</label>
                            <select id="filterSortBy" class="form-select form-select-sm rounded-pill">
                                <option value="newest" selected="@(Model.Filters?.SortBy == "newest")">Newest</option>
                                <option value="oldest" selected="@(Model.Filters?.SortBy == "oldest")">Oldest</option>
                                <option value="bloodgroup" selected="@(Model.Filters?.SortBy == "bloodgroup")">Blood Group</option>
                                <option value="units" selected="@(Model.Filters?.SortBy == "units")">Units Issued</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-pill w-100" title="Reset all filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                @if (!Model.Issues.Any())
                {
                    <!-- Empty State -->
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-box-seam fs-1 d-block mb-2 text-blood"></i>
                                <h5 class="fw-semibold">No Issue Records Found</h5>
                                <p class="mb-3">Your hospital doesn't have any blood issue records yet.</p>
                                <a asp-controller="Hospital" asp-action="BloodInventory" class="btn btn-theme rounded-pill px-4">
                                    <i class="bi bi-arrow-left me-2"></i> Back to Inventory
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Table with Data -->
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">Blood Issue History</h4>
                                <small class="text-muted">View and manage all blood units issued by the hospital</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'issueTable', 'BloodIssueHistory')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'issueTable', 'BloodIssueHistory')">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="issueTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Issue ID</th>
                                        <th>Blood Group</th>
                                        <th>Units Issued</th>
                                        <th>Issue Date</th>
                                        <th>Issued By</th>
                                        <th>Hospital</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Issues)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold text-theme">#@item.IssueId.ToString("D4")</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-blood">@item.BloodGroup</span>
                                            </td>
                                            <td>@item.UnitsIssued units</td>
                                            <td>@item.IssueDate.ToString("dd-MMM-yyyy, hh:mm tt")</td>
                                            <td>@item.IssuedBy</td>
                                            <td>@item.HospitalName</td>
                                            <td>
                                                @if (item.Status == "Completed")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Completed</span>
                                                }
                                                else if (item.Status == "Delivered")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary">Delivered</span>
                                                }
                                                else if (item.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">Pending</span>
                                                }
                                                else if (item.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Cancelled</span>
                                                }
                                                else if (item.Status == "Rejected" || item.Status == "Failed")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">@item.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">@item.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn"
                                                            data-id="@item.IssueId"
                                                            data-bg="@item.BloodGroup"
                                                            data-units="@item.UnitsIssued"
                                                            data-date="@item.IssueDate.ToString("yyyy-MM-dd HH:mm")"
                                                            data-issuedby="@item.IssuedBy"
                                                            data-hospital="@item.HospitalName"
                                                            data-status="@item.Status"
                                                            data-notes="@(item.Notes ?? "No additional notes")"
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                <small class="text-muted">
                                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                                    <strong>@Model.TotalCount</strong> records
                                </small>
                                <nav>
                                    <ul class="pagination pagination-n mb-0">
                                        @{
                                            var prevDisabled = Model.CurrentPage == 1 ? "disabled" : "";
                                            var nextDisabled = Model.CurrentPage == Model.TotalPages ? "disabled" : "";

                                            var routeValues = new Dictionary<string, object>
                                            {
                                                { "Filters.SearchQuery", Model.Filters?.SearchQuery },
                                                { "Filters.BloodGroup", Model.Filters?.BloodGroup ?? "all" },
                                                { "Filters.DateFrom", Model.Filters?.DateFrom?.ToString("yyyy-MM-dd") },
                                                { "Filters.DateTo", Model.Filters?.DateTo?.ToString("yyyy-MM-dd") },
                                                { "Filters.SortBy", Model.Filters?.SortBy ?? "newest" }
                                            };
                                        }
                                        <li class="page-item @prevDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage - 1;
                                            }
                                            <a class="page-link" href="@Url.Action("BloodIssueHistory", routeValues)">
                                                <i class="bi bi-chevron-left"></i> Previous
                                            </a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            var active = i == Model.CurrentPage ? "active" : "";
                                            routeValues["page"] = i;
                                            <li class="page-item @active">
                                                <a class="page-link" href="@Url.Action("BloodIssueHistory", routeValues)">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @nextDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage + 1;
                                            }
                                            <a class="page-link" href="@Url.Action("BloodIssueHistory", routeValues)">
                                                Next <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-box text-theme"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Issue Details</h5>
                        <small class="text-muted" id="modalIssueId">ISS-XXXX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-blood mb-3"><i class="bx bx-droplet me-2"></i>Blood Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Blood Group</label>
                                <p class="form-control-plaintext fw-bold text-blood mb-0" id="d_BloodGroup">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Units Issued</label>
                                <p class="form-control-plaintext mb-0" id="d_Units">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Issue Date</label>
                                <p class="form-control-plaintext mb-0" id="d_IssueDate">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Status</label>
                                <p class="form-control-plaintext mb-0" id="d_StatusWrapper">-</p>
                            </div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-buildings me-2"></i>Hospital Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Issued By</label>
                                <p class="form-control-plaintext mb-0" id="d_IssuedBy">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Hospital</label>
                                <p class="form-control-plaintext mb-0" id="d_Hospital">-</p>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1">Notes</label>
                                <p class="form-control-plaintext mb-0 fst-italic" id="d_Notes">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        console.log("🚀 Blood Issue History Script Loaded Successfully!");

        // ==================== 1. DATE PARSING HELPER ====================
        function parseIssueDate(dateStr) {
            if (!dateStr) return new Date(0);
            const parts = dateStr.split(',');
            if (parts.length < 2) return new Date(dateStr);

            const datePart = parts[0].trim(); // "21-Jul-2026"
            const timePart = parts[1].trim(); // "01:30 PM"

            const [day, monthStr, year] = datePart.split('-');
            const months = { 'jan': 0, 'feb': 1, 'mar': 2, 'apr': 3, 'may': 4, 'jun': 5, 'jul': 6, 'aug': 7, 'sep': 8, 'oct': 9, 'nov': 10, 'dec': 11 };
            const month = months[monthStr.toLowerCase()] || 0;

            let [hours, minutes] = timePart.split(':');
            hours = parseInt(hours, 10);
            const ampm = timePart.slice(-2).toUpperCase();
            if (ampm === 'PM' && hours < 12) hours += 12;
            if (ampm === 'AM' && hours === 12) hours = 0;

            return new Date(parseInt(year, 10), month, parseInt(day, 10), hours, parseInt(minutes, 10));
        }

        function formatIssueDate(dateStr) {
            if (!dateStr) return '-';
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;

            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            let hours = d.getHours();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            const minutes = d.getMinutes().toString().padStart(2, '0');

            return `${d.getDate().toString().padStart(2, '0')}-${months[d.getMonth()]}-${d.getFullYear()}, ${hours}:${minutes} ${ampm}`;
        }

        function getStatusBadgeHtml(status) {
            const s = (status || '').toLowerCase();
            let badgeClass = 'bg-secondary-subtle text-secondary';

            if (s === 'completed') badgeClass = 'bg-success-subtle text-success';
            else if (s === 'delivered') badgeClass = 'bg-primary-subtle text-primary';
            else if (s === 'pending') badgeClass = 'bg-warning-subtle text-warning';
            else if (s === 'cancelled') badgeClass = 'bg-secondary-subtle text-secondary';
            else if (s === 'rejected' || s === 'failed') badgeClass = 'bg-danger-subtle text-danger';

            const displayStatus = status.charAt(0).toUpperCase() + status.slice(1).toLowerCase();
            return `<span class="badge ${badgeClass}">${displayStatus}</span>`;
        }

        // ==================== 2. FILTER & SORT LOGIC ====================
        function applyFilters() {
            try {
                const sVal = (document.getElementById('searchInput').value || '').toLowerCase().trim();
                const bgVal = (document.getElementById('filterBloodGroup').value || 'all').toLowerCase().trim();
                const dateFromVal = document.getElementById('filterDateFrom').value;
                const dateToVal = document.getElementById('filterDateTo').value;
                const sortBy = document.getElementById('filterSortBy').value;

                const tbody = document.querySelector("#issueTable tbody");
                const rows = Array.from(tbody.querySelectorAll("tr"));

                // Filter
                rows.forEach(row => {
                    const issueId = (row.cells[0]?.textContent || '').toLowerCase().trim();
                    const bg = (row.cells[1]?.textContent || '').toLowerCase().trim();
                    const dateStr = (row.cells[3]?.textContent || '').trim();
                    const issuedBy = (row.cells[4]?.textContent || '').toLowerCase().trim();
                    const hospital = (row.cells[5]?.textContent || '').toLowerCase().trim();
                    const status = (row.cells[6]?.textContent || '').toLowerCase().trim();

                    let show = true;

                    // 1. Search Filter
                    if (sVal && !(issueId.includes(sVal) || bg.includes(sVal) || hospital.includes(sVal) || issuedBy.includes(sVal) || status.includes(sVal))) {
                        show = false;
                    }
                    // 2. Blood Group Filter
                    if (show && bgVal !== 'all' && bg !== bgVal) {
                        show = false;
                    }
                    // 3. Date Range Filter
                    if (show && (dateFromVal || dateToVal)) {
                        const rowDate = parseIssueDate(dateStr);
                        if (dateFromVal) {
                            const fromDate = new Date(dateFromVal);
                            fromDate.setHours(0, 0, 0, 0);
                            if (rowDate < fromDate) show = false;
                        }
                        if (dateToVal) {
                            const toDate = new Date(dateToVal);
                            toDate.setHours(23, 59, 59, 999);
                            if (rowDate > toDate) show = false;
                        }
                    }

                    row.style.display = show ? "" : "none";
                });

                // Sort visible rows
                sortTable(sortBy);

                // Update pagination text dynamically
                updatePaginationText();

            } catch (error) {
                console.error("Error in applyFilters:", error);
            }
        }

        function sortTable(sortBy) {
            const tbody = document.querySelector("#issueTable tbody");
            const rows = Array.from(tbody.querySelectorAll("tr"));

            rows.sort((a, b) => {
                if (sortBy === 'newest') {
                    return parseIssueDate(b.cells[3].textContent) - parseIssueDate(a.cells[3].textContent);
                } else if (sortBy === 'oldest') {
                    return parseIssueDate(a.cells[3].textContent) - parseIssueDate(b.cells[3].textContent);
                } else if (sortBy === 'bloodgroup') {
                    return a.cells[1].textContent.localeCompare(b.cells[1].textContent);
                } else if (sortBy === 'units') {
                    const unitsA = parseInt(a.cells[2].textContent) || 0;
                    const unitsB = parseInt(b.cells[2].textContent) || 0;
                    return unitsB - unitsA; // Descending
                }
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }

        function updatePaginationText() {
            const visibleRows = Array.from(document.querySelectorAll("#issueTable tbody tr")).filter(r => r.style.display !== 'none');
            const count = visibleRows.length;
            const start = count > 0 ? 1 : 0;
            const end = count;

            const summaryEl = document.querySelector('.pagination-wrapper-n small');
            if (summaryEl) {
                summaryEl.innerHTML = `Showing <strong>${start}</strong> to <strong>${end}</strong> of <strong>${count}</strong> records`;
            }
        }

        // ==================== 3. EVENT LISTENERS ====================
        document.addEventListener('DOMContentLoaded', function() {
            // Attach filter listeners
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterDateFrom = document.getElementById('filterDateFrom');
            const filterDateTo = document.getElementById('filterDateTo');
            const filterSortBy = document.getElementById('filterSortBy');
            const resetFiltersBtn = document.getElementById('resetFiltersBtn');

            [searchInput, filterBloodGroup, filterDateFrom, filterDateTo, filterSortBy].forEach(el => {
                if (el) {
                    el.addEventListener('input', applyFilters);
                    el.addEventListener('change', applyFilters);
                }
            });

            if (resetFiltersBtn) {
                resetFiltersBtn.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (filterBloodGroup) filterBloodGroup.value = 'all';
                    if (filterDateFrom) filterDateFrom.value = '';
                    if (filterDateTo) filterDateTo.value = '';
                    if (filterSortBy) filterSortBy.value = 'newest';
                    applyFilters();
                });
            }

            // Table click delegation for View Details
            const table = document.getElementById('issueTable');
            if (table) {
                table.addEventListener('click', function(e) {
                    const viewBtn = e.target.closest('.view-details-btn');
                    if (viewBtn) {
                        openViewDetailsFromData(viewBtn);
                    }
                });
            }
        });

        // ==================== 4. VIEW DETAILS MODAL ====================
        function openViewDetailsFromData(btn) {
            const id = btn.getAttribute('data-id');
            const bg = btn.getAttribute('data-bg');
            const units = btn.getAttribute('data-units');
            const date = btn.getAttribute('data-date');
            const issuedBy = btn.getAttribute('data-issuedby');
            const hospital = btn.getAttribute('data-hospital');
            const status = btn.getAttribute('data-status');
            const notes = btn.getAttribute('data-notes');

            document.getElementById('modalIssueId').textContent = 'ISS-' + String(id).padStart(4, '0');
            document.getElementById('d_BloodGroup').textContent = bg || '-';
            document.getElementById('d_Units').textContent = (units || '-') + ' units';
            document.getElementById('d_IssueDate').textContent = formatIssueDate(date);
            document.getElementById('d_StatusWrapper').innerHTML = getStatusBadgeHtml(status);
            document.getElementById('d_IssuedBy').textContent = issuedBy || '-';
            document.getElementById('d_Hospital').textContent = hospital || '-';
            document.getElementById('d_Notes').textContent = (notes && notes !== "No additional notes") ? notes : 'No additional notes';

            const modalElement = document.getElementById('viewDetailsModal');
            if (typeof bootstrap !== 'undefined') {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        }

        // ==================== 5. ENHANCED NOTIFICATION FUNCTION ====================
        function showNotification(message, type = "success") {
            const old = document.getElementById("customNotification");
            if (old) old.remove();

            const notification = document.createElement("div");
            notification.id = "customNotification";

            let bg = "#5C88A8";
            let icon = "✔";

            if (type === "error") {
                bg = "#dc3545";
                icon = "✖";
            } else if (type === "warning") {
                bg = "#ffc107";
                icon = "⚠";
            }

            notification.innerHTML = `
                        <div style="
                            display: flex; align-items: center; gap: 12px; padding: 16px 24px;
                            background: ${bg}; color: #ffffff; border-radius: 12px;
                            box-shadow: 0 8px 24px rgba(0,0,0,0.15); font-family: system-ui, -apple-system, sans-serif;
                            font-weight: 600; font-size: 15px; z-index: 9999999999; border: 1px solid rgba(255,255,255,0.1);
                        ">
                            <span style="font-size: 20px; line-height: 1;">${icon}</span>
                            <span>${message}</span>
                        </div>
                    `;

            notification.style.cssText = `
                        position: fixed !important; top: 20px !important; right: 20px !important;
                        z-index: 2147483647 !important; margin: 0 !important; padding: 0 !important;
                        pointer-events: auto !important; animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
                    `;

            if (!document.getElementById('notification-anim-style')) {
                const style = document.createElement('style');
                style.id = 'notification-anim-style';
                style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                document.head.appendChild(style);
            }

            document.documentElement.appendChild(notification);

            setTimeout(() => {
                notification.style.transition = "all 0.4s ease";
                notification.style.opacity = "0";
                notification.style.transform = "translateX(400px)";
                notification.style.pointerEvents = "none";
                setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
            }, 3000);
        }

        // ==================== 6. FULL EXPORT FUNCTION (Filtered Only) ====================
        window.exportTable = function(type, tableId, fileName) {
            const table = document.getElementById(tableId);
            if (!table) {
                showNotification('Table not found!', 'error');
                return;
            }

            try {
                if (type === 'excel') {
                    let csv = [];
                    let rows = table.querySelectorAll("tr");

                    for (let i = 0; i < rows.length; i++) {
                        if (rows[i].style.display === 'none') continue;

                        let row = [];
                        let cols = rows[i].querySelectorAll("td, th");

                        // Exclude the last column (Actions)
                        for (let j = 0; j < cols.length - 1; j++) {
                            let cellText = cols[j].innerText.replace(/"/g, '""').trim();
                            cellText = cellText.replace(/\s+/g, ' ');
                            row.push(`"${cellText}"`);
                        }
                        csv.push(row.join(","));
                    }

                    let csvContent = "\uFEFF" + csv.join("\n");
                    let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                    let url = URL.createObjectURL(blob);
                    let link = document.createElement("a");
                    link.setAttribute("href", url);
                    link.setAttribute("download", `${fileName}.csv`);
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);

                    showNotification('Excel Export Successful', 'success');

                } else if (type === 'pdf') {
                    if (typeof window.jspdf === 'undefined') {
                        showNotification('PDF library not loaded!', 'error');
                        return;
                    }

                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF('l', 'mm', 'a4');

                    doc.setFontSize(18);
                    doc.setTextColor(92, 136, 168); // #5C88A8
                    doc.text("Blood Issue History Report", 14, 20);

                    doc.setFontSize(10);
                    doc.setTextColor(108, 117, 125);
                    doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 30);

                    const rows = [];
                    table.querySelectorAll("tbody tr").forEach(tr => {
                        if (tr.style.display !== 'none') {
                            const cells = tr.querySelectorAll("td");
                            if (cells.length >= 7) {
                                rows.push([
                                    cells[0].innerText.trim(),
                                    cells[1].innerText.trim(),
                                    cells[2].innerText.trim(),
                                    cells[3].innerText.trim(),
                                    cells[4].innerText.trim(),
                                    cells[5].innerText.trim(),
                                    cells[6].innerText.trim()
                                ]);
                            }
                        }
                    });

                    doc.autoTable({
                        startY: 40,
                        head: [['Issue ID', 'Blood Group', 'Units', 'Issue Date', 'Issued By', 'Hospital', 'Status']],
                        body: rows,
                        theme: 'grid',
                        headStyles: { fillColor: [92, 136, 168], textColor: 255, fontSize: 10 },
                        styles: { fontSize: 8, cellPadding: 2, overflow: 'linebreak' }
                    });

                    doc.save(`${fileName}.pdf`);
                    showNotification('PDF Export Successful', 'success');
                }
            } catch (error) {
                console.error("💥 Export Error:", error);
                showNotification('Export failed: ' + error.message, 'error');
            }
        };
    </script>
}