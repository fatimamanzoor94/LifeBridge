@model Khoon_e_Hayat.ViewModels.BloodInventoryViewModel
@{
    ViewData["Title"] = "Blood Inventory";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Blood Inventory</h4>
                <button class="btn rounded-pill px-4"
                        style="background-color:#5C88A8; border-color:#5C88A8; color:#fff; box-shadow:none;"
                        data-bs-toggle="modal"
                        data-bs-target="#addBloodModal">
                    Add blood stock
                </button>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Blood Units</h6>
                                <small class="text-muted">@Model.TotalUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-collection text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Blood Groups</h6>
                                <small class="text-muted">@Model.AvailableBloodGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Low Stock</h6>
                                <small class="text-muted">@Model.LowStockUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-x-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Out of Stock</h6>
                                <small class="text-muted">@Model.OutOfStockUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-clock-history text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Expiring Soon</h6>
                                <small class="text-muted">@Model.ExpiringSoonUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-calendar-x text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Expired</h6>
                                <small class="text-muted">@Model.ExpiredUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Blood group, status, quantity..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var bg in Model.AvailableBloodGroupsList)
                                {
                                    <option value="@bg">@bg</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Available">Available</option>
                                <option value="Low Stock">Low Stock</option>
                                <option value="Critical">Critical</option>
                                <option value="Expired">Expired</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                @if (!Model.Inventory.Any())
                {
                    <!-- Empty State - NO EXPORT BUTTONS HERE -->
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-droplet-half fs-1 d-block mb-2 text-danger"></i>
                                <h5 class="fw-semibold">No Blood Inventory Found</h5>
                                <p class="mb-3">Your hospital doesn't have any blood stock yet.</p>
                                <button class="btn rounded-pill px-4" style="background-color:#5C88A8; border-color:#5C88A8; color:#fff;" data-bs-toggle="modal" data-bs-target="#addBloodModal">
                                    <i class="bi bi-plus-circle me-2"></i>Add Blood Stock
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Data Exists - SHOW EXPORT BUTTONS -->
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">Blood Inventory</h4>
                                <small class="text-muted">Manage and track hospital blood stock</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'inventoryTable', 'BloodInventory')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'inventoryTable', 'BloodInventory')">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="inventoryTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Blood Group</th>
                                        <th>Available Units</th>
                                        <th>Collection Date</th>
                                        <th>Expiry Date</th>
                                        <th>Status</th>
                                        <th>Last Updated</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Inventory)
                                    {
                                        var displayStatus = item.Status == "LOW" ? "Low Stock" : item.Status;
                                        var daysRemaining = (item.ExpiryDate.Date - DateTime.Today).Days;
                                        string expiryText = item.ExpiryDate.ToString("dd-MMM-yyyy");
                                        string badgeClass = "";

                                        if (item.Status == "Expired" || daysRemaining < 0)
                                        {
                                            expiryText = "Expired";
                                            badgeClass = "bg-secondary-subtle text-secondary";
                                        }
                                        else if (daysRemaining == 0)
                                        {
                                            expiryText = "Expiring Today";
                                            badgeClass = "bg-warning-subtle text-warning";
                                        }
                                        else if (daysRemaining <= 7)
                                        {
                                            expiryText = $"Expiring in {daysRemaining} Days";
                                            badgeClass = "bg-warning-subtle text-warning";
                                        }

                                        <tr>
                                            <td><span class="fw-bold text-danger">@item.BloodGroup</span></td>
                                            <td>@item.Quantity units</td>
                                            <td>@item.CollectionDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(badgeClass))
                                                {
                                                    <span class="badge @badgeClass">@expiryText</span>
                                                }
                                                else
                                                {
                                                    @expiryText
                                                }
                                            </td>
                                            <td>
                                                @if (displayStatus == "Available")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Available</span>
                                                }
                                                else if (displayStatus == "Low Stock")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">Low Stock</span>
                                                }
                                                else if (displayStatus == "Critical")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Critical</span>
                                                }
                                                else if (displayStatus == "Expired")
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Expired</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">@displayStatus</span>
                                                }
                                            </td>
                                            <td>@item.UpdatedAt.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn"
                                                            data-inventoryid="@item.InventoryId"
                                                            data-bg="@item.BloodGroup"
                                                            data-quantity="@item.Quantity"
                                                            data-collection="@item.CollectionDate.ToString("yyyy-MM-dd")"
                                                            data-expiry="@item.ExpiryDate.ToString("yyyy-MM-dd")"
                                                            data-status="@displayStatus"
                                                            data-updated="@item.UpdatedAt.ToString("dd-MMM-yyyy, hh:mm tt")"
                                                            data-days="@daysRemaining"
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary edit-stock-btn"
                                                            data-inventoryid="@item.InventoryId"
                                                            data-bg="@item.BloodGroup"
                                                            data-quantity="@item.Quantity"
                                                            data-expiry="@item.ExpiryDate.ToString("yyyy-MM-dd")"
                                                            title="Edit Stock">
                                                        <i class="bx bx-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger delete-stock-btn"
                                                            data-inventoryid="@item.InventoryId"
                                                            title="Delete">
                                                        <i class="bx bx-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- ==================== PAGINATION ==================== -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                <small class="text-muted">
                                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                                    <strong>@Model.TotalCount</strong> records
                                </small>
                                <nav>
                                    <ul class="pagination pagination-n mb-0">
                                        @{
                                            var prevDisabled = Model.CurrentPage == 1 ? "disabled" : "";
                                            var nextDisabled = Model.CurrentPage == Model.TotalPages ? "disabled" : "";

                                            var routeValues = new Dictionary<string, object>
                                            {
                                                { "Filters.SearchQuery", Model.Filters?.SearchQuery },
                                                { "Filters.BloodGroup", Model.Filters?.BloodGroup ?? "all" },
                                                { "Filters.Status", Model.Filters?.Status ?? "all" },
                                                { "Filters.SortBy", Model.Filters?.SortBy ?? "newest" }
                                            };
                                        }
                                        <li class="page-item @prevDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage - 1;
                                            }
                                            <a class="page-link" href="@Url.Action("BloodInventory", routeValues)">
                                                <i class="bi bi-chevron-left"></i> Previous
                                            </a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            var active = i == Model.CurrentPage ? "active" : "";
                                            routeValues["page"] = i;
                                            <li class="page-item @active">
                                                <a class="page-link" href="@Url.Action("BloodInventory", routeValues)">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @nextDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage + 1;
                                            }
                                            <a class="page-link" href="@Url.Action("BloodInventory", routeValues)">
                                                Next <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==================== ADD BLOOD STOCK MODAL ==================== -->
<div class="modal fade" id="addBloodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-droplet text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Add Blood Stock</h5>
                        <small class="text-muted">Add new blood units to inventory</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="addBloodForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Blood Group <span class="text-danger">*</span></label>
                            <select name="BloodGroup" class="form-select" required>
                                <option value="">Select Blood Group</option>
                                @foreach (var bg in Model.AvailableBloodGroupsList)
                                {
                                    <option value="@bg">@bg</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Quantity (Units) <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" class="form-control" min="1" required placeholder="Enter quantity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Collection Date <span class="text-danger">*</span></label>
                            <input type="date" name="CollectionDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Expiry Date <span class="text-danger">*</span></label>
                            <input type="date" name="ExpiryDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="alert alert-danger d-none mt-3" id="addErrorMessage"></div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn rounded-pill px-4" style="background-color:#5C88A8; border-color:#5C88A8; color:#fff;" onclick="submitAddForm()">
                    <i class="bi bi-check-circle me-2"></i>Add Stock
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== EDIT BLOOD STOCK MODAL ==================== -->
<div class="modal fade" id="editBloodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-pencil text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Edit Blood Stock</h5>
                        <small class="text-muted">Update blood inventory details</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="editBloodForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="InventoryId" id="editInventoryId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <input type="text" class="form-control" id="editBloodGroup" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Quantity (Units) <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" id="editQuantity" class="form-control" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Expiry Date <span class="text-danger">*</span></label>
                            <input type="date" name="ExpiryDate" id="editExpiryDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="alert alert-danger d-none mt-3" id="editErrorMessage"></div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn rounded-pill px-4" style="background-color:#5C88A8; border-color:#5C88A8; color:#fff;" onclick="submitEditForm()">
                    <i class="bi bi-check-circle me-2"></i>Update Stock
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DELETE CONFIRMATION MODAL ==================== -->
<div class="modal fade" id="deleteBloodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #fff5f5; border: 6px solid white;">
                    <i class="fas fa-trash-alt" style="color: #dc3545;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Delete Blood Stock?</h4>
                <p class="text-muted">You are about to delete this blood stock entry.<br />This action cannot be undone.</p>
                <input type="hidden" id="deleteInventoryId" />
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmDeleteBtn">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-droplet text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Blood Stock Details</h5>
                        <small class="text-muted" id="modalBloodGroup">Blood Group</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-danger mb-3"><i class="bx bx-droplet me-2"></i>Blood Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Blood Group</label>
                                <p class="form-control-plaintext fw-bold text-danger mb-0" id="d_BloodGroup">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Available Units</label>
                                <p class="form-control-plaintext mb-0" id="d_Quantity">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Collection Date</label>
                                <p class="form-control-plaintext mb-0" id="d_CollectionDate">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Expiry Date</label>
                                <p class="form-control-plaintext mb-0" id="d_ExpiryDate">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Remaining Days</label>
                                <p class="form-control-plaintext mb-0" id="d_RemainingDays">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Last Updated</label>
                                <p class="form-control-plaintext mb-0" id="d_Updated">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icons-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icons-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    #viewDetailsModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    /* ==================== PAGINATION STYLES ==================== */
    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        // Global variables
        let currentInventoryId = null;
        let deleteModalInstance = null;
        let editModalInstance = null;

        document.addEventListener("DOMContentLoaded", function() {
            deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteBloodModal'));
            editModalInstance = new bootstrap.Modal(document.getElementById('editBloodModal'));

            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterStatus = document.getElementById('filterStatus');

            // ==================== FILTER TABLE ====================
            function filterTable() {
                const sVal = searchInput.value.toLowerCase().trim();
                const bgVal = filterBloodGroup.value.toLowerCase().trim();
                const statVal = filterStatus.value.toLowerCase().trim();
                const rows = document.querySelectorAll("#inventoryTable tbody tr");

                rows.forEach(row => {
                    const bg = row.cells[0].textContent.toLowerCase().trim();
                    const quantity = row.cells[1].textContent.toLowerCase().trim();
                    const collectionDate = row.cells[2].textContent.toLowerCase().trim();
                    const expiryDate = row.cells[3].textContent.toLowerCase().trim();
                    const status = row.cells[4].textContent.toLowerCase().trim();

                    const normalizedStatus = status === 'low' ? 'low stock' : status;
                    const normalizedStatVal = statVal === 'low' ? 'low stock' : statVal;

                    let show = true;
                    if (sVal && !(bg.includes(sVal) || normalizedStatus.includes(sVal) || quantity.includes(sVal) || collectionDate.includes(sVal) || expiryDate.includes(sVal))) {
                        show = false;
                    }
                    if (bgVal !== 'all' && bg !== bgVal) show = false;
                    if (normalizedStatVal !== 'all' && normalizedStatus !== normalizedStatVal) show = false;

                    row.style.display = show ? "" : "none";
                });
            }

            [searchInput, filterBloodGroup, filterStatus].forEach(el => {
                el.addEventListener('input', filterTable);
                el.addEventListener('change', filterTable);
            });

            // ==================== EVENT DELEGATION ====================
            document.getElementById('inventoryTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target);
                } else if (target.classList.contains('edit-stock-btn')) {
                    openEditModal(target);
                } else if (target.classList.contains('delete-stock-btn')) {
                    openDeleteModal(target.getAttribute('data-inventoryid'));
                }
            });
        });

        // ==================== GLOBAL FUNCTIONS ====================

        function openViewDetailsModal(btn) {
            document.getElementById('modalBloodGroup').textContent = btn.getAttribute('data-bg') || 'Unknown';
            document.getElementById('d_BloodGroup').textContent = btn.getAttribute('data-bg') || '-';
            document.getElementById('d_Quantity').textContent = (btn.getAttribute('data-quantity') || '-') + ' units';
            document.getElementById('d_CollectionDate').textContent = btn.getAttribute('data-collection') || '-';
            document.getElementById('d_ExpiryDate').textContent = btn.getAttribute('data-expiry') || '-';
            document.getElementById('d_Updated').textContent = btn.getAttribute('data-updated') || '-';

            const days = parseInt(btn.getAttribute('data-days'));
            let daysText = '-';
            if (isNaN(days)) {
                daysText = 'Unknown';
            } else if (days < 0) {
                daysText = 'Expired';
            } else if (days === 0) {
                daysText = 'Expiring Today';
            } else {
                daysText = `${days} Days`;
            }
            document.getElementById('d_RemainingDays').textContent = daysText;

            const modal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
            modal.show();
        }

        function openEditModal(btn) {
            document.getElementById('editInventoryId').value = btn.getAttribute('data-inventoryid');
            document.getElementById('editBloodGroup').value = btn.getAttribute('data-bg');
            document.getElementById('editQuantity').value = btn.getAttribute('data-quantity');
            document.getElementById('editExpiryDate').value = btn.getAttribute('data-expiry');
            document.getElementById('editErrorMessage').classList.add('d-none');

            if (!editModalInstance) {
                editModalInstance = new bootstrap.Modal(document.getElementById('editBloodModal'));
            }
            editModalInstance.show();
        }

        async function submitEditForm() {
            const form = document.getElementById('editBloodForm');
            const formData = new FormData(form);
            const errorDiv = document.getElementById('editErrorMessage');

            const quantityStr = formData.get('Quantity');
            const quantity = parseInt(quantityStr);
            const expiryDateStr = formData.get('ExpiryDate');

            if (isNaN(quantity) || quantity < 0) {
                errorDiv.textContent = 'Quantity cannot be negative.';
                errorDiv.classList.remove('d-none'); return;
            }
            if (!expiryDateStr) {
                errorDiv.textContent = 'Please select an expiry date.';
                errorDiv.classList.remove('d-none'); return;
            }

            const expiryDate = new Date(expiryDateStr);
            const today = new Date(); today.setHours(0, 0, 0, 0);

            if (expiryDate < today) {
                errorDiv.textContent = 'Expiry date cannot be in the past.';
                errorDiv.classList.remove('d-none'); return;
            }

            errorDiv.classList.add('d-none');
            const token = form.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Hospital/EditBloodStock', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token.value },
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    showNotification(data.message, 'success');
                    if (editModalInstance) editModalInstance.hide();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    errorDiv.textContent = data.message || 'Failed to update';
                    errorDiv.classList.remove('d-none');
                }
            } catch (error) {
                errorDiv.textContent = 'An error occurred: ' + error.message;
                errorDiv.classList.remove('d-none');
            }
        }

        function openDeleteModal(inventoryId) {
            currentInventoryId = inventoryId;
            if (!deleteModalInstance) {
                deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteBloodModal'));
            }
            deleteModalInstance.show();
        }

        async function confirmDelete() {
            if (!currentInventoryId) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]');

            const formData = new FormData();
            formData.append('id', currentInventoryId);
            formData.append('__RequestVerificationToken', token.value);

            try {
                const response = await fetch('/Hospital/DeleteBloodStock', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token.value },
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    if (deleteModalInstance) deleteModalInstance.hide();
                    showNotification(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification(data.message, 'error');
                }
            } catch (error) {
                showNotification('An error occurred. Please try again.', 'error');
            }
        }

        async function submitAddForm() {
            const form = document.getElementById('addBloodForm');
            const formData = new FormData(form);
            const errorDiv = document.getElementById('addErrorMessage');

            const quantityStr = formData.get('Quantity');
            const quantity = parseInt(quantityStr);
            const collectionDateStr = formData.get('CollectionDate');
            const expiryDateStr = formData.get('ExpiryDate');

            if (!formData.get('BloodGroup')) {
                errorDiv.textContent = 'Please select a blood group.';
                errorDiv.classList.remove('d-none'); return;
            }
            if (isNaN(quantity) || quantity <= 0) {
                errorDiv.textContent = 'Quantity must be greater than 0.';
                errorDiv.classList.remove('d-none'); return;
            }
            if (!collectionDateStr || !expiryDateStr) {
                errorDiv.textContent = 'Please select both dates.';
                errorDiv.classList.remove('d-none'); return;
            }

            const collectionDate = new Date(collectionDateStr);
            const expiryDate = new Date(expiryDateStr);
            const today = new Date(); today.setHours(0, 0, 0, 0);

            if (expiryDate <= collectionDate) {
                errorDiv.textContent = 'Expiry date must be after collection date.';
                errorDiv.classList.remove('d-none'); return;
            }
            if (expiryDate < today) {
                errorDiv.textContent = 'Expiry date cannot be in the past.';
                errorDiv.classList.remove('d-none'); return;
            }

            errorDiv.classList.add('d-none');
            const token = form.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Hospital/AddBloodStock', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token.value },
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    const addModal = bootstrap.Modal.getInstance(document.getElementById('addBloodModal'));
                    if (addModal) addModal.hide();
                    showNotification(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    errorDiv.textContent = data.message || 'Failed to add';
                    errorDiv.classList.remove('d-none');
                }
            } catch (error) {
                errorDiv.textContent = 'An error occurred: ' + error.message;
                errorDiv.classList.remove('d-none');
            }
        }

        // ==================== ENHANCED NOTIFICATION FUNCTION ====================
        function showNotification(message, type = "success") {
            const old = document.getElementById("customNotification");
            if (old) old.remove();

            const notification = document.createElement("div");
            notification.id = "customNotification";

            let bg = "#5C88A8"; // Theme color for success
            let icon = "✔";

            if (type === "error") {
                bg = "#dc3545"; // Red for errors (better UX)
                icon = "✖";
            } else if (type === "warning") {
                bg = "#ffc107"; // Yellow for warnings
                icon = "⚠";
            }

            notification.innerHTML = `
                                <div style="
                                    display: flex;
                                    align-items: center;
                                    gap: 12px;
                                    padding: 16px 24px;
                                    background: ${bg};
                                    color: #ffffff;
                                    border-radius: 12px;
                                    box-shadow: 0 8px 24px rgba(0,0,0,0.15); /* Proper popup shadow */
                                    font-family: system-ui, -apple-system, sans-serif;
                                    font-weight: 600;
                                    font-size: 15px;
                                    z-index: 9999999999;
                                    border: 1px solid rgba(255,255,255,0.1);
                                ">
                                    <span style="font-size: 20px; line-height: 1;">${icon}</span>
                                    <span>${message}</span>
                                </div>
                            `;

            notification.style.cssText = `
                                position: fixed !important;
                                top: 20px !important;
                                right: 20px !important;
                                z-index: 2147483647 !important;
                                margin: 0 !important;
                                padding: 0 !important;
                                pointer-events: auto !important;
                                animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
                            `;

            // Add animation keyframes dynamically if not present
            if (!document.getElementById('notification-anim-style')) {
                const style = document.createElement('style');
                style.id = 'notification-anim-style';
                style.innerHTML = `
                                    @@keyframes slideInRight {
                                        from { transform: translateX(100%); opacity: 0; }
                                        to { transform: translateX(0); opacity: 1; }
                                    }
                                `;
                document.head.appendChild(style);
            }

            document.documentElement.appendChild(notification);

            setTimeout(() => {
                notification.style.transition = "all 0.4s ease";
                notification.style.opacity = "0";
                notification.style.transform = "translateX(400px)";
                notification.style.pointerEvents = "none";

                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 400);
            }, 3000);
        }

        // ==================== EXPORT FUNCTION WITH NOTIFICATIONS ====================
        window.exportTable = function(type, tableId, fileName) {
            const table = document.getElementById(tableId);
            if (!table) {
                showNotification('Table not found!', 'error');
                return;
            }

            try {
                if (type === 'excel') {
                    let csv = [];
                    let rows = table.querySelectorAll("tr");

                    for (let i = 0; i < rows.length; i++) {
                        if (rows[i].style.display === 'none') continue;

                        let row = [];
                        let cols = rows[i].querySelectorAll("td, th");

                        // Exclude the last column (Actions) from export
                        for (let j = 0; j < cols.length - 1; j++) {
                            let cellText = cols[j].innerText.replace(/"/g, '""').trim();
                            cellText = cellText.replace(/\s+/g, ' ');
                            row.push(`"${cellText}"`);
                        }
                        csv.push(row.join(","));
                    }

                    let csvContent = "\uFEFF" + csv.join("\n");
                    let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                    let url = URL.createObjectURL(blob);

                    let link = document.createElement("a");
                    link.setAttribute("href", url);
                    link.setAttribute("download", `${fileName}.csv`);
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);

                    showNotification('Excel Export Successful', 'success');

                } else if (type === 'pdf') {
                    if (typeof window.jspdf === 'undefined') {
                        showNotification('PDF library not loaded!', 'error');
                        return;
                    }

                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF('l', 'mm', 'a4');

                    doc.setFontSize(18);
                    doc.setTextColor(92, 136, 168); // #5C88A8 in RGB
                    doc.text("Blood Inventory Report", 14, 20);

                    doc.setFontSize(10);
                    doc.setTextColor(108, 117, 125);
                    doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 30);

                    const rows = [];
                    table.querySelectorAll("tbody tr").forEach(tr => {
                        if (tr.style.display !== 'none') {
                            const cells = tr.querySelectorAll("td");
                            if (cells.length >= 6) {
                                rows.push([
                                    cells[0].innerText.trim(),
                                    cells[1].innerText.trim(),
                                    cells[2].innerText.trim(),
                                    cells[3].innerText.trim(),
                                    cells[4].innerText.trim(),
                                    cells[5].innerText.trim()
                                ]);
                            }
                        }
                    });

                    doc.autoTable({
                        startY: 40,
                        head: [['Blood Group', 'Units', 'Collection Date', 'Expiry Date', 'Status', 'Last Updated']],
                        body: rows,
                        theme: 'grid',
                        headStyles: {
                            fillColor: [92, 136, 168], // #5C88A8
                            textColor: 255,
                            fontSize: 10
                        },
                        styles: {
                            fontSize: 8,
                            cellPadding: 2,
                            overflow: 'linebreak'
                        }
                    });

                    doc.save(`${fileName}.pdf`);
                    showNotification('PDF Export Successful', 'success');
                }
            } catch (error) {
                console.error("💥 Export Error:", error);
                showNotification('Export failed: ' + error.message, 'error');
            }
        };

        document.addEventListener('DOMContentLoaded', function() {
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', confirmDelete);
            }
        });
    </script>
}