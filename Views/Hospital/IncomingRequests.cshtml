@model Khoon_e_Hayat.ViewModels.IncomingRequestsViewModel
@{
    ViewData["Title"] = "Incoming Requests";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
}

@Html.AntiForgeryToken()

<style>
    /* Strict Theme Colors & Card Styling (Matches LowStockMonitor Exactly) */
    .text-blood {
        color: #90151C !important;
    }

    .text-theme {
        color: #5C88A8 !important;
    }

    .text-success-custom {
        color: #198754 !important;
    }

    .text-warning-custom {
        color: #ECBD35 !important;
    }

    .text-danger-custom {
        color: #90151C !important;
    }

    .text-info-custom {
        color: #0dcaf0 !important;
    }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }

        .btn-theme:hover {
            background-color: #4a6d87;
            border-color: #4a6d87;
            color: #fff;
        }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #0E1A2B !important;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    .badge-critical {
        color: #90151C !important;
    }

    .badge-high {
        color: #b48e12 !important;
    }

    .badge-normal {
        color: #5C88A8 !important;
    }

    .badge-pending {
        color: #b48e12 !important;
    }

    .badge-approved {
        color: #5C88A8 !important;
    }

    .badge-searching {
        color: #0dcaf0 !important;
    }

    .badge-completed {
        color: #198754 !important;
    }

    .badge-rejected {
        color: #90151C !important;
    }

    .badge-available {
        color: #198754 !important;
    }

    .badge-lowstock {
        color: #b48e12 !important;
    }

    .badge-notavailable {
        color: #90151C !important;
    }

    #viewDetailsModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }

    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icons-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icons-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    .icons-box-success {
        background: #e6f7ee;
    }

        .icons-box-success i {
            color: #198754;
        }

    .icons-box-primary {
        background: #e6f4ff;
    }

        .icons-box-primary i {
            color: #5C88A8;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .progress-bar {
        box-shadow: none !important;
        border-radius: 50px;
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Incoming Requests</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-clipboard2-pulse text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Requests</h6>
                                <small class="text-muted">@Model.TotalRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-hourglass-split text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Pending</h6>
                                <small class="text-muted text-warning-custom fw-bold">@Model.PendingRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Emergency</h6>
                                <small class="text-muted text-danger-custom fw-bold">@Model.EmergencyRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Approved</h6>
                                <small class="text-muted text-theme fw-bold">@Model.ApprovedRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check2-all text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Completed</h6>
                                <small class="text-muted text-success-custom fw-bold">@Model.CompletedRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-x-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Rejected</h6>
                                <small class="text-muted text-danger-custom fw-bold">@Model.RejectedRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4" style="border-left: none;">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="ID, patient, blood group..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var status in Model.AvailableStatuses)
                                {
                                    <option value="@status" selected="@(Model.Filters?.Status == status)">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Priority</label>
                            <select id="filterPriority" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var priority in Model.AvailablePriorities)
                                {
                                    <option value="@priority" selected="@(Model.Filters?.Priority == priority)">@priority</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var bg in Model.AvailableBloodGroups)
                                {
                                    <option value="@bg" selected="@(Model.Filters?.BloodGroup == bg)">@bg</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Sort By</label>
                            <select id="filterSortBy" class="form-select form-select-sm rounded-pill">
                                <option value="newest" selected="@(Model.Filters?.SortBy == "newest")">Newest</option>
                                <option value="oldest" selected="@(Model.Filters?.SortBy == "oldest")">Oldest</option>
                                <option value="priority" selected="@(Model.Filters?.SortBy == "priority")">Priority</option>
                                <option value="bloodgroup" selected="@(Model.Filters?.SortBy == "bloodgroup")">Blood Group</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-pill w-100" title="Reset all filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4" style="border-left: none;">
                @if (!Model.Requests.Any())
                {
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-clipboard2-pulse fs-1 d-block mb-2 text-theme"></i>
                                <h5 class="fw-semibold">No Incoming Requests</h5>
                                <p class="mb-3">There are no blood requests at the moment.</p>
                                <a asp-controller="Hospital" asp-action="Dashboard" class="btn btn-theme rounded-pill px-4">
                                    <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">Incoming Requests</h4>
                                <small class="text-muted">Review and manage blood requests</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'requestsTable', 'IncomingRequests')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'requestsTable', 'IncomingRequests')">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="requestsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Patient Name</th>
                                        <th>Blood Group</th>
                                        <th>Units</th>
                                        <th>City</th>
                                        <th>Priority</th>
                                        <th>Availability</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.Requests)
                                    {
                                        string priorityClass = request.Priority == "Critical" ? "badge-critical" : (request.Priority == "High" ? "badge-high" : "badge-normal");

                                        string statusClass = "badge-pending";
                                        if (request.Status == "Approved" || request.Status == "Blood Issued") statusClass = "badge-approved";
                                        else if (request.Status == "In Progress" || request.Status == "Searching Donor" || request.Status == "Blood Reserved") statusClass = "badge-searching";
                                        else if (request.Status == "Completed" || request.Status == "Fulfilled") statusClass = "badge-completed";
                                        else if (request.Status == "Rejected" || request.Status == "Cancelled") statusClass = "badge-rejected";

                                        string availClass = "badge-notavailable";
                                        string availText = "Not Available";
                                        if (request.IsBloodAvailable)
                                        {
                                            availClass = "badge-available";
                                            availText = $"Available ({request.AvailableStock})";
                                        }
                                        else if (request.AvailableStock > 0)
                                        {
                                            availClass = "badge-lowstock";
                                            availText = $"Low Stock ({request.AvailableStock})";
                                        }

                                        <tr>
                                            <td><span class="fw-bold text-theme">#@request.RequestId.ToString("D4")</span></td>
                                            <td><strong>@request.ReceiverName</strong></td>
                                            <td><span class="fw-bold text-blood">@request.BloodGroup</span></td>
                                            <td>@request.RequiredUnits units</td>
                                            <td>@request.City</td>
                                            <td><span class="badge @priorityClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@request.Priority</span></td>
                                            <td><span class="badge @availClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@availText</span></td>
                                            <td><span class="badge @statusClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@request.Status</span></td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2 flex-wrap">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" data-requestid="@request.RequestId" title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>

                                                    @if (request.Status == "Pending")
                                                    {
                                                        <button type="button" class="btn btn-outline-success accept-request-btn" data-requestid="@request.RequestId" title="Approve Request">
                                                            <i class="bx bx-check-circle me-1"></i> Approve
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger reject-request-btn" data-requestid="@request.RequestId" title="Reject Request">
                                                            <i class="bx bx-x-circle me-1"></i> Reject
                                                        </button>
                                                    }
                                                    else if (request.Status == "Approved")
                                                    {
                                                        // ✅ PROFESSIONAL WORKFLOW FIX: Show ONLY relevant button based on inventory
                                                        @if (request.IsBloodAvailable)
                                                        {
                                                            <button type="button" class="btn btn-outline-success issue-blood-btn" data-requestid="@request.RequestId" title="Issue Blood">
                                                                <i class="bi bi-box-seam me-1"></i> Issue Blood
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <a asp-action="SmartDonorSearch" asp-route-requestId="@request.RequestId" class="btn btn-outline-info text-decoration-none" title="Find Donors">
                                                                <i class="bi bi-people me-1"></i> Find Donors
                                                            </a>
                                                        }
                                                    }
                                                    else if (request.Status == "Blood Issued")
                                                    {
                                                        <button type="button" class="btn btn-outline-success mark-completed-btn"
                                                                data-requestid="@request.RequestId"
                                                                title="Mark as Completed">
                                                            <i class="bi bi-check-circle me-1"></i> Complete
                                                        </button>
                                                    }
                                                    else if (request.Status == "Completed" || request.Status == "Fulfilled")
                                                    {
                                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                                            <i class="bi bi-check2-all me-1"></i> Completed
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <!-- Fallback for legacy statuses -->
                                                        <button type="button" class="btn btn-outline-primary complete-request-btn" data-requestid="@request.RequestId" title="Mark Completed">
                                                            <i class="bx bx-check-double me-1"></i> Complete
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                <small class="text-muted">
                                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                                    <strong>@Model.TotalCount</strong> requests
                                </small>
                                <nav>
                                    <ul class="pagination pagination-n mb-0">
                                        @{
                                            var prevDisabled = Model.CurrentPage == 1 ? "disabled" : "";
                                            var nextDisabled = Model.CurrentPage == Model.TotalPages ? "disabled" : "";
                                            var routeValues = new Dictionary<string, object>
                                            {
                                                { "Filters.SearchQuery", Model.Filters?.SearchQuery },
                                                { "Filters.Status", Model.Filters?.Status ?? "all" },
                                                { "Filters.Priority", Model.Filters?.Priority ?? "all" },
                                                { "Filters.BloodGroup", Model.Filters?.BloodGroup ?? "all" },
                                                { "Filters.SortBy", Model.Filters?.SortBy ?? "newest" }
                                            };
                                        }
                                        <li class="page-item @prevDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage - 1;
                                            }
                                            <a class="page-link" href="@Url.Action("IncomingRequests", routeValues)"><i class="bi bi-chevron-left"></i> Previous</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            var active = i == Model.CurrentPage ? "active" : "";
                                            routeValues["page"] = i;
                                            <li class="page-item @active"><a class="page-link" href="@Url.Action("IncomingRequests", routeValues)">@i</a></li>
                                        }
                                        <li class="page-item @nextDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage + 1;
                                            }
                                            <a class="page-link" href="@Url.Action("IncomingRequests", routeValues)">Next <i class="bi bi-chevron-right"></i></a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-clipboard text-theme"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Request Details</h5>
                        <small class="text-muted" id="modalRequestId">REQ-XXXX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3" id="viewDetailsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-theme" role="status"></div>
                    <p class="mt-2 text-muted">Loading details...</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ACCEPT REQUEST MODAL ==================== -->
<div class="modal fade" id="acceptRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box icons-box-success">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Approve Request?</h4>
                <p class="text-muted mb-3">You are about to approve request <strong id="acceptRequestIdDisplay"></strong>.<br />This will mark the request as approved and notify the receiver.</p>
                <input type="hidden" id="acceptRequestId" />
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmAcceptBtn">Yes, Approve Request</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== REJECT REQUEST MODAL ==================== -->
<div class="modal fade" id="rejectRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box">
                    <i class="fas fa-times-circle"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Reject Request?</h4>
                <p class="text-muted mb-3">You are about to reject request <strong id="rejectRequestIdDisplay"></strong>.<br />Please provide a reason for this action.</p>
                <input type="hidden" id="rejectRequestId" />
                <div class="mb-3 text-start">
                    <label class="form-label small text-muted">Rejection Reason</label>
                    <textarea id="rejectReason" class="form-control rounded-3" rows="3" placeholder="Enter reason for rejection..."></textarea>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmRejectBtn">Yes, Reject Request</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== COMPLETE REQUEST MODAL ==================== -->
<div class="modal fade" id="completeRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box icons-box-primary">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Mark as Completed?</h4>
                <p class="text-muted mb-3">You are about to complete request <strong id="completeRequestIdDisplay"></strong>.<br />This action confirms the blood has been delivered.</p>
                <input type="hidden" id="completeRequestId" />
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-theme px-4 rounded-pill" id="confirmCompleteBtn">Yes, Mark Completed</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ISSUE BLOOD MODAL (NEW) ==================== -->
<div class="modal fade" id="issueBloodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box icons-box-primary">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Issue Blood?</h4>
                <p class="text-muted mb-3">You are about to issue blood for request <strong id="issueBloodRequestIdDisplay"></strong>.<br />This will deduct from inventory and notify the receiver.</p>
                <input type="hidden" id="issueBloodRequestId" />
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-theme px-4 rounded-pill" id="confirmIssueBloodBtn">Yes, Issue Blood</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MARK COMPLETED MODAL (NEW) ==================== -->
<div class="modal fade" id="markCompletedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box icons-box-success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Mark as Completed?</h4>
                <p class="text-muted mb-3">You are about to mark request <strong id="markCompletedRequestIdDisplay"></strong> as completed.<br />This confirms the blood has been delivered to the patient.</p>
                <input type="hidden" id="markCompletedRequestId" />
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Go Back</button>
                    <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmMarkCompletedBtn">Yes, Mark Completed</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        console.log(" Incoming Requests Script Loaded Successfully!");

        document.addEventListener("DOMContentLoaded", function() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            let currentRequestId = null;
            let acceptModalInstance = null;
            let rejectModalInstance = null;
            let completeModalInstance = null;
            let issueBloodModalInstance = null;
            let markCompletedModalInstance = null;

            // Initialize all modals
            acceptModalInstance = new bootstrap.Modal(document.getElementById('acceptRequestModal'));
            rejectModalInstance = new bootstrap.Modal(document.getElementById('rejectRequestModal'));
            completeModalInstance = new bootstrap.Modal(document.getElementById('completeRequestModal'));
            issueBloodModalInstance = new bootstrap.Modal(document.getElementById('issueBloodModal'));
            markCompletedModalInstance = new bootstrap.Modal(document.getElementById('markCompletedModal'));

            // ==================== FILTERS ====================
            const searchInput = document.getElementById('searchInput');
            const filterStatus = document.getElementById('filterStatus');
            const filterPriority = document.getElementById('filterPriority');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterSortBy = document.getElementById('filterSortBy');
            const resetFiltersBtn = document.getElementById('resetFiltersBtn');

            function filterTable() {
                try {
                    const sVal = (searchInput.value || '').toLowerCase().trim();
                    const statVal = (filterStatus.value || 'all').toLowerCase().trim();
                    const prioVal = (filterPriority.value || 'all').toLowerCase().trim();
                    const bgVal = (filterBloodGroup.value || 'all').toLowerCase().trim();
                    const sortBy = filterSortBy.value;

                    const tbody = document.querySelector("#requestsTable tbody");
                    const rows = Array.from(tbody.querySelectorAll("tr"));

                    if (sortBy === 'bloodgroup') {
                        rows.sort((a, b) => a.cells[2].textContent.localeCompare(b.cells[2].textContent));
                    } else if (sortBy === 'priority') {
                        const prioOrder = { 'critical': 1, 'high': 2, 'normal': 3 };
                        rows.sort((a, b) => {
                            const prioA = a.cells[5].querySelector('.badge').textContent.toLowerCase().trim();
                            const prioB = b.cells[5].querySelector('.badge').textContent.toLowerCase().trim();
                            return (prioOrder[prioA] || 99) - (prioOrder[prioB] || 99);
                        });
                    } else if (sortBy === 'oldest') {
                        rows.reverse();
                    }

                    rows.forEach(row => tbody.appendChild(row));

                    rows.forEach(row => {
                        const reqId = row.cells[0].textContent.toLowerCase();
                        const name = row.cells[1].textContent.toLowerCase();
                        const bg = row.cells[2].textContent.toLowerCase();
                        const city = row.cells[4].textContent.toLowerCase();
                        const priority = row.cells[5].querySelector('.badge').textContent.toLowerCase().trim();
                        const status = row.cells[7].querySelector('.badge').textContent.toLowerCase().trim();

                        let show = true;
                        if (sVal && !(reqId.includes(sVal) || name.includes(sVal) || bg.includes(sVal) || city.includes(sVal))) show = false;
                        if (statVal !== 'all' && status !== statVal) show = false;
                        if (prioVal !== 'all' && priority !== prioVal) show = false;
                        if (bgVal !== 'all' && bg !== bgVal) show = false;

                        row.style.display = show ? "" : "none";
                    });
                } catch (error) {
                    console.error("Error in filterTable:", error);
                }
            }

            [searchInput, filterStatus, filterPriority, filterBloodGroup, filterSortBy].forEach(el => {
                if (el) {
                    el.addEventListener('input', filterTable);
                    el.addEventListener('change', filterTable);
                }
            });

            if (resetFiltersBtn) {
                resetFiltersBtn.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (filterStatus) filterStatus.value = 'all';
                    if (filterPriority) filterPriority.value = 'all';
                    if (filterBloodGroup) filterBloodGroup.value = 'all';
                    if (filterSortBy) filterSortBy.value = 'newest';
                    filterTable();
                });
            }

            filterTable();

            // ==================== EVENT DELEGATION ====================
            document.getElementById('requestsTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target.getAttribute('data-requestid'));
                } else if (target.classList.contains('accept-request-btn')) {
                    openAcceptModal(target.getAttribute('data-requestid'));
                } else if (target.classList.contains('reject-request-btn')) {
                    openRejectModal(target.getAttribute('data-requestid'));
                } else if (target.classList.contains('complete-request-btn')) {
                    openCompleteModal(target.getAttribute('data-requestid'));
                } else if (target.classList.contains('issue-blood-btn')) {
                    openIssueBloodModal(target.getAttribute('data-requestid'));
                } else if (target.classList.contains('mark-completed-btn')) {
                    openMarkCompletedModal(target.getAttribute('data-requestid'));
                }
            });

            // ==================== VIEW DETAILS MODAL ====================
            function openViewDetailsModal(id) {
                document.getElementById('viewDetailsContent').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-theme" role="status"></div><p class="mt-2 text-muted">Loading details...</p></div>';
                const modal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                modal.show();

                fetch(`/Hospital/GetRequestDetails?id=${id}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const item = data.data;
                            document.getElementById('modalRequestId').textContent = `REQ-${String(item.requestId).padStart(4, '0')}`;

                            const availabilityHtml = item.isBloodAvailable
                                ? `<span class="badge badge-available" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">Available (${item.availableStock} units)</span>`
                                : `<span class="badge badge-notavailable" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">Not Available (${item.availableStock} units)</span>`;

                            const content = `
                                                        <div class="card border-0 bg-light-subtle rounded-4">
                                                            <div class="card-body p-4">
                                                                <h6 class="fw-bold mb-3 text-blood"><i class="bx bx-droplet me-2"></i>Blood Requirement</h6>
                                                                <div class="row g-3">
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold mb-0 text-blood">${item.bloodGroup}</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext mb-0">${item.unitsRequired} units</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Priority</label><p class="form-control-plaintext mb-0">${item.priority}</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Blood Availability</label><p class="form-control-plaintext mb-0">${availabilityHtml}</p></div>
                                                                </div>

                                                                <h6 class="fw-bold mb-3 mt-4 text-success-custom"><i class="bx bx-buildings me-2"></i>Receiver Information</h6>
                                                                <div class="row g-3">
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Receiver Name</label><p class="form-control-plaintext mb-0">${item.receiverName}</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Hospital</label><p class="form-control-plaintext mb-0">${item.hospitalName || 'N/A'}</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">City</label><p class="form-control-plaintext mb-0">${item.city || 'N/A'}</p></div>
                                                                    ${item.hospitalContact ? `<div class="col-6"><label class="form-label small text-muted mb-1">Contact</label><p class="form-control-plaintext mb-0">${item.hospitalContact}</p></div>` : ''}
                                                                </div>

                                                                <h6 class="fw-bold mb-3 mt-4 text-theme"><i class="bx bx-info-circle me-2"></i>Request Information</h6>
                                                                <div class="row g-3">
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Request ID</label><p class="form-control-plaintext fw-semibold mb-0">REQ-${String(item.requestId).padStart(4, '0')}</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Request Date</label><p class="form-control-plaintext mb-0">${new Date(item.createdAt).toLocaleString()}</p></div>
                                                                    <div class="col-6"><label class="form-label small text-muted mb-1">Status</label><p class="form-control-plaintext mb-0">${item.requestStatus}</p></div>
                                                                </div>
                                                                ${item.reason ? `
                                                                <div class="mt-3">
                                                                    <label class="form-label small text-muted mb-1">Medical Reason</label>
                                                                    <p class="form-control-plaintext mb-0 p-3 bg-white rounded-3 border">${item.reason}</p>
                                                                </div>` : ''}
                                                            </div>
                                                        </div>
                                                    `;
                            document.getElementById('viewDetailsContent').innerHTML = content;
                        } else {
                            showNotification(data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('An error occurred while fetching details.', 'error');
                    });
            }

            // ==================== ACTION MODALS ====================
            function openAcceptModal(id) {
                currentRequestId = id;
                document.getElementById('acceptRequestId').value = id;
                document.getElementById('acceptRequestIdDisplay').textContent = `REQ-${String(id).padStart(4, '0')}`;
                acceptModalInstance.show();
            }

            document.getElementById('confirmAcceptBtn').addEventListener('click', function() {
                performAction('/Hospital/AcceptRequest', currentRequestId, null, 'Request approved successfully! Inventory check initiated.', 'success');
                acceptModalInstance.hide();
            });

            function openRejectModal(id) {
                currentRequestId = id;
                document.getElementById('rejectRequestId').value = id;
                document.getElementById('rejectRequestIdDisplay').textContent = `REQ-${String(id).padStart(4, '0')}`;
                document.getElementById('rejectReason').value = '';
                rejectModalInstance.show();
            }

            document.getElementById('confirmRejectBtn').addEventListener('click', function() {
                const reason = document.getElementById('rejectReason').value;
                if (!reason.trim()) {
                    showNotification('Please provide a reason for rejection.', 'warning');
                    return;
                }
                performAction('/Hospital/RejectRequest', currentRequestId, reason, 'Request rejected successfully!', 'success');
                rejectModalInstance.hide();
            });

            function openCompleteModal(id) {
                currentRequestId = id;
                document.getElementById('completeRequestId').value = id;
                document.getElementById('completeRequestIdDisplay').textContent = `REQ-${String(id).padStart(4, '0')}`;
                completeModalInstance.show();
            }

            document.getElementById('confirmCompleteBtn').addEventListener('click', function() {
                performAction('/Hospital/CompleteRequest', currentRequestId, null, 'Request marked as completed!', 'success');
                completeModalInstance.hide();
            });

            // ==================== ISSUE BLOOD MODAL ====================
            function openIssueBloodModal(id) {
                currentRequestId = id;
                document.getElementById('issueBloodRequestId').value = id;
                document.getElementById('issueBloodRequestIdDisplay').textContent = `REQ-${String(id).padStart(4, '0')}`;
                issueBloodModalInstance.show();
            }

            document.getElementById('confirmIssueBloodBtn').addEventListener('click', async function() {
                const formData = new FormData();
                formData.append('requestId', currentRequestId);
                formData.append('__RequestVerificationToken', token);

                try {
                    const response = await fetch('/Hospital/IssueBlood', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: formData
                    });
                    const data = await response.json();

                    if (data.success) {
                        showNotification(data.message, 'success');
                        issueBloodModalInstance.hide();
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showNotification(data.message, 'error');
                    }
                } catch (error) {
                    showNotification('Network error occurred.', 'error');
                }
            });

            // ==================== MARK COMPLETED MODAL ====================
            function openMarkCompletedModal(id) {
                currentRequestId = id;
                document.getElementById('markCompletedRequestId').value = id;
                document.getElementById('markCompletedRequestIdDisplay').textContent = `REQ-${String(id).padStart(4, '0')}`;
                markCompletedModalInstance.show();
            }

            document.getElementById('confirmMarkCompletedBtn').addEventListener('click', function() {
                const formData = new FormData();
                formData.append('requestId', currentRequestId);
                formData.append('__RequestVerificationToken', token);

                fetch('/Hospital/MarkRequestCompleted', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showNotification(data.message, 'success');
                            markCompletedModalInstance.hide();
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showNotification(data.message, 'error');
                        }
                    })
                    .catch(error => {
                        showNotification('Error occurred', 'error');
                    });
            });

            function performAction(url, id, reason, successMsg, type) {
                const fd = new FormData();
                fd.append('id', id);
                if (reason) fd.append('reason', reason);
                fd.append('__RequestVerificationToken', token);

                fetch(url, { method: 'POST', body: fd })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showNotification(successMsg, type);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showNotification(data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('An error occurred. Please try again.', 'error');
                    });
            }

            // ==================== EXPORT & NOTIFICATIONS ====================
            window.exportTable = function(type, tableId, fileName) {
                const table = document.getElementById(tableId);
                if (!table) {
                    showNotification('Table not found!', 'error');
                    return;
                }

                try {
                    if (type === 'excel') {
                        let csv = [];
                        let rows = table.querySelectorAll("tr");
                        for (let i = 0; i < rows.length; i++) {
                            if (rows[i].style.display === 'none') continue;
                            let row = [], cols = rows[i].querySelectorAll("td, th");
                            for (let j = 0; j < cols.length - 1; j++) {
                                let text = cols[j].innerText.replace(/"/g, '""').trim();
                                row.push('"' + text + '"');
                            }
                            csv.push(row.join(","));
                        }
                        if (csv.length <= 1) {
                            showNotification('No records to export!', 'warning');
                            return;
                        }
                        let csvFile = "\uFEFF" + csv.join("\n");
                        let downloadLink = document.createElement("a");
                        downloadLink.href = 'data:text/csv;charset=utf-8,' + encodeURI(csvFile);
                        downloadLink.target = '_blank';
                        downloadLink.download = fileName + '.csv';
                        document.body.appendChild(downloadLink);
                        downloadLink.click();
                        document.body.removeChild(downloadLink);
                        showNotification('Excel Export Successful', 'success');
                    } else {
                        if (typeof window.jspdf === 'undefined') {
                            showNotification('PDF library not loaded!', 'error');
                            return;
                        }
                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF('l', 'mm', 'a4');

                        doc.setFontSize(18);
                        doc.setTextColor(92, 136, 168);
                        doc.text("Incoming Blood Requests", 14, 20);

                        doc.setFontSize(10);
                        doc.setTextColor(108, 117, 125);
                        doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 30);

                        const rows = [];
                        table.querySelectorAll("tbody tr").forEach(tr => {
                            if (tr.style.display !== 'none') {
                                const cells = tr.querySelectorAll("td");
                                if (cells.length >= 8) {
                                    rows.push([
                                        cells[0].innerText.trim(),
                                        cells[1].innerText.trim(),
                                        cells[2].innerText.trim(),
                                        cells[3].innerText.trim(),
                                        cells[4].innerText.trim(),
                                        cells[5].innerText.trim(),
                                        cells[6].innerText.trim(),
                                        cells[7].innerText.trim()
                                    ]);
                                }
                            }
                        });

                        if (rows.length === 0) {
                            showNotification('No records to export!', 'warning');
                            return;
                        }

                        doc.autoTable({
                            startY: 40,
                            head: [['Request ID', 'Patient', 'Blood Group', 'Units', 'City', 'Priority', 'Availability', 'Status']],
                            body: rows,
                            theme: 'grid',
                            headStyles: { fillColor: [92, 136, 168], textColor: 255, fontSize: 10 },
                            styles: { fontSize: 8, cellPadding: 2, overflow: 'linebreak' }
                        });

                        doc.save(`${fileName}.pdf`);
                        showNotification('PDF Export Successful', 'success');
                    }
                } catch (error) {
                    console.error(" Export Error:", error);
                    showNotification('Export failed: ' + error.message, 'error');
                }
            };

            function showNotification(message, type = "success") {
                const old = document.getElementById("customNotification");
                if (old) old.remove();

                const notification = document.createElement("div");
                notification.id = "customNotification";

                let bg = "#5C88A8";
                let icon = "✔";

                if (type === "error") {
                    bg = "#90151C";
                    icon = "✖";
                } else if (type === "warning") {
                    bg = "#ECBD35";
                    icon = "⚠";
                }

                notification.innerHTML = `
                                            <div style="
                                                display: flex; align-items: center; gap: 12px; padding: 16px 24px;
                                                background: ${bg}; color: #ffffff; border-radius: 12px;
                                                box-shadow: none; font-family: system-ui, -apple-system, sans-serif;
                                                font-weight: 600; font-size: 15px; z-index: 9999999999; border: 1px solid rgba(255,255,255,0.1);
                                            ">
                                                <span style="font-size: 20px; line-height: 1;">${icon}</span>
                                                <span>${message}</span>
                                            </div>
                                        `;

                notification.style.cssText = `
                                            position: fixed !important; top: 20px !important; right: 20px !important;
                                            z-index: 2147483647 !important; margin: 0 !important; padding: 0 !important;
                                            pointer-events: auto !important; animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
                                        `;

                if (!document.getElementById('notification-anim-style')) {
                    const style = document.createElement('style');
                    style.id = 'notification-anim-style';
                    style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                    document.head.appendChild(style);
                }

                document.documentElement.appendChild(notification);

                setTimeout(() => {
                    notification.style.transition = "all 0.4s ease";
                    notification.style.opacity = "0";
                    notification.style.transform = "translateX(400px)";
                    notification.style.pointerEvents = "none";
                    setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
                }, 3000);
            }
        });
    </script>
}