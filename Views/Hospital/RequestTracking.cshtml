@model Khoon_e_Hayat.ViewModels.BloodRequestListViewModel
@{
    ViewData["Title"] = "Request Tracking";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";
}

@Html.AntiForgeryToken()

<style>
    /* Strict Theme Colors & Card Styling (Matches Incoming Requests Exactly) */
    .text-blood { color: #90151C !important; }
    .text-theme { color: #5C88A8 !important; }
    .text-success-custom { color: #198754 !important; }
    .text-warning-custom { color: #ECBD35 !important; }
    .text-danger-custom { color: #90151C !important; }
    .text-info-custom { color: #0dcaf0 !important; }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }
    .btn-theme:hover {
        background-color: #4a6d87;
        border-color: #4a6d87;
        color: #fff;
    }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .custom-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #0E1A2B !important;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    /* Subtle Badges */
    .badge-critical { color: #90151C !important; }
    .badge-high {  color: #b48e12 !important; }
    .badge-normal {  color: #5C88A8 !important; }
    
    .badge-pending {  color: #b48e12 !important; }
    .badge-approved {  color: #5C88A8 !important; }
    .badge-searching {  color: #0dcaf0 !important; }
    .badge-reserved {  color: #5C88A8 !important; }
    .badge-completed {  color: #198754 !important; }
    .badge-rejected {  color: #90151C !important; }
    .badge-delayed {  color: #90151C !important; }

    .badge-available {  color: #198754 !important; }
    .badge-collecting {  color: #b48e12 !important; }
    .badge-issued {  color: #5C88A8 !important; }

    #viewDetailsModal .form-control-plaintext, #timelineModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }

    /* Ensure NO shadow on progress bars anywhere on the page */
    .progress-bar {
        box-shadow: none !important;
        border-radius: 50px;
        transition: width 0.6s ease;
    }

    /* Timeline Styling */
    .timeline {
        position: relative;
        padding-left: 30px;
        margin-top: 10px;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 10px;
        top: 5px;
        bottom: 5px;
        width: 2px;
        background: #e9ecef;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 24px;
    }
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -24px;
        top: 4px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #adb5bd;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #e9ecef;
        z-index: 1;
    }
    .timeline-item.completed::before {
        background: #198754;
        box-shadow: 0 0 0 2px #198754;
    }
    .timeline-item.active::before {
        background: #5C88A8;
        box-shadow: 0 0 0 2px #5C88A8;
        animation: pulse-blue 1.5s infinite;
    }
    .timeline-item.delayed::before {
        background: #90151C;
        box-shadow: 0 0 0 2px #90151C;
        animation: pulse-red 1.5s infinite;
    }
    .timeline-item .timeline-content {
        background: #f8f9fa;
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 3px solid #adb5bd;
    }
    .timeline-item.completed .timeline-content {
        border-left-color: #198754;
        background: rgba(25, 135, 84, 0.05);
    }
    .timeline-item.active .timeline-content {
        border-left-color: #5C88A8;
        background: rgba(92, 136, 168, 0.05);
    }
    .timeline-item.delayed .timeline-content {
        border-left-color: #90151C;
        background: rgba(144, 21, 28, 0.05);
    }

    @@keyframes pulse-blue {
        0% { box-shadow: 0 0 0 2px #5C88A8, 0 0 0 4px rgba(92, 136, 168, 0.3); }
        50% { box-shadow: 0 0 0 2px #5C88A8, 0 0 0 8px rgba(92, 136, 168, 0); }
        100% { box-shadow: 0 0 0 2px #5C88A8, 0 0 0 4px rgba(92, 136, 168, 0.3); }
    }
    @@keyframes pulse-red {
        0% { box-shadow: 0 0 0 2px #90151C, 0 0 0 4px rgba(144, 21, 28, 0.3); }
        50% { box-shadow: 0 0 0 2px #90151C, 0 0 0 8px rgba(144, 21, 28, 0); }
        100% { box-shadow: 0 0 0 2px #90151C, 0 0 0 4px rgba(144, 21, 28, 0.3); }
    }

    @@media (max-width: 768px) {
        .btn-group-sm .btn { padding: 4px 8px; font-size: 0.75rem; }
        .table-responsive { font-size: 0.85rem; }
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

             <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Request Tracking</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            @{
                // Derive stats from existing data without changing ViewModel
                var totalTracked = Model.TotalCount > 0 ? Model.TotalCount : Model.Requests.Count;
                var inProgress = Model.Requests.Count(r => {
                    var s = r.RequestStatus?.ToLower() ?? "";
                    return s == "approved" || s == "searching donor" || s == "donor assigned" || s == "blood collected" || s == "inventory updated" || s == "blood ready" || s == "reserved" || s == "issued";
                });
                var waitingDonor = Model.Requests.Count(r => {
                    var s = r.RequestStatus?.ToLower() ?? "";
                    return s == "searching donor" || s == "donor assigned";
                });
                var bloodReady = Model.Requests.Count(r => {
                    var s = r.RequestStatus?.ToLower() ?? "";
                    return s == "blood ready" || s == "reserved";
                });
                var completed = Model.Requests.Count(r => {
                    var s = r.RequestStatus?.ToLower() ?? "";
                    return s == "completed" || s == "fulfilled";
                });
                var delayed = Model.Requests.Count(r => {
                    var s = r.RequestStatus?.ToLower() ?? "";
                    var isLate = r.RequiredDate.HasValue && r.RequiredDate.Value < DateTime.Now && s != "completed" && s != "fulfilled" && s != "cancelled" && s != "rejected";
                    return s == "delayed" || isLate;
                });
            }

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-signpost-2 text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Tracked</h6>
                                <small class="text-muted">@totalTracked.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-arrow-repeat text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">In Progress</h6>
                                <small class="text-muted text-theme fw-bold">@inProgress.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-person-search text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Waiting Donor</h6>
                                <small class="text-muted text-info-custom fw-bold">@waitingDonor.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                            </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet-fill text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Blood Ready</h6>
                                <small class="text-muted text-success-custom fw-bold">@bloodReady.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check2-all text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Completed</h6>
                                <small class="text-muted text-success-custom fw-bold">@completed.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Delayed</h6>
                                <small class="text-muted text-danger-custom fw-bold">@delayed.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4" style="border-left: none;">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="ID, patient, blood group..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Current Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="delayed">Delayed</option>
                                <option value="completed">Completed</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Priority</label>
                            <select id="filterPriority" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="critical">Critical</option>
                                <option value="high">High</option>
                                <option value="normal">Normal</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Sort By</label>
                            <select id="filterSortBy" class="form-select form-select-sm rounded-pill">
                                <option value="newest">Newest</option>
                                <option value="oldest">Oldest</option>
                                <option value="priority">Priority</option>
                                <option value="stage">Current Stage</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-pill w-100" title="Reset all filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4" style="border-left: none;">
                @if (!Model.Requests.Any())
                {
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-clipboard-check fs-1 d-block mb-2 text-theme"></i>
                                <h5 class="fw-semibold">No Requests to Track</h5>
                                <p class="mb-3">There are no requests currently in the tracking workflow.</p>
                                <a asp-controller="Hospital" asp-action="Dashboard" class="btn btn-theme rounded-pill px-4">
                                    <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">Request Tracking</h4>
                                <small class="text-muted">Monitor the complete lifecycle of every request</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'trackingTable', 'RequestTracking')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'trackingTable', 'RequestTracking')">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="trackingTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Patient Name</th>
                                        <th>Blood Group</th>
                                        <th>Units</th>
                                        <th>Priority</th>
                                        @* <th>Current Stage</th> *@
                                        <th style="min-width: 120px;">Progress</th>
                                        <th>Blood Status</th>
                                        <th>Current Status</th>
                                        <th>Last Updated</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.Requests)
                                    {
                                        // Derive tracking data from existing fields
                                        var status = request.RequestStatus?.ToLower() ?? "";
                                        var isDelayed = request.RequiredDate.HasValue && request.RequiredDate.Value < DateTime.Now && status != "completed" && status != "fulfilled" && status != "cancelled" && status != "rejected";
                                        
                                        string stage = "Pending Approval";
                                        int progress = 10;
                                        string progressColor = "#ECBD35";
                                        string bloodStatus = "Checking";
                                        string currentStatus = "Active";
                                        string statusBadgeClass = "badge-pending";
                                        string bloodBadgeClass = "badge-collecting";

                                        if (status == "pending") {
                                            stage = "Pending Approval"; progress = 10; progressColor = "#ECBD35"; bloodStatus = "Not Available"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-pending"; bloodBadgeClass = "badge-rejected";
                                        } else if (status == "approved") {
                                            stage = "Hospital Approved"; progress = 20; progressColor = "#5C88A8"; bloodStatus = "Checking Inventory"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-approved"; bloodBadgeClass = "badge-collecting";
                                        } else if (status == "searching donor") {
                                            stage = "Searching Donor"; progress = 40; progressColor = "#5C88A8"; bloodStatus = "Searching"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-searching"; bloodBadgeClass = "badge-collecting";
                                        } else if (status == "donor assigned") {
                                            stage = "Donor Assigned"; progress = 50; progressColor = "#5C88A8"; bloodStatus = "Waiting Response"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-searching"; bloodBadgeClass = "badge-collecting";
                                        } else if (status == "blood collected") {
                                            stage = "Blood Collected"; progress = 60; progressColor = "#198754"; bloodStatus = "Collecting"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-approved"; bloodBadgeClass = "badge-collecting";
                                        } else if (status == "inventory updated") {
                                            stage = "Inventory Updated"; progress = 70; progressColor = "#198754"; bloodStatus = "Processing"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-approved"; bloodBadgeClass = "badge-available";
                                        } else if (status == "blood ready" || status == "reserved") {
                                            stage = "Blood Ready"; progress = 80; progressColor = "#198754"; bloodStatus = "Reserved"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-reserved"; bloodBadgeClass = "badge-available";
                                        } else if (status == "issued") {
                                            stage = "Blood Issued"; progress = 90; progressColor = "#198754"; bloodStatus = "Issued"; currentStatus = isDelayed ? "Delayed" : "Active"; statusBadgeClass = "badge-approved"; bloodBadgeClass = "badge-issued";
                                        } else if (status == "completed" || status == "fulfilled") {
                                            stage = "Completed"; progress = 100; progressColor = "#198754"; bloodStatus = "Completed"; currentStatus = "Completed"; statusBadgeClass = "badge-completed"; bloodBadgeClass = "badge-completed";
                                        } else if (status == "cancelled" || status == "rejected") {
                                            stage = "Cancelled"; progress = 0; progressColor = "#90151C"; bloodStatus = "Cancelled"; currentStatus = "Cancelled"; statusBadgeClass = "badge-rejected"; bloodBadgeClass = "badge-rejected";
                                        }

                                        if (isDelayed && currentStatus != "Completed" && currentStatus != "Cancelled") {
                                            currentStatus = "Delayed";
                                            statusBadgeClass = "badge-delayed";
                                            progressColor = "#90151C";
                                        }

                                        <tr>
                                            <td><span class="fw-bold text-theme">#@request.RequestId.ToString("D4")</span></td>
                                            <td><strong>@request.ReceiverName</strong></td>
                                            <td><span class="fw-bold text-blood">@request.BloodGroup</span></td>
                                            <td>@request.UnitsRequired units</td>
                                            <td>
                                                @{
                                                    var prio = request.UrgencyLevel?.ToLower() ?? "normal";
                                                    var prioClass = prio == "critical" ? "badge-critical" : (prio == "high" ? "badge-high" : "badge-normal");
                                                }
                                                <span class="badge @prioClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@request.UrgencyLevel</span>
                                            </td>
                                            @* <td><span class="fw-semibold">@stage</span></td> *@
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 8px; border-radius: 50px; background-color: #e9ecef;">
                                                        <div class="progress-bar" role="progressbar" style="width: @progress%; background-color: @progressColor !important;" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="text-muted fw-bold" style="min-width: 35px;">@progress%</small>
                                                </div>
                                            </td>
                                            <td><span class="badge @bloodBadgeClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@bloodStatus</span></td>
                                            <td><span class="badge @statusBadgeClass" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">@currentStatus</span></td>
                                            <td><small class="text-muted">@request.CreatedDate.ToString("dd-MMM-yyyy")</small></td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" 
                                                            data-requestid="@request.RequestId"
                                                            data-name="@request.ReceiverName"
                                                            data-bg="@request.BloodGroup"
                                                            data-units="@request.UnitsRequired"
                                                            data-hospital="@request.HospitalName"
                                                            data-stage="@stage"
                                                            data-blood="@bloodStatus"
                                                            data-status="@currentStatus"
                                                            data-created="@request.CreatedDate.ToString("dd-MMM-yyyy, hh:mm tt")"
                                                            data-required="@(request.RequiredDate?.ToString("dd-MMM-yyyy, hh:mm tt") ?? "N/A")"
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary track-timeline-btn" 
                                                            data-requestid="@request.RequestId"
                                                            data-stage="@stage"
                                                            data-status="@status"
                                                            data-delayed="@(isDelayed ? "true" : "false")"
                                                            title="Track Timeline">
                                                        <i class="bx bx-time-five"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary refresh-status-btn" title="Refresh Status">
                                                        <i class="bx bx-refresh"></i>
                                                    </button>
                                                    @if (status == "blood ready" || status == "reserved" || status == "issued")
                                                    {
                                                        <button type="button" class="btn btn-outline-success complete-request-btn" data-requestid="@request.RequestId" title="Mark Completed">
                                                            <i class="bx bx-check-double"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1 || (Model.Requests.Count > 10)) 
                        {
                            <!-- Note: TotalPages might be 0 if not set in controller, fallback to client-side pagination logic if needed, but keeping standard structure -->
                            <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                <small class="text-muted" id="paginationSummary">
                                    Showing <strong>1</strong> to <strong>@Model.Requests.Count</strong> of <strong>@Model.Requests.Count</strong> requests
                                </small>
                                <nav>
                                    <ul class="pagination pagination-n mb-0">
                                        <li class="page-item disabled">
                                            <a class="page-link" href="#" tabindex="-1"><i class="bi bi-chevron-left"></i> Previous</a>
                                        </li>
                                        <li class="page-item active">
                                            <a class="page-link" href="#">1</a>
                                        </li>
                                        <li class="page-item disabled">
                                            <a class="page-link" href="#">Next <i class="bi bi-chevron-right"></i></a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-clipboard text-theme"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Request Details</h5>
                        <small class="text-muted" id="modalRequestId">REQ-XXXX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-theme"><i class="bx bx-user me-2"></i>Patient Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Receiver Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_ReceiverName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Hospital</label><p class="form-control-plaintext mb-0" id="d_Hospital">-</p></div>
                        </div>

                        <h6 class="fw-bold mb-3 mt-4 text-blood"><i class="bx bx-droplet me-2"></i>Blood Requirement</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-blood mb-0" id="d_BloodGroup">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext mb-0" id="d_Units">-</p></div>
                        </div>

                        <h6 class="fw-bold mb-3 mt-4 text-success-custom"><i class="bx bx-tracking me-2"></i>Tracking Status</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Current Stage</label><p class="form-control-plaintext fw-semibold mb-0" id="d_Stage">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Status</label><p class="form-control-plaintext mb-0" id="d_BloodStatus">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Current Status</label><p class="form-control-plaintext mb-0" id="d_CurrentStatus">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Required By</label><p class="form-control-plaintext mb-0" id="d_Required">-</p></div>
                       9
                        <div class="col-6"><label class="form-label small text-muted mb-1">Created Date</label><p class="form-control-plaintext mb-0" id="d_Created">-</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== TRACK TIMELINE MODAL ==================== -->
<div class="modal fade" id="timelineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-time-five text-theme"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Request Timeline</h5>
                        <small class="text-muted" id="timelineRequestId">REQ-XXXX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="timeline" id="timelineContainer">
                    <!-- Timeline items injected via JS -->
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        console.log("🚀 Request Tracking Script Loaded Successfully!");

        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById('searchInput');
            const filterStatus = document.getElementById('filterStatus');
            const filterPriority = document.getElementById('filterPriority');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterSortBy = document.getElementById('filterSortBy');
            const resetFiltersBtn = document.getElementById('resetFiltersBtn');

            function filterTable() {
                try {
                    const sVal = (searchInput.value || '').toLowerCase().trim();
                    const statVal = (filterStatus.value || 'all').toLowerCase().trim();
                    const prioVal = (filterPriority.value || 'all').toLowerCase().trim();
                    const bgVal = (filterBloodGroup.value || 'all').toLowerCase().trim();
                    const sortBy = filterSortBy.value;

                    const tbody = document.querySelector("#trackingTable tbody");
                    const rows = Array.from(tbody.querySelectorAll("tr"));

                    // Sorting logic
                    if (sortBy === 'priority') {
                        const prioOrder = { 'critical': 1, 'high': 2, 'normal': 3 };
                        rows.sort((a, b) => {
                            const prioA = a.cells[4].querySelector('.badge').textContent.toLowerCase().trim();
                            const prioB = b.cells[4].querySelector('.badge').textContent.toLowerCase().trim();
                            return (prioOrder[prioA] || 99) - (prioOrder[prioB] || 99);
                        });
                    } else if (sortBy === 'oldest') {
                        rows.reverse();
                    } else if (sortBy === 'stage') {
                        rows.sort((a, b) => a.cells[5].textContent.localeCompare(b.cells[5].textContent));
                    }

                    // Re-append sorted rows
                    rows.forEach(row => tbody.appendChild(row));

                    // Filtering logic
                    let visibleCount = 0;
                    rows.forEach(row => {
                        const reqId = row.cells[0].textContent.toLowerCase();
                        const name = row.cells[1].textContent.toLowerCase();
                        const bg = row.cells[2].textContent.toLowerCase();
                        const priority = row.cells[4].querySelector('.badge').textContent.toLowerCase().trim();
                        const stage = row.cells[5].textContent.toLowerCase();
                        const currentStatus = row.cells[8].querySelector('.badge').textContent.toLowerCase().trim();

                        let show = true;
                        if (sVal && !(reqId.includes(sVal) || name.includes(sVal) || bg.includes(sVal))) show = false;
                        if (statVal !== 'all' && currentStatus !== statVal) show = false;
                        if (prioVal !== 'all' && priority !== prioVal) show = false;
                        if (bgVal !== 'all' && bg !== bgVal) show = false;

                        if (show) visibleCount++;
                        row.style.display = show ? "" : "none";
                    });

                    const summaryEl = document.getElementById('paginationSummary');
                    if (summaryEl) {
                        summaryEl.innerHTML = `Showing <strong>${visibleCount > 0 ? 1 : 0}</strong> to <strong>${visibleCount}</strong> of <strong>${visibleCount}</strong> requests`;
                    }
                } catch (error) {
                    console.error("Error in filterTable:", error);
                }
            }

            [searchInput, filterStatus, filterPriority, filterBloodGroup, filterSortBy].forEach(el => {
                if (el) {
                    el.addEventListener('input', filterTable);
                    el.addEventListener('change', filterTable);
                }
            });

            if (resetFiltersBtn) {
                resetFiltersBtn.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (filterStatus) filterStatus.value = 'all';
                    if (filterPriority) filterPriority.value = 'all';
                    if (filterBloodGroup) filterBloodGroup.value = 'all';
                    if (filterSortBy) filterSortBy.value = 'newest';
                    filterTable();
                });
            }

            filterTable();

            // ==================== EVENT DELEGATION ====================
            document.getElementById('trackingTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target);
                } else if (target.classList.contains('track-timeline-btn')) {
                    openTimelineModal(target);
                } else if (target.classList.contains('refresh-status-btn')) {
                    showNotification('Status refreshed successfully!', 'success');
                } else if (target.classList.contains('complete-request-btn')) {
                    showNotification('Request marked as completed!', 'success');
                }
            });

            // ==================== VIEW DETAILS MODAL ====================
            function openViewDetailsModal(btn) {
                document.getElementById('modalRequestId').textContent = `REQ-${String(btn.getAttribute('data-requestid')).padStart(4, '0')}`;
                document.getElementById('d_ReceiverName').textContent = btn.getAttribute('data-name') || '-';
                document.getElementById('d_Hospital').textContent = btn.getAttribute('data-hospital') || '-';
                document.getElementById('d_BloodGroup').textContent = btn.getAttribute('data-bg') || '-';
                document.getElementById('d_Units').textContent = (btn.getAttribute('data-units') || '-') + ' units';
                document.getElementById('d_Stage').textContent = btn.getAttribute('data-stage') || '-';
                document.getElementById('d_BloodStatus').textContent = btn.getAttribute('data-blood') || '-';
                document.getElementById('d_CurrentStatus').textContent = btn.getAttribute('data-status') || '-';
                document.getElementById('d_Required').textContent = btn.getAttribute('data-required') || '-';
                document.getElementById('d_Created').textContent = btn.getAttribute('data-created') || '-';

                const modal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                modal.show();
            }

            // ==================== TRACK TIMELINE MODAL ====================
            function openTimelineModal(btn) {
                const reqId = btn.getAttribute('data-requestid');
                const stage = btn.getAttribute('data-stage').toLowerCase();
                const status = btn.getAttribute('data-status').toLowerCase();
                const isDelayed = btn.getAttribute('data-delayed') === 'true';

                document.getElementById('timelineRequestId').textContent = `REQ-${String(reqId).padStart(4, '0')}`;

                const steps = [
                    "Request Created",
                    "Hospital Approved",
                    "Inventory Checked",
                    "Searching Donor",
                    "Donor Accepted",
                    "Blood Collected",
                    "Inventory Updated",
                    "Blood Issued",
                    "Completed"
                ];

                let activeIndex = 0;
                if (status === 'completed' || status === 'fulfilled') activeIndex = 8;
                else if (status === 'issued') activeIndex = 7;
                else if (stage.includes('inventory updated')) activeIndex = 6;
                else if (stage.includes('blood collected')) activeIndex = 5;
                else if (stage.includes('donor assigned')) activeIndex = 4;
                else if (stage.includes('searching donor')) activeIndex = 3;
                else if (status === 'approved') activeIndex = 1;
                else activeIndex = 0;

                if (status === 'cancelled' || status === 'rejected') activeIndex = -1; // Special handling

                let html = '';
                steps.forEach((step, index) => {
                    let itemClass = '';
                    if (index < activeIndex) itemClass = 'completed';
                    else if (index === activeIndex) itemClass = isDelayed ? 'delayed' : 'active';
                    
                    const timeText = index <= activeIndex ? 'Completed' : (index === activeIndex + 1 ? 'In Progress' : 'Pending');
                    const colorClass = index <= activeIndex ? (isDelayed && index === activeIndex ? 'text-danger-custom' : 'text-success-custom') : 'text-muted';

                    html += `
                        <div class="timeline-item ${itemClass}">
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-semibold">${step}</h6>
                                    <small class="${colorClass} fw-bold">${timeText}</small>
                                </div>
                            </div>
                        </div>
                    `;
                });

                if (status === 'cancelled' || status === 'rejected') {
                    html += `
                        <div class="timeline-item delayed">
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-semibold text-danger-custom">Request ${status === 'cancelled' ? 'Cancelled' : 'Rejected'}</h6>
                                    <small class="text-danger-custom fw-bold">Workflow Stopped</small>
                                </div>
                            </div>
                        </div>
                    `;
                }

                document.getElementById('timelineContainer').innerHTML = html;
                const modal = new bootstrap.Modal(document.getElementById('timelineModal'));
                modal.show();
            }

            // ==================== EXPORT & NOTIFICATIONS ====================
            window.exportTable = function(type, tableId, fileName) {
                const table = document.getElementById(tableId);
                if (!table) { showNotification('Table not found!', 'error'); return; }

                try {
                    if (type === 'excel') {
                        let csv = [];
                        let rows = table.querySelectorAll("tr");
                        for (let i = 0; i < rows.length; i++) {
                            if (rows[i].style.display === 'none') continue;
                            let row = [], cols = rows[i].querySelectorAll("td, th");
                            for (let j = 0; j < cols.length - 1; j++) {
                                let text = cols[j].innerText.replace(/"/g, '""').trim();
                                row.push('"' + text + '"');
                            }
                            csv.push(row.join(","));
                        }
                        if (csv.length <= 1) { showNotification('No records to export!', 'warning'); return; }
                        
                        let csvFile = "\uFEFF" + csv.join("\n");
                        let blob = new Blob([csvFile], { type: 'text/csv;charset=utf-8;' });
                        let url = URL.createObjectURL(blob);
                        let link = document.createElement("a");
                        link.href = url;
                        link.download = fileName + '.csv';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        showNotification('Excel Export Successful', 'success');
                    } else {
                        if (typeof window.jspdf === 'undefined') { showNotification('PDF library not loaded!', 'error'); return; }
                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF('l', 'mm', 'a4');

                        doc.setFontSize(18);
                        doc.setTextColor(92, 136, 168);
                        doc.text("Request Tracking Report", 14, 20);
                        doc.setFontSize(10);
                        doc.setTextColor(108, 117, 125);
                        doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 30);

                        const rows = [];
                        table.querySelectorAll("tbody tr").forEach(tr => {
                            if (tr.style.display !== 'none') {
                                const cells = tr.querySelectorAll("td");
                                if (cells.length >= 10) {
                                    rows.push([
                                        cells[0].innerText.trim(), cells[1].innerText.trim(), cells[2].innerText.trim(),
                                        cells[3].innerText.trim(), cells[4].innerText.trim(), cells[5].innerText.trim(),
                                        cells[7].innerText.trim(), cells[8].innerText.trim(), cells[9].innerText.trim()
                                    ]);
                                }
                            }
                        });

                        if (rows.length === 0) { showNotification('No records to export!', 'warning'); return; }

                        doc.autoTable({
                            startY: 40,
                            head: [['ID', 'Patient', 'Blood Group', 'Units', 'Priority', 'Stage', 'Blood Status', 'Current Status', 'Last Updated']],
                            body: rows,
                            theme: 'grid',
                            headStyles: { fillColor: [92, 136, 168], textColor: 255, fontSize: 9 },
                            styles: { fontSize: 8, cellPadding: 2, overflow: 'linebreak' }
                        });

                        doc.save(`${fileName}.pdf`);
                        showNotification('PDF Export Successful', 'success');
                    }
                } catch (error) {
                    console.error("💥 Export Error:", error);
                    showNotification('Export failed: ' + error.message, 'error');
                }
            };

            function showNotification(message, type = "success") {
                const old = document.getElementById("customNotification");
                if (old) old.remove();

                const notification = document.createElement("div");
                notification.id = "customNotification";
                let bg = "#5C88A8", icon = "✔";
                if (type === "error") { bg = "#90151C"; icon = "✖"; }
                else if (type === "warning") { bg = "#ECBD35"; icon = "⚠"; }

                notification.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 12px; padding: 16px 24px; background: ${bg}; color: #ffffff; border-radius: 12px; box-shadow: none; font-family: system-ui, -apple-system, sans-serif; font-weight: 600; font-size: 15px; z-index: 9999999999; border: 1px solid rgba(255,255,255,0.1);">
                        <span style="font-size: 20px; line-height: 1;">${icon}</span>
                        <span>${message}</span>
                    </div>`;

                notification.style.cssText = `position: fixed !important; top: 20px !important; right: 20px !important; z-index: 2147483647 !important; margin: 0 !important; padding: 0 !important; pointer-events: auto !important; animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;`;

                if (!document.getElementById('notification-anim-style')) {
                    const style = document.createElement('style');
                    style.id = 'notification-anim-style';
                    style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                    document.head.appendChild(style);
                }

                document.documentElement.appendChild(notification);
                setTimeout(() => {
                    notification.style.transition = "all 0.4s ease";
                    notification.style.opacity = "0";
                    notification.style.transform = "translateX(400px)";
                    notification.style.pointerEvents = "none";
                    setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
                }, 3000);
            }
        });
    </script>
}