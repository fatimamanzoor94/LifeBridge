<!-- ==================== CHART.JS INITIALIZATION ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof Chart !== 'undefined') {
                // Exact Admin Dashboard Chart Defaults
                Chart.defaults.font.family = "'Public Sans', 'Inter', system-ui, sans-serif";
                Chart.defaults.color = '#898F99';
                Chart.defaults.plugins.legend.labels.usePointStyle = true;
                Chart.defaults.plugins.legend.labels.pointStyle = 'circle';
                Chart.defaults.plugins.legend.labels.padding = 20;
                Chart.defaults.plugins.legend.labels.color = '#898F99';
                Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(6, 49, 84, 0.95)';
                Chart.defaults.plugins.tooltip.titleColor = '#ffffff';
                Chart.defaults.plugins.tooltip.bodyColor = '#ffffff';
                Chart.defaults.plugins.tooltip.titleFont = { size: 13, weight: '600' };
                Chart.defaults.plugins.tooltip.bodyFont = { size: 12 };
                Chart.defaults.plugins.tooltip.padding = 12;
                Chart.defaults.plugins.tooltip.cornerRadius = 8;
                Chart.defaults.plugins.tooltip.displayColors = true;
                Chart.defaults.plugins.tooltip.boxPadding = 4;

                const theme = ['#0E1A2B', '#5C88A8', '#06162B', '#2F6E9B', '#0B2342', '#214D72', '#0A1A33', '#223A5E', '#1C2F57', '#0F2E57'];

                // 1. Monthly Blood Usage Trend (STACKED BAR CHART with REAL DATA)
                const usageCtx = document.getElementById('monthlyUsageChart');
                if (usageCtx) {
                    const monthlyByGroup = @Html.Raw(Json.Serialize(Model.MonthlyBloodUsageByGroup));
                    const months = Object.keys(monthlyByGroup);
                    const bloodGroups = ["A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-"];

                    // Check if there is any data at all
                    const totalUsage = Object.values(monthlyByGroup).reduce((sum, monthData) => {
                        return sum + Object.values(monthData).reduce((mSum, val) => mSum + val, 0);
                    }, 0);

                    if (totalUsage === 0) {
                        // Smart Fallback: Show message if no data
                        usageCtx.parentElement.innerHTML = `
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted" style="min-height: 320px;">
                                <div class="text-center">
                                    <i class="bi bi-graph-down fs-1 d-block mb-2" style="color: #D1D5DB;"></i>
                                    <p class="mb-0">No blood usage data recorded in the last 6 months.</p>
                                    <small class="text-muted">Data will appear here once blood is issued to patients.</small>
                                </div>
                            </div>`;
                    } else {
                        // Theme Colors (Same as Admin Dashboard)
                        const themeColors = ['#0E1A2B', '#5C88A8', '#06162B', '#2F6E9B', '#0B2342', '#214D72', '#0A1A33', '#223A5E'];

                        // Build datasets for each blood group
                        const datasets = bloodGroups.map((group, index) => ({
                            label: group,
                            data: months.map(month => monthlyByGroup[month][group] || 0),
                            backgroundColor: themeColors[index % themeColors.length],
                            borderRadius: 4,
                            borderSkipped: false,
                            barPercentage: 0.8,
                            categoryPercentage: 0.9
                        }));

                        new Chart(usageCtx.getContext('2d'), {
                            type: 'bar',
                            data: {
                                labels: months,
                                datasets: datasets
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                interaction: { mode: 'index', intersect: false },
                                plugins: {
                                    legend: {
                                        position: 'top',
                                        align: 'end',
                                        labels: {
                                            usePointStyle: true,
                                            pointStyle: 'circle',
                                            padding: 15,
                                            font: { size: 11, weight: '500' },
                                            color: '#898F99'
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(6, 49, 84, 0.95)',
                                        titleColor: '#ffffff',
                                        bodyColor: '#ffffff',
                                        padding: 12,
                                        cornerRadius: 8,
                                        callbacks: {
                                            label: function(context) {
                                                return ' ' + context.dataset.label + ': ' + context.parsed.y + ' Units';
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        stacked: true,
                                        grid: { display: false },
                                        border: { display: false },
                                        ticks: { color: '#898F99', padding: 10, font: { size: 11, weight: '500' } }
                                    },
                                    y: {
                                        stacked: true,
                                        beginAtZero: true,
                                        grid: { color: 'rgba(137,143,153,0.12)', drawBorder: false },
                                        border: { display: false },
                                        ticks: {
                                            color: '#898F99',
                                            padding: 15,
                                            font: { size: 11, weight: '500' },
                                            stepSize: 1,
                                            callback: function(value) { return value; }
                                        }
                                    }
                                }
                            }
                        });
                    }
                }

                // 2. Inventory Health Status (Doughnut Chart) with Smart Fallback
                const statusCtx = document.getElementById('inventoryStatusChart');
                if (statusCtx) {
                    const statusData = [@availableStock, @lowStock, @criticalStock];
                    const totalStatus = statusData.reduce((a, b) => a + b, 0);

                    if (totalStatus === 0) {
                        statusCtx.parentElement.innerHTML = `
                                            <div class="d-flex align-items-center justify-content-center h-100 text-muted" style="min-height: 320px;">
                                                <div class="text-center">
                                                    <i class="bi bi-pie-chart fs-1 d-block mb-2" style="color: #D1D5DB;"></i>
                                                    <p class="mb-0">No inventory data available.</p>
                                                </div>
                                            </div>`;
                    } else {
                        const statusColors = ['#238823', '#FFBF00', '#D2222D']; // Green, Yellow, Red
                        new Chart(statusCtx.getContext('2d'), {
                            type: 'doughnut',
                            data: {
                                labels: ['Available', 'Low Stock', 'Critical'],
                                datasets: [{
                                    data: statusData,
                                    backgroundColor: statusColors,
                                    borderWidth: 0,
                                    hoverOffset: 15,
                                    spacing: 4,
                                    borderRadius: 6
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                cutout: '72%',
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: { padding: 20, font: { size: 12, weight: '500' }, color: '#898F99', usePointStyle: true, pointStyle: 'rectRounded' }
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                                var percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                                return ' ' + context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    }
                }

                // 3. Blood Group Distribution (Line Chart)
                const bgCtx = document.getElementById('bloodGroupChart');
                if (bgCtx) {
                    new Chart(bgCtx.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.BloodGroupDistribution.Keys.Select(k => $"'{k}'")))],
                            datasets: [{
                                label: 'Units',
                                data: [@string.Join(",", Model.BloodGroupDistribution.Values)],
                                borderColor: '#2F6E9B',
                                backgroundColor: 'transparent',
                                borderWidth: 1.8,
                                fill: false,
                                tension: 0.4,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                pointBackgroundColor: '#0E1A2B',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2.5,
                                pointHoverBorderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { grid: { display: false }, border: { display: false }, ticks: { color: '#898F99', padding: 10, font: { size: 11, weight: '500' } } },
                                y: { grid: { color: 'rgba(137,143,153,0.12)', drawBorder: false }, border: { display: false }, ticks: { color: '#898F99', padding: 15, stepSize: 1, font: { size: 11, weight: '500' } } }
                            }
                        }
                    });
                }

                // 4. Request Priority Overview (Line Chart)
                const priorityCtx = document.getElementById('requestPriorityChart');
                if (priorityCtx) {
                    new Chart(priorityCtx.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: ['Critical', 'High', 'Normal'],
                            datasets: [{
                                label: 'Requests',
                                data: [@priorityCritical, @priorityHigh, @priorityNormal],
                                borderColor: '#2F6E9B',
                                backgroundColor: 'transparent',
                                borderWidth: 1.8,
                                fill: false,
                                tension: 0.4,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                pointBackgroundColor: '#0E1A2B',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2.5,
                                pointHoverBorderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { grid: { display: false }, border: { display: false }, ticks: { color: '#898F99', padding: 10, font: { size: 11, weight: '500' } } },
                                y: { grid: { color: 'rgba(137,143,153,0.12)', drawBorder: false }, border: { display: false }, ticks: { color: '#898F99', padding: 15, stepSize: 1, font: { size: 11, weight: '500' } } }
                            }
                        }
                    });
                }
            }
        });
    </script>
}