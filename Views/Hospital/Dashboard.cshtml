@model Khoon_e_Hayat.ViewModels.HospitalDashboardViewModel
@{
    ViewData["Title"] = "Hospital Dashboard";
    Layout = "~/Views/Shared/_HospitalLayout.cshtml";

    // ==========================================
    // REAL-TIME CALCULATIONS FOR CHARTS
    // ==========================================
    var availableStock = Model.BloodInventory.Count(i => i.Status == "Available");
    var lowStock = Model.BloodInventory.Count(i => i.Status == "Low Stock");
    var criticalStock = Model.BloodInventory.Count(i => i.Status == "Critical");

    var allRecentRequests = Model.RecentRequests.Concat(Model.EmergencyRequestList).ToList();
    var priorityCritical = allRecentRequests.Count(r => r.Priority == "Critical" || r.Priority == "Emergency");
    var priorityHigh = allRecentRequests.Count(r => r.Priority == "High");
    var priorityNormal = allRecentRequests.Count(r => r.Priority == "Normal");

    var unreadNotifications = ViewBag.UnreadNotificationCount ?? 0;

    // Debug check for Monthly Usage
    var totalMonthlyUsage = Model.MonthlyBloodUsage.Values.Sum();
}

@functions {
    public string GetStatusBadge(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "fulfilled" => "success",
            "completed" => "success",
            "rejected" => "danger",
            "critical" => "danger",
            "emergency" => "danger",
            "normal" => "info",
            "high" => "warning",
            _ => "secondary"
        };
    }
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">Hospital Dashboard</h4>
                    <small class="text-muted">Welcome back! Manage your blood inventory, requests, and donor assignments.</small>
                </div>
                <span class="badge bg-label-primary rounded-pill px-3 py-2">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- ==================== SUMMARY CARDS ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Blood Units -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Blood Units</h6>
                                <small class="text-muted">@Model.TotalBloodUnits.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Available Blood Groups -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-collection text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Blood Groups</h6>
                                <small class="text-muted">@Model.AvailableBloodGroups.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending Requests -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-hourglass-split text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Pending Requests</h6>
                                <small class="text-muted">@Model.PendingRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Emergency Requests -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle text-danger"></i></div>
                                <h6 class="card-title mt-3 mb-1">Emergencies</h6>
                                <small class="text-danger fw-bold">@Model.EmergencyRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Assigned Donors -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-people text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Assigned Donors</h6>
                                <small class="text-muted">@Model.AssignedDonors.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Low Stock Items -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-octagon text-warning"></i></div>
                                <h6 class="card-title mt-3 mb-1">Low Stock</h6>
                                <small class="text-muted">@lowStock.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Critical Stock -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet-slash text-danger"></i></div>
                                <h6 class="card-title mt-3 mb-1">Critical Stock</h6>
                                <small class="text-muted">@criticalStock.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Notifications -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-bell text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Notifications</h6>
                                <small class="text-muted">@unreadNotifications.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== ANALYTICS SECTION ==================== -->
            <div class="row g-4 mb-4">
                <!-- Monthly Blood Usage Trend -->
                <div class="col-lg-8">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1 fw-semibold">Monthly Blood Usage Trend</h5>
                                    <small class="text-muted">Blood units utilized over the last 6 months</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="chart-container">
                                <canvas id="monthlyUsageChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inventory Health Status -->
                <div class="col-lg-4">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div>
                                <h5 class="mb-1 fw-semibold">Inventory Health</h5>
                                <small class="text-muted">Current stock status distribution</small>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2 d-flex flex-column justify-content-center align-items-center">
                            <div class="chart-container-doughnut">
                                <canvas id="inventoryStatusChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Blood Group Distribution -->
                <div class="col-lg-6">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1 fw-semibold">Blood Group Distribution</h5>
                                    <small class="text-muted">Total units available per blood group</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="chart-container">
                                <canvas id="bloodGroupChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Request Priority Overview -->
                <div class="col-lg-6">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1 fw-semibold">Request Priority Overview</h5>
                                    <small class="text-muted">Distribution of recent request urgencies</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="chart-container">
                                <canvas id="requestPriorityChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== RECENT ACTIVITY SECTION ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Recent Activity</h4>
                            <small class="text-muted">Latest blood requests, emergencies, and system updates</small>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="BloodInventory" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-droplet me-1"></i>Inventory
                            </a>
                            <a asp-action="IncomingRequests" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-clipboard2-pulse me-1"></i>Requests
                            </a>
                            <a asp-action="SmartDonorSearch" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-search me-1"></i>Find Donors
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <!-- ✅ FIXED: Perfect 3-Column Grid with Equal Heights -->
                    <div class="row g-4">
                        <!-- Recent Blood Requests -->
                        <div class="col-lg-4 col-md-12">
                            <div class="activity-column h-100">
                                <h6 class="activity-title mb-3">
                                    <i class="bi bi-clipboard2-pulse text-primary me-2"></i>Recent Requests
                                </h6>
                                <div class="activity-content">
                                    @if (Model.RecentRequests.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var req in Model.RecentRequests.Take(5))
                                            {
                                                <div class="list-group-item border-0 px-0 py-2 mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1 me-2">
                                                            <h6 class="mb-1 fw-medium small">REQ-@req.RequestId.ToString("D4")</h6>
                                                            <p class="small text-muted mb-1">@req.ReceiverName</p>
                                                            <span class="badge bg-@GetStatusBadge(req.Priority) rounded-pill small">@req.Priority</span>
                                                        </div>
                                                        <div class="text-end">
                                                            <p class="fw-semibold small mb-1">@req.BloodGroup (@req.RequiredUnits units)</p>
                                                            <small class="text-muted">@req.RequestDate.ToString("dd MMM")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted empty-state">
                                            <i class="bi bi-clipboard2-x fs-4 d-block mb-2"></i>
                                            <small>No recent requests</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Emergency Requests -->
                        <div class="col-lg-4 col-md-12">
                            <div class="activity-column h-100">
                                <h6 class="activity-title mb-3">
                                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Emergencies
                                </h6>
                                <div class="activity-content">
                                    @if (Model.EmergencyRequestList.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var emergency in Model.EmergencyRequestList.Take(5))
                                            {
                                                <div class="list-group-item border-0 px-0 py-2 mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1 me-2">
                                                            <h6 class="mb-1 fw-medium small">@emergency.ReceiverName</h6>
                                                            <p class="small text-muted mb-1">Blood Group: @emergency.BloodGroup</p>
                                                            <span class="badge bg-danger rounded-pill small">CRITICAL</span>
                                                        </div>
                                                        <div class="text-end">
                                                            <p class="fw-semibold small mb-1 text-danger">@emergency.RequiredUnits Units</p>
                                                            <small class="text-muted">@emergency.RequestDate.ToString("dd MMM")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted empty-state">
                                            <i class="bi bi-shield-check fs-4 d-block mb-2"></i>
                                            <small>No active emergencies</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Recent System Activities -->
                        <div class="col-lg-4 col-md-12">
                            <div class="activity-column h-100">
                                <h6 class="activity-title mb-3">
                                    <i class="bi bi-activity text-success me-2"></i>System Activities
                                </h6>
                                <div class="activity-content">
                                    @if (Model.RecentActivities.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var activity in Model.RecentActivities.Take(5))
                                            {
                                                <div class="list-group-item border-0 px-0 py-2 mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1 me-2">
                                                            <h6 class="mb-1 fw-medium small">@activity.Activity</h6>
                                                            <p class="small text-muted mb-1">@activity.Timestamp.ToString("dd MMM, hh:mm tt")</p>
                                                        </div>
                                                        <div class="text-end">
                                                            <i class="bi @activity.Icon fs-5 text-primary"></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted empty-state">
                                            <i class="bi bi-activity fs-4 d-block mb-2"></i>
                                            <small>No recent activities</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

