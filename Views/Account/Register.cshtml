@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Khoon-e-Hayat</title>
    <link rel="icon" type="image/png" href="~/assets/Favicon.png">

    <!-- Tailwind CSS & Dependencies -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind Config (Matching Landing Page) -->
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        primary: '#23BBB7',
        secondary: '#23BBB7',
        accent: '#90151C',
        success: '#23BBB7',
        background: '#F6F6F6',
        muted: 'black',
        deep: '#063154',
        border: '#bcc5cc',
        },
        fontFamily: {
        sans: ['Inter', 'sans-serif'],
        }
        }
        }
        }
    </script>

    <!-- Custom Styles -->
    <style>
        :root {
        --primary: #23BBB7;
        --secondary: #23BBB7;
        --accent: #90151C;
        --success: #23BBB7;
        --background: #F6F6F6;
        --text-muted: #898F99;
        --deep: #063154;
        --border: #bcc5cc;
        }

        * {
        box-sizing: border-box;
        }

        body {
        font-family: 'Inter', sans-serif;
        color: #1f2937;
        overflow-x: hidden;
        }

        ::-webkit-scrollbar {
        width: 8px;
        }

        ::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.2);
        }

        ::-webkit-scrollbar-thumb {
        background: var(--secondary);
        border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
        background: var(--primary);
        }

        /* Navbar Glass Effect */
        .glass-nav {
        background: rgba(144, 21, 28, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Premium Glassmorphism Card */
        .glass-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.15);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-8px);
        box-shadow: 0 20px 40px 0 rgba(0, 0, 0, 0.25);
        }

        /* Animations */
        @@keyframes fadeInUp {
        from {
        opacity: 0;
        transform: translateY(40px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        @@keyframes float {
        0%, 100% {
        transform: translateY(0px);
        }

        50% {
        transform: translateY(-15px);
        }
        }

        .animate-fadeInUp {
        animation: fadeInUp 0.8s ease forwards;
        }

        .animate-float {
        animation: float 6s ease-in-out infinite;
        }
    </style>
</head>
<body>

    <!-- Full Screen Background Image -->
    <div class="fixed inset-0 z-0" style="background-image: url('../assets/Khoon-e-Hayat-Bg-1.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"></div>

    <!-- Dark Semi-Transparent Overlay (70% Opacity) -->
    <div class="fixed inset-0 z-0 bg-black/70"></div>

    <!-- Subtle Floating Decorative Elements -->
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-20 left-10 w-24 h-24 rounded-full bg-white/5 blur-sm animate-float"></div>
        <div class="absolute bottom-20 right-20 w-32 h-32 rounded-full bg-[#90151C]/20 blur-md animate-float" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 right-10 w-16 h-16 rounded-full bg-[#23BBB7]/20 blur-sm animate-float" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-1/3 left-1/4 w-20 h-20 rounded-full bg-white/5 blur-sm animate-float" style="animation-delay: 1.5s;"></div>
    </div>

    <!-- Success Toast Notification -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[60] bg-[#23BBB7] text-white px-6 py-3 rounded-xl shadow-lg flex items-center space-x-3 animate-fadeInUp">
            <i class="fas fa-check-circle"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ========== MINIMAL TOP NAV ========== -->
    <nav class="fixed top-0 left-0 w-full z-50 glass-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 lg:h-20">
                <!-- Logo -->
                <a href="/" class="flex items-center group">
                    <div class="w-32 h-32 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                        <img src="~/assets/finalLogo-01.png" alt="Khoon-e-Hayat Logo" class="w-full h-full object-contain drop-shadow-lg">
                    </div>
                </a>

                <!-- Right Actions -->
                <div class="flex items-center space-x-4">
                    <span class="text-white/80 text-sm hidden sm:inline">Already have an account?</span>
                    <a href="login-modal.html"
                       class="px-5 py-2 rounded-full border-2 border-white text-white hover:bg-primary hover:border-primary hover:text-white font-semibold transition-all">
                        Login
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ========== MAIN CENTERED CONTENT ========== -->
    <main class="relative z-10 min-h-screen flex items-center justify-center pt-24 pb-12 px-4">
        <div class="w-full max-w-2xl space-y-8">

            <!-- Heading Section -->
            <div class="text-center space-y-4 animate-fadeInUp">
                <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20 mb-2">
                    <i class="fas fa-heart text-[#23BBB7]"></i>
                    <span class="text-sm font-medium text-white/90">Join Our Healthcare Network</span>
                </div>
                <h2 class="text-4xl lg:text-5xl font-extrabold text-white drop-shadow-lg">Choose Your Role</h2>
                <p class="text-lg text-white/70 max-w-lg mx-auto">Select how you want to contribute to saving lives and become a part of the Khoon-e-Hayat community.</p>
            </div>

            <!-- Glassmorphism Cards -->
            <div class="space-y-6">

                <!-- 1. Donor Card -->
                <div class="glass-card rounded-3xl p-6 lg:p-8 group animate-fadeInUp" style="animation-delay: 0.1s;">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
                        <div class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-[#90151C] transition-colors duration-300">
                            <i class="fas fa-hand-holding-heart text-3xl text-white group-hover:scale-110 transition-transform"></i>
                        </div>
                        <div class="flex-1 w-full">
                            <h3 class="text-2xl font-bold text-white mb-2">Register as Donor</h3>
                            <p class="text-white/70 text-sm mb-4">Save lives by donating blood to those in critical need.</p>

                            <!-- Benefits -->
                            <ul class="space-y-2 mb-5">
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Instant Emergency Alerts
                                </li>
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Track Donation History
                                </li>
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Digital Health Certificate
                                </li>
                            </ul>

                            <a asp-action="RegisterDonor" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-[#1A9A96] text-white font-semibold hover:bg-[#1A9A96] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                                Become a Donor <i class="fas fa-arrow-right ml-2 text-sm"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 2. Receiver Card -->
                <div class="glass-card rounded-3xl p-6 lg:p-8 group animate-fadeInUp" style="animation-delay: 0.2s;">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
                        <div class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-[#90151C] transition-colors duration-300">
                            <i class="fas fa-droplet text-3xl text-white group-hover:scale-110 transition-transform"></i>
                        </div>
                        <div class="flex-1 w-full">
                            <h3 class="text-2xl font-bold text-white mb-2">Register as Receiver</h3>
                            <p class="text-white/70 text-sm mb-4">Request blood urgently from our verified donor network.</p>

                            <!-- Benefits -->
                            <ul class="space-y-2 mb-5">
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Urgent Blood Requests
                                </li>
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Find Nearby Donors
                                </li>
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Real-time Status Updates
                                </li>
                            </ul>

                            <a asp-action="RegisterReceiver" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-[#1A9A96] text-white font-semibold hover:bg-[#1A9A96] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                                Request Blood <i class="fas fa-arrow-right ml-2 text-sm"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 3. Hospital Card -->
                <div class="glass-card rounded-3xl p-6 lg:p-8 group animate-fadeInUp" style="animation-delay: 0.3s;">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
                        <div class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-[#90151C] transition-colors duration-300">
                            <i class="fas fa-hospital text-3xl text-white group-hover:scale-110 transition-transform"></i>
                        </div>
                        <div class="flex-1 w-full">
                            <h3 class="text-2xl font-bold text-white mb-2">Register as Hospital</h3>
                            <p class="text-white/70 text-sm mb-4">Manage blood inventory and connect with donors directly.</p>

                            <!-- Benefits -->
                            <ul class="space-y-2 mb-5">
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Manage Blood Inventory
                                </li>
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Verified Donor Network
                                </li>
                                <li class="flex items-center text-sm text-white/80">
                                    <i class="fas fa-check-circle text-[#23BBB7] mr-2"></i> Admin Dashboard Access
                                </li>
                            </ul>

                            <a asp-action="RegisterHospital" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-[#1A9A96] text-white font-semibold hover:bg-[#1A9A96] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                                Register Hospital <i class="fas fa-arrow-right ml-2 text-sm"></i>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

</body>
</html>
