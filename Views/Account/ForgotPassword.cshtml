@model Khoon_e_Hayat.Models.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Khoon-e-Hayat</title>
    <link rel="icon" type="image/png" href="~/assets/Favicon.png">

    <!-- Tailwind CSS & Dependencies -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        primary: '#23BBB7',
        secondary: '#23BBB7',
        accent: '#90151C',
        success: '#23BBB7',
        background: '#F6F6F6',
        muted: 'black',
        deep: '#063154',
        border: '#bcc5cc',
        },
        fontFamily: {
        sans: ['Inter', 'sans-serif'],
        }
        }
        }
        }
    </script>

    <!-- Custom Styles -->
    <style>
        :root {
        --primary: #23BBB7;
        --accent: #90151C;
        }

        * {
        box-sizing: border-box;
        }

        body {
        font-family: 'Inter', sans-serif;
        color: #1f2937;
        overflow-x: hidden;
        }

        ::-webkit-scrollbar {
        width: 8px;
        }

        ::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.2);
        }

        ::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 10px;
        }

        .glass-nav {
        background: rgba(144, 21, 28, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .solid-card {
        background: #FFFFFF;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        border-radius: 30px;
        }

        .form-input-solid {
        background: #F8FAFC;
        border: 1px solid #E5E7EB;
        color: #111827;
        transition: all 0.3s ease;
        }

        .form-input-solid:focus {
        background: #FFFFFF;
        border-color: #23BBB7;
        box-shadow: 0 0 0 4px rgba(35, 187, 183, 0.15);
        outline: none;
        }

        .form-input-solid::placeholder {
        color: #9CA3AF;
        }

        @@keyframes fadeInUp {
        from {
        opacity: 0;
        transform: translateY(40px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        @@keyframes float {
        0%, 100% {
        transform: translateY(0px);
        }

        50% {
        transform: translateY(-15px);
        }
        }

        .animate-fadeInUp {
        animation: fadeInUp 0.8s ease forwards;
        }

        .animate-float {
        animation: float 6s ease-in-out infinite;
        }

        .validation-summary-valid {
        display: none !important;
        }

        .validation-summary-errors {
        display: block !important;
        animation: fadeInUp 0.5s ease;
        }

        .validation-summary-errors ul {
        list-style: none;
        padding: 0;
        margin: 0;
        }

        .validation-summary-errors li {
        padding: 4px 0;
        }
    </style>
</head>
<body>

    <!-- Background -->
    <div class="fixed inset-0 z-0" style="background-image: url('../assets/Khoon-e-Hayat-Bg-1.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"></div>
    <div class="fixed inset-0 z-0 bg-black/70"></div>

    <!-- Floating Shapes -->
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-20 left-10 w-24 h-24 rounded-full bg-white/5 blur-sm animate-float"></div>
        <div class="absolute bottom-20 right-20 w-32 h-32 rounded-full bg-[#90151C]/20 blur-md animate-float" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 right-10 w-16 h-16 rounded-full bg-[#23BBB7]/20 blur-sm animate-float" style="animation-delay: 2s;"></div>
    </div>

    <!-- Success Toast -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[60] bg-[#23BBB7] text-white px-6 py-3 rounded-xl shadow-lg flex items-center space-x-3 animate-fadeInUp">
            <i class="fas fa-check-circle"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Navbar -->
    <nav class="fixed top-0 left-0 w-full z-50 glass-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 lg:h-20">
                <a href="/" class="flex items-center group">
                    <div class="w-32 h-32 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                        <img src="~/assets/finalLogo-01.png" alt="Khoon-e-Hayat Logo" class="w-full h-full object-contain drop-shadow-lg">
                    </div>
                </a>

                @* <div class="flex items-center space-x-4">
                    <span class="text-white/80 text-sm hidden sm:inline">Need help?</span>
                    <a href="mailto:support@khoonehayat.com" class="px-5 py-2 rounded-full border-2 border-white text-white hover:bg-white hover:text-[#90151C] font-semibold transition-all shadow-lg">
                        Contact Support
                    </a>
                </div> *@
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 min-h-screen flex items-center justify-center pt-24 pb-12 px-4">
        <div class="w-full max-w-md animate-fadeInUp">
            <div class="solid-card p-8 lg:p-10">

                <div class="text-center mb-8">
                    <div class="w-20 h-20 mx-auto rounded-full bg-[#23BBB7]/10 flex items-center justify-center mb-4">
                        <i class="fas fa-key text-4xl text-[#23BBB7]"></i>
                    </div>
                    <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mb-3">Forgot Password?</h2>
                    <p class="text-gray-500 text-lg">No worries, we'll send you reset instructions</p>
                </div>

                <form asp-action="ForgotPassword" method="post" id="forgotForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-red-600 bg-red-50 border border-red-200 p-4 rounded-xl mb-6 text-sm font-medium"></div>

                    <div class="mb-6">
                        <label asp-for="Email" class="block text-gray-700 text-sm font-semibold mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-input-solid w-full pl-11 pr-4 py-3.5 rounded-xl transition-colors" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                    </div>

                    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6 flex items-start space-x-3">
                        <i class="fas fa-info-circle text-blue-500 mt-1"></i>
                        <p class="text-blue-700 text-sm">We'll email you a secure link to reset your password. The link expires in 1 hour.</p>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full py-4 rounded-xl bg-[#90151C] hover:bg-[#7A1117] text-white font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2">
                        <i class="fas fa-paper-plane"></i>
                        <span>Send Reset Link</span>
                    </button>
                </form>

                <div class="text-center mt-8">
                    <a asp-controller="Account" asp-action="Login" class="text-[#90151C] hover:text-[#7A1117] font-bold transition-colors flex items-center justify-center space-x-2">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back to Login</span>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
        // Prevent Double Submission
        $('#forgotForm').on('submit', function () {
        const btn = $('#submitBtn');
        const originalHtml = btn.html();

        btn.prop('disabled', true);
        btn.html('<i class="fas fa-spinner fa-spin mr-2"></i> Sending...');

        setTimeout(function() {
        btn.prop('disabled', false);
        btn.html(originalHtml);
        }, 5000);
        });

        // Re-enable button if page loads with errors
        if ($('.validation-summary-errors').length > 0) {
        $('#submitBtn').prop('disabled', false);
        $('#submitBtn').html('<i class="fas fa-paper-plane"></i> <span>Send Reset Link</span>');
        }
        });
    </script>
</body>
</html>