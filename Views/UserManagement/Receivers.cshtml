@model Khoon_e_Hayat.ViewModels.ReceiverListViewModel
@{
    ViewData["Title"] = "Receivers Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Receivers Management</h4>
            </div>

            <!-- ==================== STATISTICS CARDS (Dashboard Design) ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Receivers -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-group text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Receivers</h6>
                                <small class="text-muted">@Model.TotalReceivers.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Verified Receivers -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-badge-check text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Verified Receivers</h6>
                                <small class="text-muted">@Model.VerifiedReceivers.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Active Receivers -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Active Receivers</h6>
                                <small class="text-muted">@Model.ActiveReceivers.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Critical Blood Need -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-error text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Critical Blood Need</h6>
                                <small class="text-muted">@Model.CriticalBloodNeed.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Blood Groups Needed -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-droplet text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Blood Groups Needed</h6>
                                <small class="text-muted">@Model.BloodGroupsNeeded Blood Groups</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Name, Email, Phone, Hospital, City, Blood Group..." />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group Needed</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Urgency Level</label>
                            <select id="filterUrgency" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="critical">Critical</option>
                                <option value="high">High</option>
                                <option value="medium">Medium</option>
                                <option value="low">Low</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Account Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Email Verification</label>
                            <select id="filterVerification" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="verified">Verified</option>
                                <option value="notverified">Not Verified</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">All Receivers</h4>
                            <small class="text-muted">Manage registered blood receivers</small>
                        </div>
                        <!-- Export Buttons -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'receiversTable', 'Receivers')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'receiversTable', 'Receivers')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="receiversTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Receiver ID</th>
                                    <th>Full Name</th>
                                    @* <th>Email</th> *@
                                    @* <th>Phone</th> *@
                                    <th>Blood Group Needed</th>
                                    <th>Hospital Name</th>
                                    @* <th>City</th> *@
                                    <th>Urgency Level</th>
                                    @* <th>Email Verification</th> *@
                                    <th>Account Status</th>
                                    @* <th>Registration Date</th> *@
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Receivers.Any())
                                {
                                    @foreach (var receiver in Model.Receivers)
                                    {
                                        <tr>
                                            <td>REC-@receiver.UserId.ToString("D4")</td>
                                            <td>@receiver.FullName</td>
                                            @* <td>@receiver.Email</td> *@
                                            @* <td>@(receiver.Phone ?? "-")</td> *@
                                            <td>@(receiver.BloodGroupNeeded ?? "-")</td>
                                            <td>@(receiver.HospitalName ?? "-")</td>
                                            @* <td>@(receiver.City ?? "-")</td> *@
                                            <td>
                                                @if (receiver.UrgencyLevel == "Critical")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Critical</span>
                                                }
                                                else if (receiver.UrgencyLevel == "High")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">High</span>
                                                }
                                                else if (receiver.UrgencyLevel == "Medium")
                                                {
                                                    <span class="badge bg-info-subtle text-info">Medium</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Low</span>
                                                }
                                            </td>
                                            @* <td>
                                                @if (receiver.IsEmailVerified)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Verified</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Not Verified</span>
                                                }
                                            </td> *@
                                            <td>
                                                @if (receiver.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                                }
                                            </td>
                                            @* <td>@receiver.CreatedAt.ToString("dd-MMM-yyyy")</td> *@
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <!-- VIEW BUTTON -->
                                                    <button class="btn btn-outline-info view-btn"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#viewReceiverModal"
                                                            data-userid="@receiver.UserId"
                                                            data-fullname="@receiver.FullName"
                                                            title="View Details">
                                                        View
                                                    </button>

                                                    <!-- ACTIVATE / DEACTIVATE -->
                                                    @if (receiver.IsActive)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-danger deactivate-btn"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deactivateReceiverModal"
                                                                data-userid="@receiver.UserId"
                                                                data-receivername="@receiver.FullName"
                                                                title="Deactivate">
                                                            Deactivate
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-success activate-btn"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#activateReceiverModal"
                                                                data-userid="@receiver.UserId"
                                                                data-receivername="@receiver.FullName"
                                                                title="Activate">
                                                            Activate
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <!-- ==================== EMPTY STATE ==================== -->
                                    <tr id="emptyStateRow">
                                        <td colspan="9" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bx bx-droplet fs-1 d-block mb-2 text-danger"></i>
                                                <h5 class="fw-semibold">No Receivers Found</h5>
                                                <p class="mb-0">No registered blood receivers available at the moment.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Receivers: @Model.TotalReceivers</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ACTIVATE RECEIVER MODAL ==================== -->
<div class="modal fade" id="activateReceiverModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #e8f8ee; border: 6px solid white;">
                    <i class="fas fa-check-circle" style="color: #28a745;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Activate Receiver?</h4>
                <p class="text-muted">
                    You are about to activate <strong id="activateReceiverName"></strong><br />
                    This will allow them to access the system again.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmActivateBtn">Activate</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DEACTIVATE RECEIVER MODAL ==================== -->
<div class="modal fade" id="deactivateReceiverModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box">
                    <i class="fas fa-user-slash"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Deactivate Receiver?</h4>
                <p class="text-muted">
                    You are about to deactivate <strong id="deactivateReceiverName"></strong><br />
                    They will no longer be able to access the system.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmDeactivateBtn">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW RECEIVER DETAILS MODAL ==================== -->
<div class="modal fade" id="viewReceiverModal" tabindex="-1" aria-labelledby="viewReceiverModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-user text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewReceiverModalLabel">Receiver Details</h5>
                        <small class="text-muted" id="viewReceiverIdDisplay">REC-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Personal Information Section -->
                        <h6 class="fw-bold text-primary mb-3"><i class="bx bx-user me-2"></i>Personal Information</h6>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Full Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewFullName">-</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-envelope me-1"></i>Email Address</label>
                            <p class="form-control-plaintext mb-0" id="viewEmail">
                                <a href="#" class="text-decoration-none" id="viewEmailLink">-</a>
                            </p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-phone me-1"></i>Phone Number</label>
                            <p class="form-control-plaintext mb-0" id="viewPhone">
                                <a href="#" class="text-decoration-none" id="viewPhoneLink">-</a>
                            </p>
                        </div>

                        <!-- Blood Requirement Information Section -->
                        <h6 class="fw-bold text-danger mb-3 mt-4"><i class="bx bx-droplet me-2"></i>Blood Requirement Information</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-droplet me-1"></i>Blood Group Needed</label>
                                <p class="form-control-plaintext fw-semibold mb-0" id="viewBloodGroupNeeded">-</p>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-error me-1"></i>Urgency Level</label>
                                <span id="viewUrgencyBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Required Date</label>
                                <p class="form-control-plaintext mb-0" id="viewRequiredDate">-</p>
                            </div>
                        </div>

                        <!-- Hospital Information Section -->
                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-map me-2"></i>Hospital Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-buildings me-1"></i>Hospital Name</label>
                                <p class="form-control-plaintext mb-0" id="viewHospitalName">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-map me-1"></i>City</label>
                                <p class="form-control-plaintext mb-0" id="viewCity">-</p>
                            </div>
                        </div>

                        <!-- Account Information Section -->
                        <h6 class="fw-bold text-info mb-3 mt-4"><i class="bx bx-shield me-2"></i>Account Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Email Verification</label>
                                <span id="viewVerificationBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-check-shield me-1"></i>Account Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Registration Date</label>
                                <p class="form-control-plaintext fw-medium mb-0" id="viewCreatedAt">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Dashboard Card Design + Modal Styles) ==================== -->
<style>
    /* ==================== DASHBOARD CARD STYLES ==================== */
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icons-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        transition: background 0.2s ease;
    }

    .custom-card:hover .icons-box {
        background: #e9ecef;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .custom-card:hover .trend-icon {
        opacity: 1;
    }

    /* ==================== DELETE MODAL ANIMATION ==================== */
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        background: #ffffff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icons-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icons-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* ==================== VIEW MODAL ENHANCEMENTS ==================== */
    #viewReceiverModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewReceiverModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    #viewReceiverModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        #viewReceiverModal .card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    @@media (max-width: 576px) {
        #viewReceiverModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewReceiverModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==================== SEARCH & FILTER FUNCTIONALITY ====================
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterUrgency = document.getElementById('filterUrgency');
            const filterStatus = document.getElementById('filterStatus');
            const filterVerification = document.getElementById('filterVerification');
            const emptyStateRow = document.getElementById('emptyStateRow');

            function filterTable() {
                const searchVal = searchInput.value.toLowerCase().trim();
                const bloodGroupVal = filterBloodGroup.value.toLowerCase();
                const urgencyVal = filterUrgency.value.toLowerCase();
                const statusVal = filterStatus.value.toLowerCase();
                const verificationVal = filterVerification.value.toLowerCase();

                const rows = document.querySelectorAll("#receiversTable tbody tr");
                let visibleCount = 0;

                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    // ✅ UPDATED INDICES (Based on your actual visible columns)
                    // Columns: 0=ID, 1=Name, 2=BloodGroup, 3=Hospital, 4=Urgency, 5=Status, 6=Actions
                    const name = row.cells[1]?.textContent.toLowerCase() || '';
                    const bloodGroup = row.cells[2]?.textContent.toLowerCase() || '';
                    const hospital = row.cells[3]?.textContent.toLowerCase() || '';

                    const urgencyBadge = row.cells[4]?.querySelector('.badge');
                    const urgencyText = urgencyBadge ? urgencyBadge.textContent.toLowerCase() : '';

                    const statusBadge = row.cells[5]?.querySelector('.badge');
                    const isActive = statusBadge && statusBadge.classList.contains('bg-success-subtle');

                    // Note: Email Verification column is commented out, so we skip that filter
                    // For verification filter, we'll just show all rows (no column to check)
                    const isVerified = true; // Default to true since column is hidden

                    let showRow = true;

                    // ✅ UPDATED SEARCH FILTER (Removed city since column is commented)
                    if (searchVal) {
                        const matchesSearch = name.includes(searchVal) ||
                                              hospital.includes(searchVal) ||
                                              bloodGroup.includes(searchVal);
                        if (!matchesSearch) showRow = false;
                    }

                    // Blood Group filter
                    if (bloodGroupVal !== 'all' && bloodGroup !== bloodGroupVal) showRow = false;

                    // Urgency filter
                    if (urgencyVal !== 'all' && urgencyText !== urgencyVal) showRow = false;

                    // Status filter
                    if (statusVal !== 'all') {
                        if (statusVal === 'active' && !isActive) showRow = false;
                        if (statusVal === 'inactive' && isActive) showRow = false;
                    }

                    // Verification filter (skipped since column is commented out)
                    // If you uncomment the Email Verification column later,
                    // you'll need to add the logic back here

                    row.style.display = showRow ? "" : "none";
                    if (showRow) visibleCount++;
                });

                initializePagination();
            }

            searchInput.addEventListener("input", filterTable);
            filterBloodGroup.addEventListener("change", filterTable);
            filterUrgency.addEventListener("change", filterTable);
            filterStatus.addEventListener("change", filterTable);
            filterVerification.addEventListener("change", filterTable);

            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function initializePagination() {
                const visibleRows = Array.from(document.querySelectorAll("#receiversTable tbody tr"))
                    .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                const pageCount = Math.ceil(visibleRows.length / rowsPerPage);

                if (currentPage > pageCount && pageCount > 0) {
                    currentPage = pageCount;
                } else if (pageCount === 0) {
                    currentPage = 1;
                }

                displayTablePage(currentPage, visibleRows);
            }

            function displayTablePage(page, visibleRows) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                document.querySelectorAll("#receiversTable tbody tr").forEach(row => {
                    if (row.id !== 'emptyStateRow') {
                        row.style.display = 'none';
                    }
                });

                visibleRows.forEach((row, index) => {
                    if (index >= start && index < end) {
                        row.style.display = '';
                    }
                });

                updatePaginationButtons(visibleRows.length);
            }

            function updatePaginationButtons(totalVisibleRows) {
                pagination.innerHTML = "";
                const pageCount = Math.ceil(totalVisibleRows / rowsPerPage);

                if (pageCount <= 1) return;

                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prevLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage > 1) {
                        const visibleRows = Array.from(document.querySelectorAll("#receiversTable tbody tr"))
                            .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                        displayTablePage(currentPage - 1, visibleRows);
                    }
                });
                pagination.appendChild(prevLi);

                for (let i = 1; i <= pageCount; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${currentPage === i ? "active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", function (e) {
                        e.preventDefault();
                        const visibleRows = Array.from(document.querySelectorAll("#receiversTable tbody tr"))
                            .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                        displayTablePage(i, visibleRows);
                    });
                    pagination.appendChild(li);
                }

                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                nextLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage < pageCount) {
                        const visibleRows = Array.from(document.querySelectorAll("#receiversTable tbody tr"))
                            .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                        displayTablePage(currentPage + 1, visibleRows);
                    }
                });
                pagination.appendChild(nextLi);
            }

            initializePagination();

            // ==================== ACTIVATE MODAL ====================
            const activateModal = document.getElementById('activateReceiverModal');
            let currentActivateUserId = null;

            activateModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('activateReceiverName').textContent = button.getAttribute('data-receivername');
                currentActivateUserId = button.getAttribute('data-userid');
            });

            document.getElementById('confirmActivateBtn').addEventListener('click', function () {
                if (currentActivateUserId) {
                    toggleReceiverStatus(currentActivateUserId, true);
                }
            });

            // ==================== DEACTIVATE MODAL ====================
            const deactivateModal = document.getElementById('deactivateReceiverModal');
            let currentDeactivateUserId = null;

            deactivateModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('deactivateReceiverName').textContent = button.getAttribute('data-receivername');
                currentDeactivateUserId = button.getAttribute('data-userid');
            });

            document.getElementById('confirmDeactivateBtn').addEventListener('click', function () {
                if (currentDeactivateUserId) {
                    toggleReceiverStatus(currentDeactivateUserId, false);
                }
            });

            // ==================== AJAX ACTIVATE/DEACTIVATE ====================
            function toggleReceiverStatus(userId, activate) {
                const actionUrl = activate ? '/UserManagement/ActivateReceiver' : '/UserManagement/DeactivateReceiver';

                // Get anti-forgery token - try multiple methods
                let token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                // If not found in inputs, try meta tags
                if (!token) {
                    token = document.querySelector('meta[name="__RequestVerificationToken"]')?.content;
                }

                // If still not found, try cookie
                if (!token) {
                    token = document.cookie.split('; ')
                        .find(row => row.startsWith('__RequestVerificationToken='))
                        ?.split('=')[1];
                }

                const modal = activate ? activateModal : deactivateModal;

                // Build form data
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token || '');
                formData.append('userId', userId);

                fetch(actionUrl, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(modal).hide();
                        showNotification(data.message, 'success');

                        // AJAX update instead of full page reload
                        const rows = document.querySelectorAll("#receiversTable tbody tr");
                        rows.forEach(row => {
                            const viewBtn = row.querySelector('.view-btn');
                            if (viewBtn && viewBtn.getAttribute('data-userid') == userId) {

                                // ✅ UPDATED: Account Status is now at index 5
                                const statusBadge = row.cells[5]?.querySelector('.badge');
                                if (statusBadge) {
                                    if (activate) {
                                        statusBadge.className = 'badge bg-success-subtle text-success';
                                        statusBadge.textContent = 'Active';
                                    } else {
                                        statusBadge.className = 'badge bg-danger-subtle text-danger';
                                        statusBadge.textContent = 'Inactive';
                                    }
                                }

                                // ✅ UPDATED: Actions column is now at index 6
                                const actionCell = row.cells[6];
                                if (actionCell) {
                                    const btnGroup = actionCell.querySelector('.btn-group');
                                    if (btnGroup) {
                                        const existingToggleBtn = btnGroup.querySelector('.activate-btn, .deactivate-btn');
                                        if (existingToggleBtn) existingToggleBtn.remove();

                                        const newBtn = document.createElement('button');
                                        newBtn.type = 'button';
                                        newBtn.setAttribute('data-bs-toggle', 'modal');
                                        newBtn.setAttribute('data-userid', userId);
                                        newBtn.setAttribute('data-receivername', viewBtn.getAttribute('data-fullname'));

                                        if (activate) {
                                            newBtn.className = 'btn btn-outline-danger deactivate-btn';
                                            newBtn.setAttribute('data-bs-target', '#deactivateReceiverModal');
                                            newBtn.title = 'Deactivate';
                                            newBtn.textContent = 'Deactivate';
                                        } else {
                                            newBtn.className = 'btn btn-outline-success activate-btn';
                                            newBtn.setAttribute('data-bs-target', '#activateReceiverModal');
                                            newBtn.title = 'Activate';
                                            newBtn.textContent = 'Activate';
                                        }
                                        btnGroup.appendChild(newBtn);
                                    }
                                }
                            }
                        });
                    } else {
                        showNotification('Error: ' + (data.message || 'Unknown error'), 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Failed to update receiver status. Please check console for details.', 'error');
                });
            }

            // ==================== NOTIFICATION POPUP ====================
            function showNotification(message, type) {
                const bg = type === 'success' ? '#28a745' : '#dc3545';
                const notification = document.createElement('div');
                notification.style.cssText = `
                    position: fixed; top: 20px; right: 20px; z-index: 9999;
                    background: ${bg}; color: white; padding: 12px 20px;
                    border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.2);
                    font-weight: 500; animation: popIn 0.3s ease;
                `;
                notification.textContent = message;
                document.body.appendChild(notification);
                setTimeout(() => notification.remove(), 3000);
            }

            // ==================== VIEW MODAL - Populate Data via AJAX ====================
            const viewModal = document.getElementById('viewReceiverModal');

            viewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const userId = button.getAttribute('data-userid');

                // Show loading state with professional ID format
                document.getElementById('viewReceiverIdDisplay').textContent = `REC-${String(userId).padStart(4, '0')}`;
                document.getElementById('viewFullName').textContent = 'Loading...';

                // Reset all fields
                ['viewEmailLink', 'viewPhoneLink', 'viewBloodGroupNeeded', 'viewRequiredDate',
                 'viewHospitalName', 'viewCity', 'viewCreatedAt'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = '-';
                });

                // Reset badges
                ['viewUrgencyBadge', 'viewVerificationBadge', 'viewStatusBadge'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        el.className = 'badge rounded-pill';
                        el.textContent = '-';
                    }
                });

                // Fetch full details via AJAX
                fetch(`/UserManagement/GetReceiverDetails?userId=${userId}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        // Personal Info
                        document.getElementById('viewFullName').textContent = data.fullName || '-';

                        const emailLink = document.getElementById('viewEmailLink');
                        emailLink.textContent = data.email || '-';
                        emailLink.href = data.email ? `mailto:${data.email}` : '#';

                        const phoneLink = document.getElementById('viewPhoneLink');
                        phoneLink.textContent = data.phone || '-';
                        phoneLink.href = data.phone ? `tel:${data.phone.replace(/\s+/g, '')}` : '#';

                        // Blood Requirement Info
                        document.getElementById('viewBloodGroupNeeded').textContent = data.bloodGroupNeeded || '-';

                        const urgencyBadge = document.getElementById('viewUrgencyBadge');
                        const urgency = data.urgencyLevel || 'Low';
                        urgencyBadge.textContent = urgency;
                        if (urgency === 'Critical') {
                            urgencyBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                        } else if (urgency === 'High') {
                            urgencyBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
                        } else if (urgency === 'Medium') {
                            urgencyBadge.className = 'badge bg-info-subtle text-info rounded-pill';
                        } else {
                            urgencyBadge.className = 'badge bg-secondary-subtle text-secondary rounded-pill';
                        }

                        document.getElementById('viewRequiredDate').textContent = data.requiredDate
                            ? new Date(data.requiredDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                            : '-';

                        // Hospital Info
                        document.getElementById('viewHospitalName').textContent = data.hospitalName || '-';
                        document.getElementById('viewCity').textContent = data.city || '-';

                        // Account Info
                        const verificationBadge = document.getElementById('viewVerificationBadge');
                        if (data.isEmailVerified) {
                            verificationBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                            verificationBadge.textContent = 'Verified';
                        } else {
                            verificationBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                            verificationBadge.textContent = 'Not Verified';
                        }

                        const statusBadge = document.getElementById('viewStatusBadge');
                        if (data.isActive) {
                            statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                            statusBadge.textContent = 'Active';
                        } else {
                            statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                            statusBadge.textContent = 'Inactive';
                        }

                        document.getElementById('viewCreatedAt').textContent = data.createdAt
                            ? new Date(data.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                            : '-';
                    })
                    .catch(error => {
                        console.error('Error fetching receiver details:', error);
                        document.getElementById('viewFullName').textContent = 'Error loading data';
                    });
            });
        });
    </script>
}