@model Khoon_e_Hayat.ViewModels.HospitalListViewModel
@{
    ViewData["Title"] = "Hospitals Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Hospitals Management</h4>
            </div>

            <!-- ==================== STATISTICS CARDS (Dashboard Design) ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Hospitals -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-buildings text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Hospitals</h6>
                                <small class="text-muted">@Model.TotalHospitals.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Verified Hospitals -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-badge-check text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Verified Hospitals</h6>
                                <small class="text-muted">@Model.VerifiedHospitals.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending Verification -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-time-five text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Verification</h6>
                                <small class="text-muted">@Model.PendingVerification.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Rejected Hospitals -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-x-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Rejected Hospitals</h6>
                                <small class="text-muted">@Model.RejectedHospitals.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Active Hospitals -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bx bx-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Active Hospitals</h6>
                                <small class="text-muted">@Model.ActiveHospitals.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Name, Email, License, Contact, City..." />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Verification Status</label>
                            <select id="filterVerificationStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="approved">Approved</option>
                                <option value="pending">Pending</option>
                                <option value="rejected">Rejected</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Account Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">City</label>
                            <select id="filterCity" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var city in Model.AvailableCities)
                                {
                                    <option value="@city.ToLower()">@city</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Email Verification</label>
                            <select id="filterEmailVerification" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="verified">Verified</option>
                                <option value="notverified">Not Verified</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">All Hospitals</h4>
                            <small class="text-muted">Manage registered hospitals</small>
                        </div>
                        <!-- Export Buttons -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'hospitalsTable', 'Hospitals')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'hospitalsTable', 'Hospitals')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="hospitalsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Hospital ID</th>
                                    <th>Hospital Name</th>
                                    @* <th>Email</th> *@
                                    @* <th>License Number</th> *@
                                    <th>Contact Person</th>
                                    <th>City</th>
                                    <th>Verification Status</th>
                                    <th>Email Verification</th>
                                    <th>Account Status</th>
                                    @* <th>Registration Date</th> *@
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Hospitals.Any())
                                {
                                    @foreach (var hospital in Model.Hospitals)
                                    {
                                        <tr>
                                            <td>HSP-@hospital.UserId.ToString("D4")</td>
                                            <td>@hospital.HospitalName</td>
                                            @* <td>@hospital.Email</td> *@
                                            @* <td>@(hospital.LicenseNumber ?? "-")</td> *@
                                            <td>@(hospital.ContactPerson ?? "-")</td>
                                            <td>@(hospital.City ?? "-")</td>
                                            <td>
                                                @if (hospital.VerificationStatus == "Approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Approved</span>
                                                }
                                                else if (hospital.VerificationStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                @if (hospital.IsEmailVerified)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Verified</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Not Verified</span>
                                                }
                                            </td>
                                            <td>
                                                @if (hospital.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                                }
                                            </td>
                                            @* <td>@hospital.CreatedAt.ToString("dd-MMM-yyyy")</td> *@
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <!-- VIEW BUTTON -->
                                                    <button class="btn btn-outline-info view-btn"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#viewHospitalModal"
                                                            data-userid="@hospital.UserId"
                                                            data-fullname="@hospital.HospitalName"
                                                            title="View Details">
                                                        View
                                                    </button>

                                                    <!-- ACTIVATE / DEACTIVATE -->
                                                    @if (hospital.IsActive)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-danger deactivate-btn"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deactivateHospitalModal"
                                                                data-userid="@hospital.UserId"
                                                                data-hospitalname="@hospital.HospitalName"
                                                                title="Deactivate">
                                                            Deactivate
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-success activate-btn"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#activateHospitalModal"
                                                                data-userid="@hospital.UserId"
                                                                data-hospitalname="@hospital.HospitalName"
                                                                title="Activate">
                                                            Activate
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <!-- ==================== EMPTY STATE ==================== -->
                                    <tr id="emptyStateRow">
                                        <td colspan="9" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bx bx-buildings fs-1 d-block mb-2 text-danger"></i>
                                                <h5 class="fw-semibold">No Hospitals Found</h5>
                                                <p class="mb-0">No registered hospitals available at the moment.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Hospitals: @Model.TotalHospitals</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ACTIVATE HOSPITAL MODAL ==================== -->
<div class="modal fade" id="activateHospitalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #e8f8ee; border: 6px solid white;">
                    <i class="fas fa-check-circle" style="color: #28a745;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Activate Hospital?</h4>
                <p class="text-muted">
                    You are about to activate <strong id="activateHospitalName"></strong><br />
                    This will allow them to access the system again.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmActivateBtn">Activate</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DEACTIVATE HOSPITAL MODAL ==================== -->
<div class="modal fade" id="deactivateHospitalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box">
                    <i class="fas fa-user-slash"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Deactivate Hospital?</h4>
                <p class="text-muted">
                    You are about to deactivate <strong id="deactivateHospitalName"></strong><br />
                    They will no longer be able to access the system.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmDeactivateBtn">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW HOSPITAL DETAILS MODAL ==================== -->
<div class="modal fade" id="viewHospitalModal" tabindex="-1" aria-labelledby="viewHospitalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-buildings text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewHospitalModalLabel">Hospital Details</h5>
                        <small class="text-muted" id="viewHospitalIdDisplay">HSP-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Hospital Information Section -->
                        <h6 class="fw-bold text-primary mb-3"><i class="bx bx-buildings me-2"></i>Hospital Information</h6>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-buildings me-1"></i>Hospital Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewHospitalName">-</p>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-file me-1"></i>License Number</label>
                                <p class="form-control-plaintext mb-0" id="viewLicenseNumber">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Contact Person</label>
                                <p class="form-control-plaintext mb-0" id="viewContactPerson">-</p>
                            </div>
                        </div>

                        <!-- Account Information Section -->
                        <h6 class="fw-bold text-info mb-3 mt-4"><i class="bx bx-shield me-2"></i>Account Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-envelope me-1"></i>Email</label>
                                <p class="form-control-plaintext mb-0" id="viewEmail">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-phone me-1"></i>Phone</label>
                                <p class="form-control-plaintext mb-0" id="viewPhone">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Email Verification</label>
                                <span id="viewEmailVerificationBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-check-shield me-1"></i>Account Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Registration Date</label>
                                <p class="form-control-plaintext fw-medium mb-0" id="viewCreatedAt">-</p>
                            </div>
                        </div>

                        <!-- Location Information Section -->
                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-map me-2"></i>Location Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-map me-1"></i>Address</label>
                                <p class="form-control-plaintext mb-0" id="viewAddress">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-map-pin me-1"></i>City</label>
                                <p class="form-control-plaintext mb-0" id="viewCity">-</p>
                            </div>
                        </div>

                        <!-- Verification Information Section -->
                        <h6 class="fw-bold text-warning mb-3 mt-4"><i class="bx bx-check-double me-2"></i>Verification Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-check-circle me-1"></i>Verification Status</label>
                                <span id="viewVerificationStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-file me-1"></i>License Document</label>
                                <p class="form-control-plaintext mb-0" id="viewLicenseDocument">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Dashboard Card Design + Modal Styles) ==================== -->
<style>
    /* ==================== DASHBOARD CARD STYLES ==================== */
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icons-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        transition: background 0.2s ease;
    }

    .custom-card:hover .icons-box {
        background: #e9ecef;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .custom-card:hover .trend-icon {
        opacity: 1;
    }

    /* ==================== DELETE MODAL ANIMATION ==================== */
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        background: #ffffff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icons-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icons-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* ==================== VIEW MODAL ENHANCEMENTS ==================== */
    #viewHospitalModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewHospitalModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    #viewHospitalModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        #viewHospitalModal .card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    @@media (max-width: 576px) {
        #viewHospitalModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewHospitalModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==================== SEARCH & FILTER FUNCTIONALITY ====================
            const searchInput = document.getElementById('searchInput');
            const filterVerificationStatus = document.getElementById('filterVerificationStatus');
            const filterStatus = document.getElementById('filterStatus');
            const filterCity = document.getElementById('filterCity');
            const filterEmailVerification = document.getElementById('filterEmailVerification');
            const emptyStateRow = document.getElementById('emptyStateRow');

            function filterTable() {
                const searchVal = searchInput.value.toLowerCase().trim();
                const verifStatusVal = filterVerificationStatus.value.toLowerCase();
                const statusVal = filterStatus.value.toLowerCase();
                const cityVal = filterCity.value.toLowerCase();
                const emailVerifVal = filterEmailVerification.value.toLowerCase();

                const rows = document.querySelectorAll("#hospitalsTable tbody tr");
                let visibleCount = 0;

                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    // ✅ UPDATED INDICES (Based on your actual visible columns)
                    const name = row.cells[1]?.textContent.toLowerCase() || '';
                    const contact = row.cells[2]?.textContent.toLowerCase() || '';
                    const city = row.cells[3]?.textContent.toLowerCase() || '';

                    const verifStatusBadge = row.cells[4]?.querySelector('.badge');
                    const verifStatusText = verifStatusBadge ? verifStatusBadge.textContent.toLowerCase() : '';

                    const emailVerifBadge = row.cells[5]?.querySelector('.badge');
                    const isEmailVerified = emailVerifBadge && emailVerifBadge.classList.contains('bg-success-subtle');

                    const statusBadge = row.cells[6]?.querySelector('.badge');
                    const isActive = statusBadge && statusBadge.classList.contains('bg-success-subtle');

                    let showRow = true;

                    // ✅ UPDATED SEARCH FILTER (Removed license since it's commented out)
                    if (searchVal) {
                        const matchesSearch = name.includes(searchVal) ||
                                              contact.includes(searchVal) ||
                                              city.includes(searchVal);
                        if (!matchesSearch) showRow = false;
                    }

                    // Verification Status filter
                    if (verifStatusVal !== 'all' && verifStatusText !== verifStatusVal) showRow = false;

                    // Status filter
                    if (statusVal !== 'all') {
                        if (statusVal === 'active' && !isActive) showRow = false;
                        if (statusVal === 'inactive' && isActive) showRow = false;
                    }

                    // City filter
                    if (cityVal !== 'all' && city !== cityVal) showRow = false;

                    // Email Verification filter
                    if (emailVerifVal !== 'all') {
                        if (emailVerifVal === 'verified' && !isEmailVerified) showRow = false;
                        if (emailVerifVal === 'notverified' && isEmailVerified) showRow = false;
                    }

                    row.style.display = showRow ? "" : "none";
                    if (showRow) visibleCount++;
                });

                initializePagination();
            }

            searchInput.addEventListener("input", filterTable);
            filterVerificationStatus.addEventListener("change", filterTable);
            filterStatus.addEventListener("change", filterTable);
            filterCity.addEventListener("change", filterTable);
            filterEmailVerification.addEventListener("change", filterTable);

            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function initializePagination() {
                const visibleRows = Array.from(document.querySelectorAll("#hospitalsTable tbody tr"))
                    .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                const pageCount = Math.ceil(visibleRows.length / rowsPerPage);

                if (currentPage > pageCount && pageCount > 0) {
                    currentPage = pageCount;
                } else if (pageCount === 0) {
                    currentPage = 1;
                }

                displayTablePage(currentPage, visibleRows);
            }

            function displayTablePage(page, visibleRows) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                document.querySelectorAll("#hospitalsTable tbody tr").forEach(row => {
                    if (row.id !== 'emptyStateRow') {
                        row.style.display = 'none';
                    }
                });

                visibleRows.forEach((row, index) => {
                    if (index >= start && index < end) {
                        row.style.display = '';
                    }
                });

                updatePaginationButtons(visibleRows.length);
            }

            function updatePaginationButtons(totalVisibleRows) {
                pagination.innerHTML = "";
                const pageCount = Math.ceil(totalVisibleRows / rowsPerPage);

                if (pageCount <= 1) return;

                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prevLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage > 1) {
                        const visibleRows = Array.from(document.querySelectorAll("#hospitalsTable tbody tr"))
                            .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                        displayTablePage(currentPage - 1, visibleRows);
                    }
                });
                pagination.appendChild(prevLi);

                for (let i = 1; i <= pageCount; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${currentPage === i ? "active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", function (e) {
                        e.preventDefault();
                        const visibleRows = Array.from(document.querySelectorAll("#hospitalsTable tbody tr"))
                            .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                        displayTablePage(i, visibleRows);
                    });
                    pagination.appendChild(li);
                }

                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                nextLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage < pageCount) {
                        const visibleRows = Array.from(document.querySelectorAll("#hospitalsTable tbody tr"))
                            .filter(row => row.style.display !== 'none' && row.id !== 'emptyStateRow');
                        displayTablePage(currentPage + 1, visibleRows);
                    }
                });
                pagination.appendChild(nextLi);
            }

            initializePagination();

            // ==================== ACTIVATE MODAL ====================
            const activateModal = document.getElementById('activateHospitalModal');
            let currentActivateUserId = null;

            activateModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('activateHospitalName').textContent = button.getAttribute('data-hospitalname');
                currentActivateUserId = button.getAttribute('data-userid');
            });

            document.getElementById('confirmActivateBtn').addEventListener('click', function () {
                if (currentActivateUserId) {
                    toggleHospitalStatus(currentActivateUserId, true);
                }
            });

            // ==================== DEACTIVATE MODAL ====================
            const deactivateModal = document.getElementById('deactivateHospitalModal');
            let currentDeactivateUserId = null;

            deactivateModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('deactivateHospitalName').textContent = button.getAttribute('data-hospitalname');
                currentDeactivateUserId = button.getAttribute('data-userid');
            });

            document.getElementById('confirmDeactivateBtn').addEventListener('click', function () {
                if (currentDeactivateUserId) {
                    toggleHospitalStatus(currentDeactivateUserId, false);
                }
            });

            // ==================== AJAX ACTIVATE/DEACTIVATE ====================
            function toggleHospitalStatus(userId, activate) {
                const actionUrl = activate ? '/UserManagement/ActivateHospital' : '/UserManagement/DeactivateHospital';

                // Get anti-forgery token - try multiple methods
                let token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                // If not found in inputs, try meta tags
                if (!token) {
                    token = document.querySelector('meta[name="__RequestVerificationToken"]')?.content;
                }

                // If still not found, try cookie
                if (!token) {
                    token = document.cookie.split('; ')
                        .find(row => row.startsWith('__RequestVerificationToken='))
                        ?.split('=')[1];
                }

                const modal = activate ? activateModal : deactivateModal;

                // Build form data
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token || '');
                formData.append('userId', userId);

                fetch(actionUrl, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(modal).hide();
                        showNotification(data.message, 'success');

                        // AJAX update instead of full page reload
                        const rows = document.querySelectorAll("#hospitalsTable tbody tr");
                        rows.forEach(row => {
                            const viewBtn = row.querySelector('.view-btn');
                            if (viewBtn && viewBtn.getAttribute('data-userid') == userId) {

                                // ✅ UPDATED: Account Status is now at index 6
                                const statusBadge = row.cells[6]?.querySelector('.badge');
                                if (statusBadge) {
                                    if (activate) {
                                        statusBadge.className = 'badge bg-success-subtle text-success';
                                        statusBadge.textContent = 'Active';
                                    } else {
                                        statusBadge.className = 'badge bg-danger-subtle text-danger';
                                        statusBadge.textContent = 'Inactive';
                                    }
                                }

                                // ✅ UPDATED: Actions column is now at index 7
                                const actionCell = row.cells[7];
                                if (actionCell) {
                                    const btnGroup = actionCell.querySelector('.btn-group');
                                    if (btnGroup) {
                                        const existingToggleBtn = btnGroup.querySelector('.activate-btn, .deactivate-btn');
                                        if (existingToggleBtn) existingToggleBtn.remove();

                                        const newBtn = document.createElement('button');
                                        newBtn.type = 'button';
                                        newBtn.setAttribute('data-bs-toggle', 'modal');
                                        newBtn.setAttribute('data-userid', userId);
                                        newBtn.setAttribute('data-hospitalname', viewBtn.getAttribute('data-fullname'));

                                        if (activate) {
                                            newBtn.className = 'btn btn-outline-danger deactivate-btn';
                                            newBtn.setAttribute('data-bs-target', '#deactivateHospitalModal');
                                            newBtn.title = 'Deactivate';
                                            newBtn.textContent = 'Deactivate';
                                        } else {
                                            newBtn.className = 'btn btn-outline-success activate-btn';
                                            newBtn.setAttribute('data-bs-target', '#activateHospitalModal');
                                            newBtn.title = 'Activate';
                                            newBtn.textContent = 'Activate';
                                        }
                                        btnGroup.appendChild(newBtn);
                                    }
                                }
                            }
                        });
                    } else {
                        showNotification('Error: ' + (data.message || 'Unknown error'), 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Failed to update hospital status. Please check console for details.', 'error');
                });
            }

            // ==================== NOTIFICATION POPUP ====================
            function showNotification(message, type) {
                const bg = type === 'success' ? '#28a745' : '#dc3545';
                const notification = document.createElement('div');
                notification.style.cssText = `
                    position: fixed; top: 20px; right: 20px; z-index: 9999;
                    background: ${bg}; color: white; padding: 12px 20px;
                    border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.2);
                    font-weight: 500; animation: popIn 0.3s ease;
                `;
                notification.textContent = message;
                document.body.appendChild(notification);
                setTimeout(() => notification.remove(), 3000);
            }

            // ==================== VIEW MODAL - Populate Data via AJAX ====================
            const viewModal = document.getElementById('viewHospitalModal');

            viewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const userId = button.getAttribute('data-userid');

                // Show loading state with professional ID format
                document.getElementById('viewHospitalIdDisplay').textContent = `HSP-${String(userId).padStart(4, '0')}`;
                document.getElementById('viewHospitalName').textContent = 'Loading...';

                // Reset all fields
                ['viewLicenseNumber', 'viewContactPerson', 'viewEmail', 'viewPhone',
                 'viewAddress', 'viewCity', 'viewCreatedAt', 'viewLicenseDocument'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = '-';
                });

                // Reset badges
                ['viewEmailVerificationBadge', 'viewStatusBadge', 'viewVerificationStatusBadge'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        el.className = 'badge rounded-pill';
                        el.textContent = '-';
                    }
                });

                // Fetch full details via AJAX
                fetch(`/UserManagement/GetHospitalDetails?userId=${userId}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        // Hospital Info
                        document.getElementById('viewHospitalName').textContent = data.hospitalName || '-';
                        document.getElementById('viewLicenseNumber').textContent = data.licenseNumber || '-';
                        document.getElementById('viewContactPerson').textContent = data.contactPerson || '-';

                        // Account Info
                        document.getElementById('viewEmail').textContent = data.email || '-';
                        document.getElementById('viewPhone').textContent = data.phone || '-';

                        const emailVerifBadge = document.getElementById('viewEmailVerificationBadge');
                        if (data.isEmailVerified) {
                            emailVerifBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                            emailVerifBadge.textContent = 'Verified';
                        } else {
                            emailVerifBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                            emailVerifBadge.textContent = 'Not Verified';
                        }

                        const statusBadge = document.getElementById('viewStatusBadge');
                        if (data.isActive) {
                            statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                            statusBadge.textContent = 'Active';
                        } else {
                            statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                            statusBadge.textContent = 'Inactive';
                        }

                        document.getElementById('viewCreatedAt').textContent = data.createdAt
                            ? new Date(data.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                            : '-';

                        // Location Info
                        document.getElementById('viewAddress').textContent = data.address || '-';
                        document.getElementById('viewCity').textContent = data.city || '-';

                        // Verification Info
                        const verifStatusBadge = document.getElementById('viewVerificationStatusBadge');
                        const verStatus = data.verificationStatus || 'Pending';
                        verifStatusBadge.textContent = verStatus;
                        if (verStatus === 'Approved') {
                            verifStatusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                        } else if (verStatus === 'Rejected') {
                            verifStatusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                        } else {
                            verifStatusBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
                        }

                        const licenseDocEl = document.getElementById('viewLicenseDocument');
                        if (data.licenseDocumentPath) {
                            licenseDocEl.innerHTML = `<a href="${data.licenseDocumentPath}" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">View License</a>`;
                        } else {
                            licenseDocEl.textContent = 'Not Uploaded';
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching hospital details:', error);
                        document.getElementById('viewHospitalName').textContent = 'Error loading data';
                    });
            });
        });
    </script>
}