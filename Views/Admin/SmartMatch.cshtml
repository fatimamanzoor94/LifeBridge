@model Khoon_e_Hayat.ViewModels.SmartMatchViewModel
@{
    ViewData["Title"] = "Smart Match Center";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">Smart Match Center</h4>
                    <small class="text-muted">AI-powered donor matching & automated assignment workflow.</small>
                </div>
                <div class="d-flex gap-2">
                    <select id="quickLoadRequest" class="form-select form-select-sm rounded-pill" style="width: 280px;">
                        <option value="">-- Select Pending Request --</option>
                    </select>
                    <button class="btn btn-sm btn-outline-success rounded-pill px-3" id="runAiBtn">
                        <i class="bx bx-refresh me-1"></i> Run AI Engine
                    </button>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-list-ul text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Requests</h6>
                                <small class="text-muted">@Model.TotalMatchRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-time-five text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Active Matches</h6>
                                <small class="text-muted" id="statActive">@Model.ActiveMatches.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Successful</h6>
                                <small class="text-muted">@Model.SuccessfulMatches.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-loader-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Pending</h6>
                                <small class="text-muted" id="statPending">@Model.PendingRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-star text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Avg Score</h6>
                                <small class="text-muted">@Model.AvgMatchScore%</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-user-check text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Available Donors</h6>
                                <small class="text-muted">@Model.AvailableDonors.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Name, Phone, Email..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Availability</label>
                            <select id="filterAvailability" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Eligibility</label>
                            <select id="filterEligibility" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Eligible">Eligible</option>
                                <option value="In Cooldown">In Cooldown</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Sort By</label>
                            <select id="sortBy" class="form-select form-select-sm rounded-pill">
                                <option value="score-desc">Highest Match</option>
                                <option value="dist-asc">Nearest</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill w-100" id="resetFiltersBtn">Reset</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Container (Cards instead of Table) -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">AI Match Results</h4>
                            <small class="text-muted" id="totalMatchesText">Select a request and run AI Engine</small>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div id="matchesContainer" class="row g-3">
                        <!-- Empty State -->
                        <div class="col-12 text-center py-5 text-muted" id="emptyState">
                            <i class="bx bx-search-alt fs-1 d-block mb-2 text-success"></i>
                            <h5 class="fw-semibold">No Matches Found</h5>
                            <p class="mb-0">Select a pending request and click "Run AI Engine" to find compatible donors.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Assign Donor Modal -->
<div class="modal fade" id="assignDonorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper"><div class="icons-box" style="background: #e8f8ee; border: 6px solid white;"><i class="fas fa-user-check" style="color: #28a745;"></i></div></div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Assign Donor?</h4>
                <p class="text-muted">This will automatically send an Email, WhatsApp message, and create notifications for the donor.</p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmAssignBtn">Yes, Assign</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card {
    background: #ffffff;
    border-radius: 16px !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .custom-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
    }

    .icon-box {
    width: 48px;
    height: 48px;
    background: #f8f9fa;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    }

    .trend-icon {
    font-size: 1.5rem;
    color: #28a745;
    opacity: 0.6;
    }

    .delete-modal {
    border-radius: 22px;
    border: none;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
    overflow: visible;
    animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    }

    .icons-box {
    width: 85px;
    height: 85px;
    background: #fff5f5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 6px solid white;
    }

    .icons-box i {
    font-size: 34px;
    color: #ff3b3b;
    }

    @@keyframes popIn {
    from {
    transform: scale(0.8);
    opacity: 0;
    }

    to {
    transform: scale(1);
    opacity: 1;
    }
    }

    /* Match Card Specific Styles - Matching Hospital Design */
    .match-card {
    background: #FFFFFF;
    border: 1px solid #e9ecef;
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    }

    .match-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(16, 24, 40, 0.08);
    border-color: #5C88A8;
    }

    .donor-card-header {
    padding: 20px;
    background: #F8F9FA;
    border-bottom: 1px solid #e9ecef;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    }

    .donor-card-body {
    padding: 20px;
    flex-grow: 1;
    }

    .donor-card-footer {
    padding: 16px 20px;
    border-top: 1px solid #e9ecef;
    display: flex;
    gap: 8px;
    }

    /* Match Score Circle - Matching Hospital */
    .match-score-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    }

    .score-value {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    }

    .score-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-top: 2px;
    }

    .score-perfect {
    /* background: #d4edda; */
    color: #198754;
    }

    .score-excellent {
    /* background: #e6f4ff; */
    color: #5C88A8;
    }

    .score-good {
    /* background: #fff3cd; */
    color: #d39e00;
    }

    .score-fair {
    /* background: #f1f3f5; */
    color: #6c757d;
    }

    /* Donor Info Grid - Matching Hospital */
    .donor-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 16px;
    }

    .donor-info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #6c757d;
    }

    .donor-info-item i {
    color: #5C88A8;
    font-size: 0.9rem;
    }

    .donor-status-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    }

    .availability-badge {
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    }

    .badge-available {
    background: #e6f7ee;
    color: #198754;
    }

    .badge-cooldown {
    background: #fff3cd;
    color: #d39e00;
    }

    .badge-unavailable {
    background: #f1f3f5;
    color: #6c757d;
    }

    .match-reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    }

    .reason-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    color: #6c757d;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
    }

    .reason-tag i {
    color: #5C88A8 !important;
    }

    /* Profile Image - Matching Hospital */
    .donor-avatar-lg {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #5C88A8;
    }

    /* Blood Group Text - Matching Hospital */
    .blood-group-text {
    color: #90151C !important;
    font-size: 1.5rem;
    font-weight: 700;
    }

    .match-score {
    color: #5C88A8 !important;
    font-size: 2rem;
    font-weight: 800;
    }

    /* Progress Bar - Matching Hospital */
    .progress {
    box-shadow: none !important;
    border: none !important;
    background: #edf1f7;
    height: 6px;
    }

    .progress-bar {
    box-shadow: none !important;
    }

    /* Action Buttons - Matching Hospital */
    .btn-action {
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    transition: all 0.2s;
    flex: 1;
    }

    .btn-action:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    }

    .btn-action-primary {
    background: #5C88A8;
    color: #FFFFFF;
    }

    .btn-action-primary:hover:not(:disabled) {
    background: #5C88A8;
    border-color: #5C88A8;
    color: #FFFFFF;
    }

    .btn-action-ghost {
    background: #FFFFFF;
    color: #5C88A8;
    border-color: #e9ecef;
    }

    .btn-action-ghost:hover {
    border-color: #5C88A8;
    background: #e6f4ff;
    }

    /* Responsive - Matching Hospital */
    @@media (max-width: 768px) {
    .donor-info-grid {
    grid-template-columns: 1fr;
    }

    .donor-card-header {
    flex-direction: column;
    gap: 12px;
    }

    .match-score-circle {
    align-self: flex-end;
    }

    .btn-action {
    padding: 6px 10px;
    font-size: 0.75rem;
    }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        let currentDonorId = null;
        let currentRequestId = null;
        let allDonors = [];
        const assignModal = new bootstrap.Modal(document.getElementById('assignDonorModal'));

        // Load Pending Requests
        fetch('/Admin/GetPendingRequests').then(r => r.json()).then(data => {
        const select = document.getElementById('quickLoadRequest');
        data.forEach(req => {
        const opt = document.createElement('option');
        opt.value = req.requestId;
        opt.textContent = `REQ-${String(req.requestId).padStart(4, '0')} | ${req.bloodGroup} | ${req.hospitalName || 'N/A'} | ${req.urgencyLevel}`;
        opt.dataset.bloodGroup = req.bloodGroup;
        opt.dataset.city = req.city;
        opt.dataset.priority = req.urgencyLevel;
        select.appendChild(opt);
        });
        });

        // Run AI Engine
        document.getElementById('runAiBtn').addEventListener('click', function() {
        const select = document.getElementById('quickLoadRequest');
        if (!select.value) { showNotification('Please select a pending request first.', 'warning'); return; }
        currentRequestId = parseInt(select.value);
        findMatches();
        });

        function findMatches() {
        const select = document.getElementById('quickLoadRequest');
        const selectedOption = select.options[select.selectedIndex];
        const fd = new FormData();
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        fd.append('BloodRequestId', currentRequestId);
        fd.append('BloodGroupRequired', selectedOption.dataset.bloodGroup || '');
        fd.append('City', selectedOption.dataset.city || '');

        document.getElementById('matchesContainer').innerHTML = `<div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">AI Engine analyzing...</p></div>`;

        fetch('/Admin/FindDonors', { method: 'POST', body: fd }).then(r => r.json()).then(d => {
        if (d.success) {
        allDonors = d.donors || [];
        renderCards();
        showNotification(`Found ${allDonors.length} compatible donors.`, 'success');
        } else {
        showNotification(d.message || 'Failed.', 'error');
        resetCards();
        }
        });
        }

        function renderCards() {
        const filtered = applyFiltersAndSort();
        const container = document.getElementById('matchesContainer');
        container.innerHTML = '';

        if (filtered.length === 0) {
        container.innerHTML = `<div class="col-12 text-center py-5 text-muted"><i class="bx bx-search-alt fs-1 d-block mb-2"></i><h5>No Matches Found</h5></div>`;
        } else {
        filtered.forEach(d => {
        const scoreClass = d.matchScore >= 85 ? "score-perfect" :
        d.matchScore >= 70 ? "score-excellent" :
        d.matchScore >= 50 ? "score-good" : "score-fair";

        const availabilityClass = d.availabilityStatus === 'Active' ? "badge-available" :
        d.availabilityStatus === 'In Cooldown' ? "badge-cooldown" : "badge-unavailable";

        const isEligible = d.eligibilityStatus === 'Eligible';

        container.innerHTML += `
        <div class="col-md-6 col-lg-4">
        <div class="donor-card">
        <div class="donor-card-header">
        <div class="d-flex align-items-center gap-3">
        <img src="/${d.profilePicture || 'aassets/img/avatars/DefaultAvatar.png'}" alt="${d.donorName}" class="donor-avatar-lg" onerror="this.src='/aassets/img/avatars/DefaultAvatar.png';" />
        <div class="flex-grow-1">
        <h5 class="mb-1 fw-bold">${d.donorName}</h5>
        <div class="d-flex gap-2 flex-wrap">
        <span class="badge bg-primary-subtle text-primary fs-6">${d.bloodGroup}</span>
        ${d.isVerified ? '<span class="badge bg-success-subtle text-success"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>' : ''}
        </div>
        </div>
        </div>
        <div class="match-score-circle ${scoreClass}">
        <span class="score-value">${d.matchScore}%</span>
        <span class="score-label">${d.aiBadge || 'Match'}</span>
        </div>
        </div>

        <div class="donor-card-body">
        <div class="donor-info-grid">
        <div class="donor-info-item">
        <i class="bi bi-geo-alt"></i>
        <span>${d.city}, ${d.area || 'N/A'}</span>
        </div>
        <div class="donor-info-item">
        <i class="bi bi-gender-ambiguous"></i>
        <span>${d.gender || 'N/A'} ${d.age ? `(${d.age} yrs)` : ''}</span>
        </div>
        <div class="donor-info-item">
        <i class="bi bi-calendar-check"></i>
        <span>${d.lastDonationDate ? new Date(d.lastDonationDate).toLocaleDateString() : 'Never'}</span>
        </div>
        <div class="donor-info-item">
        <i class="bi bi-droplet"></i>
        <span>${d.totalDonations || 0} donations</span>
        </div>
        </div>

        <div class="donor-status-row">
        <span class="availability-badge ${availabilityClass}">${d.availabilityStatus}</span>
        ${isEligible ? '<span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Eligible</span>' : '<span class="badge bg-warning-subtle text-warning"><i class="bi bi-clock me-1"></i>Not Eligible</span>'}
        </div>

        ${d.explanation ? `
        <div class="match-reasons">
        ${d.explanation.split(', ').slice(0,2).map(r => `<span class="reason-tag"><i class="bi bi-check-circle-fill text-success me-1"></i>${r}</span>`).join('')}
        </div>` : ''}
        </div>

        <div class="donor-card-footer">
        <button class="btn-action btn-action-primary assign-donor-btn" data-donorid="${d.donorId}" ${!isEligible ? 'disabled' : ''}>
        <i class="bi bi-person-plus"></i> Assign
        </button>
        </div>
        </div>
        </div>`;
        });
        }
        document.getElementById('totalMatchesText').textContent = `Showing ${filtered.length} compatible donors`;
        }

        function resetCards() {
        document.getElementById('matchesContainer').innerHTML = `<div class="col-12 text-center py-5 text-muted"><i class="bx bx-search-alt fs-1 d-block mb-2"></i><h5>No Matches Found</h5></div>`;
        }

        function applyFiltersAndSort() {
        const sVal = document.getElementById('searchInput').value.toLowerCase();
        const bgVal = document.getElementById('filterBloodGroup').value;
        const availVal = document.getElementById('filterAvailability').value;
        const eligVal = document.getElementById('filterEligibility').value;
        const sortVal = document.getElementById('sortBy').value;

        let filtered = allDonors.filter(d => {
        if (sVal && !(d.donorName.toLowerCase().includes(sVal) || (d.phone || '').includes(sVal))) return false;
        if (bgVal !== 'all' && d.bloodGroup !== bgVal) return false;
        if (availVal !== 'all' && d.availabilityStatus !== availVal) return false;
        if (eligVal !== 'all' && d.eligibilityStatus !== eligVal) return false;
        return true;
        });

        if (sortVal === 'score-desc') filtered.sort((a, b) => b.matchScore - a.matchScore);
        if (sortVal === 'dist-asc') filtered.sort((a, b) => a.distanceKm - b.distanceKm);
        return filtered;
        }

        ['searchInput', 'filterBloodGroup', 'filterAvailability', 'filterEligibility', 'sortBy'].forEach(id => {
        document.getElementById(id).addEventListener('change', renderCards);
        document.getElementById(id).addEventListener('input', renderCards);
        });

        document.getElementById('resetFiltersBtn').addEventListener('click', () => {
        document.getElementById('searchInput').value = '';
        document.getElementById('filterBloodGroup').value = 'all';
        document.getElementById('filterAvailability').value = 'all';
        document.getElementById('filterEligibility').value = 'all';
        document.getElementById('sortBy').value = 'score-desc';
        renderCards();
        });

        // Event Delegation for Assign Button
        document.getElementById('matchesContainer').addEventListener('click', function(e) {
        const btn = e.target.closest('.assign-donor-btn');
        if (btn) {
        currentDonorId = btn.dataset.donorid;
        assignModal.show();
        }
        });

        // Confirm Assignment (Triggers Full Workflow)
        document.getElementById('confirmAssignBtn').addEventListener('click', function() {
        if (!currentDonorId || !currentRequestId) return;
        const fd = new FormData();
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        fd.append('donorId', currentDonorId);
        fd.append('bloodRequestId', currentRequestId);

        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Assigning...';
        this.disabled = true;

        fetch('/Admin/SelectDonor', { method: 'POST', body: fd }).then(r => r.json()).then(d => {
        assignModal.hide();
        this.innerHTML = 'Yes, Assign';
        this.disabled = false;
        if (d.success) {
        showNotification(d.message, 'success');
        findMatches();
        } else {
        showNotification(d.message, 'error');
        }
        });
        });

        function showNotification(msg, type) {
        const bg = type === 'success' ? '#28a745' : (type === 'warning' ? '#ffc107' : '#dc3545');
        const textColor = type === 'warning' ? '#000' : '#fff';
        const n = document.createElement('div');
        n.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:${textColor};padding:12px 20px;border-radius:10px;box-shadow:0 5px 20px rgba(0,0,0,0.2);font-weight:500;animation:popIn 0.3s ease;`;
        n.textContent = msg;
        document.body.appendChild(n);
        setTimeout(() => n.remove(), 4000);
        }
        });
    </script>
}