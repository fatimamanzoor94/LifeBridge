@model Khoon_e_Hayat.ViewModels.BloodRequestListViewModel
@{
    ViewData["Title"] = "Blood Requests Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Blood Requests Management</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Requests -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-droplet text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Requests</h6>
                                <small class="text-muted">@Model.TotalCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-time-five text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Pending Requests</h6>
                                <small class="text-muted">@Model.PendingCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Fulfilled/Completed -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Fulfilled Requests</h6>
                                <small class="text-muted">@Model.FulfilledCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Emergency -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-error text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Emergency Requests</h6>
                                <small class="text-muted">@Model.EmergencyCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Active Cities -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-map text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Active Cities</h6>
                                <small class="text-muted">@Model.ActiveCitiesCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Name, Blood Group, Hospital, City..." />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Urgency</label>
                            <select id="filterUrgency" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Matched">Matched</option>
                                <option value="Blood Issued">Blood Issued</option>
                                <option value="Fulfilled">Fulfilled</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">City</label>
                            <select id="filterCity" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var city in Model.AvailableCities)
                                {
                                    <option value="@city.ToLower()">@city</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Blood Requests</h4>
                            <small class="text-muted">Monitor and update blood request statuses</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'bloodRequestsTable', 'BloodRequests')"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'bloodRequestsTable', 'BloodRequests')"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="bloodRequestsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Request ID</th>
                                    <th>Receiver Name</th>
                                    <th>Blood Group</th>
                                    <th>Units</th>
                                    <th>Hospital Name</th>
                                    <th>City</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Requests.Any())
                                {
                                    foreach (var req in Model.Requests)
                                    {
                                        <tr>
                                            <td>REQ-@req.RequestId.ToString("D4")</td>
                                            <td>@req.ReceiverName</td>
                                            <td><span class="fw-bold text-danger">@req.BloodGroup</span></td>
                                            <td>@req.UnitsRequired</td>
                                            <td>@(req.HospitalName ?? "-")</td>
                                            <td>@(req.City ?? "-")</td>
                                            <td>
                                                @if (req.UrgencyLevel == "Critical") { <span class="badge bg-danger-subtle text-danger">Critical</span> }
                                                else if (req.UrgencyLevel == "High") { <span class="badge bg-warning-subtle text-warning">High</span> }
                                                else if (req.UrgencyLevel == "Medium") { <span class="badge bg-info-subtle text-info">Medium</span> }
                                                else { <span class="badge bg-secondary-subtle text-secondary">Low</span> }
                                            </td>
                                            <td>
                                                @if (string.IsNullOrEmpty(req.RequestStatus))
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Not Set</span>
                                                }
                                                else if (req.RequestStatus == "Pending") 
                                                { 
                                                    <span class="badge bg-warning-subtle text-warning">Pending</span> 
                                                }
                                                else if (req.RequestStatus == "Approved") 
                                                { 
                                                    <span class="badge bg-primary-subtle text-primary">Approved</span> 
                                                }
                                                else if (req.RequestStatus == "Matched") 
                                                { 
                                                    <span class="badge bg-info-subtle text-info">Matched</span> 
                                                }
                                                else if (req.RequestStatus == "Blood Issued") 
                                                { 
                                                    <span class="badge bg-success-subtle text-success">Blood Issued</span> 
                                                }
                                                else if (req.RequestStatus == "Fulfilled" || req.RequestStatus == "Completed") 
                                                { 
                                                    <span class="badge bg-success-subtle text-success">@(req.RequestStatus == "Completed" ? "Completed" : "Fulfilled")</span> 
                                                }
                                                else if (req.RequestStatus == "Cancelled") 
                                                { 
                                                    <span class="badge bg-danger-subtle text-danger">Cancelled</span> 
                                                }
                                                else 
                                                { 
                                                    <span class="badge bg-secondary-subtle text-secondary">@req.RequestStatus</span> 
                                                }
                                            </td>
                                            <td>@req.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" 
                                                            data-requestid="@req.RequestId" title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary update-status-btn" 
                                                            data-requestid="@req.RequestId" 
                                                            data-currentstatus="@req.RequestStatus" 
                                                            title="Update Status">
                                                        <i class="bx bx-edit"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="emptyStateRow">
                                        <td colspan="10" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bx bx-droplet fs-1 d-block mb-2 text-danger"></i>
                                                <h5 class="fw-semibold">No Blood Requests Found</h5>
                                                <p class="mb-0">No blood requests available at the moment.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Requests: @Model.TotalCount</small>
                        <nav><ul class="pagination pagination-sm mb-0" id="pagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-droplet text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Blood Request Details</h5>
                        <small class="text-muted" id="modalRequestId">REQ-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-primary mb-3"><i class="bx bx-user me-2"></i>Receiver Information</h6>
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label small text-muted mb-1">Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_ReceiverName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Email</label><p class="form-control-plaintext mb-0" id="d_ReceiverEmail">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Phone</label><p class="form-control-plaintext mb-0" id="d_ReceiverPhone">-</p></div>
                        </div>

                        <h6 class="fw-bold text-danger mb-3 mt-4"><i class="bx bx-droplet me-2"></i>Blood Requirement</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-danger mb-0" id="d_BloodGroup">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext mb-0" id="d_UnitsRequired">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Urgency Level</label><p class="form-control-plaintext mb-0" id="d_UrgencyLevel">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Required Date</label><p class="form-control-plaintext mb-0" id="d_RequiredDate">-</p></div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-buildings me-2"></i>Hospital Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Hospital Name</label><p class="form-control-plaintext mb-0" id="d_HospitalName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">City</label><p class="form-control-plaintext mb-0" id="d_City">-</p></div>
                        </div>

                        <h6 class="fw-bold text-info mb-3 mt-4"><i class="bx bx-info-circle me-2"></i>Request Information</h6>
                        <div class="row g-3">
                            <div class="col-4"><label class="form-label small text-muted mb-1">Request ID</label><p class="form-control-plaintext fw-semibold mb-0" id="d_RequestId">-</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Created Date</label><p class="form-control-plaintext mb-0" id="d_CreatedDate">-</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Status</label><p class="form-control-plaintext mb-0" id="d_RequestStatus">-</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== UPDATE STATUS MODAL ==================== -->
<div class="modal fade" id="updateStatusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #e7f1ff; border: 6px solid white;">
                    <i class="fas fa-sync-alt" style="color: #0d6efd;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Update Request Status?</h4>
                <p class="text-muted">
                    You are updating status for <strong id="updateRequestId"></strong>.<br />
                    Select the new status below.
                </p>
                <div class="text-start mb-3 mt-3 px-4">
                    <label class="form-label small text-muted mb-1">New Status <span class="text-danger">*</span></label>
                    <select id="newStatusSelect" class="form-select"></select>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 rounded-pill" id="confirmUpdateBtn">Update</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card { background: #ffffff; border-radius: 16px !important; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .custom-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important; }
    .icon-box { width: 48px; height: 48px; background: #f8f9fa; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .trend-icon { font-size: 1.5rem; color: #28a745; opacity: 0.6; }
    .delete-modal { border-radius: 22px; border: none; box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25); overflow: visible; animation: popIn 0.3s ease; }
    .delete-icon-wrapper { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); z-index: 10; }
    .icons-box { width: 85px; height: 85px; background: #fff5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 6px solid white; }
    .icons-box i { font-size: 34px; color: #ff3b3b; }
    @@keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    
    #viewDetailsModal .form-control-plaintext { font-size: 1.05rem; padding: 0.25rem 0; border-bottom: 1px dashed #dee2e6; }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ==================== GLOBAL VARIABLES ====================
            let currentRequestId = null;
            let updateStatusModalInstance = null;
            
            updateStatusModalInstance = new bootstrap.Modal(document.getElementById('updateStatusModal'));

            // ==================== FILTERS ====================
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterUrgency = document.getElementById('filterUrgency');
            const filterStatus = document.getElementById('filterStatus');
            const filterCity = document.getElementById('filterCity');

            function filterTable() {
                const sVal = searchInput.value.toLowerCase();
                const bgVal = filterBloodGroup.value;
                const urgVal = filterUrgency.value;
                const statVal = filterStatus.value;
                const cityVal = filterCity.value;
                
                const rows = document.querySelectorAll("#bloodRequestsTable tbody tr");

                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    const reqId = row.cells[0].textContent.toLowerCase();
                    const name = row.cells[1].textContent.toLowerCase();
                    const bg = row.cells[2].textContent.toLowerCase();
                    const hospital = row.cells[4].textContent.toLowerCase();
                    const city = row.cells[5].textContent.toLowerCase();
                    
                    const urgBadge = row.cells[6].querySelector('.badge');
                    const urgText = urgBadge ? urgBadge.textContent : '';

                    const statBadge = row.cells[7].querySelector('.badge');
                    const statText = statBadge ? statBadge.textContent : '';

                    let show = true;

                    if (sVal && !(reqId.includes(sVal) || name.includes(sVal) || bg.includes(sVal) || hospital.includes(sVal) || city.includes(sVal))) show = false;
                    if (bgVal !== 'all' && bg !== bgVal.toLowerCase()) show = false;
                    if (urgVal !== 'all' && urgText !== urgVal) show = false;
                    if (statVal !== 'all' && statText !== statVal) show = false;
                    if (cityVal !== 'all' && city !== cityVal) show = false;

                    row.style.display = show ? "" : "none";
                });
                initPagination();
            }

            [searchInput, filterBloodGroup, filterUrgency, filterStatus, filterCity].forEach(el => el.addEventListener('input', filterTable));
            [filterBloodGroup, filterUrgency, filterStatus, filterCity].forEach(el => el.addEventListener('change', filterTable));

            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function initPagination() {
                const visible = Array.from(document.querySelectorAll("#bloodRequestsTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow');
                const pages = Math.ceil(visible.length / rowsPerPage);
                if (currentPage > pages) currentPage = pages || 1;
                showPage(currentPage, visible);
            }

            function showPage(page, visible) {
                currentPage = page;
                document.querySelectorAll("#bloodRequestsTable tbody tr").forEach(r => { if(r.id !== 'emptyStateRow') r.style.display = 'none'; });
                const start = (page - 1) * rowsPerPage;
                visible.slice(start, start + rowsPerPage).forEach(r => r.style.display = '');
                renderPagination(visible.length);
            }

            function renderPagination(total) {
                pagination.innerHTML = "";
                const pages = Math.ceil(total / rowsPerPage);
                if (pages <= 1) return;

                const prev = document.createElement("li"); prev.className = `page-item ${currentPage===1?'disabled':''}`;
                prev.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prev.onclick = (e) => { e.preventDefault(); if(currentPage>1) showPage(currentPage-1, getVisible()); };
                pagination.appendChild(prev);

                for (let i=1; i<=pages; i++) {
                    const li = document.createElement("li"); li.className = `page-item ${currentPage===i?'active':''}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.onclick = (e) => { e.preventDefault(); showPage(i, getVisible()); };
                    pagination.appendChild(li);
                }

                const next = document.createElement("li"); next.className = `page-item ${currentPage===pages?'disabled':''}`;
                next.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                next.onclick = (e) => { e.preventDefault(); if(currentPage<pages) showPage(currentPage+1, getVisible()); };
                pagination.appendChild(next);
            }

            function getVisible() { return Array.from(document.querySelectorAll("#bloodRequestsTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow'); }
            initPagination();

            // ==================== EVENT DELEGATION ====================
            document.getElementById('bloodRequestsTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target.getAttribute('data-requestid'));
                }
                else if (target.classList.contains('update-status-btn')) {
                    openUpdateStatusModal(target.getAttribute('data-requestid'), target.getAttribute('data-currentstatus'));
                }
            });

            // ==================== VIEW DETAILS MODAL ====================
            function openViewDetailsModal(requestId) {
                document.getElementById('modalRequestId').textContent = `REQ-${String(requestId).padStart(4, '0')}`;
                
                fetch(`/Admin/GetRequestDetails?requestId=${requestId}`)
                    .then(r => {
                        if (!r.ok) throw new Error('Network response was not ok');
                        return r.json();
                    })
                    .then(d => {
                        document.getElementById('d_ReceiverName').textContent = d.receiverName || '-';
                        document.getElementById('d_ReceiverEmail').textContent = d.receiverEmail || '-';
                        document.getElementById('d_ReceiverPhone').textContent = d.receiverPhone || '-';
                        
                        document.getElementById('d_BloodGroup').textContent = d.bloodGroup || '-';
                        document.getElementById('d_UnitsRequired').textContent = d.unitsRequired || '-';
                        document.getElementById('d_UrgencyLevel').textContent = d.urgencyLevel || '-';
                        document.getElementById('d_RequiredDate').textContent = d.requiredDate ? new Date(d.requiredDate).toLocaleDateString() : 'Not Specified';
                        
                        document.getElementById('d_HospitalName').textContent = d.hospitalName || '-';
                        document.getElementById('d_City').textContent = d.city || '-';
                        
                        document.getElementById('d_RequestId').textContent = `REQ-${String(d.requestId).padStart(4, '0')}`;
                        document.getElementById('d_CreatedDate').textContent = new Date(d.createdDate).toLocaleDateString();
                        document.getElementById('d_RequestStatus').textContent = d.requestStatus || '-';
                        
                        const viewModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                        viewModal.show();
                    })
                    .catch(error => {
                        console.error('Error fetching details:', error);
                        showNotification('Failed to load request details', 'error');
                    });
            }

            // ==================== UPDATE STATUS MODAL ====================
            function openUpdateStatusModal(requestId, currentStatus) {
                currentRequestId = requestId;
                document.getElementById('updateRequestId').textContent = `REQ-${String(requestId).padStart(4, '0')}`;
                
                const statusSelect = document.getElementById('newStatusSelect');
                statusSelect.innerHTML = '';
                
                let options = [];
                // Backend validation allows these specific transitions
                if (currentStatus === 'Pending') {
                    options = ['Approved', 'Matched', 'Fulfilled', 'Cancelled'];
                } else if (currentStatus === 'Matched') {
                    options = ['Fulfilled', 'Completed'];
                } else if (currentStatus === 'Approved') {
                    options = ['Blood Issued', 'Completed'];
                } else if (currentStatus === 'Blood Issued') {
                    options = ['Completed'];
                }
                
                if (options.length === 0) {
                    showNotification('No further status updates available for this request.', 'warning');
                    return;
                }
                
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt;
                    option.textContent = opt;
                    statusSelect.appendChild(option);
                });
                
                updateStatusModalInstance.show();
            }

            document.getElementById('confirmUpdateBtn').addEventListener('click', function() {
                const newStatus = document.getElementById('newStatusSelect').value;
                if (!currentRequestId || !newStatus) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('requestId', currentRequestId);
                fd.append('status', newStatus);

                fetch('/Admin/UpdateRequestStatus', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        if (d.success) {
                            updateStatusModalInstance.hide();
                            showNotification(d.message, 'success');
                            updateRowStatus(currentRequestId, newStatus);
                            // Reload to update statistics cards accurately
                            setTimeout(() => location.reload(), 1000); 
                        } else {
                            showNotification(d.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Failed to update status', 'error');
                    });
            });

            document.getElementById('updateStatusModal').addEventListener('hidden.bs.modal', function() {
                document.body.classList.remove('modal-open');
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove();
            });

            // ==================== UPDATE ROW STATUS (UPDATED) ====================
            function updateRowStatus(requestId, status) {
                const row = document.querySelector(`tr [data-requestid="${requestId}"]`)?.closest('tr');
                if (!row) return;

                const badge = row.cells[7].querySelector('.badge');
                let badgeClass = 'bg-secondary-subtle text-secondary';
                let badgeText = status;
                
                if (status === 'Pending') {
                    badgeClass = 'bg-warning-subtle text-warning';
                } else if (status === 'Matched') {
                    badgeClass = 'bg-info-subtle text-info';
                } else if (status === 'Approved') {
                    badgeClass = 'bg-primary-subtle text-primary';
                } else if (status === 'Blood Issued') {
                    badgeClass = 'bg-success-subtle text-success';
                } else if (status === 'Fulfilled' || status === 'Completed') {
                    badgeClass = 'bg-success-subtle text-success';
                    badgeText = status === 'Completed' ? 'Completed' : 'Fulfilled';
                } else if (status === 'Cancelled') {
                    badgeClass = 'bg-danger-subtle text-danger';
                }
                
                badge.className = 'badge ' + badgeClass;
                badge.textContent = badgeText;
                
                const updateBtn = row.querySelector('.update-status-btn');
                if (updateBtn) {
                    updateBtn.setAttribute('data-currentstatus', status);
                }
            }

            // ==================== NOTIFICATION ====================
            function showNotification(msg, type) {
                const bg = type === 'success' ? '#28a745' : (type === 'warning' ? '#ffc107' : '#dc3545');
                const textColor = type === 'warning' ? '#000' : '#fff';
                const n = document.createElement('div');
                n.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:${textColor};padding:12px 20px;border-radius:10px;box-shadow:0 5px 20px rgba(0,0,0,0.2);font-weight:500;animation:popIn 0.3s ease;`;
                n.textContent = msg;
                document.body.appendChild(n);
                setTimeout(() => n.remove(), 3000);
            }
        });
    </script>
}
