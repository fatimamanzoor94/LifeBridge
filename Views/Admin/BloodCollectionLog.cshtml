@model Khoon_e_Hayat.ViewModels.BloodCollectionHistoryViewModel
@{
    ViewData["Title"] = "Blood Collection Log";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // ✅ Admin Layout
}

@Html.AntiForgeryToken()

<style>
    /* Strict Theme Colors (Matches Hospital Panel Exactly) */
    .text-blood {
        color: #90151C !important;
    }

    .bg-theme {
        background-color: #5C88A8 !important;
    }

    .text-theme {
        color: #5C88A8 !important;
    }

    .btn-theme {
        background-color: #5C88A8;
        border-color: #5C88A8;
        color: #fff;
    }

        .btn-theme:hover {
            background-color: #4a6d87;
            border-color: #4a6d87;
            color: #fff;
        }

    .btn-outline-theme {
        color: #5C88A8;
        border-color: #5C88A8;
    }

        .btn-outline-theme:hover {
            background-color: #5C88A8;
            border-color: #5C88A8;
            color: #fff;
        }

    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }

    #viewDetailsModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .pagination-wrapper-n {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .pagination-n .page-link {
        border: 1px solid #e9ecef;
        color: #5C88A8;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 8px !important;
    }

    .pagination-n .page-item.active .page-link {
        background: #5C88A8;
        border-color: #5C88A8;
        color: #FFFFFF;
    }

    .pagination-n .page-item.disabled .page-link {
        color: #adb5bd;
        background: #FFFFFF;
    }
</style>

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Blood Collection Log</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-clipboard2-pulse text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Collections</h6>
                                <small class="text-muted">@Model.TotalCollections.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet-fill text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Units</h6>
                                <small class="text-muted">@Model.TotalUnitsCollected.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-calendar-day text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Today</h6>
                                <small class="text-muted">@Model.TodayCollections.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-calendar-month text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">This Month</h6>
                                <small class="text-muted">@Model.MonthCollections.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Hospital, ID, blood group, status..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var bg in Model.AvailableBloodGroups)
                                {
                                    <option value="@bg" selected="@(Model.Filters?.BloodGroup == bg)">@bg</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var status in Model.AvailableStatuses)
                                {
                                    <option value="@status" selected="@(Model.Filters?.Status == status)">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">From Date</label>
                            <input type="date" id="filterDateFrom" class="form-control form-control-sm rounded-pill" value="@(Model.Filters?.DateFrom?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">To Date</label>
                            <input type="date" id="filterDateTo" class="form-control form-control-sm rounded-pill" value="@(Model.Filters?.DateTo?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-pill w-100" title="Reset all filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                @if (!Model.Collections.Any())
                {
                    <div class="card-body px-4">
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-clipboard2-pulse fs-1 d-block mb-2 text-blood"></i>
                                <h5 class="fw-semibold">No Collection Records Found</h5>
                                <p class="mb-3">System doesn't have any blood collection records yet.</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="mb-1 fw-semibold">System-Wide Collection History</h4>
                                <small class="text-muted">View all blood collection records across all hospitals</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'collectionTable', 'AdminBloodCollectionLog')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'collectionTable', 'AdminBloodCollectionLog')">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive p-3">
                            <table class="table align-middle mb-0" id="collectionTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Hospital</th> <!-- ✅ Added for Admin -->
                                        <th>Collection ID</th>
                                        <th>Blood Group</th>
                                        <th>Units</th>
                                        <th>Collection Date</th>
                                        <th>Expiry Date</th>
                                        <th>Status</th>
                                        <th>Last Updated</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Collections)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold text-dark">@(item.Hospital?.HospitalName ?? "Unknown Hospital")</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-theme">#@item.InventoryId.ToString("D4")</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-blood">@item.BloodGroup</span>
                                            </td>
                                            <td>@item.Quantity units</td>
                                            <td>@item.CollectionDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                @item.ExpiryDate.ToString("dd-MMM-yyyy")
                                                @if (item.ExpiryDate <= DateTime.Now.AddDays(7) && item.ExpiryDate > DateTime.Now)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning ms-2">Expiring Soon</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.Status == "Available")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Available</span>
                                                }
                                                else if (item.Status == "Reserved" || item.Status == "Low Stock")
                                                {

                                                    <span class="badge bg-warning-subtle text-warning">@item.Status</span>
                                                }
                                                else if (item.Status == "Used")
                                                {

                                                    <span class="badge bg-primary-subtle text-primary">Used</span>
                                                }
                                                else if (item.Status == "Critical")
                                                {

                                                    <span class="badge bg-danger-subtle text-danger">Critical</span>
                                                }
                                                else if (item.Status == "Expired")
                                                {

                                                    <span class="badge bg-secondary-subtle text-secondary">Expired</span>
                                                }
                                                else
                                                {

                                                    <span class="badge bg-secondary-subtle text-secondary">@item.Status</span>
                                                }
                                            </td>
                                            <td>@item.UpdatedAt.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn"
                                                            data-id="@item.InventoryId"
                                                            data-hospital="@(item.Hospital?.HospitalName ?? "Unknown")"
                                                            data-bg="@item.BloodGroup"
                                                            data-qty="@item.Quantity"
                                                            data-col="@item.CollectionDate.ToString("yyyy-MM-dd")"
                                                            data-exp="@item.ExpiryDate.ToString("yyyy-MM-dd")"
                                                            data-stat="@item.Status"
                                                            data-upd="@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")"
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination-wrapper-n" style="margin-top: 20px;">
                                <small class="text-muted">
                                    Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to
                                    <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> of
                                    <strong>@Model.TotalCount</strong> records
                                </small>
                                <nav>
                                    <ul class="pagination pagination-n mb-0">
                                        @{
                                            var prevDisabled = Model.CurrentPage == 1 ? "disabled" : "";
                                            var nextDisabled = Model.CurrentPage == Model.TotalPages ? "disabled" : "";
                                            var routeValues = new Dictionary<string, object>
                                            {
                                                { "Filters.SearchQuery", Model.Filters?.SearchQuery },
                                                { "Filters.BloodGroup", Model.Filters?.BloodGroup ?? "all" },
                                                { "Filters.Status", Model.Filters?.Status ?? "all" },
                                                { "Filters.DateFrom", Model.Filters?.DateFrom?.ToString("yyyy-MM-dd") },
                                                { "Filters.DateTo", Model.Filters?.DateTo?.ToString("yyyy-MM-dd") },
                                                { "Filters.SortBy", Model.Filters?.SortBy ?? "newest" }
                                            };
                                        }
                                        <li class="page-item @prevDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage - 1;
                                            }
                                            <a class="page-link" href="@Url.Action("BloodCollectionLog", routeValues)">
                                                <i class="bi bi-chevron-left"></i> Previous
                                            </a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            var active = i == Model.CurrentPage ? "active" : "";
                                            routeValues["page"] = i;
                                            <li class="page-item @active">
                                                <a class="page-link" href="@Url.Action("BloodCollectionLog", routeValues)">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @nextDisabled">
                                            @{
                                                routeValues["page"] = Model.CurrentPage + 1;
                                            }
                                            <a class="page-link" href="@Url.Action("BloodCollectionLog", routeValues)">
                                                Next <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-droplet text-theme"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Collection Details</h5>
                        <small class="text-muted" id="modalCollectionId">COL-XXXX</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-blood mb-3"><i class="bx bx-droplet me-2"></i>Blood Information</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Hospital</label>
                                <p class="form-control-plaintext fw-bold text-dark mb-0" id="d_Hospital">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Blood Group</label>
                                <p class="form-control-plaintext fw-bold text-blood mb-0" id="d_BloodGroup">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Quantity</label>
                                <p class="form-control-plaintext mb-0" id="d_Quantity">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Collection Date</label>
                                <p class="form-control-plaintext mb-0" id="d_CollectionDate">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Expiry Date</label>
                                <p class="form-control-plaintext mb-0" id="d_ExpiryDate">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Status</label>
                                <p class="form-control-plaintext mb-0" id="d_StatusWrapper">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Last Updated</label>
                                <p class="form-control-plaintext mb-0" id="d_Updated">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        console.log("🚀 Admin Blood Collection Log Script Loaded Successfully!");

        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterStatus = document.getElementById('filterStatus');
            const filterDateFrom = document.getElementById('filterDateFrom');
            const filterDateTo = document.getElementById('filterDateTo');
            const resetFiltersBtn = document.getElementById('resetFiltersBtn');

            function filterTable() {
                try {
                    const sVal = (searchInput.value || '').toLowerCase().trim();
                    const bgVal = (filterBloodGroup.value || 'all').toLowerCase().trim();
                    const statVal = (filterStatus.value || 'all').toLowerCase().trim();
                    const dateFromVal = filterDateFrom.value;
                    const dateToVal = filterDateTo.value;

                    const rows = document.querySelectorAll("#collectionTable tbody tr");
                    const monthMap = { 'jan': 0, 'feb': 1, 'mar': 2, 'apr': 3, 'may': 4, 'jun': 5, 'jul': 6, 'aug': 7, 'sep': 8, 'oct': 9, 'nov': 10, 'dec': 11 };

                    rows.forEach(row => {
                        // ✅ Updated indices for new Hospital column
                        const hospital = (row.cells[0]?.textContent || '').toLowerCase().trim();
                        const colId = (row.cells[1]?.textContent || '').toLowerCase().trim();
                        const bg = (row.cells[2]?.textContent || '').toLowerCase().trim();
                        const statusText = (row.cells[6]?.textContent || '').toLowerCase().trim();
                        const collDateText = (row.cells[4]?.textContent || '').trim();

                        let show = true;

                        if (sVal && !(hospital.includes(sVal) || colId.includes(sVal) || bg.includes(sVal) || statusText.includes(sVal))) show = false;
                        if (show && bgVal !== 'all' && bg !== bgVal) show = false;
                        if (show && statVal !== 'all' && statusText !== statVal) show = false;

                        if (show && (dateFromVal || dateToVal)) {
                            const dateParts = collDateText.split('-');
                            if (dateParts.length === 3) {
                                const day = parseInt(dateParts[0], 10);
                                const monthStr = dateParts[1].toLowerCase();
                                const year = parseInt(dateParts[2], 10);
                                const month = monthMap[monthStr] !== undefined ? monthMap[monthStr] : 0;
                                const rowDate = new Date(year, month, day);
                                rowDate.setHours(0, 0, 0, 0);

                                if (dateFromVal) {
                                    const fromDate = new Date(dateFromVal);
                                    fromDate.setHours(0, 0, 0, 0);
                                    if (rowDate < fromDate) show = false;
                                }
                                if (dateToVal) {
                                    const toDate = new Date(dateToVal);
                                    toDate.setHours(23, 59, 59, 999);
                                    if (rowDate > toDate) show = false;
                                }
                            }
                        }
                        row.style.display = show ? "" : "none";
                    });
                } catch (error) {
                    console.error("Error in filterTable:", error);
                }
            }

            [searchInput, filterBloodGroup, filterStatus, filterDateFrom, filterDateTo].forEach(el => {
                if (el) {
                    el.addEventListener('input', filterTable);
                    el.addEventListener('change', filterTable);
                }
            });

            if (resetFiltersBtn) {
                resetFiltersBtn.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (filterBloodGroup) filterBloodGroup.value = 'all';
                    if (filterStatus) filterStatus.value = 'all';
                    if (filterDateFrom) filterDateFrom.value = '';
                    if (filterDateTo) filterDateTo.value = '';
                    filterTable();
                });
            }

            const table = document.getElementById('collectionTable');
            if (table) {
                table.addEventListener('click', function(e) {
                    const viewBtn = e.target.closest('.view-details-btn');
                    if (viewBtn) openViewDetailsFromData(viewBtn);
                });
            }
        });

        function formatDateToDisplay(dateStr) {
            if (!dateStr) return '-';
            const d = new Date(dateStr);
            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            return `${String(d.getDate()).padStart(2, '0')}-${months[d.getMonth()]}-${d.getFullYear()}`;
        }

        function getStatusBadgeHtml(status) {
            const s = (status || '').toLowerCase();
            let badgeClass = 'bg-secondary-subtle text-secondary';
            if (s === 'available') badgeClass = 'bg-success-subtle text-success';
            else if (s === 'reserved' || s === 'low stock') badgeClass = 'bg-warning-subtle text-warning';
            else if (s === 'used') badgeClass = 'bg-primary-subtle text-primary';
            else if (s === 'critical') badgeClass = 'bg-danger-subtle text-danger';
            else if (s === 'expired') badgeClass = 'bg-secondary-subtle text-secondary';

            const displayStatus = status.charAt(0).toUpperCase() + status.slice(1).toLowerCase();
            return `<span class="badge ${badgeClass}">${displayStatus}</span>`;
        }

        function openViewDetailsFromData(btn) {
            const id = btn.getAttribute('data-id');
            const hospital = btn.getAttribute('data-hospital');
            const bg = btn.getAttribute('data-bg');
            const qty = btn.getAttribute('data-qty');
            const col = btn.getAttribute('data-col');
            const exp = btn.getAttribute('data-exp');
            const stat = btn.getAttribute('data-stat');
            const upd = btn.getAttribute('data-upd');

            document.getElementById('modalCollectionId').textContent = 'COL-' + String(id).padStart(4, '0');
            document.getElementById('d_Hospital').textContent = hospital || '-'; // ✅ Added Hospital
            document.getElementById('d_BloodGroup').textContent = bg || '-';
            document.getElementById('d_Quantity').textContent = (qty || '-') + ' units';
            document.getElementById('d_CollectionDate').textContent = formatDateToDisplay(col);
            document.getElementById('d_ExpiryDate').textContent = formatDateToDisplay(exp);
            document.getElementById('d_StatusWrapper').innerHTML = getStatusBadgeHtml(stat);
            document.getElementById('d_Updated').textContent = formatDateToDisplay(upd);

            const modalElement = document.getElementById('viewDetailsModal');
            if (typeof bootstrap !== 'undefined') {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        }

        function showNotification(message, type = "success") {
            const old = document.getElementById("customNotification");
            if (old) old.remove();
            const notification = document.createElement("div");
            notification.id = "customNotification";
            let bg = "#5C88A8", icon = "✔";
            if (type === "error") { bg = "#dc3545"; icon = "✖"; }
            else if (type === "warning") { bg = "#ffc107"; icon = "⚠"; }

            notification.innerHTML = `<div style="display: flex; align-items: center; gap: 12px; padding: 16px 24px; background: ${bg}; color: #ffffff; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); font-weight: 600; font-size: 15px; z-index: 9999999999; border: 1px solid rgba(255,255,255,0.1);"><span style="font-size: 20px;">${icon}</span><span>${message}</span></div>`;
            notification.style.cssText = "position: fixed !important; top: 20px !important; right: 20px !important; z-index: 2147483647 !important; animation: slideInRight 0.4s ease;";

            if (!document.getElementById('notification-anim-style')) {
                const style = document.createElement('style');
                style.id = 'notification-anim-style';
                style.innerHTML = `@@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }`;
                document.head.appendChild(style);
            }
            document.documentElement.appendChild(notification);
            setTimeout(() => {
                notification.style.transition = "all 0.4s ease";
                notification.style.opacity = "0";
                notification.style.transform = "translateX(400px)";
                setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 400);
            }, 3000);
        }

        window.exportTable = function(type, tableId, fileName) {
            const table = document.getElementById(tableId);
            if (!table) { showNotification('Table not found!', 'error'); return; }

            try {
                if (type === 'excel') {
                    let csv = [];
                    let rows = table.querySelectorAll("tr");
                    let hasData = false;
                    for (let i = 0; i < rows.length; i++) {
                        if (rows[i].style.display === 'none') continue;
                        hasData = true;
                        let row = [];
                        let cols = rows[i].querySelectorAll("td, th");
                        for (let j = 0; j < cols.length - 1; j++) { // Exclude Actions
                            let cellText = cols[j].innerText.replace(/"/g, '""').trim().replace(/\s+/g, ' ');
                            row.push(`"${cellText}"`);
                        }
                        csv.push(row.join(","));
                    }
                    if (!hasData) { showNotification('No records to export!', 'warning'); return; }
                    let csvContent = "\uFEFF" + csv.join("\n");
                    let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                    let link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.download = `${fileName}.csv`;
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(link.href);
                    showNotification('Excel Export Successful', 'success');

                } else if (type === 'pdf') {
                    if (typeof window.jspdf === 'undefined') { showNotification('PDF library not loaded!', 'error'); return; }
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF('l', 'mm', 'a4');
                    doc.setFontSize(18); doc.setTextColor(92, 136, 168); doc.text("Admin Blood Collection Log Report", 14, 20);
                    doc.setFontSize(10); doc.setTextColor(108, 117, 125); doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 30);

                    const rows = [];
                    table.querySelectorAll("tbody tr").forEach(tr => {
                        if (tr.style.display !== 'none') {
                            const cells = tr.querySelectorAll("td");
                            if (cells.length >= 8) { // ✅ Updated to 8 columns
                                rows.push([
                                    cells[0].innerText.trim(), // Hospital
                                    cells[1].innerText.trim(), // Collection ID
                                    cells[2].innerText.trim(), // Blood Group
                                    cells[3].innerText.trim(), // Units
                                    cells[4].innerText.trim(), // Collection Date
                                    cells[5].innerText.trim(), // Expiry Date
                                    cells[6].innerText.trim(), // Status
                                    cells[7].innerText.trim()  // Last Updated
                                ]);
                            }
                        }
                    });
                    if (rows.length === 0) { showNotification('No records to export!', 'warning'); return; }

                    doc.autoTable({
                        startY: 40,
                        head: [['Hospital', 'Collection ID', 'Blood Group', 'Units', 'Collection Date', 'Expiry Date', 'Status', 'Last Updated']],
                        body: rows,
                        theme: 'grid',
                        headStyles: { fillColor: [92, 136, 168], textColor: 255, fontSize: 10 },
                        styles: { fontSize: 8, cellPadding: 2, overflow: 'linebreak' }
                    });
                    doc.save(`${fileName}.pdf`);
                    showNotification('PDF Export Successful', 'success');
                }
            } catch (error) {
                console.error("💥 Export Error:", error);
                showNotification('Export failed: ' + error.message, 'error');
            }
        };
    </script>
}