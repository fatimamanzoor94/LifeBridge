@model Khoon_e_Hayat.ViewModels.HospitalVerificationListViewModel
@{
    ViewData["Title"] = "Hospital Verification";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Hospital Verification</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <!-- Pending -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-time-five text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Pending Hospitals</h6>
                                <small class="text-muted">@Model.PendingCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Approved -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Approved Hospitals</h6>
                                <small class="text-muted">@Model.ApprovedCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Rejected -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-x-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Rejected Hospitals</h6>
                                <small class="text-muted">@Model.RejectedCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Today -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-calendar text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Today's Requests</h6>
                                <small class="text-muted">@Model.TodayCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Total -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-buildings text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Requests</h6>
                                <small class="text-muted">@Model.TotalCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Name, Email, License, Contact, City..." />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="pending">Pending</option>
                                <option value="approved">Approved</option>
                                <option value="rejected">Rejected</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">City</label>
                            <select id="filterCity" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var city in Model.AvailableCities)
                                {
                                    <option value="@city.ToLower()">@city</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Date</label>
                            <select id="filterDate" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Verification Requests</h4>
                            <small class="text-muted">Review and verify hospital registrations</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'verificationTable', 'Verification')"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'verificationTable', 'Verification')"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="verificationTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Request ID</th>
                                    <th>Hospital Name</th>
                                    <th>Email</th>
                                    <th>License Number</th>
                                    <th>Contact Person</th>
                                    <th>City</th>
                                    @* <th>Submitted Date</th> *@
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Requests.Any())
                                {
                                    foreach (var req in Model.Requests)
                                    {
                                        <tr data-date="@req.SubmittedDate.ToString("yyyy-MM-dd")">
                                            <td>VER-@req.UserId.ToString("D4")</td>
                                            <td>@req.HospitalName</td>
                                            <td>@req.Email</td>
                                            <td>@(req.LicenseNumber ?? "-")</td>
                                            <td>@(req.ContactPerson ?? "-")</td>
                                            <td>@(req.City ?? "-")</td>
                                            @* <td>@req.SubmittedDate.ToString("dd-MMM-yyyy")</td> *@
                                            <td>
                                                @if (req.VerificationStatus == "Approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Approved</span>
                                                }
                                                else if (req.VerificationStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" 
                                                            data-userid="@req.UserId" 
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    
                                                    <button type="button" class="btn btn-outline-secondary view-license-btn" 
                                                            data-userid="@req.UserId" 
                                                            title="View License">
                                                        <i class="bx bx-file"></i>
                                                    </button>

                                                    @if (req.VerificationStatus != "Approved")
                                                    {
                                                        <button type="button" class="btn btn-outline-success approve-action-btn" 
                                                                data-userid="@req.UserId" 
                                                                data-hospitalname="@req.HospitalName" 
                                                                title="Approve">
                                                            <i class="bx bx-check"></i>
                                                        </button>
                                                    }
                                                    
                                                    @if (req.VerificationStatus != "Rejected")
                                                    {
                                                        <button type="button" class="btn btn-outline-danger reject-action-btn" 
                                                                data-userid="@req.UserId" 
                                                                data-hospitalname="@req.HospitalName" 
                                                                title="Reject">
                                                            <i class="bx bx-x"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="emptyStateRow">
                                        <td colspan="9" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bx bx-buildings fs-1 d-block mb-2 text-danger"></i>
                                                <h5 class="fw-semibold">No Verification Requests Found</h5>
                                                <p class="mb-0">No hospital registration requests available.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Requests: @Model.TotalCount</small>
                        <nav><ul class="pagination pagination-sm mb-0" id="pagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-buildings text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Hospital Details</h5>
                        <small class="text-muted" id="modalRequestId">VER-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-primary mb-3"><i class="bx bx-buildings me-2"></i>Hospital Information</h6>
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label small text-muted mb-1">Hospital Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_HospitalName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">License Number</label><p class="form-control-plaintext mb-0" id="d_LicenseNumber">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Contact Person</label><p class="form-control-plaintext mb-0" id="d_ContactPerson">-</p></div>
                        </div>

                        <h6 class="fw-bold text-info mb-3 mt-4"><i class="bx bx-phone me-2"></i>Contact Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Email</label><p class="form-control-plaintext mb-0" id="d_Email">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Phone</label><p class="form-control-plaintext mb-0" id="d_Phone">-</p></div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-map me-2"></i>Location</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Address</label><p class="form-control-plaintext mb-0" id="d_Address">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">City</label><p class="form-control-plaintext mb-0" id="d_City">-</p></div>
                        </div>

                        <h6 class="fw-bold text-warning mb-3 mt-4"><i class="bx bx-file me-2"></i>License Document</h6>
                        <div id="d_LicenseSection">
                            <div class="d-flex gap-2" id="licenseButtonsContainer">
                                <p class="text-muted mb-0">Loading...</p>
                            </div>
                        </div>
                        
                        <div id="d_RejectionSection" class="mt-3" style="display:none;">
                            <h6 class="fw-bold text-danger mb-2"><i class="bx bx-error me-2"></i>Rejection Reason</h6>
                            <p class="form-control-plaintext text-danger mb-0" id="d_RejectionReason">-</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== APPROVE MODAL ==================== -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box" style="background: #e8f8ee; border: 6px solid white;">
                    <i class="fas fa-check-circle" style="color: #28a745;"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Approve Hospital Verification?</h4>
                <p class="text-muted">
                    You are about to approve <strong id="approveHospitalName"></strong>.<br />
                    This hospital will gain access to all hospital features.
                </p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success px-4 rounded-pill" id="confirmApproveBtn">Approve</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== REJECT MODAL ==================== -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icons-box">
                    <i class="fas fa-user-slash"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Reject Hospital Verification?</h4>
                <p class="text-muted">
                    You are about to reject <strong id="rejectHospitalName"></strong>.<br />
                    They will not be able to access hospital features.
                </p>
                <div class="text-start mb-3 mt-3 px-4">
                    <label class="form-label small text-muted mb-1">Reason for Rejection <span class="text-danger">*</span></label>
                    <textarea id="rejectionReasonInput" class="form-control" rows="3" placeholder="e.g., Invalid License, Unclear Document..." required></textarea>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmRejectBtn">Reject</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card { background: #ffffff; border-radius: 16px !important; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .custom-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important; }
    .icon-box { width: 48px; height: 48px; background: #f8f9fa; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .trend-icon { font-size: 1.5rem; color: #28a745; opacity: 0.6; }
    .delete-modal { border-radius: 22px; border: none; box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25); overflow: visible; animation: popIn 0.3s ease; }
    .delete-icon-wrapper { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); z-index: 10; }
    .icons-box { width: 85px; height: 85px; background: #fff5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 6px solid white; }
    .icons-box i { font-size: 34px; color: #ff3b3b; }
    @@keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    
    #viewDetailsModal .form-control-plaintext { font-size: 1.05rem; padding: 0.25rem 0; border-bottom: 1px dashed #dee2e6; }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ==================== GLOBAL VARIABLES ====================
            let currentUserId = null;
            let approveModalInstance = null;
            let rejectModalInstance = null;
            
            // Initialize modal instances once
            approveModalInstance = new bootstrap.Modal(document.getElementById('approveModal'));
            rejectModalInstance = new bootstrap.Modal(document.getElementById('rejectModal'));

            // ==================== FILTERS ====================
            const searchInput = document.getElementById('searchInput');
            const filterStatus = document.getElementById('filterStatus');
            const filterCity = document.getElementById('filterCity');
            const filterDate = document.getElementById('filterDate');

            function filterTable() {
                const sVal = searchInput.value.toLowerCase();
                const statVal = filterStatus.value;
                const cityVal = filterCity.value;
                const dateVal = filterDate.value;
                
                const rows = document.querySelectorAll("#verificationTable tbody tr");
                const today = new Date(); today.setHours(0,0,0,0);

                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    const name = row.cells[1].textContent.toLowerCase();
                    const email = row.cells[2].textContent.toLowerCase();
                    const lic = row.cells[3].textContent.toLowerCase();
                    const contact = row.cells[4].textContent.toLowerCase();
                    const city = row.cells[5].textContent.toLowerCase();
                    
                    const statusBadge = row.cells[7].querySelector('.badge');
                    const statusText = statusBadge ? statusBadge.textContent.toLowerCase() : '';

                    const rowDateStr = row.getAttribute('data-date');
                    const rowDate = new Date(rowDateStr);

                    let show = true;

                    if (sVal && !(name.includes(sVal) || email.includes(sVal) || lic.includes(sVal) || contact.includes(sVal) || city.includes(sVal))) show = false;
                    if (statVal !== 'all' && statusText !== statVal) show = false;
                    if (cityVal !== 'all' && city !== cityVal) show = false;

                    if (dateVal !== 'all') {
                        if (dateVal === 'today') {
                            if (rowDate.getTime() !== today.getTime()) show = false;
                        } else if (dateVal === 'week') {
                            const weekAgo = new Date(today); weekAgo.setDate(weekAgo.getDate() - 7);
                            if (rowDate < weekAgo) show = false;
                        } else if (dateVal === 'month') {
                            if (rowDate.getMonth() !== today.getMonth() || rowDate.getFullYear() !== today.getFullYear()) show = false;
                        }
                    }

                    row.style.display = show ? "" : "none";
                });
                initPagination();
            }

            [searchInput, filterStatus, filterCity, filterDate].forEach(el => el.addEventListener('input', filterTable));
            [filterStatus, filterCity, filterDate].forEach(el => el.addEventListener('change', filterTable));

            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function initPagination() {
                const visible = Array.from(document.querySelectorAll("#verificationTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow');
                const pages = Math.ceil(visible.length / rowsPerPage);
                if (currentPage > pages) currentPage = pages || 1;
                showPage(currentPage, visible);
            }

            function showPage(page, visible) {
                currentPage = page;
                document.querySelectorAll("#verificationTable tbody tr").forEach(r => { if(r.id !== 'emptyStateRow') r.style.display = 'none'; });
                const start = (page - 1) * rowsPerPage;
                visible.slice(start, start + rowsPerPage).forEach(r => r.style.display = '');
                renderPagination(visible.length);
            }

            function renderPagination(total) {
                pagination.innerHTML = "";
                const pages = Math.ceil(total / rowsPerPage);
                if (pages <= 1) return;

                const prev = document.createElement("li"); prev.className = `page-item ${currentPage===1?'disabled':''}`;
                prev.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prev.onclick = (e) => { e.preventDefault(); if(currentPage>1) showPage(currentPage-1, getVisible()); };
                pagination.appendChild(prev);

                for (let i=1; i<=pages; i++) {
                    const li = document.createElement("li"); li.className = `page-item ${currentPage===i?'active':''}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.onclick = (e) => { e.preventDefault(); showPage(i, getVisible()); };
                    pagination.appendChild(li);
                }

                const next = document.createElement("li"); next.className = `page-item ${currentPage===pages?'disabled':''}`;
                next.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                next.onclick = (e) => { e.preventDefault(); if(currentPage<pages) showPage(currentPage+1, getVisible()); };
                pagination.appendChild(next);
            }

            function getVisible() { return Array.from(document.querySelectorAll("#verificationTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow'); }
            initPagination();

            // ==================== EVENT DELEGATION ====================
            document.getElementById('verificationTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target.getAttribute('data-userid'));
                }
                else if (target.classList.contains('view-license-btn')) {
                    openLicenseOptions(target.getAttribute('data-userid'));
                }
                else if (target.classList.contains('approve-action-btn')) {
                    openApproveModal(target.getAttribute('data-userid'), target.getAttribute('data-hospitalname'));
                }
                else if (target.classList.contains('reject-action-btn')) {
                    openRejectModal(target.getAttribute('data-userid'), target.getAttribute('data-hospitalname'));
                }
            });

            // ==================== VIEW DETAILS MODAL ====================
            function openViewDetailsModal(userId) {
                document.getElementById('modalRequestId').textContent = `VER-${String(userId).padStart(4, '0')}`;
                
                fetch(`/Admin/GetHospitalVerificationDetails?userId=${userId}`)
                    .then(r => {
                        if (!r.ok) throw new Error('Network response was not ok');
                        return r.json();
                    })
                    .then(d => {
                        document.getElementById('d_HospitalName').textContent = d.hospitalName || '-';
                        document.getElementById('d_LicenseNumber').textContent = d.licenseNumber || '-';
                        document.getElementById('d_ContactPerson').textContent = d.contactPerson || '-';
                        document.getElementById('d_Email').textContent = d.email || '-';
                        document.getElementById('d_Phone').textContent = d.phone || '-';
                        document.getElementById('d_Address').textContent = d.address || '-';
                        document.getElementById('d_City').textContent = d.city || '-';

                        // License Buttons - NOW USING CONTROLLER ACTION
                        const licenseContainer = document.getElementById('licenseButtonsContainer');
                        if (d.licenseDocumentPath) {
                            licenseContainer.innerHTML = `
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="viewLicense(${userId})">
                                    <i class="bx bx-show me-1"></i>View
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="downloadLicense(${userId}, '${d.hospitalName.replace(/'/g, "\\'")}')">
                                    <i class="bx bx-download me-1"></i>Download
                                </button>
                            `;
                        } else {
                            licenseContainer.innerHTML = `<p class="text-muted mb-0">No document uploaded.</p>`;
                        }

                        // Rejection Section
                        const rejSec = document.getElementById('d_RejectionSection');
                        if (d.verificationStatus === 'Rejected' && d.rejectionReason) {
                            rejSec.style.display = 'block';
                            document.getElementById('d_RejectionReason').textContent = d.rejectionReason;
                        } else {
                            rejSec.style.display = 'none';
                        }
                        
                        const viewModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                        viewModal.show();
                    })
                    .catch(error => {
                        console.error('Error fetching details:', error);
                        showNotification('Failed to load hospital details', 'error');
                    });
            }

            // ==================== LICENSE FUNCTIONS - USING CONTROLLER ACTION ====================
            window.viewLicense = function(userId) {
                if (userId) {
                    window.open(`/Admin/ViewLicense?userId=${userId}`, '_blank');
                } else {
                    showNotification('No license document available', 'error');
                }
            };

            window.downloadLicense = function(userId) {

    const link = document.createElement('a');

    link.href = `/Admin/DownloadLicense?userId=${userId}`;

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);
};

            function openLicenseOptions(userId) {
                fetch(`/Admin/GetHospitalVerificationDetails?userId=${userId}`)
                    .then(r => r.json())
                    .then(d => {
                        if (d.licenseDocumentPath) {
                            const modalHtml = `
                                <div class="modal fade" id="licenseOptionsModal" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">License Document</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-center">
                                                <p class="mb-3">What would you like to do?</p>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button type="button" class="btn btn-outline-primary" onclick="viewLicense(${userId}); bootstrap.Modal.getInstance(document.getElementById('licenseOptionsModal')).hide();">
                                                        <i class="bx bx-show me-1"></i>View
                                                    </button>
                                                    <button type="button" class="btn btn-outline-success" onclick="downloadLicense(${userId}, '${d.hospitalName.replace(/'/g, "\\'")}'); bootstrap.Modal.getInstance(document.getElementById('licenseOptionsModal')).hide();">
                                                        <i class="bx bx-download me-1"></i>Download
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `;
                            
                            const existingModal = document.getElementById('licenseOptionsModal');
                            if (existingModal) existingModal.remove();
                            
                            document.body.insertAdjacentHTML('beforeend', modalHtml);
                            const licenseModal = new bootstrap.Modal(document.getElementById('licenseOptionsModal'));
                            licenseModal.show();
                            
                            document.getElementById('licenseOptionsModal').addEventListener('hidden.bs.modal', function() {
                                this.remove();
                            });
                        } else {
                            showNotification('No license document uploaded', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Failed to load license document', 'error');
                    });
            }

            // ==================== APPROVE MODAL ====================
            function openApproveModal(userId, hospitalName) {
                currentUserId = userId;
                document.getElementById('approveHospitalName').textContent = hospitalName;
                approveModalInstance.show();
            }

            document.getElementById('confirmApproveBtn').addEventListener('click', function() {
                if (!currentUserId) return;
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('userId', currentUserId);

                fetch('/Admin/ApproveHospital', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        if (d.success) {
                            approveModalInstance.hide();
                            showNotification(d.message, 'success');
                            updateRowStatus(currentUserId, 'Approved');
                        } else {
                            showNotification(d.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Failed to approve hospital', 'error');
                    });
            });

            document.getElementById('approveModal').addEventListener('hidden.bs.modal', function() {
                document.body.classList.remove('modal-open');
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove();
            });

            // ==================== REJECT MODAL ====================
            function openRejectModal(userId, hospitalName) {
                currentUserId = userId;
                document.getElementById('rejectHospitalName').textContent = hospitalName;
                document.getElementById('rejectionReasonInput').value = '';
                rejectModalInstance.show();
            }

            document.getElementById('confirmRejectBtn').addEventListener('click', function() {
                const reason = document.getElementById('rejectionReasonInput').value.trim();
                if (!reason) {
                    showNotification('Please provide a reason for rejection.', 'error');
                    return;
                }
                if (!currentUserId) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('userId', currentUserId);
                fd.append('reason', reason);

                fetch('/Admin/RejectHospital', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        if (d.success) {
                            rejectModalInstance.hide();
                            showNotification(d.message, 'success');
                            updateRowStatus(currentUserId, 'Rejected');
                        } else {
                            showNotification(d.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Failed to reject hospital', 'error');
                    });
            });

            document.getElementById('rejectModal').addEventListener('hidden.bs.modal', function() {
                document.body.classList.remove('modal-open');
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove();
            });

            // ==================== UPDATE ROW STATUS ====================
            function updateRowStatus(userId, status) {
                const row = document.querySelector(`tr [data-userid="${userId}"]`)?.closest('tr');
                if (!row) {
                    location.reload();
                    return;
                }

                const badge = row.cells[7].querySelector('.badge');
                badge.className = 'badge ' + (status === 'Approved' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger');
                badge.textContent = status;

                const actionsCell = row.cells[8].querySelector('.btn-group');
                actionsCell.innerHTML = '';

                actionsCell.innerHTML += `
                    <button type="button" class="btn btn-outline-info view-details-btn" data-userid="${userId}" title="View Details">
                        <i class="bx bx-info-circle"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary view-license-btn" data-userid="${userId}" title="View License">
                        <i class="bx bx-file"></i>
                    </button>
                `;

                if (status === 'Approved') {
                    actionsCell.innerHTML += `
                        <button type="button" class="btn btn-outline-danger reject-action-btn" data-userid="${userId}" data-hospitalname="${row.cells[1].textContent}" title="Reject">
                            <i class="bx bx-x"></i>
                        </button>
                    `;
                } else if (status === 'Rejected') {
                    actionsCell.innerHTML += `
                        <button type="button" class="btn btn-outline-success approve-action-btn" data-userid="${userId}" data-hospitalname="${row.cells[1].textContent}" title="Approve">
                            <i class="bx bx-check"></i>
                        </button>
                    `;
                }
            }

            // ==================== NOTIFICATION ====================
            function showNotification(msg, type) {
                const bg = type === 'success' ? '#28a745' : '#dc3545';
                const n = document.createElement('div');
                n.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:white;padding:12px 20px;border-radius:10px;box-shadow:0 5px 20px rgba(0,0,0,0.2);font-weight:500;animation:popIn 0.3s ease;`;
                n.textContent = msg;
                document.body.appendChild(n);
                setTimeout(() => n.remove(), 3000);
            }
        });
    </script>
}

