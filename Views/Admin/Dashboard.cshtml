@model Khoon_e_Hayat.ViewModels.DashboardViewModel

@functions {
    public string GetStatusBadge(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "fulfilled" => "success",
            "rejected" => "danger",
            "critical" => "danger",
            "new" => "info",
            "active" => "success",
            "inactive" => "secondary",
            _ => "secondary"
        };
    }
}

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">Dashboard Overview</h4>
                    <small class="text-muted">Here's an overview of your blood donation platform's performance, users, and requests</small>
                </div>
                <span class="badge bg-label-primary rounded-pill px-3 py-2">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- ==================== SUMMARY CARDS ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Users -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-people text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Users</h6>
                                <small class="text-muted">@Model.TotalUsers.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Total Donors -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-droplet-half text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Donors</h6>
                                <small class="text-muted">@Model.TotalDonors.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Total Receivers -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-person-hearts text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Receivers</h6>
                                <small class="text-muted">@Model.TotalReceivers.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Total Hospitals -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hospital text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Hospitals</h6>
                                <small class="text-muted">@Model.TotalHospitals.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending Hospital Approvals -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hourglass-split text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Approvals</h6>
                                <small class="text-muted">@Model.PendingHospitalApprovals.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                        @if (Model.PendingHospitalApprovals > 0)
                        {
                            <div class="mt-2 px-3 pb-3">
                                <a asp-action="Hospitals" class="text-danger small text-decoration-none">
                                    View Pending <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Active Blood Requests -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-clipboard2-pulse text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Active Requests</h6>
                                <small class="text-muted">@Model.ActiveBloodRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Emergency Requests -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-exclamation-triangle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Emergency Requests</h6>
                                <small class="text-muted">@Model.EmergencyRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Contact Messages -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-chat-dots text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Contact Messages</h6>
                                <small class="text-muted">@Model.ContactMessages.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== ANALYTICS SECTION ==================== -->
            <div class="row g-4 mb-4">
                <!-- Monthly Registrations Trend -->
                <div class="col-lg-8">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1 fw-semibold">Monthly Registrations Trend</h5>
                                    <small class="text-muted">New user registrations throughout the year</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="chart-container">
                                <canvas id="registrationsChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Distribution -->
                <div class="col-lg-4">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div>
                                <h5 class="mb-1 fw-semibold">User Distribution</h5>
                                <small class="text-muted">Active users by role</small>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2 d-flex flex-column justify-content-center align-items-center">
                            <div class="chart-container-doughnut">
                                <canvas id="userDistChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Blood Requests By Status -->
                <div class="col-lg-6">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1 fw-semibold">Blood Requests By Status</h5>
                                    <small class="text-muted">Distribution of request statuses</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="chart-container">
                                <canvas id="requestStatusChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Blood Requests By Blood Group -->
                <div class="col-lg-6">
                    <div class="card custom-card analytics-card h-100">
                        <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1 fw-semibold">Requests By Blood Group</h5>
                                    <small class="text-muted">Blood requests distribution by group</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="chart-container">
                                <canvas id="bloodGroupChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                            /* ================= ANALYTICS SECTION ================= */
                            .analytics-card {
                                background: rgba(255, 255, 255, 0.85) !important;
                                backdrop-filter: blur(12px);
                                -webkit-backdrop-filter: blur(12px);
                                border: 1px solid rgba(255, 255, 255, 0.6) !important;
                                box-shadow: 0 10px 30px rgba(16, 24, 40, 0.04) !important;
                            }

                                .analytics-card:hover {
                                    background: rgba(255, 255, 255, 0.95) !important;
                                    box-shadow: 0 15px 40px rgba(16, 24, 40, 0.08) !important;
                                    transform: translateY(-4px);
                                }

                                .analytics-card .card-header h5 {
                                    font-size: 1.1rem;
                                    font-weight: 700;
                                    color: #1e293b;
                                }

                                .analytics-card .card-header small {
                                    font-size: 0.85rem;
                                    color: #64748b;
                                }

                            .chart-container {
                                position: relative;
                                height: 320px;
                                width: 100%;
                            }

                            .chart-container-doughnut {
                                position: relative;
                                height: 320px;
                                width: 100%;
                                max-width: 300px;
                                margin: 0 auto;
                            }

                            @@media (max-width: 991.98px) {
                                .chart-container, .chart-container-doughnut {
                                    height: 280px;
                                }
                            }

                            @@media (max-width: 767.98px) {
                                .chart-container, .chart-container-doughnut {
                                    height: 250px;
                                }

                                .analytics-card .card-header .d-flex {
                                    flex-direction: column;
                                    align-items: flex-start !important;
                                    gap: 0.75rem;
                                }
                            }
            </style>

            <!-- ==================== RECENT ACTIVITY SECTION ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Recent Activity</h4>
                            <small class="text-muted">Latest blood requests, users, and messages</small>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="BloodRequests" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-clipboard2-pulse me-1"></i>Requests
                            </a>
                            <a asp-action="ContactMessages" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-chat-dots me-1"></i>Messages
                            </a>
                            <a asp-controller="UserManagement" asp-action="Hospitals" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-hospital me-1"></i>Hospitals
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <!-- ✅ FIXED: Perfect 3-Column Grid with Equal Heights -->
                    <div class="row g-4">
                        <!-- Recent Blood Requests -->
                        <div class="col-lg-4 col-md-12">
                            <div class="activity-column h-100">
                                <h6 class="activity-title mb-3">
                                    <i class="bi bi-clipboard2-pulse text-primary me-2"></i>Recent Blood Requests
                                </h6>
                                <div class="activity-content">
                                    @if (Model.RecentBloodRequests.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var req in Model.RecentBloodRequests.Take(5))
                                            {
                                                <div class="list-group-item border-0 px-0 py-2 mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1 me-2">
                                                            <h6 class="mb-1 fw-medium small">@req.ReceiverName</h6>
                                                            <p class="small text-muted mb-1">@req.HospitalName, @req.City</p>
                                                            <span class="badge bg-@GetStatusBadge(req.UrgencyLevel) rounded-pill small">
                                                                @req.UrgencyLevel
                                                            </span>
                                                        </div>
                                                        <div class="text-end">
                                                            <p class="fw-semibold small mb-1">@req.BloodGroup (@req.UnitsRequired units)</p>
                                                            <small class="text-muted">@req.CreatedDate.ToString("dd MMM")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted empty-state">
                                            <i class="bi bi-clipboard2-x fs-4 d-block mb-2"></i>
                                            <small>No recent requests</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Recent Users -->
                        <div class="col-lg-4 col-md-12">
                            <div class="activity-column h-100">
                                <h6 class="activity-title mb-3">
                                    <i class="bi bi-people text-primary me-2"></i>Recent Registered Users
                                </h6>
                                <div class="activity-content">
                                    @if (Model.RecentUsers.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var user in Model.RecentUsers.Take(5))
                                            {
                                                <div class="list-group-item border-0 px-0 py-2 mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1 me-2">
                                                            <h6 class="mb-1 fw-medium small">@user.Name</h6>
                                                            <p class="small text-muted mb-1">@user.Email</p>
                                                            <span class="badge bg-label-primary rounded-pill small">
                                                                @user.Role
                                                            </span>
                                                        </div>
                                                        <div class="text-end">
                                                            <p class="fw-semibold small mb-1">@user.City</p>
                                                            <small class="text-muted">@user.RegistrationDate.ToString("dd MMM")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted empty-state">
                                            <i class="bi bi-person-x fs-4 d-block mb-2"></i>
                                            <small>No recent users</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Pending Hospitals -->
                        <div class="col-lg-4 col-md-12">
                            <div class="activity-column h-100">
                                <h6 class="activity-title mb-3">
                                    <i class="bi bi-hospital text-primary me-2"></i>Pending Hospital Verifications
                                </h6>
                                <div class="activity-content">
                                    @if (Model.PendingHospitals.Any())
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var hosp in Model.PendingHospitals.Take(5))
                                            {
                                                <div class="list-group-item border-0 px-0 py-2 mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1 me-2">
                                                            <h6 class="mb-1 fw-medium small">@hosp.HospitalName</h6>
                                                            <p class="small text-muted mb-1">License: @hosp.LicenseNumber</p>
                                                            <span class="badge bg-warning rounded-pill small">
                                                                Pending
                                                            </span>
                                                        </div>
                                                        <div class="text-end">
                                                            <p class="fw-semibold small mb-1">@hosp.City</p>
                                                            <small class="text-muted">@hosp.RegistrationDate.ToString("dd MMM")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted empty-state">
                                            <i class="bi bi-hospital-x fs-4 d-block mb-2"></i>
                                            <small>No pending verifications</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Perfect Alignment) ==================== -->
<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        border: 1px solid #eef1f6 !important;
        box-shadow: 0 8px 30px rgba(16, 24, 40, 0.04);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .custom-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(16, 24, 40, 0.08);
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        transition: background 0.2s ease;
    }

    .custom-card:hover .icon-box {
        background: #e9ecef;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .custom-card:hover .trend-icon {
        opacity: 1;
    }

    .badge.bg-label-primary {
        background-color: #cfe2ff !important;
        color: #0d6efd !important;
    }

    .badge.bg-label-success {
        background-color: #d1e7dd !important;
        color: #198754 !important;
    }

    .badge.bg-label-secondary {
        background-color: #e2e3e5 !important;
        color: #6c757d !important;
    }

    .card-header {
        border-bottom: 1px solid #f1f3f7 !important;
        padding-bottom: 18px !important;
    }

    .card-body h6 {
        font-size: 15px;
        font-weight: 700;
        color: #2f3e52;
        margin-bottom: 18px !important;
    }

    /* ✅ NEW: Perfect Activity Column Styling */
    .activity-column {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .activity-title {
        font-size: 15px;
        font-weight: 700;
        color: #2f3e52;
        margin-bottom: 20px !important;
        padding-bottom: 12px;
        border-bottom: 2px solid #f1f3f7;
    }

    .activity-content {
        flex: 1;
        overflow-y: auto;
        max-height: 450px;
    }

    .list-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .list-group-item {
        border: 1px solid #edf1f7 !important;
        border-radius: 14px !important;
        background: #fafcff !important;
        padding: 14px !important;
        transition: all 0.25s ease;
        box-shadow: 0 2px 8px rgba(16, 24, 40, 0.03);
    }

        .list-group-item:hover {
            transform: translateY(-2px);
            background: #f0f4ff !important;
            border-color: #d9e7ff !important;
            box-shadow: 0 4px 12px rgba(16, 24, 40, 0.06);
        }

        .list-group-item h6 {
            font-size: 14px;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 3px !important;
        }

        .list-group-item p {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 6px !important;
        }

    .text-end p {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 3px !important;
    }

    .text-end small {
        font-size: 12px;
        color: #9ca3af !important;
    }

    .badge {
        font-size: 11px !important;
        font-weight: 600 !important;
        padding: 6px 10px !important;
        border-radius: 50px !important;
        letter-spacing: 0.3px;
    }

    .card-header .btn {
        border-radius: 50px !important;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        transition: all 0.25s ease;
    }

        .card-header .btn:hover {
            transform: translateY(-2px);
        }

    .text-center.py-4 {
        border: 2px dashed #e5e7eb;
        border-radius: 14px;
        background: #fafafa;
    }

    .empty-state {
        min-height: 200px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    /* Responsive Adjustments */
    @@media (max-width: 992px) {
        .activity-column {
            margin-bottom: 20px;
        }
    }

    @@media (max-width: 768px) {
        .card-header .d-flex {
            flex-direction: column !important;
            align-items: flex-start !important;
        }

        .card-header .btn {
            width: 100%;
            justify-content: center;
        }

        .list-group-item {
            padding: 12px !important;
        }

            .list-group-item .d-flex {
                flex-direction: column;
                gap: 8px;
            }

        .text-end {
            text-align: left !important;
        }

        .activity-content {
            max-height: 350px;
        }
    }
</style>

<!-- ==================== CHART.JS INITIALIZATION ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof Chart !== 'undefined') {

                Chart.defaults.font.family = "'Public Sans', 'Inter', system-ui, sans-serif";
                Chart.defaults.color = '#898F99';
                Chart.defaults.plugins.legend.labels.usePointStyle = true;
                Chart.defaults.plugins.legend.labels.pointStyle = 'circle';
                Chart.defaults.plugins.legend.labels.padding = 20;
                Chart.defaults.plugins.legend.labels.color = '#898F99';
                Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(6, 49, 84, 0.95)';
                Chart.defaults.plugins.tooltip.titleColor = '#ffffff';
                Chart.defaults.plugins.tooltip.bodyColor = '#ffffff';
                Chart.defaults.plugins.tooltip.titleFont = { size: 13, weight: '600' };
                Chart.defaults.plugins.tooltip.bodyFont = { size: 12 };
                Chart.defaults.plugins.tooltip.padding = 12;
                Chart.defaults.plugins.tooltip.cornerRadius = 8;
                Chart.defaults.plugins.tooltip.displayColors = true;
                Chart.defaults.plugins.tooltip.boxPadding = 4;

                // Theme Palette
                const theme = [
                    '#0E1A2B', // Dark Navy
                    '#5C88A8', // Light Blue
                    '#06162B', // Very Dark Navy
                    '#2F6E9B', // Bright Blue
                    '#0B2342', // Deep Blue
                    '#214D72', // Medium Blue
                    '#0A1A33', // Dark Blue
                    '#223A5E', // Steel Blue
                    '#1C2F57', // Medium Dark Blue
                    '#0F2E57'  // Royal Blue
                ];

                // 1. Monthly Registrations Trend
                const regCtx = document.getElementById('registrationsChart');
                if (regCtx) {
                    const ctx = regCtx.getContext('2d');
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.MonthlyRegistrationsData.Select(d => $"'{d.Month}'")))],
                            datasets: [{
                                label: 'Registrations',
                                data: [@Html.Raw(string.Join(",", Model.MonthlyRegistrationsData.Select(d => d.Count)))],
                                borderColor: '#2F6E9B',
                                backgroundColor: 'transparent',
                                borderWidth: 2.5,
                                fill: false,
                                tension: 0.45,
                                cubicInterpolationMode: 'monotone',
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                pointBackgroundColor: '#0E1A2B',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2.5,
                                pointHoverBorderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: { legend: { display: false } },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    border: { display: false },
                                    ticks: { color: '#898F99', padding: 10, font: { size: 11, weight: '500' } }
                                },
                                y: {
                                    grid: { color: 'rgba(137,143,153,0.12)', drawBorder: false },
                                    border: { display: false },
                                    ticks: { color: '#898F99', padding: 15, font: { size: 11, weight: '500' }, stepSize: 1 }
                                }
                            }
                        }
                    });
                }

                // 2. User Distribution
                const distCtx = document.getElementById('userDistChart');
                if (distCtx) {
                    const distColors = [theme[3], theme[1], theme[5]];
                    new Chart(distCtx.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.UserDistributionData.Select(d => $"'{d.Label}'")))],
                            datasets: [{
                                data: [@Html.Raw(string.Join(",", Model.UserDistributionData.Select(d => d.Value)))],
                                backgroundColor: distColors,
                                borderWidth: 0,
                                hoverOffset: 15,
                                spacing: 4,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '72%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        padding: 20,
                                        font: { size: 12, weight: '500' },
                                        color: '#898F99',
                                        usePointStyle: true,
                                        pointStyle: 'rectRounded'
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                            var percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                            return ' ' + context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // 3. Blood Requests By Status (LINE STYLE like Monthly Registrations)
                const statusCtx = document.getElementById('requestStatusChart');
                if (statusCtx) {
                    const ctx = statusCtx.getContext('2d');

                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.BloodRequestsByStatusData.Select(d => $"'{d.Label}'")))],
                            datasets: [{
                                label: 'Requests',
                                data: [@Html.Raw(string.Join(",", Model.BloodRequestsByStatusData.Select(d => d.Value)))],
                                borderColor: '#2F6E9B',
                                backgroundColor: 'transparent',
                                borderWidth: 1.8,
                                fill: false,
                                tension: 0.4,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                pointBackgroundColor: '#0E1A2B',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2.5,
                                pointHoverBorderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: { legend: { display: false } },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    border: { display: false },
                                    ticks: { color: '#898F99', padding: 10, font: { size: 11, weight: '500' } }
                                },
                                y: {
                                    grid: { color: 'rgba(137,143,153,0.12)', drawBorder: false },
                                    border: { display: false },
                                    ticks: { color: '#898F99', padding: 15, stepSize: 1, font: { size: 11, weight: '500' } }
                                }
                            }
                        }
                    });
                }

                // 4. Blood Requests By Blood Group (LINE STYLE like Monthly Registrations)
                const bgCtx = document.getElementById('bloodGroupChart');
                if (bgCtx) {
                    const ctx = bgCtx.getContext('2d');

                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.BloodRequestsByBloodGroupData.Select(d => $"'{d.Label}'")))],
                            datasets: [{
                                label: 'Requests',
                                data: [@Html.Raw(string.Join(",", Model.BloodRequestsByBloodGroupData.Select(d => d.Value)))],
                                borderColor: '#2F6E9B',
                                backgroundColor: 'transparent',
                                borderWidth: 1.8,
                                fill: false,
                                tension: 0.4,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                pointBackgroundColor: '#0E1A2B',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2.5,
                                pointHoverBorderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: { legend: { display: false } },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    border: { display: false },
                                    ticks: { color: '#898F99', padding: 10, font: { size: 11, weight: '500' } }
                                },
                                y: {
                                    grid: { color: 'rgba(137,143,153,0.12)', drawBorder: false },
                                    border: { display: false },
                                    ticks: { color: '#898F99', padding: 15, stepSize: 1, font: { size: 11, weight: '500' } }
                                }
                            }
                        }
                    });
                }
            }
        });
    </script>
