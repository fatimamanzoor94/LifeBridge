@model Khoon_e_Hayat.ViewModels.EmergencyAlertListViewModel
@{
    ViewData["Title"] = "Emergency Alerts Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Emergency Alerts Management</h4>
            </div>

            <!-- ==================== STATISTICS CARDS ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Alerts -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-bell text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Alerts</h6>
                                <small class="text-muted">@Model.TotalCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Active Alerts -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-time-five text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Active Alerts</h6>
                                <small class="text-muted">@Model.ActiveCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Resolved Alerts -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-check-circle text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Resolved Alerts</h6>
                                <small class="text-muted">@Model.ResolvedCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Critical Alerts -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-error text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Critical Alerts</h6>
                                <small class="text-muted">@Model.CriticalCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Hospital Alerts -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-buildings text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Hospital Alerts</h6>
                                <small class="text-muted">@Model.HospitalAlertsCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Today's Alerts -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bx bx-calendar text-dark"></i></div>
                                <h6 class="card-title mt-3 mb-1">Today's Alerts</h6>
                                <small class="text-muted">@Model.TodayCount.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== SEARCH & FILTER ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Alert ID, Receiver, Hospital, Blood Group..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Priority</label>
                            <select id="filterPriority" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Active">Active</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Ignored">Ignored</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">City</label>
                            <select id="filterCity" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                @foreach (var city in Model.AvailableCities)
                                {
                                    <option value="@city.ToLower()">@city</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <label class="form-label small text-muted mb-1">Date</label>
                            <select id="filterDate" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLE ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Emergency Alerts</h4>
                            <small class="text-muted">Monitor and manage critical blood shortage alerts</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTable('excel', 'alertsTable', 'EmergencyAlerts')"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="exportTable('pdf', 'alertsTable', 'EmergencyAlerts')"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="alertsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Alert ID</th>
                                    <th>Receiver Name</th>
                                    <th>Blood Group</th>
                                    <th>Hospital Name</th>
                                    <th>City</th>
                                    <th>Alert Message</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Alerts.Any())
                                {
                                    foreach (var alert in Model.Alerts)
                                    {
                                        <tr data-date="@alert.CreatedDate.ToString("yyyy-MM-dd")" data-status="@alert.AlertStatus">
                                            <td>ALT-@alert.AlertId.ToString("D4")</td>
                                            <td>@alert.ReceiverName</td>
                                            <td><span class="fw-bold text-danger">@alert.BloodGroup</span></td>
                                            <td>@(alert.HospitalName ?? "-")</td>
                                            <td>@(alert.City ?? "-")</td>
                                            <td><span class="text-truncate d-inline-block" style="max-width: 150px;" title="@alert.AlertMessage">@(alert.AlertMessage ?? "-")</span></td>
                                            <td>
                                                @if (alert.PriorityLevel == "Critical") { <span class="badge bg-danger-subtle text-danger">Critical</span> }
                                                else if (alert.PriorityLevel == "High") { <span class="badge bg-warning-subtle text-warning">High</span> }
                                                else { <span class="badge bg-info-subtle text-info">Medium</span> }
                                            </td>
                                            <td>
                                                @if (alert.AlertStatus == "Active") { <span class="badge bg-danger-subtle text-danger">Active</span> }
                                                else if (alert.AlertStatus == "In Progress") { <span class="badge bg-warning-subtle text-warning">In Progress</span> }
                                                else if (alert.AlertStatus == "Resolved") { <span class="badge bg-success-subtle text-success">Resolved</span> }
                                                else { <span class="badge bg-secondary-subtle text-secondary">Ignored</span> }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" data-alertid="@alert.AlertId" title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    
                                                    @if (alert.AlertStatus == "Active" || alert.AlertStatus == "In Progress")
                                                    {
                                                        <button type="button" class="btn btn-outline-primary resend-alert-btn" data-alertid="@alert.AlertId" title="Send Alert Again">
                                                            <i class="bx bx-broadcast"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success notify-hospital-btn" data-alertid="@alert.AlertId" title="Notify Hospital">
                                                            <i class="bx bx-phone-call"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-warning find-donors-btn" data-alertid="@alert.AlertId" title="Find Donors">
                                                            <i class="bx bx-search-alt"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success resolve-alert-btn" data-alertid="@alert.AlertId" title="Mark Resolved">
                                                            <i class="bx bx-check"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary dismiss-alert-btn" data-alertid="@alert.AlertId" title="Dismiss Alert">
                                                            <i class="bx bx-hide"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="emptyStateRow">
                                        <td colspan="9" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bx bx-bell-off fs-1 d-block mb-2 text-success"></i>
                                                <h5 class="fw-semibold">No Emergency Alerts Found</h5>
                                                <p class="mb-0">All systems are currently stable.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Alerts: @Model.TotalCount</small>
                        <nav><ul class="pagination pagination-sm mb-0" id="pagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW DETAILS MODAL ==================== -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-bell text-danger"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Emergency Alert Details</h5>
                        <small class="text-muted" id="modalAlertId">ALT-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-danger mb-3"><i class="bx bx-bell me-2"></i>Alert Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Alert ID</label><p class="form-control-plaintext fw-semibold mb-0" id="d_AlertId">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Priority Level</label><p class="form-control-plaintext mb-0" id="d_PriorityLevel">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Alert Status</label><p class="form-control-plaintext mb-0" id="d_AlertStatus">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Created Date</label><p class="form-control-plaintext mb-0" id="d_CreatedDate">-</p></div>
                            <div class="col-12"><label class="form-label small text-muted mb-1">Alert Message</label><p class="form-control-plaintext mb-0" id="d_AlertMessage">-</p></div>
                        </div>

                        <h6 class="fw-bold text-primary mb-3 mt-4"><i class="bx bx-user me-2"></i>Receiver Information</h6>
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label small text-muted mb-1">Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_ReceiverName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Email</label><p class="form-control-plaintext mb-0" id="d_ReceiverEmail">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Phone</label><p class="form-control-plaintext mb-0" id="d_ReceiverPhone">-</p></div>
                        </div>

                        <h6 class="fw-bold text-danger mb-3 mt-4"><i class="bx bx-droplet me-2"></i>Blood Requirement</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-danger mb-0" id="d_BloodGroup">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext mb-0" id="d_UnitsRequired">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Urgency Level</label><p class="form-control-plaintext mb-0" id="d_UrgencyLevel">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Required Date</label><p class="form-control-plaintext mb-0" id="d_RequiredDate">-</p></div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bx bx-buildings me-2"></i>Hospital Information</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Hospital Name</label><p class="form-control-plaintext mb-0" id="d_HospitalName">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">City</label><p class="form-control-plaintext mb-0" id="d_City">-</p></div>
                        </div>

                        <h6 class="fw-bold text-info mb-3 mt-4"><i class="bx bx-info-circle me-2"></i>Request Information</h6>
                        <div class="row g-3">
                            <div class="col-4"><label class="form-label small text-muted mb-1">Request ID</label><p class="form-control-plaintext fw-semibold mb-0" id="d_RequestId">-</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Request Status</label><p class="form-control-plaintext mb-0" id="d_RequestStatus">-</p></div>
                            <div class="col-4"><label class="form-label small text-muted mb-1">Created Date</label><p class="form-control-plaintext mb-0" id="d_RequestCreatedDate">-</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CONFIRMATION MODALS ==================== -->
<div class="modal fade" id="resendAlertModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content delete-modal position-relative"><div class="delete-icon-wrapper"><div class="icons-box" style="background: #e7f1ff; border: 6px solid white;"><i class="fas fa-broadcast-tower" style="color: #0d6efd;"></i></div></div><div class="modal-body text-center pt-5 pb-4"><h4 class="fw-bold">Send Alert Again?</h4><p class="text-muted">You are about to resend this emergency alert to donors and hospitals.<br />This will trigger the notification system again.</p><div class="d-flex gap-2 justify-content-center mt-3"><button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary px-4 rounded-pill" id="confirmResendBtn">Send Alert</button></div></div></div></div></div>
<div class="modal fade" id="notifyHospitalModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content delete-modal position-relative"><div class="delete-icon-wrapper"><div class="icons-box" style="background: #e8f8ee; border: 6px solid white;"><i class="fas fa-phone-volume" style="color: #28a745;"></i></div></div><div class="modal-body text-center pt-5 pb-4"><h4 class="fw-bold">Notify Hospital?</h4><p class="text-muted">You are about to notify the hospital regarding this emergency blood requirement.</p><div class="d-flex gap-2 justify-content-center mt-3"><button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success px-4 rounded-pill" id="confirmNotifyBtn">Notify Hospital</button></div></div></div></div></div>
<div class="modal fade" id="findDonorsModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content delete-modal position-relative"><div class="delete-icon-wrapper"><div class="icons-box" style="background: #fff3cd; border: 6px solid white;"><i class="fas fa-users" style="color: #ffc107;"></i></div></div><div class="modal-body text-center pt-5 pb-4"><h4 class="fw-bold">Find Donors?</h4><p class="text-muted">You are about to start smart donor matching for this emergency alert.<br />The system will search for compatible nearby donors.</p><div class="d-flex gap-2 justify-content-center mt-3"><button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-warning px-4 rounded-pill" id="confirmFindDonorsBtn">Find Donors</button></div></div></div></div></div>
<div class="modal fade" id="resolveAlertModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content delete-modal position-relative"><div class="delete-icon-wrapper"><div class="icons-box" style="background: #e8f8ee; border: 6px solid white;"><i class="fas fa-check-circle" style="color: #28a745;"></i></div></div><div class="modal-body text-center pt-5 pb-4"><h4 class="fw-bold">Mark as Resolved?</h4><p class="text-muted">You are about to mark this emergency alert as resolved.</p><div class="d-flex gap-2 justify-content-center mt-3"><button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success px-4 rounded-pill" id="confirmResolveBtn">Mark Resolved</button></div></div></div></div></div>
<div class="modal fade" id="dismissAlertModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content delete-modal position-relative"><div class="delete-icon-wrapper"><div class="icons-box" style="background: #f8f9fa; border: 6px solid white;"><i class="fas fa-eye-slash" style="color: #6c757d;"></i></div></div><div class="modal-body text-center pt-5 pb-4"><h4 class="fw-bold">Dismiss Alert?</h4><p class="text-muted">You are about to dismiss this emergency alert.</p><div class="d-flex gap-2 justify-content-center mt-3"><button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-secondary px-4 rounded-pill" id="confirmDismissBtn">Dismiss Alert</button></div></div></div></div></div>

<!-- ==================== MATCHED DONORS MODAL (NEW) ==================== -->
<div class="modal fade" id="matchedDonorsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-warning-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-group text-warning"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Matched Donors</h5>
                        <small class="text-muted" id="matchedDonorsSubtitle">Smart matching results</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="card custom-card p-3 text-center">
                            <h6 class="text-muted mb-1">Total Found</h6>
                            <h3 class="fw-bold text-primary mb-0" id="totalMatched">0</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card custom-card p-3 text-center">
                            <h6 class="text-muted mb-1">Eligible</h6>
                            <h3 class="fw-bold text-success mb-0" id="eligibleDonors">0</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card custom-card p-3 text-center">
                            <h6 class="text-muted mb-1">Match Score</h6>
                            <h3 class="fw-bold text-warning mb-0" id="matchScore">0%</h3>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Blood Group</th>
                                <th>City</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="matchedDonorsTableBody">
                            <!-- Rows will be injected here -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-card { background: #ffffff; border-radius: 16px !important; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .custom-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important; }
    .icon-box { width: 48px; height: 48px; background: #f8f9fa; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .trend-icon { font-size: 1.5rem; color: #28a745; opacity: 0.6; }
    .delete-modal { border-radius: 22px; border: none; box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25); overflow: visible; animation: popIn 0.3s ease; }
    .delete-icon-wrapper { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); z-index: 10; }
    .icons-box { width: 85px; height: 85px; background: #fff5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 6px solid white; }
    .icons-box i { font-size: 34px; color: #ff3b3b; }
    @@keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    
    #viewDetailsModal .form-control-plaintext { font-size: 1.05rem; padding: 0.25rem 0; border-bottom: 1px dashed #dee2e6; }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ==================== GLOBAL VARIABLES ====================
            let currentAlertId = null;
            let resendModalInstance = new bootstrap.Modal(document.getElementById('resendAlertModal'));
            let notifyModalInstance = new bootstrap.Modal(document.getElementById('notifyHospitalModal'));
            let findDonorsModalInstance = new bootstrap.Modal(document.getElementById('findDonorsModal'));
            let resolveModalInstance = new bootstrap.Modal(document.getElementById('resolveAlertModal'));
            let dismissModalInstance = new bootstrap.Modal(document.getElementById('dismissAlertModal'));

            // ==================== FILTERS ====================
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterPriority = document.getElementById('filterPriority');
            const filterStatus = document.getElementById('filterStatus');
            const filterCity = document.getElementById('filterCity');
            const filterDate = document.getElementById('filterDate');

            function filterTable() {
                const sVal = searchInput.value.toLowerCase();
                const bgVal = filterBloodGroup.value;
                const priVal = filterPriority.value;
                const statVal = filterStatus.value;
                const cityVal = filterCity.value;
                const dateVal = filterDate.value;
                
                const rows = document.querySelectorAll("#alertsTable tbody tr");
                const today = new Date(); today.setHours(0,0,0,0);

                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    const alertId = row.cells[0].textContent.toLowerCase();
                    const name = row.cells[1].textContent.toLowerCase();
                    const bg = row.cells[2].textContent.toLowerCase();
                    const hospital = row.cells[3].textContent.toLowerCase();
                    const city = row.cells[4].textContent.toLowerCase();
                    
                    const priBadge = row.cells[6].querySelector('.badge');
                    const priText = priBadge ? priBadge.textContent : '';

                    const statBadge = row.cells[7].querySelector('.badge');
                    const statText = statBadge ? statBadge.textContent : '';

                    const rowDateStr = row.getAttribute('data-date');
                    const rowDate = new Date(rowDateStr);

                    let show = true;

                    if (sVal && !(alertId.includes(sVal) || name.includes(sVal) || hospital.includes(sVal) || bg.includes(sVal) || city.includes(sVal))) show = false;
                    if (bgVal !== 'all' && bg !== bgVal.toLowerCase()) show = false;
                    if (priVal !== 'all' && priText !== priVal) show = false;
                    if (statVal !== 'all' && statText !== statVal) show = false;
                    if (cityVal !== 'all' && city !== cityVal) show = false;

                    if (dateVal !== 'all') {
                        if (dateVal === 'today') {
                            if (rowDate.getTime() !== today.getTime()) show = false;
                        } else if (dateVal === 'week') {
                            const weekAgo = new Date(today); weekAgo.setDate(weekAgo.getDate() - 7);
                            if (rowDate < weekAgo) show = false;
                        } else if (dateVal === 'month') {
                            if (rowDate.getMonth() !== today.getMonth() || rowDate.getFullYear() !== today.getFullYear()) show = false;
                        }
                    }

                    row.style.display = show ? "" : "none";
                });
                initPagination();
            }

            [searchInput, filterBloodGroup, filterPriority, filterStatus, filterCity, filterDate].forEach(el => el.addEventListener('input', filterTable));
            [filterBloodGroup, filterPriority, filterStatus, filterCity, filterDate].forEach(el => el.addEventListener('change', filterTable));

            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function initPagination() {
                const visible = Array.from(document.querySelectorAll("#alertsTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow');
                const pages = Math.ceil(visible.length / rowsPerPage);
                if (currentPage > pages) currentPage = pages || 1;
                showPage(currentPage, visible);
            }

            function showPage(page, visible) {
                currentPage = page;
                document.querySelectorAll("#alertsTable tbody tr").forEach(r => { if(r.id !== 'emptyStateRow') r.style.display = 'none'; });
                const start = (page - 1) * rowsPerPage;
                visible.slice(start, start + rowsPerPage).forEach(r => r.style.display = '');
                renderPagination(visible.length);
            }

            function renderPagination(total) {
                pagination.innerHTML = "";
                const pages = Math.ceil(total / rowsPerPage);
                if (pages <= 1) return;

                const prev = document.createElement("li"); prev.className = `page-item ${currentPage===1?'disabled':''}`;
                prev.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prev.onclick = (e) => { e.preventDefault(); if(currentPage>1) showPage(currentPage-1, getVisible()); };
                pagination.appendChild(prev);

                for (let i=1; i<=pages; i++) {
                    const li = document.createElement("li"); li.className = `page-item ${currentPage===i?'active':''}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.onclick = (e) => { e.preventDefault(); showPage(i, getVisible()); };
                    pagination.appendChild(li);
                }

                const next = document.createElement("li"); next.className = `page-item ${currentPage===pages?'disabled':''}`;
                next.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                next.onclick = (e) => { e.preventDefault(); if(currentPage<pages) showPage(currentPage+1, getVisible()); };
                pagination.appendChild(next);
            }

            function getVisible() { return Array.from(document.querySelectorAll("#alertsTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow'); }
            initPagination();

            // ==================== EVENT DELEGATION ====================
            document.getElementById('alertsTable').addEventListener('click', function(e) {
                const target = e.target.closest('button');
                if (!target) return;

                if (target.classList.contains('view-details-btn')) {
                    openViewDetailsModal(target.getAttribute('data-alertid'));
                } else if (target.classList.contains('resend-alert-btn')) {
                    currentAlertId = target.getAttribute('data-alertid');
                    resendModalInstance.show();
                } else if (target.classList.contains('notify-hospital-btn')) {
                    currentAlertId = target.getAttribute('data-alertid');
                    notifyModalInstance.show();
                } else if (target.classList.contains('find-donors-btn')) {
                    currentAlertId = target.getAttribute('data-alertid');
                    findDonorsModalInstance.show();
                } else if (target.classList.contains('resolve-alert-btn')) {
                    currentAlertId = target.getAttribute('data-alertid');
                    resolveModalInstance.show();
                } else if (target.classList.contains('dismiss-alert-btn')) {
                    currentAlertId = target.getAttribute('data-alertid');
                    dismissModalInstance.show();
                }
            });

            // ==================== VIEW DETAILS MODAL ====================
            function openViewDetailsModal(alertId) {
                document.getElementById('modalAlertId').textContent = `ALT-${String(alertId).padStart(4, '0')}`;
                
                fetch(`/Admin/GetAlertDetails?alertId=${alertId}`)
                    .then(r => {
                        if (!r.ok) throw new Error('Network response was not ok');
                        return r.json();
                    })
                    .then(d => {
                        document.getElementById('d_AlertId').textContent = `ALT-${String(d.alertId).padStart(4, '0')}`;
                        document.getElementById('d_AlertMessage').textContent = d.alertMessage || '-';
                        document.getElementById('d_PriorityLevel').textContent = d.priorityLevel || '-';
                        document.getElementById('d_AlertStatus').textContent = d.alertStatus || '-';
                        document.getElementById('d_CreatedDate').textContent = new Date(d.createdDate).toLocaleDateString();

                        document.getElementById('d_ReceiverName').textContent = d.receiverName || '-';
                        document.getElementById('d_ReceiverEmail').textContent = d.receiverEmail || '-';
                        document.getElementById('d_ReceiverPhone').textContent = d.receiverPhone || '-';

                        document.getElementById('d_BloodGroup').textContent = d.bloodGroup || '-';
                        document.getElementById('d_UnitsRequired').textContent = d.unitsRequired || '-';
                        document.getElementById('d_UrgencyLevel').textContent = d.urgencyLevel || '-';
                        document.getElementById('d_RequiredDate').textContent = d.requiredDate ? new Date(d.requiredDate).toLocaleDateString() : 'Not Specified';

                        document.getElementById('d_HospitalName').textContent = d.hospitalName || '-';
                        document.getElementById('d_City').textContent = d.city || '-';

                        document.getElementById('d_RequestId').textContent = `REQ-${String(d.requestId).padStart(4, '0')}`;
                        document.getElementById('d_RequestStatus').textContent = d.requestStatus || '-';
                        document.getElementById('d_RequestCreatedDate').textContent = new Date(d.requestCreatedDate).toLocaleDateString();
                        
                        const viewModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                        viewModal.show();
                    })
                    .catch(error => {
                        console.error('Error fetching details:', error);
                        showNotification('Failed to load alert details', 'error');
                    });
            }

            // ==================== ACTION HANDLERS ====================
            // Standard Action (Notify Hospital)
            handleAction(notifyModalInstance, '/Admin/NotifyHospital');
            
            // Resolve & Dismiss Actions
            document.getElementById('confirmResolveBtn').onclick = function() { updateStatus('Resolved'); };
            document.getElementById('confirmDismissBtn').onclick = function() { updateStatus('Ignored'); };

            // Custom Handler: Resend Alert (Shows Success/Fail Counts)
            document.getElementById('confirmResendBtn').onclick = function() {
                if (!currentAlertId) return;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('alertId', currentAlertId);

                fetch('/Admin/ResendAlert', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        resendModalInstance.hide();
                        if (d.success) {
                            showNotification(`${d.message} (Sent: ${d.successCount}, Failed: ${d.failedCount})`, 'success');
                        } else {
                            showNotification(d.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Action failed', 'error');
                    });
            };

            // Custom Handler: Find Donors (Opens Matched Donors Modal)
            document.getElementById('confirmFindDonorsBtn').onclick = function() {
                if (!currentAlertId) return;
                findDonorsModalInstance.hide();
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('alertId', currentAlertId);

                fetch('/Admin/FindMatchingDonors', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        if (d.success) {
                            document.getElementById('totalMatched').textContent = d.totalDonors;
                            document.getElementById('eligibleDonors').textContent = d.eligibleDonors;
                            document.getElementById('matchScore').textContent = d.matchPercentage + '%';
                            
                            const tbody = document.getElementById('matchedDonorsTableBody');
                            tbody.innerHTML = '';
                            if (d.donors && d.donors.length > 0) {
                                d.donors.forEach(donor => {
                                    tbody.innerHTML += `
                                        <tr>
                                            <td>${donor.fullName}</td>
                                            <td>${donor.email}</td>
                                            <td>${donor.phone || '-'}</td>
                                            <td><span class="fw-bold text-danger">${donor.bloodGroup}</span></td>
                                            <td>${donor.city}</td>
                                            <td><span class="badge bg-success-subtle text-success">Available</span></td>
                                        </tr>
                                    `;
                                });
                            } else {
                                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-3">No matching donors found in this city.</td></tr>`;
                            }
                            
                            const matchedModal = new bootstrap.Modal(document.getElementById('matchedDonorsModal'));
                            matchedModal.show();
                            showNotification(d.message, 'success');
                        } else {
                            showNotification(d.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Failed to find donors', 'error');
                    });
            };

            function handleAction(modalInstance, url) {
                const confirmBtn = modalInstance._element.querySelector('button[id^="confirm"]');
                confirmBtn.addEventListener('click', function() {
                    if (!currentAlertId) return;
                    
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const fd = new FormData();
                    fd.append('__RequestVerificationToken', token);
                    fd.append('alertId', currentAlertId);

                    fetch(url, { method: 'POST', body: fd })
                        .then(r => r.json())
                        .then(d => {
                            if (d.success) {
                                modalInstance.hide();
                                showNotification(d.message, 'success');
                            } else {
                                showNotification(d.message, 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showNotification('Action failed', 'error');
                        });
                });
            }

            function updateStatus(status) {
                if (!currentAlertId) return;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('alertId', currentAlertId);
                fd.append('status', status);

                fetch('/Admin/UpdateAlertStatus', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        if (d.success) {
                            if (status === 'Resolved') resolveModalInstance.hide();
                            else dismissModalInstance.hide();
                            
                            showNotification(d.message, 'success');
                            updateRowStatus(currentAlertId, status);
                        } else {
                            showNotification(d.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Failed to update status', 'error');
                    });
            }

            // ==================== UPDATE ROW STATUS ====================
            function updateRowStatus(alertId, status) {
                const row = document.querySelector(`tr [data-alertid="${alertId}"]`)?.closest('tr');
                if (!row) {
                    location.reload();
                    return;
                }

                const badge = row.cells[7].querySelector('.badge');
                let badgeClass = 'bg-secondary-subtle text-secondary';
                if (status === 'Active') badgeClass = 'bg-danger-subtle text-danger';
                else if (status === 'In Progress') badgeClass = 'bg-warning-subtle text-warning';
                else if (status === 'Resolved') badgeClass = 'bg-success-subtle text-success';
                
                badge.className = 'badge ' + badgeClass;
                badge.textContent = status;
                row.setAttribute('data-status', status);

                const actionsCell = row.cells[8].querySelector('.btn-group');
                actionsCell.innerHTML = `
                    <button type="button" class="btn btn-outline-info view-details-btn" data-alertid="${alertId}" title="View Details">
                        <i class="bx bx-info-circle"></i>
                    </button>
                `;

                if (status === 'Active' || status === 'In Progress') {
                    actionsCell.innerHTML += `
                        <button type="button" class="btn btn-outline-primary resend-alert-btn" data-alertid="${alertId}" title="Send Alert Again"><i class="bx bx-broadcast"></i></button>
                        <button type="button" class="btn btn-outline-success notify-hospital-btn" data-alertid="${alertId}" title="Notify Hospital"><i class="bx bx-phone-call"></i></button>
                        <button type="button" class="btn btn-outline-warning find-donors-btn" data-alertid="${alertId}" title="Find Donors"><i class="bx bx-search-alt"></i></button>
                        <button type="button" class="btn btn-outline-success resolve-alert-btn" data-alertid="${alertId}" title="Mark Resolved"><i class="bx bx-check"></i></button>
                        <button type="button" class="btn btn-outline-secondary dismiss-alert-btn" data-alertid="${alertId}" title="Dismiss Alert"><i class="bx bx-hide"></i></button>
                    `;
                }
            }

            // ==================== NOTIFICATION ====================
            function showNotification(msg, type) {
                const bg = type === 'success' ? '#28a745' : '#dc3545';
                const n = document.createElement('div');
                n.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:white;padding:12px 20px;border-radius:10px;box-shadow:0 5px 20px rgba(0,0,0,0.2);font-weight:500;animation:popIn 0.3s ease;`;
                n.textContent = msg;
                document.body.appendChild(n);
                setTimeout(() => n.remove(), 3000);
            }

            // Clean up modals
            document.querySelectorAll('.modal').forEach(modal => {
                modal.addEventListener('hidden.bs.modal', function() {
                    document.body.classList.remove('modal-open');
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.remove();
                });
            });
        });
    </script>
}

