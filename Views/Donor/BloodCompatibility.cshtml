@model Khoon_e_Hayat.ViewModels.DonorBloodCompatibilityViewModel
@{
    ViewData["Title"] = "Blood Compatibility";
    Layout = "~/Views/Shared/_DonorLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">Blood Compatibility Guide</h4>
                    <small class="text-muted">Understand blood group matching, donation rules, and compatibility charts.</small>
                </div>
                <span class="badge bg-label-primary rounded-pill px-3 py-2">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- ==================== SECTION 1: COMPATIBILITY CHART ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <h4 class="mb-1 fw-semibold">Blood Compatibility Chart</h4>
                    <small class="text-muted">Comprehensive guide to blood donation and reception compatibility</small>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Blood Group</th>
                                    <th>Can Donate To</th>
                                    <th>Can Receive From</th>
                                    <th>Special Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bg in Model.BloodGroups)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-@bg.ColorTheme-subtle text-@bg.ColorTheme fs-5 px-3 py-2">@bg.BloodGroup</span>
                                        </td>
                                        <td>
                                            @foreach (var d in bg.CanDonateTo)
                                            {
                                                <span class="badge bg-light text-dark border me-1">@d</span>
                                            }
                                        </td>
                                        <td>
                                            @foreach (var r in bg.CanReceiveFrom)
                                            {
                                                <span class="badge bg-@bg.ColorTheme-subtle text-@bg.ColorTheme me-1">@r</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(bg.SpecialRole))
                                            {
                                                <span class="badge bg-warning-subtle text-warning">
                                                    <i class="bi bi-star-fill me-1"></i>@bg.SpecialRole
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ==================== SECTION 2: VISUAL BLOOD GROUP GRID ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <h4 class="mb-1 fw-semibold">Visual Blood Group Grid</h4>
                    <small class="text-muted">Quick visual reference for each blood type's compatibility</small>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-4">
                        @foreach (var bg in Model.BloodGroups)
                        {
                            <div class="col-md-6 col-lg-3">
                                <div class="card custom-card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                                    <div class="display-4 fw-bold text-@bg.ColorTheme mb-3">@bg.BloodGroup</div>
                                    @if (!string.IsNullOrEmpty(bg.SpecialRole))
                                    {
                                        <span class="badge bg-warning-subtle text-warning mb-3">@bg.SpecialRole</span>
                                    }
                                    
                                    <h6 class="fw-semibold mb-2 text-start">Can Donate To</h6>
                                    <div class="mb-3 text-start">
                                        @foreach (var d in bg.CanDonateTo)
                                        {
                                            <span class="badge bg-light text-dark border me-1 mb-1">@d</span>
                                        }
                                    </div>
                                    
                                    <h6 class="fw-semibold mb-2 text-start">Can Receive From</h6>
                                    <div class="text-start">
                                        @foreach (var r in bg.CanReceiveFrom)
                                        {
                                            <span class="badge bg-@bg.ColorTheme-subtle text-@bg.ColorTheme me-1 mb-1">@r</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ==================== SECTION 3: QUICK COMPATIBILITY TOOL ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <h4 class="mb-1 fw-semibold">Quick Compatibility Tool</h4>
                    <small class="text-muted">Select a blood group to instantly see compatibility matches</small>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">Select Your Blood Group</label>
                            <select id="compatibilitySelector" class="form-select form-select-lg rounded-pill">
                                <option value="">-- Choose Blood Group --</option>
                                @foreach (var bg in Model.BloodGroups)
                                {
                                    <option value="@bg.BloodGroup">@bg.BloodGroup</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <div id="compatibilityResult" class="mt-4 d-none">
                        <!-- JS will populate this -->
                    </div>
                </div>
            </div>

            <!-- ==================== SECTION 4: EDUCATIONAL SECTION ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <h4 class="mb-1 fw-semibold">Educational Information</h4>
                    <small class="text-muted">Learn why blood compatibility is critical in medical emergencies</small>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card custom-card border-0 shadow-sm rounded-4 h-100 p-4">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="icon-box bg-danger-subtle"><i class="bi bi-droplet-fill text-danger"></i></div>
                                    <h5 class="fw-semibold mb-0">Universal Donor (O-)</h5>
                                </div>
                                <p class="text-muted mb-0">Individuals with O-negative blood can donate red blood cells to any other blood type. This makes O- crucial in emergency situations where there is no time to determine the patient's blood type.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card custom-card border-0 shadow-sm rounded-4 h-100 p-4">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="icon-box bg-info-subtle"><i class="bi bi-heart-pulse-fill text-info"></i></div>
                                    <h5 class="fw-semibold mb-0">Universal Receiver (AB+)</h5>
                                </div>
                                <p class="text-muted mb-0">People with AB-positive blood can receive red blood cells from any other blood type. This unique ability is vital in critical care scenarios where rapid transfusions are needed.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card custom-card border-0 shadow-sm rounded-4 h-100 p-4">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="icon-box bg-success-subtle"><i class="bi bi-shield-check text-success"></i></div>
                                    <h5 class="fw-semibold mb-0">Why Compatibility Matters</h5>
                                </div>
                                <p class="text-muted mb-0">Transfusing incompatible blood can cause severe, potentially fatal immune reactions. The body's antibodies will attack the foreign red blood cells, leading to complications like kidney failure or shock.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card custom-card border-0 shadow-sm rounded-4 h-100 p-4">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="icon-box bg-warning-subtle"><i class="bi bi-exclamation-triangle-fill text-warning"></i></div>
                                    <h5 class="fw-semibold mb-0">Emergency Protocols</h5>
                                </div>
                                <p class="text-muted mb-0">In life-threatening emergencies, O-negative blood is typically used for patients with unknown blood types, while AB-positive patients might receive AB plasma. Cross-matching is always prioritized when time permits.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ==================== STYLES ==================== -->
<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .custom-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
    }
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
</style>

<!-- ==================== JAVASCRIPT ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Serialize model data for JS
            const bloodData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BloodGroups));

            const selector = document.getElementById('compatibilitySelector');
            const resultDiv = document.getElementById('compatibilityResult');

            selector.addEventListener('change', function () {
                const selectedGroup = this.value;
                
                if (!selectedGroup) {
                    resultDiv.classList.add('d-none');
                    return;
                }

                const selectedData = bloodData.find(bg => bg.BloodGroup === selectedGroup);
                if (!selectedData) return;

                let donateHtml = selectedData.CanDonateTo.map(g => 
                    `<span class="badge bg-success-subtle text-success fs-6 px-3 py-2 me-2 mb-2">${g}</span>`
                ).join('');

                let receiveHtml = selectedData.CanReceiveFrom.map(g => 
                    `<span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2 me-2 mb-2">${g}</span>`
                ).join('');

                resultDiv.innerHTML = `
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: rgba(25, 135, 84, 0.05);">
                                <h5 class="fw-bold text-success mb-3"><i class="bi bi-arrow-right-circle me-2"></i>Can Donate To</h5>
                                <div>${donateHtml || '<span class="text-muted">None</span>'}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: rgba(13, 110, 253, 0.05);">
                                <h5 class="fw-bold text-primary mb-3"><i class="bi bi-arrow-left-circle me-2"></i>Can Receive From</h5>
                                <div>${receiveHtml || '<span class="text-muted">None</span>'}</div>
                            </div>
                        </div>
                    </div>
                `;
                
                resultDiv.classList.remove('d-none');
            });
        });
    </script>
}