@model Khoon_e_Hayat.ViewModels.DonorBloodRequestViewModel
@{
    ViewData["Title"] = "Blood Requests";
    Layout = "~/Views/Shared/_DonorLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">Blood Requests</h4>
                    <small class="text-muted">Browse and respond to available blood donation requests.</small>
                </div>
                <span class="badge bg-label-primary rounded-pill px-3 py-2">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-clipboard2-pulse text-primary"></i></div>
                                <h6 class="card-title mt-3 mb-1">Total Requests</h6>
                                <small class="text-muted">@Model.TotalRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-check-circle text-success"></i></div>
                                <h6 class="card-title mt-3 mb-1">Active Requests</h6>
                                <small class="text-muted">@Model.ActiveRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-exclamation-triangle-fill text-danger"></i></div>
                                <h6 class="card-title mt-3 mb-1">Emergency</h6>
                                <small class="text-muted">@Model.EmergencyRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box"><i class="bi bi-droplet-half text-info"></i></div>
                                <h6 class="card-title mt-3 mb-1">Matching Your Group</h6>
                                <small class="text-muted">@Model.MatchingRequests.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Search</label>
                            <input type="text" id="searchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Patient, Hospital, City..." />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Blood Group</label>
                            <select id="filterBloodGroup" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Urgency</label>
                            <select id="filterUrgency" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select id="filterStatus" class="form-select form-select-sm rounded-pill">
                                <option value="all">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">From Date</label>
                            <input type="date" id="filterDateFrom" class="form-control form-control-sm rounded-pill px-3" />
                        </div>
                        <div class="col-12 col-md-1">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill w-100" id="resetFiltersBtn">Reset</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Available Requests</h4>
                            <small class="text-muted">Requests sorted by urgency and latest posted date</small>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="requestsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Request ID</th>
                                    <th>Blood Group</th>
                                    <th>Patient Name</th>
                                    <th>Hospital</th>
                                    <th>City</th>
                                    <th>Units</th>
                                    <th>Required Date</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th>Posted Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Requests.Any())
                                {
                                    foreach (var req in Model.Requests)
                                    {
                                        <tr data-bg="@req.BloodGroup" data-urgency="@req.UrgencyLevel" data-status="@req.Status" data-date="@req.PostedDate.ToString("yyyy-MM-dd")">
                                            <td>REQ-@req.RequestId.ToString("D4")</td>
                                            <td>
                                                <span class="fw-bold text-danger fs-5">@req.BloodGroup</span>
                                                @if(req.IsMatchingBloodGroup) {
                                                    <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.7em;">Match</span>
                                                }
                                            </td>
                                            <td>@req.PatientName</td>
                                            <td>@req.HospitalName</td>
                                            <td>@req.City</td>
                                            <td>@req.UnitsRequired</td>
                                            <td>@req.RequiredDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                @if (req.UrgencyLevel == "Critical") { <span class="badge bg-danger-subtle text-danger">Critical</span> }
                                                else if (req.UrgencyLevel == "High") { <span class="badge bg-warning-subtle text-warning">High</span> }
                                                else if (req.UrgencyLevel == "Medium") { <span class="badge bg-info-subtle text-info">Medium</span> }
                                                else { <span class="badge bg-success-subtle text-success">Low</span> }
                                            </td>
                                            <td>
                                                @if (req.Status == "Pending") { <span class="badge bg-warning-subtle text-warning">Pending</span> }
                                                else if (req.Status == "Approved") { <span class="badge bg-success-subtle text-success">Approved</span> }
                                                else if (req.Status == "Completed") { <span class="badge bg-primary-subtle text-primary">Completed</span> }
                                                else if (req.Status == "Cancelled") { <span class="badge bg-secondary-subtle text-secondary">Cancelled</span> }
                                                else { <span class="badge bg-secondary-subtle text-secondary">@req.Status</span> }
                                            </td>
                                            <td>@req.PostedDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex gap-1">
                                                    <button type="button" class="btn btn-outline-info view-details-btn" 
                                                            data-requestid="@req.RequestId"
                                                            data-bg="@req.BloodGroup"
                                                            data-patient="@req.PatientName"
                                                            data-hospital="@req.HospitalName"
                                                            data-city="@req.City"
                                                            data-contact="@req.ContactNumber"
                                                            data-units="@req.UnitsRequired"
                                                            data-reqdate="@req.RequiredDate.ToString("dd-MMM-yyyy")"
                                                            data-urgency="@req.UrgencyLevel"
                                                            data-status="@req.Status"
                                                            data-match="@req.IsMatchingBloodGroup"
                                                            data-distance="@req.Distance"
                                                            data-eligibility="@req.Eligibility"
                                                            title="View Details">
                                                        <i class="bx bx-info-circle"></i>
                                                    </button>
                                                    @if (req.Status == "Pending" || req.Status == "Approved")
                                                    {
                                                        <button type="button" class="btn btn-outline-success accept-btn" data-requestid="@req.RequestId" title="Accept Request">
                                                            <i class="bx bx-check"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger decline-btn" data-requestid="@req.RequestId" title="Decline Request">
                                                            <i class="bx bx-x"></i>
                                                        </button>
                                                    }
                                                    <button type="button" class="btn btn-outline-primary navigate-btn" data-city="@req.City" data-hospital="@req.HospitalName" title="Navigate">
                                                        <i class="bx bx-navigation"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="emptyStateRow">
                                        <td colspan="11" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bi bi-droplet fs-1 d-block mb-2 text-success"></i>
                                                <h5 class="fw-semibold">No Blood Requests Available</h5>
                                                <p class="mb-0">There are currently no blood requests matching your criteria.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Requests: @Model.TotalRequests</small>
                        <nav><ul class="pagination pagination-sm mb-0" id="pagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-clipboard2-pulse text-danger"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Request Details</h5>
                        <small class="text-muted" id="modalRequestId">REQ-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-danger mb-3"><i class="bi bi-droplet-fill me-2"></i>Medical Requirement</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group</label><p class="form-control-plaintext fw-bold text-danger fs-5 mb-0" id="d_BloodGroup">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Units Required</label><p class="form-control-plaintext fw-semibold mb-0" id="d_Units">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Urgency Level</label><p class="form-control-plaintext mb-0" id="d_Urgency">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Required Date</label><p class="form-control-plaintext mb-0" id="d_ReqDate">-</p></div>
                        </div>

                        <h6 class="fw-bold text-primary mb-3 mt-4"><i class="bi bi-hospital me-2"></i>Hospital & Patient</h6>
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label small text-muted mb-1">Patient Name</label><p class="form-control-plaintext fw-semibold mb-0" id="d_Patient">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Hospital Name</label><p class="form-control-plaintext mb-0" id="d_Hospital">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">City</label><p class="form-control-plaintext mb-0" id="d_City">-</p></div>
                            <div class="col-12"><label class="form-label small text-muted mb-1">Contact Number</label><p class="form-control-plaintext mb-0" id="d_Contact">-</p></div>
                        </div>

                        <h6 class="fw-bold text-success mb-3 mt-4"><i class="bi bi-robot me-2"></i>Smart Indicators</h6>
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label small text-muted mb-1">Blood Group Match</label><p class="form-control-plaintext mb-0" id="d_Match">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Estimated Distance</label><p class="form-control-plaintext mb-0" id="d_Distance">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Eligibility Status</label><p class="form-control-plaintext mb-0" id="d_Eligibility">-</p></div>
                            <div class="col-6"><label class="form-label small text-muted mb-1">Request Status</label><p class="form-control-plaintext mb-0" id="d_Status">-</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .custom-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
    }
    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
    }
    #viewDetailsModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }
</style>

<!-- Scripts -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('searchInput');
            const filterBloodGroup = document.getElementById('filterBloodGroup');
            const filterUrgency = document.getElementById('filterUrgency');
            const filterStatus = document.getElementById('filterStatus');
            const filterDateFrom = document.getElementById('filterDateFrom');
            const resetBtn = document.getElementById('resetFiltersBtn');

            function filterTable() {
                const sVal = searchInput.value.toLowerCase();
                const bgVal = filterBloodGroup.value;
                const urgVal = filterUrgency.value;
                const statVal = filterStatus.value;
                const dateFrom = filterDateFrom.value ? new Date(filterDateFrom.value) : null;
                
                const rows = document.querySelectorAll("#requestsTable tbody tr");
                
                rows.forEach(row => {
                    if (row.id === 'emptyStateRow') return;

                    const patient = row.cells[2].textContent.toLowerCase();
                    const hospital = row.cells[3].textContent.toLowerCase();
                    const city = row.cells[4].textContent.toLowerCase();
                    
                    const bg = row.getAttribute('data-bg');
                    const urgency = row.getAttribute('data-urgency');
                    const status = row.getAttribute('data-status');
                    
                    const rowDateStr = row.getAttribute('data-date');
                    const rowDate = rowDateStr ? new Date(rowDateStr) : null;

                    let show = true;

                    if (sVal && !(patient.includes(sVal) || hospital.includes(sVal) || city.includes(sVal))) show = false;
                    if (bgVal !== 'all' && bg !== bgVal) show = false;
                    if (urgVal !== 'all' && urgency !== urgVal) show = false;
                    if (statVal !== 'all' && status !== statVal) show = false;
                    if (dateFrom && rowDate && rowDate < dateFrom) show = false;

                    row.style.display = show ? "" : "none";
                });
                
                currentPage = 1;
                initPagination();
            }

            [searchInput, filterBloodGroup, filterUrgency, filterStatus, filterDateFrom].forEach(el => {
                el.addEventListener('input', filterTable);
                el.addEventListener('change', filterTable);
            });

            resetBtn.addEventListener('click', () => {
                searchInput.value = '';
                filterBloodGroup.value = 'all';
                filterUrgency.value = 'all';
                filterStatus.value = 'all';
                filterDateFrom.value = '';
                filterTable();
            });

            const rowsPerPage = 10;
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function initPagination() {
                const visible = Array.from(document.querySelectorAll("#requestsTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow');
                const pages = Math.ceil(visible.length / rowsPerPage);
                if (currentPage > pages) currentPage = pages || 1;
                showPage(currentPage, visible);
            }

            function showPage(page, visible) {
                currentPage = page;
                document.querySelectorAll("#requestsTable tbody tr").forEach(r => { if(r.id !== 'emptyStateRow') r.style.display = 'none'; });
                const start = (page - 1) * rowsPerPage;
                visible.slice(start, start + rowsPerPage).forEach(r => r.style.display = '');
                renderPagination(visible.length);
            }

            function renderPagination(total) {
                pagination.innerHTML = "";
                const pages = Math.ceil(total / rowsPerPage);
                if (pages <= 1) return;

                const prev = document.createElement("li"); prev.className = `page-item ${currentPage===1?'disabled':''}`;
                prev.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prev.onclick = (e) => { e.preventDefault(); if(currentPage>1) showPage(currentPage-1, getVisible()); };
                pagination.appendChild(prev);

                for (let i=1; i<=pages; i++) {
                    const li = document.createElement("li"); li.className = `page-item ${currentPage===i?'active':''}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.onclick = (e) => { e.preventDefault(); showPage(i, getVisible()); };
                    pagination.appendChild(li);
                }

                const next = document.createElement("li"); next.className = `page-item ${currentPage===pages?'disabled':''}`;
                next.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                next.onclick = (e) => { e.preventDefault(); if(currentPage<pages) showPage(currentPage+1, getVisible()); };
                pagination.appendChild(next);
            }

            function getVisible() { return Array.from(document.querySelectorAll("#requestsTable tbody tr")).filter(r => r.style.display !== 'none' && r.id !== 'emptyStateRow'); }
            initPagination();

            document.getElementById('requestsTable').addEventListener('click', function(e) {
                const btn = e.target.closest('button');
                if (!btn) return;

                const row = btn.closest('tr');
                if (!row || row.id === 'emptyStateRow') return;

                if (btn.classList.contains('view-details-btn')) {
                    document.getElementById('modalRequestId').textContent = `REQ-${btn.getAttribute('data-requestid').padStart(4, '0')}`;
                    document.getElementById('d_BloodGroup').textContent = btn.getAttribute('data-bg');
                    document.getElementById('d_Patient').textContent = btn.getAttribute('data-patient');
                    document.getElementById('d_Hospital').textContent = btn.getAttribute('data-hospital');
                    document.getElementById('d_City').textContent = btn.getAttribute('data-city');
                    document.getElementById('d_Contact').textContent = btn.getAttribute('data-contact');
                    document.getElementById('d_Units').textContent = btn.getAttribute('data-units');
                    document.getElementById('d_ReqDate').textContent = btn.getAttribute('data-reqdate');
                    document.getElementById('d_Urgency').textContent = btn.getAttribute('data-urgency');
                    document.getElementById('d_Status').textContent = btn.getAttribute('data-status');
                    
                    document.getElementById('d_Match').innerHTML = btn.getAttribute('data-match') === 'True' 
                        ? '<span class="badge bg-success-subtle text-success">Exact Match</span>' 
                        : '<span class="badge bg-secondary-subtle text-secondary">No Match</span>';
                        
                    document.getElementById('d_Distance').textContent = btn.getAttribute('data-distance');
                    document.getElementById('d_Eligibility').textContent = btn.getAttribute('data-eligibility');
                    
                    const viewModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
                    viewModal.show();
                } 
                else if (btn.classList.contains('accept-btn')) {
                    showNotification('Request accepted! The hospital will be notified.', 'success');
                } 
                else if (btn.classList.contains('decline-btn')) {
                    showNotification('Request declined.', 'warning');
                } 
                else if (btn.classList.contains('navigate-btn')) {
                    const hospital = btn.getAttribute('data-hospital');
                    const city = btn.getAttribute('data-city');
                    window.open(`https://www.google.com/maps/search/${hospital}+${city}`, '_blank');
                }
            });

            function showNotification(msg, type) {
                const bg = type === 'success' ? '#28a745' : (type === 'warning' ? '#ffc107' : '#dc3545');
                const textColor = type === 'warning' ? '#000' : '#fff';
                const n = document.createElement('div');
                n.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:${textColor};padding:12px 20px;border-radius:10px;box-shadow:0 5px 20px rgba(0,0,0,0.2);font-weight:500;animation:popIn 0.3s ease;`;
                n.textContent = msg;
                document.body.appendChild(n);
                setTimeout(() => n.remove(), 3000);
            }
        });
    </script>
}
