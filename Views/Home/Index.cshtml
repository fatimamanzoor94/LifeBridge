@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khoon-e-Hayat</title>

    <link rel="icon" type="image/png" href="assets/Favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            primary: '#23BBB7',
                            secondary: '#23BBB7',
                            accent: '#90151C',
                            success: '#23BBB7',
                            background: '#F6F6F6',
                            muted: 'black',
                            deep: '#063154',
                            border: '#bcc5cc',
                        },
                        fontFamily: {
                            sans: ['Inter', 'sans-serif'],
                        }
                    }
                }
            }
    </script>
    <style>
            :root {
                --primary: #23BBB7;
                --secondary: #23BBB7;
                --accent: #90151C;
                --success: #23BBB7;
                --background: #F6F6F6;
                --text-muted: #898F99;
                --deep: #063154;
                --border: #bcc5cc;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--background);
                color: #1f2937;
                overflow-x: hidden;
            }

            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: var(--background);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--secondary);
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--primary);
                }

            .glass {
                background: #90151C;
                border: 1px solid var(--border);
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(40px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes fadeInLeft {
                from {
                    opacity: 0;
                    transform: translateX(-40px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes fadeInRight {
                from {
                    opacity: 0;
                    transform: translateX(40px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes float {
                0%, 100% {
                    transform: translateY(0px);
                }

                50% {
                    transform: translateY(-10px);
                }
            }

            .animate-fadeInUp {
                animation: fadeInUp 0.8s ease forwards;
            }

            .animate-fadeInLeft {
                animation: fadeInLeft 0.8s ease forwards;
            }

            .animate-fadeInRight {
                animation: fadeInRight 0.8s ease forwards;
            }

            .animate-float {
                animation: float 3s ease-in-out infinite;
            }

            .reveal {
                opacity: 0;
                transform: translateY(40px);
                transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .reveal.active {
                    opacity: 1;
                    transform: translateY(0);
                }

            .hero-section {
                position: relative;
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                min-height: 100vh;
                transition: background-image 1s ease-in-out;
            }

                .hero-section::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.8);
                    z-index: 1;
                }

                .hero-section > * {
                    position: relative;
                    z-index: 2;
                }

            @@media (max-width: 768px) {
                .hero-section {
                    background-position: center center;
                }
            }

            .service-card {
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                border: 1px solid var(--border);
            }

                .service-card:hover {
                    transform: translateY(-8px);
                    border-color: var(--secondary);
                }

            .btn-primary {
                background-color: var(--primary);
                color: white;
                transition: all 0.3s ease;
                border: 2px solid var(--primary);
            }

                .btn-primary:hover {
                    background-color: var(--accent);
                    border-color: var(--accent);
                    transform: translateY(-2px);
                }

            .btn-accent {
                background-color: var(--success);
                color: white;
                transition: all 0.3s ease;
                border: 2px solid var(--success);
            }

                .btn-accent:hover {
                    background-color: var(--primary);
                    border-color: var(--primary);
                    transform: translateY(-2px);
                }

            .btn-outline {
                background-color: transparent;
                color: white;
                border: 2px solid white;
                transition: all 0.3s ease;
            }

                .btn-outline:hover {
                    background-color: white;
                    color: var(--primary);
                    transform: translateY(-2px);
                }

            .form-input {
                transition: all 0.3s ease;
                border: 2px solid var(--border);
                background-color: white;
            }

                .form-input:focus {
                    border-color: var(--secondary);
                    outline: none;
                }

            .testimonial-card {
                transition: all 0.3s ease;
                border: 1px solid var(--border);
            }

                .testimonial-card:hover {
                    transform: scale(1.02);
                    border-color: var(--secondary);
                }

            .counter-section {
                position: relative;
                background-image: url('../assets/Khoon-e-Hayat-Bg-9.png');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
            }

                .counter-section::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.82);
                    z-index: 1;
                }

                .counter-section > * {
                    position: relative;
                    z-index: 2;
                }

            .tab-btn.active {
                background: var(--primary);
                color: white;
            }


            .nav-link {
                position: relative;
            }

                .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: -4px;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background: var(--success);
                    transition: width 0.3s ease;
                }

                .nav-link:hover::after {
                    width: 100%;
                }

            .calc-slider {
                -webkit-appearance: none;
                width: 100%;
                height: 6px;
                border-radius: 5px;
                background: var(--border);
                outline: none;
            }

                .calc-slider::-webkit-slider-thumb {
                    -webkit-appearance: none;
                    appearance: none;
                    width: 20px;
                    height: 20px;
                    border-radius: 50%;
                    background: var(--success);
                    cursor: pointer;
                    border: 3px solid white;
                }

            /* Social Icons - Solid Hover */
            .social-icon {
                transition: all 0.3s ease;
                background-color: var(--deep);
            }

                .social-icon:hover {
                    transform: translateY(-4px) scale(1.1);
                    background-color: var(--primary);
                }

            /* Hamburger Animation */
            .hamburger span {
                transition: all 0.3s ease;
                background-color: #fefefe;
            }

            .hamburger.active span:nth-child(1) {
                transform: rotate(45deg) translate(5px, 5px);
            }

            .hamburger.active span:nth-child(2) {
                opacity: 0;
            }

            .hamburger.active span:nth-child(3) {
                transform: rotate(-45deg) translate(7px, -6px);
            }

            /* Section Divider - Solid Color */
            .section-divider {
                height: 4px;
                width: 60px;
                background: var(--success);
                border-radius: 2px;
            }

            /* Loading Spinner - Solid Colors */
            .spinner {
                border: 3px solid rgba(255, 255, 255, 0.3);
                border-top: 3px solid white;
                border-radius: 50%;
                width: 20px;
                height: 20px;
                animation: spin 1s linear infinite;
            }

            @@keyframes spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }

            /* Toast Notification - Solid Colors, No Shadow */
            .toast {
                position: fixed;
                bottom: 2rem;
                right: 2rem;
                padding: 1rem 1.5rem;
                border-radius: 0.75rem;
                color: white;
                font-weight: 500;
                z-index: 2000;
                transform: translateX(150%);
                transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                border: 2px solid white;
            }

                .toast.show {
                    transform: translateX(0);
                }

            .toast-success {
                background: var(--success);
            }

            .toast-error {
                background: #dc2626;
            }

            .toast-info {
                background: var(--secondary);
            }

            /* Tab Navigation - Glider Effect - Solid Colors */
            .tab-nav-container {
                position: relative;
                display: flex;
                align-items: center;
                background: white;
                /* border: 1px solid var(--border); */
                border-radius: 9999px;
                padding: 0.25rem;
                gap: 0.25rem;
            }

            .tab-glider {
                position: absolute;
                top: 0.25rem;
                bottom: 0.25rem;
                background: var(--accent);
                border-radius: 9999px;
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s ease;
                pointer-events: none;
                z-index: 0;
            }

            .tab-link {
                position: relative;
                z-index: 1;
                padding: 0.5rem 1rem;
                font-weight: 500;
                font-size: 0.875rem;
                color: var(--text-muted);
                border-radius: 9999px;
                transition: color 0.2s ease;
                text-decoration: none;
                white-space: nowrap;
            }

                .tab-link:hover {
                    color: var(--accent);
                }

                .tab-link.active {
                    color: white;
                }

            .tab-radio {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

                .tab-radio:focus-visible + .tab-link {
                    outline: 2px solid var(--success);
                    outline-offset: 2px;
                }

            .calculator-section {
                position: relative;
                background-image: url('../images/Bg16.png');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
            }

                .calculator-section::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.5);
                    z-index: 1;
                }

                .calculator-section > * {
                    position: relative;
                    z-index: 2;
                }

            /* FEATURE CARD STYLES - LIGHT MODE ONLY */
            .feature-card h3,
            .feature-card p {
                color: #1f2937;
            }

            .feature-card:hover {
                background-color: #f9fafb;
            }

                .feature-card:hover h3,
                .feature-card:hover p {
                    color: #1f2937;
                }
    </style>
</head>
<body>

    <!-- Toast Notification -->
    <div id="toast" class="toast toast-success">
        <i class="fas fa-check-circle mr-2"></i>
        <span id="toastMessage">Success!</span>
    </div>

    <!-- ========== NAVBAR ========== -->
    <nav id="navbar" class="fixed top-0 left-0 w-full z-50 glass border-b border-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 lg:h-20">
                <!-- Logo -->
                <a href="#home" class="flex items-center group">
                    <div class="w-32 h-32 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                        <img id="navbarLogo"
                             src="assets/finalLogo-01.png"
                             alt="OIMS Logo"
                             class="w-full h-full object-contain">
                    </div>
                </a>

                <input id="heroCoverage" type="hidden">
                <input id="calcTerm" type="hidden">

                <!-- Desktop Tab Navigation -->
                <div class="hidden lg:flex items-center">
                    <div class="tab-nav-container" role="tablist" aria-label="Main Navigation">
                        <div class="tab-glider" id="tabGlider" aria-hidden="true"></div>

                        <input type="radio" name="nav-tab" id="tab-home" class="tab-radio" value="0" checked>
                        <input type="radio" name="nav-tab" id="tab-About Us" class="tab-radio" value="1">
                        <input type="radio" name="nav-tab" id="tab-Hospitals" class="tab-radio" value="2">
                        <input type="radio" name="nav-tab" id="tab-testimonials" class="tab-radio" value="3">
                        <input type="radio" name="nav-tab" id="tab-contact" class="tab-radio" value="4">

                        <a href="#home" class="tab-link active" role="tab" aria-controls="home" data-tab="0" aria-selected="true">Home</a>
                        <a href="#about" class="tab-link" role="tab" aria-controls="about" data-tab="1" aria-selected="false">About Us</a>
                        <a href="#Hospitals" class="tab-link" role="tab" aria-controls="Hospitals" data-tab="2" aria-selected="false">Hospitals</a>
                        <a href="#testimonials" class="tab-link" role="tab" aria-controls="testimonials" data-tab="3" aria-selected="false">Testimonials</a>
                        <a href="#contact" class="tab-link" role="tab" aria-controls="contact" data-tab="4" aria-selected="false">Contact</a>
                    </div>
                </div>

                <!-- Right Actions -->
                <div class="hidden lg:flex items-center space-x-4">
                    <a asp-controller="Account" asp-action="Login"
                       class="px-5 py-2 rounded-full border-2 border-white text-white hover:bg-primary hover:border-primary hover:text-white font-semibold transition-all">
                        Login
                    </a>
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn-accent px-5 py-2 rounded-full text-white font-semibold">
                        Register
                    </a>
                </div>

                <!-- Mobile Menu Toggle -->
                <div class="flex lg:hidden items-center">
                    <button id="hamburger" class="hamburger flex flex-col space-y-1.5 p-2" aria-label="Toggle mobile menu" aria-expanded="false" aria-controls="mobileMenu">
                        <span class="w-6 h-0.5 block"></span>
                        <span class="w-6 h-0.5 block"></span>
                        <span class="w-6 h-0.5 block"></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="lg:hidden hidden bg-white border-t border-border">
            <div class="px-4 py-4 space-y-3">
                <a href="#home" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Home</a>
                <a href="#about" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">About Us</a>
                <a href="#Hospitals" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Hospitals</a>
                <a href="#testimonials" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Testimonials</a>
                <a href="#contact" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Contact</a>
                <div class="pt-3 border-t border-border space-y-3">
                    <a href="login-modal.html" class="w-full py-2.5 rounded-lg border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold transition-all text-center block">Login</a>
                    <a href="register-modal.html" class="w-full btn-accent py-2.5 rounded-lg text-white font-semibold text-center block">Register</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ========== HERO SECTION ========== -->
    <section id="home" class="hero-section min-h-screen flex items-center relative overflow-hidden pt-20">

        <!-- Floating Shapes -->
        <div class="absolute top-20 left-10 w-20 h-20 rounded-full bg-white/10 animate-float"></div>
        <div class="absolute bottom-20 right-20 w-32 h-32 rounded-full bg-white/5 animate-float" style="animation-delay: 1s;"></div>
        <div class="absolute top-40 right-40 w-16 h-16 rounded-full bg-white/10 animate-float" style="animation-delay: 2s;"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">

                <!-- Left Content -->
                <div class="text-white space-y-8 animate-fadeInLeft">
                    <div class="inline-flex items-center space-x-2 bg-white px-4 py-2 rounded-full border border-border">
                        <i class="fas fa-heart text-red-600"></i>
                        <span class="text-sm font-medium text-deep">
                            Saving Lives Through Blood Donation
                        </span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
                        Donate Blood,<br>
                        <span class="text-[#23BBB7]">Save Lives</span><br>
                        Every Day
                    </h1>

                    <p class="text-lg text-white/80 max-w-lg leading-relaxed">
                        Khoon-e-Hayat connects blood donors, patients, hospitals, and blood banks
                        on one platform. Find donors quickly, request blood instantly, and help
                        save lives when every second matters.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4">

                        <a href="@Url.Action("Login", "Account")"
                           class="px-8 py-4 rounded-full text-white font-bold text-lg bg-[#90151C] hover:bg-[#7A1117] text-center">
                            <i class="fas fa-hand-holding-heart mr-2"></i>
                            Become a Donor
                        </a>

                        <a href="@Url.Action("Login", "Account")"
                           class="px-8 py-4 rounded-full bg-transparent text-white border border-white hover:bg-white hover:text-black font-bold text-lg transition-all text-center">
                            <i class="fas fa-search mr-2"></i>
                            Find a Donor
                        </a>

                    </div>

                    <!-- Trust Badges -->
                    <div class="flex items-center space-x-6 pt-4">

                        <div class="flex items-center space-x-2">
                            <i class="fas fa-users text-[#23BBB7]"></i>
                            <span class="text-sm text-white/80">Verified Donors</span>
                        </div>

                        <div class="flex items-center space-x-2">
                            <i class="fas fa-hospital text-[#23BBB7]"></i>
                            <span class="text-sm text-white/80">Partner Hospitals</span>
                        </div>

                        <div class="flex items-center space-x-2">
                            <i class="fas fa-clock text-[#23BBB7]"></i>
                            <span class="text-sm text-white/80">Emergency Requests</span>
                        </div>

                    </div>
                </div>

                <!-- Right Content -->
                <div class="animate-fadeInRight">

                    <div class="bg-white/15 backdrop-blur-xl border border-white/30 shadow-2xl rounded-3xl p-8">

                        <div class="text-center mb-8">
                            <!-- <i class="fas fa-heartbeat text-6xl text-[#90151C] mb-4"></i> -->
                            <h3 class="text-3xl font-bold text-white">
                                Lives Saved
                            </h3>
                            <p class="text-white/70 mt-2">
                                Together We Make a Difference
                            </p>
                        </div>

                        <!-- Stats -->
                        <div class="grid grid-cols-2 gap-4">

                            <div class="bg-white/10 rounded-2xl p-4 text-center">
                                <h4 class="text-3xl font-bold text-[#23BBB7]">5K+</h4>
                                <p class="text-white/70 text-sm">Donors</p>
                            </div>

                            <div class="bg-white/10 rounded-2xl p-4 text-center">
                                <h4 class="text-3xl font-bold text-[#23BBB7]">2K+</h4>
                                <p class="text-white/70 text-sm">Requests</p>
                            </div>

                            <div class="bg-white/10 rounded-2xl p-4 text-center">
                                <h4 class="text-3xl font-bold text-[#23BBB7]">50+</h4>
                                <p class="text-white/70 text-sm">Hospitals</p>
                            </div>

                            <div class="bg-white/10 rounded-2xl p-4 text-center">
                                <h4 class="text-3xl font-bold text-[#23BBB7]">24/7</h4>
                                <p class="text-white/70 text-sm">Support</p>
                            </div>

                        </div>

                        <!-- Blood Groups -->
                        <div class="mt-8">
                            <h4 class="text-white font-semibold mb-4 text-center">
                                Available Blood Groups
                            </h4>

                            <div class="grid grid-cols-4 gap-3">

                                <div class="bg-[#90151C] text-white rounded-xl py-2 text-center font-bold">A+</div>
                                <div class="bg-[#90151C] text-white rounded-xl py-2 text-center font-bold">B+</div>
                                <div class="bg-[#90151C] text-white rounded-xl py-2 text-center font-bold">AB+</div>
                                <div class="bg-[#90151C] text-white rounded-xl py-2 text-center font-bold">O+</div>

                                <div class="bg-[#23BBB7] text-white rounded-xl py-2 text-center font-bold">A-</div>
                                <div class="bg-[#23BBB7] text-white rounded-xl py-2 text-center font-bold">B-</div>
                                <div class="bg-[#23BBB7] text-white rounded-xl py-2 text-center font-bold">AB-</div>
                                <div class="bg-[#23BBB7] text-white rounded-xl py-2 text-center font-bold">O-</div>

                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- ========== ABOUT US ========== -->
    <section id="about" class="py-20 lg:py-28 bg-background">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Section Heading -->
            <div class="text-center mb-16 reveal">
                <span class="text-[#90151C] font-semibold text-sm uppercase tracking-wider">
                    Who We Are
                </span>

                <h2 class="text-4xl lg:text-5xl font-extrabold text-black mt-3 mb-4">
                    About <span class="text-[#23BBB7]">Khoon-e-Hayat</span>
                </h2>

                <div class="section-divider mx-auto mt-4"></div>

                <p class="text-lg text-gray-600 leading-relaxed max-w-4xl mx-auto mt-8">
                    Khoon-e-Hayat is a modern blood donation platform dedicated to connecting
                    blood donors, patients, hospitals, and blood banks through a single
                    trusted network. Our goal is to make blood accessible whenever and
                    wherever it is needed, helping save lives during emergencies.
                </p>

                <p class="text-lg text-gray-600 leading-relaxed max-w-4xl mx-auto mt-4">
                    By enabling instant donor searches, emergency blood requests, and
                    hospital collaboration, we create a community-driven ecosystem that
                    promotes voluntary blood donation and strengthens healthcare support.
                </p>
            </div>

            <!-- Mission & Vision -->
            <div class="grid md:grid-cols-2 gap-8">

                <!-- Mission Card -->
                <div class="bg-white p-8 rounded-3xl border border-border hover:border-[#23BBB7] transition-all duration-300">
                    <div class="w-16 h-16 rounded-2xl bg-[#90151C]/10 flex items-center justify-center mb-5">
                        <i class="fas fa-bullseye text-3xl text-[#90151C]"></i>
                    </div>

                    <h3 class="text-2xl font-bold text-black mb-4">
                        Our Mission
                    </h3>

                    <p class="text-gray-600 leading-relaxed">
                        To provide a fast, reliable, and accessible blood donation network
                        that connects donors with patients in need, ensuring timely support
                        during critical situations and medical emergencies.
                    </p>
                </div>

                <!-- Vision Card -->
                <div class="bg-white p-8 rounded-3xl border border-border hover:border-[#23BBB7] transition-all duration-300">
                    <div class="w-16 h-16 rounded-2xl bg-[#90151C]/10 flex items-center justify-center mb-5">
                        <i class="fas fa-eye text-3xl text-[#90151C]"></i>
                    </div>

